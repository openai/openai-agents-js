+++ b/codex-rs/tools/src/json_schema/strict_mcp_optional.rs
@@ -0,0 +1,385 @@
+//! JavaScript's opt-in optional/null preservation, separate from legacy strict conversion.
+use serde_json::{Map, Value, json};
+use std::collections::{BTreeMap, BTreeSet};
+
+const MAX_BYTES: usize = 65_536;
+const MAX_DEPTH: usize = 64;
+
+fn children(schema: &Value) -> Vec<&Value> {
+    let mut nodes = Vec::new();
+    for key in ["properties", "$defs", "definitions"] {
+        if let Some(values) = schema.get(key).and_then(Value::as_object) {
+            nodes.extend(values.values());
+        }
+    }
+    if let Some(items) = schema.get("items") {
+        nodes.push(items);
+    }
+    if let Some(branches) = schema.get("anyOf").and_then(Value::as_array) {
+        nodes.extend(branches);
+    }
+    nodes
+}
+
+fn allows_null(schema: &Value, root: &Value, depth: usize) -> Option<bool> {
+    if depth > MAX_DEPTH {
+        return None;
+    }
+    let schema = schema.as_object()?;
+    if let Some(reference) = schema.get("$ref") {
+        return allows_null(
+            root.pointer(reference.as_str()?.strip_prefix('#')?)?,
+            root,
+            depth + 1,
+        );
+    }
+    if let Some(typ) = schema.get("type") {
+        let accepts = match typ {
+            Value::String(typ) => typ == "null",
+            Value::Array(types) => types.iter().any(|typ| typ == "null"),
+            _ => return None,
+        };
+        if !accepts {
+            return Some(false);
+        }
+    }
+    if let Some(values) = schema.get("enum") {
+        if !values.as_array()?.iter().any(Value::is_null) {
+            return Some(false);
+        }
+    }
+    if let Some(value) = schema.get("const") {
+        if !value.is_null() {
+            return Some(false);
+        }
+    }
+    if let Some(branches) = schema.get("anyOf") {
+        let values: Vec<_> = branches
+            .as_array()?
+            .iter()
+            .map(|node| allows_null(node, root, depth + 1))
+            .collect();
+        if values.contains(&Some(true)) {
+            return Some(true);
+        }
+        if values.iter().all(|value| *value == Some(false)) {
+            return Some(false);
+        }
+        return None;
+    }
+    Some(true)
+}
+
+fn optional(schema: &Value, key: &str) -> bool {
+    !schema
+        .get("required")
+        .and_then(Value::as_array)
+        .is_some_and(|required| required.iter().any(|value| value == key))
+}
+
+fn omits_fields(schema: &Value, root: &Value, depth: usize) -> bool {
+    if depth > MAX_DEPTH {
+        return true;
+    }
+    if let Some(reference) = schema.get("$ref").and_then(Value::as_str) {
+        return reference
+            .strip_prefix('#')
+            .and_then(|r| root.pointer(r))
+            .is_none_or(|node| omits_fields(node, root, depth + 1));
+    }
+    if let Some(properties) = schema.get("properties").and_then(Value::as_object) {
+        if properties
+            .iter()
+            .any(|(key, node)| optional(schema, key) && allows_null(node, root, 0) != Some(true))
+        {
+            return true;
+        }
+    }
+    children(schema)
+        .iter()
+        .any(|node| omits_fields(node, root, depth + 1))
+}
+
+fn supported_normalization(schema: &Value, root: &Value, depth: usize) -> bool {
+    if depth > MAX_DEPTH {
+        return false;
+    }
+    if let Some(branches) = schema.get("anyOf").and_then(Value::as_array) {
+        // Match v0's fail-closed boundary: no branch-aware runtime validator.
+        if branches.iter().any(|node| omits_fields(node, root, 0)) {
+            return false;
+        }
+    }
+    children(schema)
+        .iter()
+        .all(|node| supported_normalization(node, root, depth + 1))
+}
+
+fn references(schema: &Value, found: &mut BTreeSet<String>, depth: usize) -> bool {
+    if depth > MAX_DEPTH {
+        return false;
+    }
+    if let Some(reference) = schema.get("$ref").and_then(Value::as_str) {
+        found.insert(reference.to_owned());
+    }
+    children(schema)
+        .iter()
+        .all(|node| references(node, found, depth + 1))
+}
+
+fn rewrite_references(schema: &mut Value, refs: &BTreeMap<String, String>) {
+    let Some(object) = schema.as_object_mut() else {
+        return;
+    };
+    if let Some(reference) = object.get_mut("$ref") {
+        if let Some(next) = reference.as_str().and_then(|r| refs.get(r)) {
+            *reference = Value::String(next.clone());
+        }
+    }
+    for key in ["properties", "$defs", "definitions"] {
+        if let Some(nodes) = object.get_mut(key).and_then(Value::as_object_mut) {
+            for node in nodes.values_mut() {
+                rewrite_references(node, refs);
+            }
+        }
+    }
+    if let Some(node) = object.get_mut("items") {
+        rewrite_references(node, refs);
+    }
+    if let Some(nodes) = object.get_mut("anyOf").and_then(Value::as_array_mut) {
+        for node in nodes {
+            rewrite_references(node, refs);
+        }
+    }
+}
+
+fn wrap_optional(schema: &mut Value, root: &Value, depth: usize) -> Option<()> {
+    if depth > MAX_DEPTH {
+        return None;
+    }
+    let required = schema.get("required").cloned().unwrap_or(json!([]));
+    if !required.is_array() {
+        return None;
+    }
+    let object = schema.as_object_mut()?;
+    if let Some(properties) = object.get_mut("properties") {
+        for (key, node) in properties.as_object_mut()? {
+            let nullable = allows_null(node, root, 0)?;
+            wrap_optional(node, root, depth + 1)?;
+            if !required.as_array()?.iter().any(|value| value == key) && !nullable {
+                let original = std::mem::replace(node, Value::Null);
+                *node = json!({"anyOf":[original,{"type":"null"}]});
+            }
+        }
+    }
+    for key in ["$defs", "definitions"] {
+        if let Some(nodes) = object.get_mut(key) {
+            for node in nodes.as_object_mut()?.values_mut() {
+                wrap_optional(node, root, depth + 1)?;
+            }
+        }
+    }
+    if let Some(node) = object.get_mut("items") {
+        wrap_optional(node, root, depth + 1)?;
+    }
+    if let Some(nodes) = object.get_mut("anyOf") {
+        for node in nodes.as_array_mut()? {
+            wrap_optional(node, root, depth + 1)?;
+        }
+    }
+    Some(())
+}
+
+pub fn nullable_mcp_input_schema(
+    input: &Map<String, Value>,
+    budget: Option<usize>,
+) -> Option<super::JsonSchema> {
+    let original = Value::Object(input.clone());
+    let bytes = serde_json::to_vec(&original).ok()?.len();
+    if bytes > MAX_BYTES || !supported_normalization(&original, &original, 0) {
+        return None;
+    }
+    let mut refs = BTreeSet::new();
+    if !references(&original, &mut refs, 0) {
+        return None;
+    }
+    let mut prepared = original.clone();
+    if !refs.is_empty() {
+        let mut estimate = bytes;
+        let mut mapping = BTreeMap::new();
+        let defs = prepared
+            .as_object_mut()?
+            .entry("$defs")
+            .or_insert(json!({}))
+            .as_object_mut()?;
+        for (index, reference) in refs.into_iter().enumerate() {
+            let target = original.pointer(reference.strip_prefix('#')?)?;
+            estimate = estimate.checked_add(serde_json::to_vec(target).ok()?.len())?;
+            if estimate > MAX_BYTES {
+                return None;
+            }
+            let mut name = format!("__sdk_nullable_ref_{index}");
+            while defs.contains_key(&name) {
+                name.push('_');
+            }
+            defs.insert(name.clone(), target.clone());
+            mapping.insert(reference, format!("#/$defs/{name}"));
+        }
+        rewrite_references(&mut prepared, &mapping);
+    }
+    let stable = prepared.clone();
+    wrap_optional(&mut prepared, &stable, 0)?;
+    super::strict_mcp::strict_mcp_input_schema(prepared.as_object()?, budget)
+}
+
+fn normalize(
+    schema: &Value,
+    root: &Value,
+    value: &mut Value,
+    depth: usize,
+    references: usize,
+) -> bool {
+    if depth > MAX_DEPTH || references > MAX_DEPTH {
+        return false;
+    }
+    if let Some(reference) = schema.get("$ref").and_then(Value::as_str) {
+        return reference
+            .strip_prefix('#')
+            .and_then(|r| root.pointer(r))
+            .is_some_and(|schema| normalize(schema, root, value, depth, references + 1));
+    }
+    match value {
+        Value::Object(values) => {
+            if let Some(properties) = schema.get("properties").and_then(Value::as_object) {
+                for (key, node) in properties {
+                    if optional(schema, key)
+                        && values.get(key).is_some_and(Value::is_null)
+                        && allows_null(node, root, 0) == Some(false)
+                    {
+                        values.remove(key);
+                    } else if let Some(value) = values.get_mut(key) {
+                        if !normalize(node, root, value, depth + 1, 0) {
+                            return false;
+                        }
+                    }
+                }
+            }
+        }
+        Value::Array(values) => {
+            if let Some(items) = schema.get("items") {
+                for value in values {
+                    if !normalize(items, root, value, depth + 1, 0) {
+                        return false;
+                    }
+                }
+            }
+        }
+        _ => {}
+    }
+    true
+}
+
+/// None means the exact provider conversion has retained its non-strict fallback.
+pub fn normalize_nullable_mcp_arguments(
+    input: &Map<String, Value>,
+    budget: Option<usize>,
+    value: &Value,
+) -> Result<Option<Value>, &'static str> {
+    if nullable_mcp_input_schema(input, budget).is_none() {
+        return Ok(None);
+    }
+    let root = Value::Object(input.clone());
+    let mut effective = value.clone();
+    if !normalize(&root, &root, &mut effective, 0, 0) {
+        return Err("MCP strict arguments exceed the supported nesting bound");
+    }
+    Ok(Some(effective))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preserves_explicit_null_and_omits_only_synthetic_optional_fields() {
+        let input = json!({"type":"object","properties":{
+            "key":{"type":"string"}, "note":{"type":"string"},
+            "nullable":{"type":["string","null"]},
+            "nested":{"type":"object","properties":{"note":{"type":"string"}}},
+            "list":{"type":"array","items":{"type":"object","properties":{"note":{"type":"string"}}}}
+        },"required":["key"],"additionalProperties":false});
+        let schema = serde_json::to_value(
+            nullable_mcp_input_schema(input.as_object().unwrap(), None).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(
+            schema["properties"]["note"]["anyOf"][1],
+            json!({"type":"null"})
+        );
+        let arguments = json!({"key":"ok","note":null,"nullable":null,"nested":{"note":null},"list":[{"note":null}]});
+        assert_eq!(
+            normalize_nullable_mcp_arguments(input.as_object().unwrap(), None, &arguments).unwrap(),
+            Some(json!({"key":"ok","nullable":null,"nested":{},"list":[{}]}))
+        );
+        assert_eq!(arguments["note"], Value::Null);
+        let legacy = serde_json::to_value(
+            super::super::strict_mcp::strict_mcp_input_schema(input.as_object().unwrap(), None)
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(legacy["properties"]["note"]["type"], "string");
+        assert!(legacy["properties"]["note"].get("anyOf").is_none());
+    }
+
+    #[test]
+    fn stabilizes_property_references_without_inheriting_optional_null() {
+        let input = json!({"type":"object","properties":{
+            "optional":{"type":"string"},
+            "requiredCopy":{"$ref":"#/properties/optional"}
+        },"required":["requiredCopy"],"additionalProperties":false});
+        let schema = serde_json::to_value(
+            nullable_mcp_input_schema(input.as_object().unwrap(), None).unwrap(),
+        )
+        .unwrap();
+        let reference = schema["properties"]["requiredCopy"]["$ref"]
+            .as_str()
+            .unwrap();
+        assert_eq!(
+            schema
+                .pointer(reference.strip_prefix('#').unwrap())
+                .unwrap()["type"],
+            "string"
+        );
+        assert_eq!(
+            normalize_nullable_mcp_arguments(
+                input.as_object().unwrap(),
+                None,
+                &json!({"optional":null,"requiredCopy":null})
+            )
+            .unwrap(),
+            Some(json!({"requiredCopy":null}))
+        );
+    }
+
+    #[test]
+    fn retains_open_and_ambiguous_branch_fallback_without_argument_changes() {
+        for input in [
+            json!({"type":"object","properties":{},"additionalProperties":true}),
+            json!({"type":"object","properties":{"value":{"anyOf":[
+                {"type":"object","properties":{"note":{"type":"string"}}},
+                {"type":"string"}
+            ]}}}),
+        ] {
+            assert!(nullable_mcp_input_schema(input.as_object().unwrap(), None).is_none());
+            assert!(
+                normalize_nullable_mcp_arguments(
+                    input.as_object().unwrap(),
+                    None,
+                    &json!({"value":{"note":null}})
+                )
+                .unwrap()
+                .is_none()
+            );
+        }
+    }
+}
