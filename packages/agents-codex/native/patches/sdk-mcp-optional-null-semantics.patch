+/// Internal SDK conversion policy; booleans retain the existing Python/Core behavior.
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema)]
+#[serde(untagged)]
+pub enum SdkStrictMcpToolSchemas {
+    Required(bool),
+    NullableOptional(SdkNullableOptionalMcpSchema),
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema)]
+pub enum SdkNullableOptionalMcpSchema {
+    #[serde(rename = "omit_synthetic_nulls")]
+    OmitSyntheticNulls,
+}
+
+impl Default for SdkStrictMcpToolSchemas {
+    fn default() -> Self {
+        Self::Required(false)
+    }
+}
+
+impl From<bool> for SdkStrictMcpToolSchemas {
+    fn from(value: bool) -> Self {
+        Self::Required(value)
+    }
+}
+
+impl SdkStrictMcpToolSchemas {
+    pub fn enabled(self) -> bool {
+        self != Self::Required(false)
+    }
+    pub fn nullable_optionals(self) -> bool {
+        matches!(self, Self::NullableOptional(_))
+    }
+}
+
 fn is_default<T: Default + PartialEq>(value: &T) -> bool {
     value == &T::default()
 }
