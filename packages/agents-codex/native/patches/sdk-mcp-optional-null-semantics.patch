+
+/// JavaScript optional-null mode; the ordinary strict converter remains unchanged.
+pub fn mcp_tool_to_nullable_strict_responses_api_tool(
+    tool_name: &ToolName,
+    tool: &rmcp::model::Tool,
+    schema_max_bytes: Option<usize>,
+) -> Result<ResponsesApiTool, serde_json::Error> {
+    let mut output = mcp_tool_to_responses_api_tool(tool_name, tool, schema_max_bytes)?;
+    if let Some(mut schema) =
+        crate::nullable_mcp_input_schema(tool.input_schema.as_ref(), schema_max_bytes)
+    {
+        schema.mcp_input_schema_max_bytes = schema_max_bytes;
+        output.strict = true;
+        output.parameters = schema;
+    }
+    Ok(output)
+}
