diff --git a/codex-rs/core/src/session/staged_input_projection.rs b/codex-rs/core/src/session/staged_input_projection.rs
new file mode 100644
index 00000000000..9fc162cc9ff
--- /dev/null
+++ b/codex-rs/core/src/session/staged_input_projection.rs
@@ -0,0 +1,199 @@
+//! Current, local occurrence admission for portable staged text input.
+use super::{ModelInfo, Session, StepContext, TurnContext};
+use codex_extension_api::{ExtensionData, StagedInputBatch};
+use codex_protocol::error::CodexErr;
+use codex_protocol::models::{ContentItem, ResponseItem};
+use futures::{
+    FutureExt,
+    future::{BoxFuture, Shared},
+};
+use std::collections::HashSet;
+use std::sync::{Arc, Mutex, Weak};
+
+type WriteJoin = Shared<BoxFuture<'static, Result<(), String>>>;
+struct Pending {
+    session: Weak<Session>,
+    turn: Weak<TurnContext>,
+    batch: Arc<StagedInputBatch>,
+    settlement: tokio::sync::Mutex<()>,
+    write: Mutex<Option<WriteJoin>>,
+}
+struct Sources {
+    count: usize,
+    model_info: Arc<ModelInfo>,
+    // Request position, immutable batch position, original payload.
+    entries: Vec<(usize, usize, ResponseItem)>,
+}
+
+pub(crate) fn stage(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    _model: &ModelInfo,
+    batch: &Arc<StagedInputBatch>,
+) -> Result<(), CodexErr> {
+    if batch
+        .pending_occurrences_for(&turn.sub_id)
+        .iter()
+        .any(|(_, item)| {
+            !matches!(item,
+        ResponseItem::Message { role, content, .. } if role == "user" && content.iter()
+            .all(|part| matches!(part, ContentItem::InputText { .. })))
+        })
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Selected staged admission requires text user items".into(),
+        ));
+    }
+    turn.extension_data.get_or_init(|| Pending {
+        session: Arc::downgrade(session),
+        turn: Arc::downgrade(turn),
+        batch: Arc::clone(batch),
+        settlement: tokio::sync::Mutex::new(()),
+        write: Mutex::new(None),
+    });
+    Ok(())
+}
+
+pub(crate) fn append_to_prompt(step: &StepContext, input: &mut Vec<ResponseItem>) {
+    let Some(pending) = step.turn.extension_data.get::<Pending>() else {
+        return;
+    };
+    let entries = pending
+        .batch
+        .pending_occurrences_for(&step.turn.sub_id)
+        .into_iter()
+        .map(|(ordinal, item)| {
+            let index = input.len();
+            input.push(item.clone());
+            (index, ordinal, item)
+        })
+        .collect();
+    step.extension_data.insert(Sources {
+        count: input.len(),
+        model_info: step.settings.model_info.clone(),
+        entries,
+    });
+}
+
+pub(crate) fn source_count(step: Option<&ExtensionData>) -> Option<usize> {
+    step.and_then(|store| store.get::<Sources>())
+        .filter(|sources| !sources.entries.is_empty())
+        .map(|sources| sources.count)
+}
+
+pub(crate) async fn commit(
+    turn_store: Option<&ExtensionData>,
+    step_store: Option<&ExtensionData>,
+    projected: &[ResponseItem],
+    origins: Option<&[Option<usize>]>,
+) -> Result<(), CodexErr> {
+    let Some(pending) = turn_store.and_then(|store| store.get::<Pending>()) else {
+        return Ok(());
+    };
+    let sources = step_store
+        .and_then(|store| store.get::<Sources>())
+        .ok_or_else(|| {
+            CodexErr::InvalidRequest("Staged input lacks its sampled source owner".into())
+        })?;
+    if sources.entries.is_empty() {
+        return Ok(());
+    }
+    let origins = origins
+        .ok_or_else(|| CodexErr::InvalidRequest("Staged input lacks its live source map".into()))?;
+    if projected.len() != origins.len()
+        || origins
+            .iter()
+            .flatten()
+            .any(|index| *index >= sources.count)
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Staged source map is outside its sampled request".into(),
+        ));
+    }
+    if projected.iter().zip(origins).any(|(item, origin)| {
+        origin.is_none() && matches!(item, ResponseItem::Message { role, .. } if role == "user")
+    }) {
+        return Err(CodexErr::InvalidRequest(
+            "Selected staged admission requires original user objects".into(),
+        ));
+    }
+    let _settlement = pending.settlement.lock().await;
+    let previous = pending
+        .write
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone();
+    if let Some(previous) = previous {
+        previous.await.map_err(CodexErr::Fatal)?;
+    }
+    let retained: HashSet<_> = origins.iter().flatten().copied().collect();
+    let remaining: HashSet<_> = pending
+        .batch
+        .pending_occurrences_for(&pending.turn.upgrade().ok_or(CodexErr::TurnAborted)?.sub_id)
+        .into_iter()
+        .map(|(index, _)| index)
+        .collect();
+    let selected: Vec<_> = sources
+        .entries
+        .iter()
+        .filter(|(index, ordinal, _)| retained.contains(index) && remaining.contains(ordinal))
+        .cloned()
+        .collect();
+    if selected.is_empty() {
+        return Ok(());
+    }
+    let session = pending.session.upgrade().ok_or(CodexErr::TurnAborted)?;
+    let turn = pending.turn.upgrade().ok_or(CodexErr::TurnAborted)?;
+    let Some((active, cancelled)) = session.active_turn_context_and_cancellation_token().await
+    else {
+        return Err(CodexErr::TurnAborted);
+    };
+    if active.sub_id != turn.sub_id || cancelled.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+    let model = sources.model_info.clone();
+    let batch = Arc::clone(&pending.batch);
+    // The write owns both persistence and acknowledgment through caller cancellation.
+    let write = tokio::spawn(async move {
+        let positions = selected
+            .iter()
+            .map(|(_, ordinal, _)| *ordinal)
+            .collect::<Vec<_>>();
+        let items = selected
+            .into_iter()
+            .map(|(_, _, item)| session.annotate_client_response_item(item))
+            .collect();
+        session
+            .record_annotated_conversation_items(&turn, &model, items)
+            .await;
+        session
+            .ensure_rollout_durable()
+            .await
+            .map_err(|error| error.to_string())?;
+        batch.acknowledge_occurrences(&positions)
+    })
+    .map(|result| result.unwrap_or_else(|_| Err("Staged input persistence task failed".into())))
+    .boxed()
+    .shared();
+    *pending
+        .write
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(write.clone());
+    write.await.map_err(CodexErr::Fatal)
+}
+
+pub(crate) async fn join(turn: &TurnContext) -> Result<(), CodexErr> {
+    let Some(pending) = turn.extension_data.get::<Pending>() else {
+        return Ok(());
+    };
+    let _settlement = pending.settlement.lock().await;
+    let write = pending
+        .write
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone();
+    if let Some(write) = write {
+        write.await.map_err(CodexErr::Fatal)?;
+    }
+    Ok(())
+}
