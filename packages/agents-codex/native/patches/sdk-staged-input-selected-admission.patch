+        assert!(batch.pending_occurrences_for("other").is_empty());
+        assert!(batch.acknowledge_occurrences(&[99]).is_err());
+        assert_eq!(batch.pending_occurrences_for("turn").len(), 2);
+        batch.acknowledge_occurrences(&[1, 1]).unwrap();
+        assert_eq!(batch.pending_occurrences_for("turn"), vec![(0, item)]);
+        assert!(batch.is_pending());
+        batch.acknowledge_occurrences(&[0]).unwrap();
+        assert!(!batch.is_pending());
+    }
+    #[test]
+    fn fresh_root_claim_preserves_live_mask_and_rejects_other_threads() {
+        let item: ResponseItem = serde_json::from_value(serde_json::json!({
+            "type":"message", "role":"user", "content":[{"type":"input_text", "text":"same"}]
+        })).unwrap();
+        let batch = StagedInputBatch::selected_before_send("old".into(), vec![item.clone(), item.clone()]);
+        let current = Arc::new(std::sync::Mutex::new("old".into()));
+        let claim = FreshStagedInput::new("thread".into(), batch.clone(), Arc::clone(&current)).unwrap();
+        assert!(claim.claim("child", "new").is_none());
+        // A rejected/busy native submission has not been freezing an earlier mask.
+        batch.acknowledge_occurrences(&[0]).unwrap();
+        let fresh = claim.claim("thread", "new").unwrap();
+        assert_eq!(fresh.pending_occurrences_for("new"), vec![(1, item)]);
+        assert_eq!(*current.lock().unwrap(), "new");
+        assert!(claim.claim("thread", "later").is_none());
+        fresh.acknowledge_occurrences(&[1]).unwrap();
+        assert!(!batch.is_pending());
+    }
+
+}
