+
+#[tokio::test(start_paused = true)]
+async fn retry_classification_preserves_missing_zero_and_expired_advice() {
+    for error in [
+        CodexErr::ServerOverloaded,
+        CodexErr::RetryLimit(RetryLimitReachedError {
+            status: StatusCode::TOO_MANY_REQUESTS,
+            request_id: None,
+        }),
+    ] {
+        assert!(!error.is_retryable());
+        assert_eq!(error.server_retry_delay(), None);
+        let deadline = RetryAfter::from_delay(Duration::from_secs(2)).expect("deadline");
+        let error = error.with_retry_after(deadline);
+        assert!(error.is_retryable());
+        assert_eq!(error.server_retry_delay(), Some(Duration::from_secs(2)));
+        tokio::time::advance(Duration::from_secs(3)).await;
+        assert_eq!(error.retry_after(), Some(deadline));
+        assert!(error.is_retryable());
+        assert_eq!(error.retry_delay(1), Some(Duration::ZERO));
+        assert_eq!(error.server_retry_delay(), Some(Duration::ZERO));
+    }
+    let zero = RetryAfter::from_delay(Duration::ZERO).expect("zero deadline");
+    let error = CodexErr::ServerOverloaded.with_retry_after(zero);
+    assert!(error.is_retryable());
+    assert_eq!(error.server_retry_delay(), Some(Duration::ZERO));
+    let terminal = CodexErr::QuotaExceeded.with_retry_after(zero);
+    assert!(!terminal.is_retryable());
+    assert_eq!(terminal.retry_delay(1), None);
+    assert_eq!(terminal.server_retry_delay(), Some(Duration::ZERO));
 }
 
