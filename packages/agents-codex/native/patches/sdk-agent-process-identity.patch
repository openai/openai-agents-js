diff --git a/codex-rs/exec-server/src/server/build_identity.rs b/codex-rs/exec-server/src/server/build_identity.rs
index 691b592535e6362da9219398b8b6b8ea0ba16303..5166fa82a4e8569bd2f76603994451b5c3a1593e 100644
--- a/codex-rs/exec-server/src/server/build_identity.rs
+++ b/codex-rs/exec-server/src/server/build_identity.rs
@@ -16,6 +16,53 @@ pub(super) static PROVIDER_ID: LazyLock<Option<String>> = LazyLock::new(|| {
 pub(super) fn local_environment_info() -> EnvironmentInfo {
     EnvironmentInfo {
         provider_id: PROVIDER_ID.clone(),
+        process_identity: current_process_identity(),
         ..super::release_version::local_environment_info()
     }
 }
+
+#[cfg(unix)]
+fn current_process_identity() -> Option<codex_exec_server_protocol::ExecutorProcessIdentity> {
+    let mut supplementary_gids = rustix::process::getgroups()
+        .ok()?
+        .into_iter()
+        .map(|gid| gid.as_raw())
+        .collect::<Vec<_>>();
+    supplementary_gids.sort_unstable();
+    supplementary_gids.dedup();
+    Some(codex_exec_server_protocol::ExecutorProcessIdentity::Unix {
+        effective_uid: rustix::process::geteuid().as_raw(),
+        effective_gid: rustix::process::getegid().as_raw(),
+        supplementary_gids,
+    })
+}
+
+#[cfg(not(unix))]
+fn current_process_identity() -> Option<codex_exec_server_protocol::ExecutorProcessIdentity> {
+    None
+}
+
+#[cfg(all(test, unix))]
+mod process_identity_tests {
+    #[test]
+    fn environment_metadata_reports_current_effective_credentials() {
+        let identity = super::local_environment_info()
+            .process_identity
+            .expect("Unix identity");
+        let codex_exec_server_protocol::ExecutorProcessIdentity::Unix {
+            effective_uid,
+            effective_gid,
+            supplementary_gids,
+        } = identity;
+        assert_eq!(effective_uid, rustix::process::geteuid().as_raw());
+        assert_eq!(effective_gid, rustix::process::getegid().as_raw());
+        let mut expected = rustix::process::getgroups()
+            .expect("current groups")
+            .into_iter()
+            .map(|gid| gid.as_raw())
+            .collect::<Vec<_>>();
+        expected.sort_unstable();
+        expected.dedup();
+        assert_eq!(supplementary_gids, expected);
+    }
+}
