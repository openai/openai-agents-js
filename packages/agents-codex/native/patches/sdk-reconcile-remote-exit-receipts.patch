+async fn wait_for_remote_exit(
+    process: &dyn codex_exec_server::ExecProcess,
+    mut state: watch::Receiver<ProcessState>,
+    mut events: codex_exec_server::ExecProcessEventReceiver,
+) -> bool {
+    // Replay is bounded. The output watcher can already own an exit that
+    // this new subscriber never sees.
+    let confirmed = tokio::select! {
+        biased;
+        Ok(_) = state.wait_for(|state| state.peer_exit_confirmed) => true,
+        confirmed = async {
+            let mut saw_output = false;
+            loop {
+                let closed = match events.recv().await {
+                    Ok(ExecProcessEvent::Exited { .. }) => return true,
+                    Ok(ExecProcessEvent::Output(chunk)) => {
+                        let has_replay_gap = !saw_output && chunk.seq > 1;
+                        saw_output = true;
+                        if !has_replay_gap {
+                            continue;
+                        }
+                        false
+                    }
+                    Ok(ExecProcessEvent::Closed { .. }) => true,
+                    Err(broadcast::error::RecvError::Lagged(_)) => false,
+                    Ok(ExecProcessEvent::Failed(_))
+                    | Err(broadcast::error::RecvError::Closed) => return false,
+                };
+                let exit_confirmed = process
+                    .read(Some(u64::MAX), None, Some(0))
+                    .await
+                    .is_ok_and(|receipt| {
+                        receipt.failure.is_none() && receipt.exited && receipt.exit_code.is_some()
+                    });
+                if exit_confirmed || closed {
+                    return exit_confirmed;
+                }
+            }
+        } => confirmed,
+    };
+    confirmed || state.borrow().peer_exit_confirmed
+}
