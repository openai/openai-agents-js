+            assert_eq!(serde_json::to_vec(&receipt).unwrap(), expected_bytes);
+        }
+        // A denial already present at the same path belongs to the caller.
+        let same_path = PermissionProfileSnapshot::legacy_with_sdk_private_deny(
+            snapshot.permission_profile().clone(),
+            Some(path("application-deny")),
+        );
+        assert_eq!(same_path.sdk_portable_permission_profile(), baseline);
+    }
+}
