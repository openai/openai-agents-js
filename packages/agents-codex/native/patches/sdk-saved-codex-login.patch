+// The SDK opts into the exact file-backed Codex OAuth login. Unlike the
+// regular loader, this path never looks at environment or in-memory auth.
+type SavedChatgptOwner = (Option<String>, String);
+
+// Serialize saved login reads with refresh writes across SDK engines in this process.
+static SAVED_CHATGPT_LOGIN_PERMIT: Semaphore = Semaphore::const_new(1);
