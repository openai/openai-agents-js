+    let manager = AuthManager::shared_saved_chatgpt(
+        home.path().to_path_buf(),
+        crate::test_support::transport_default_auth_route_config(),
+    )
+    .await?;
+    let stale = manager.auth_cached().expect("saved login");
+    let CodexAuth::Chatgpt(auth) = &stale else {
+        anyhow::bail!("expected saved ChatGPT auth");
+    };
+    let mut first = manager.unauthorized_recovery();
+    let mut second = manager.unauthorized_recovery();
+    first.next_with_request_auth(Some(&stale)).await?;
+    second.next_with_request_auth(Some(&stale)).await?;
+
+    let permit = SAVED_CHATGPT_LOGIN_PERMIT.acquire().await?;
+    let recover = async {
+        tokio::join!(
+            first.next_with_request_auth(Some(&stale)),
+            second.next_with_request_auth(Some(&stale)),
+        )
+    };
+    tokio::pin!(recover);
+    tokio::select! {
+        biased;
+        _ = &mut recover => panic!("recovered before the rotation was published"),
+        _ = std::future::ready(()) => {}
+    }
+    let attempted = auth.current_auth_json().expect("saved login");
+    manager
+        .finish_chatgpt_refresh(
+            auth,
+            Some(&attempted),
+            Ok(RefreshResponse {
+                id_token: None,
+                access_token: Some("rotated-access-token".into()),
+                refresh_token: Some("rotated-refresh-token".into()),
+            }),
+        )
+        .await?;
+    let current = manager.auth_cached().expect("rotated login");
+    // Catch an attempted grant for the new revision without a network request.
+    manager.record_permanent_refresh_failure_if_unchanged(
+        &current,
+        &RefreshTokenFailedError::new(RefreshTokenFailedReason::Other, "unexpected grant"),
+    );
+    drop(permit);
+
+    let (first, second) = recover.await;
+    first?;
+    second?;
+    assert_eq!(
+        manager.auth_cached().expect("rotated login").get_token()?,
+        "rotated-access-token"
+    );
+    Ok(())
+}
