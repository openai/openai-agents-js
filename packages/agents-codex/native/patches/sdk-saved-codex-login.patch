+#[test]
+fn portable_profile_omits_only_injected_sdk_private_denies() {
+    let root = std::env::temp_dir();
+    let path = |name: &str| PathUri::from_host_native_path(root.join(name)).unwrap();
+    let deny = |path| {
+        FileSystemSandboxEntry::new(FileSystemPath::Path { path }, FileSystemAccessMode::Deny)
+    };
+    let caller_duplicate = path("caller-duplicate");
+    let caller_unrelated = path("caller-unrelated");
+    let auth = path("auth.json");
+    let mcp = path(".credentials.json");
+    let baseline = PermissionProfile::workspace_write();
+    let mut fs = baseline.file_system_sandbox_policy();
+    fs.entries.extend([
+        deny(caller_duplicate.clone()),
+        deny(caller_unrelated.clone()),
+    ]);
+    let baseline =
+        PermissionProfile::from_runtime_permissions(&fs, baseline.network_sandbox_policy());
+    let snapshot = PermissionProfileSnapshot::legacy_with_sdk_private_denies(
+        baseline.clone(),
+        [
+            caller_duplicate.clone(),
+            auth.clone(),
+            mcp.clone(),
+            mcp.clone(),
+        ],
+    );
+    let live = snapshot.permission_profile().file_system_sandbox_policy();
+    for path in [caller_duplicate, caller_unrelated, auth, mcp] {
+        assert_eq!(
+            live.entries
+                .iter()
+                .filter(|entry| **entry == deny(path.clone()))
+                .count(),
+            1
+        );
+    }
+    assert_eq!(snapshot.sdk_portable_permission_profile(), baseline);
+}
