+#[tokio::test]
+async fn saved_login_world_state_omits_private_deny_from_context_and_rollout() {
+    let root = tempfile::tempdir().expect("synthetic policy paths");
+    let path = |name: &str| {
+        PathUri::from_host_native_path(root.path().join(name)).expect("absolute fixture path")
+    };
+    let app_deny = path("application-deny");
+    let private_paths = [
+        path("original-login/auth.json"),
+        path("relocated-login/auth.json"),
+    ];
+    let profile = PermissionProfile::workspace_write();
+    let mut file_system = profile.file_system_sandbox_policy();
+    file_system.entries.push(FileSystemSandboxEntry::new(
+        FileSystemPath::Path {
+            path: app_deny.clone(),
+        },
+        FileSystemAccessMode::Deny,
+    ));
+    let profile =
+        PermissionProfile::from_runtime_permissions(&file_system, profile.network_sandbox_policy());
+    let mut baseline_permissions = None;
+
+    for private_path in std::iter::once(None).chain(private_paths.iter().map(Some)) {
+        let (mut session, mut turn_context) = make_session_and_context().await;
+        let config = Arc::make_mut(&mut turn_context.config);
+        config.include_permissions_instructions = true;
+        config.include_environment_context = true;
+        let TurnEnvironmentState::Ready(environment) =
+            &mut turn_context.initial_environments.environments[0]
+        else {
+            panic!("turn environment should be ready");
+        };
+        environment.config_mut().permission_profile =
+            PermissionProfileSnapshot::legacy_with_sdk_private_deny(
+                profile.clone(),
+                private_path.cloned(),
+            );
+        let sandbox = environment.sandbox_context(/*additional_permissions*/ None);
+        let live_policy = sandbox.permissions.file_system_sandbox_policy();
+        let policy_context = sandbox.policy_context();
+        assert!(!live_policy.can_read_path(&app_deny, &policy_context));
+        for path in &private_paths {
+            assert_eq!(
+                live_policy.can_read_path(path, &policy_context),
+                Some(path) != private_path
+            );
+        }
+
+        let rollout_path = attach_thread_persistence(&mut session).await;
+        let step_context = StepContext::for_test(Arc::new(turn_context));
+        session
+            .record_context_updates_and_set_reference_context_item(&step_context)
+            .await
+            .expect("record world state");
+        session.flush_rollout().await.expect("flush world state");
+        let (items, _, parse_errors) = RolloutRecorder::load_rollout_items(&rollout_path)
+            .await
+            .expect("read rollout");
+        assert_eq!(parse_errors, 0);
+
+        let messages = items
+            .iter()
+            .filter_map(|item| match item {
+                RolloutItem::ResponseItem(envelope) => Some(envelope.item.clone()),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        let permissions_text = developer_input_texts(&messages)
+            .into_iter()
+            .find(|text| text.starts_with("<permissions instructions>"))
+            .expect("emitted permissions instructions");
+        let environment_text = user_input_texts(&messages)
+            .into_iter()
+            .find(|text| text.starts_with("<environment_context>"))
+            .expect("emitted environment context");
+        let snapshot = items
+            .iter()
+            .find_map(|item| match item {
+                RolloutItem::WorldState(snapshot) if snapshot.full => Some(&snapshot.state),
+                _ => None,
+            })
+            .expect("persisted full world-state snapshot");
+        let filesystem = snapshot["environments"]["filesystem"]
+            .as_str()
+            .expect("persisted filesystem context");
+        for text in [permissions_text, environment_text, filesystem] {
+            assert!(text.contains("application-deny"));
+        }
+        let snapshot_json = serde_json::to_string(snapshot).expect("serialize persisted snapshot");
+        for text in [permissions_text, environment_text, snapshot_json.as_str()] {
+            assert!(!text.contains("original-login"));
+            assert!(!text.contains("relocated-login"));
+        }
+        let permissions = snapshot.get("permissions").expect("persisted permissions");
+        if let Some(baseline) = &baseline_permissions {
+            assert_eq!(permissions, baseline);
+        } else {
+            baseline_permissions = Some(permissions.clone());
+        }
+    }
+}
