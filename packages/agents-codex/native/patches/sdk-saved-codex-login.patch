+async fn saved_chatgpt_reads_wait_for_refresh_write() -> anyhow::Result<()> {
+    let home = tempdir()?;
+    write_auth_file(
+        AuthFileParams {
+            openai_api_key: None,
+            chatgpt_plan_type: Some("pro".to_string()),
+            chatgpt_account_id: None,
+        },
+        home.path(),
+    )?;
+    let open = || {
+        AuthManager::shared_saved_chatgpt(
+            home.path().to_path_buf(),
+            crate::test_support::transport_default_auth_route_config(),
+        )
+    };
+    let reloading = open().await?;
+    let recovering = open().await?;
+    let mut recovery = recovering.unauthorized_recovery();
+    let auth_file = get_auth_file(home.path());
+    let saved = std::fs::read(&auth_file)?;
+
+    let permit = SAVED_CHATGPT_LOGIN_PERMIT.acquire().await?;
+    std::fs::write(&auth_file, b"")?;
+    let opening = open();
+    let reload = reloading.reload();
+    let next = recovery.next();
+    tokio::pin!(opening, reload, next);
+    tokio::select! {
+        biased;
+        _ = &mut opening => panic!("opened a saved login during a refresh write"),
+        _ = &mut reload => panic!("reloaded a saved login during a refresh write"),
+        _ = &mut next => panic!("recovered a saved login during a refresh write"),
+        _ = std::future::ready(()) => {}
+    }
+    std::fs::write(&auth_file, saved)?;
+    drop(permit);
+
+    let (opened, changed, recovered) = tokio::join!(opening, reload, next);
+    assert!(opened?.is_saved_chatgpt());
+    assert!(!changed);
+    assert!(reloading.auth_cached().is_some());
+    assert_eq!(recovered?.auth_state_changed(), Some(false));
+    Ok(())
+}
