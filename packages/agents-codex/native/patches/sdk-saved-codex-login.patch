+        let root = std::env::temp_dir();
+        let path =
+            |name: &str| PathUri::from_host_native_path(root.join(name)).expect("fixture path");
+        let retained_deny = FileSystemSandboxEntry::new(
+            FileSystemPath::Path {
+                path: path("application-deny"),
+            },
+            FileSystemAccessMode::Deny,
+        );
+        let cwd = path("workspace");
+        let baseline = PermissionProfile::workspace_write();
+        let mut fs = baseline.file_system_sandbox_policy();
+        fs.entries.push(retained_deny.clone());
+        let baseline =
+            PermissionProfile::from_runtime_permissions(&fs, baseline.network_sandbox_policy());
+        let snapshot = PermissionProfileSnapshot::legacy(baseline.clone());
+        let selection = |permission_profile| TurnEnvironmentSelection {
+            environment_id: "local".into(),
+            cwd: cwd.clone(),
+            workspace_roots: vec![cwd.clone()],
+            config: EnvironmentConfigState::Ready(EnvironmentConfig {
+                allow_login_shell: false,
+                workspace_roots: vec![cwd.clone()],
+                permission_profile,
+                shell_environment_policy: Default::default(),
+                windows_sandbox_level: WindowsSandboxLevel::Disabled,
+                windows_sandbox_type: SandboxType::None,
+                use_legacy_landlock: false,
+                exec_policy: None,
+                mcp_policy: None,
+                network_policy: None,
+                selected_capability_roots: vec![],
+            }),
+        };
+        let ordinary = selection(snapshot.clone());
+        let expected = sdk_executor_policy_receipt(&ordinary, false, None);
+        let expected_bytes = serde_json::to_vec(&expected).unwrap();
+        for name in ["first-cache", "relocated-cache"] {
+            let deny = path(name);
+            let saved = PermissionProfileSnapshot::legacy_with_sdk_private_deny(
+                snapshot.permission_profile().clone(),
+                Some(deny.clone()),
+            );
+            let live = saved.permission_profile().file_system_sandbox_policy();
+            assert!(live.entries.contains(&retained_deny));
