+    #[test]
+    fn expanded_completion_preserves_record_and_actual_queue_budgets() {
+        let completion =
+            json!({"x": "\\".repeat((crate::sdk_trace::MAX_COMPLETION_DATA_BYTES - 8) / 2)})
+                .to_string();
+        let mut data = sample_span();
+        data.attributes = vec![opentelemetry::KeyValue::new(
+            "sdk.outcome.data",
+            completion.clone(),
+        )];
+        // This ordinary data fits its original share of the record allowance.
+        for index in 0..7 {
+            data.attributes.push(opentelemetry::KeyValue::new(
+                format!("ordinary.{index}"),
+                "g".repeat(4000),
+            ));
+        }
+        let mut routes = Routes {
+            processors: vec!["recording".into()],
+            ..Default::default()
+        };
+        event(&mut routes, &data, "end", None, None, None);
+        assert_eq!(routes.queue.len(), 1);
+        let snapshot = &routes.queue.front().unwrap().1;
+        assert_eq!(snapshot["attributes"]["sdk.outcome.data"], completion);
+        let encoded_bytes = serde_json::to_vec(snapshot).unwrap().len();
+        assert_eq!(routes.bytes, encoded_bytes);
+        let attrs = snapshot["attributes"].as_object().unwrap();
+        assert!(completion_projection_bytes(attrs.get("sdk.outcome.data")) > 32_768);
+        let mut invalid = attrs.clone();
+        invalid.insert("sdk.outcome.data".into(), json!("x".repeat(65_537)));
+        assert_eq!(
+            completion_projection_bytes(invalid.get("sdk.outcome.data")),
+            0
+        );
+        invalid.insert("sdk.outcome.data".into(), json!("not JSON"));
+        assert_eq!(
+            completion_projection_bytes(invalid.get("sdk.outcome.data")),
+            0
+        );
+        // The larger record still fails a queue with one fewer actual byte.
+        let mut constrained = Routes {
+            processors: vec!["recording".into()],
+            ..Default::default()
+        };
+        constrained.delivery.max_queue_bytes = (encoded_bytes - 1) as u32;
+        event(&mut constrained, &data, "end", None, None, None);
+        assert!(constrained.queue.is_empty());
+        assert_eq!(constrained.bytes, 0);
+        // Completion data grants no allowance to an unrelated large field.
+        for index in 0..20 {
+            data.attributes.push(opentelemetry::KeyValue::new(
+                format!("other.{index}"),
+                "g".repeat(4000),
+            ));
+        }
+        let mut unrelated = Routes {
+            processors: vec!["recording".into()],
+            ..Default::default()
+        };
+        event(&mut unrelated, &data, "end", None, None, None);
+        assert!(unrelated.queue.is_empty());
+    }
