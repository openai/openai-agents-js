+//! Validate live contributor positions before any staged input can be acknowledged.
+use codex_protocol::models::ResponseItem;
+use std::collections::HashSet;
+
+/// Compose one contributor's local positions into the immutable sampled input.
+/// Reordering preserves identity. Repeated requests do not mutate this mapping.
+pub(crate) fn compose(
+    before: &[ResponseItem],
+    after: &[ResponseItem],
+    source_indices: &[Option<usize>],
+    origins: &[Option<usize>],
+    staged_origins: &HashSet<usize>,
+) -> Result<Vec<Option<usize>>, String> {
+    if origins.len() != before.len() || source_indices.len() != after.len() {
+        return Err("Context source map has the wrong input or output length".into());
+    }
+    let mut selected = HashSet::new();
+    let mut composed = Vec::with_capacity(after.len());
+    for (item, index) in after.iter().zip(source_indices) {
+        let origin = match index {
+            Some(index) => {
+                let original = before
+                    .get(*index)
+                    .ok_or("Context source map is outside its captured input")?;
+                if original != item {
+                    return Err("Context source map refers to a changed input item".into());
+                }
+                origins[*index]
+            }
+            None => None,
+        };
+        let user = matches!(item, ResponseItem::Message { role, .. } if role == "user");
+        if user && origin.is_none() {
+            return Err("Selected staged input requires original user objects".into());
+        }
+        if let Some(origin) = origin
+            && (user || staged_origins.contains(&origin))
+            && !selected.insert(origin)
+        {
+            return Err("Context source map repeats an original user occurrence".into());
+        }
+        composed.push(origin);
+    }
+    Ok(composed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn item(role: &str, text: &str) -> ResponseItem {
+        serde_json::from_value(serde_json::json!({
+            "type":"message","role":role,
+            "content":[{"type":"input_text","text":text}]
+        }))
+        .unwrap()
+    }
+    #[test]
+    fn equal_payloads_keep_distinct_sources_under_reordering_and_retries() {
+        let same = item("user", "same");
+        let input = vec![same.clone(), same.clone()];
+        let origins = vec![Some(4), Some(9)];
+        let staged = HashSet::from([4, 9]);
+        let map = vec![Some(1), Some(0)];
+        assert_eq!(
+            compose(&input, &input, &map, &origins, &staged).unwrap(),
+            vec![Some(9), Some(4)]
+        );
+        assert_eq!(
+            compose(&input, &input, &map, &origins, &staged).unwrap(),
+            vec![Some(9), Some(4)]
+        );
+    }
+    #[test]
+    fn the_same_original_user_occurrence_cannot_be_duplicated() {
+        let row = item("user", "same");
+        assert!(
+            compose(
+                &[row.clone()],
+                &[row.clone(), row],
+                &[Some(0), Some(0)],
+                &[Some(3)],
+                &HashSet::from([3])
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn range_content_and_unowned_user_changes_are_rejected() {
+        let a = item("user", "A");
+        let b = item("user", "B");
+        assert!(
+            compose(
+                &[a.clone()],
+                &[a.clone()],
+                &[Some(7)],
+                &[Some(0)],
+                &HashSet::from([0])
+            )
+            .is_err()
+        );
+        assert!(
+            compose(
+                &[a.clone()],
+                &[b],
+                &[Some(0)],
+                &[Some(0)],
+                &HashSet::from([0])
+            )
+            .is_err()
+        );
+        assert!(compose(&[a.clone()], &[a], &[None], &[Some(0)], &HashSet::from([0])).is_err());
+    }
+    #[test]
+    fn multiple_contributors_compose_through_generated_nonuser_rows() {
+        let a = item("user", "A");
+        let b = item("user", "B");
+        let extra = item("assistant", "reference");
+        let first = vec![b.clone(), extra.clone()];
+        let origins = compose(
+            &[a, b.clone()],
+            &first,
+            &[Some(1), None],
+            &[Some(0), Some(1)],
+            &HashSet::from([0, 1]),
+        )
+        .unwrap();
+        assert_eq!(
+            compose(
+                &first,
+                &[extra, b],
+                &[Some(1), Some(0)],
+                &origins,
+                &HashSet::from([0, 1])
+            )
+            .unwrap(),
+            vec![None, Some(1)]
+        );
+    }
+}
