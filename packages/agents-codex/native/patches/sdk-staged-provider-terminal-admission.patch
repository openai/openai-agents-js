+//! Own selected staged inputs through terminal acceptance, not transport dispatch.
+//!
+//! The selected batch remains fail-closed in turn admission until the caller
+//! installs the matching request projection and completed-output slot.
+
+use std::collections::HashSet;
+use std::sync::Arc;
+use std::sync::Mutex;
