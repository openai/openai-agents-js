+/// Select canonical occurrences from a current native source map. Equal text
+/// never substitutes for an omitted original, and only sampled staged rows
+/// belong in canonical_items. This function does not accept the cursor.
+pub(crate) fn sampling_input_projection_from_origins(
+    canonical_items: &[ResponseItem],
+    items: &[ResponseItem],
+    origins: &[Option<usize>],
+    wire_input_indices: Vec<usize>,
+    prefix_len: usize,
+) -> Result<codex_api::ProviderHistoryInputProjection> {
+    if origins.len() != items.len() {
+        return Err(invalid("Sampling origins do not cover the current input"));
+    }
+    let mut projection = canonical_input_projection(
+        canonical_items, wire_input_indices, prefix_len,
+    )?;
+    projection.sampling_item_sha256 = items.iter().map(item_digest)
+        .collect::<Result<Vec<_>>>()?;
+    let mut delivered = std::collections::HashSet::new();
+    for ((item, digest), origin) in items.iter()
+        .zip(&projection.sampling_item_sha256).zip(origins)
+    {
+        let user = matches!(item, ResponseItem::Message { role, .. } if role == "user");
+        match origin {
+            Some(index) => {
+                if projection.item_sha256.get(*index) != Some(digest) {
+                    return Err(invalid("Sampling origin does not match its canonical occurrence"));
+                }
+                if !delivered.insert(*index) && user {
+                    return Err(invalid("One original user occurrence was sampled twice"));
+                }
+            }
+            None if user => {
+                return Err(invalid("A sampled user row has no current native origin"));
+            }
+            None => {}
+        }
+    }
+    projection.delivered_input_indices = delivered.into_iter().collect();
+    projection.delivered_input_indices.sort_unstable();
+    Ok(projection)
+}
