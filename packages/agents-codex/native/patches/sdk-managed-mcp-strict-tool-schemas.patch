diff --git a/codex-rs/tools/src/json_schema/strict_mcp.rs b/codex-rs/tools/src/json_schema/strict_mcp.rs
new file mode 100644
index 0000000..966a624
--- /dev/null
+++ b/codex-rs/tools/src/json_schema/strict_mcp.rs
@@ -0,0 +1,166 @@
+use serde_json::{Map, Value, json};
+
+use super::{JsonSchema, parse_tool_input_schema_without_compaction};
+
+const MAX_STRICT_SCHEMA_BYTES: usize = 65_536;
+const MAX_SCHEMA_DEPTH: usize = 64;
+
+/// Work on a copy of the raw server schema. A schema that needs an unsupported
+/// conversion stays on the existing non-strict route.
+pub(crate) fn strict_mcp_input_schema(input: &Map<String, Value>) -> Option<JsonSchema> {
+    let mut root = if input.is_empty() {
+        json!({ "type": "object", "additionalProperties": false, "properties": {} })
+    } else {
+        Value::Object(input.clone())
+    };
+    let source = root.clone();
+    let root_obj = root.as_object_mut()?;
+    root_obj.entry("type").or_insert(json!("object"));
+    root_obj.entry("properties").or_insert(json!({}));
+    if root_obj.get("type")?.as_str()? != "object"
+        || root_obj.contains_key("anyOf")
+        || root_obj.contains_key("$ref")
+        || !convert_schema(&mut root, &source, 0)
+        || serde_json::to_vec(&root).ok()?.len() > MAX_STRICT_SCHEMA_BYTES
+    {
+        return None;
+    }
+    parse_tool_input_schema_without_compaction(&root).ok()
+}
+
+fn convert_schema(value: &mut Value, root: &Value, depth: usize) -> bool {
+    if depth > MAX_SCHEMA_DEPTH {
+        return false;
+    }
+    let Some(schema) = value.as_object_mut() else {
+        return false;
+    };
+    // Retain the ordinary schema when strict conversion would drop a constraint.
+    if schema.keys().any(|key| {
+        !matches!(
+            key.as_str(),
+            "type"
+                | "description"
+                | "title"
+                | "default"
+                | "properties"
+                | "required"
+                | "additionalProperties"
+                | "items"
+                | "anyOf"
+                | "enum"
+                | "const"
+                | "$ref"
+                | "$defs"
+                | "definitions"
+                | "minItems"
+        )
+    }) {
+        return false;
+    }
+    if let Some(reference) = schema.get("$ref") {
+        return reference
+            .as_str()
+            .and_then(|r| r.strip_prefix('#'))
+            .is_some_and(|r| root.pointer(r).is_some())
+            && schema
+                .keys()
+                .all(|k| matches!(k.as_str(), "$ref" | "title" | "description"));
+    }
+    let object = schema.get("type").is_some_and(|types| {
+        types == "object"
+            || types
+                .as_array()
+                .is_some_and(|types| types.iter().any(|t| t == "object"))
+    }) || schema.contains_key("properties");
+    if object {
+        let Some(properties) = schema
+            .entry("properties")
+            .or_insert(json!({}))
+            .as_object_mut()
+        else {
+            return false;
+        };
+        let empty = properties.is_empty();
+        if !properties
+            .values_mut()
+            .all(|value| convert_schema(value, root, depth + 1))
+        {
+            return false;
+        }
+        let required: Vec<_> = properties.keys().cloned().collect();
+        if !match schema.get("additionalProperties") {
+            Some(Value::Bool(false)) => true,
+            None => !empty,
+            _ => false,
+        } {
+            return false;
+        }
+        schema.insert("additionalProperties".into(), json!(false));
+        schema.insert("required".into(), json!(required));
+    } else if schema.contains_key("additionalProperties") {
+        return false;
+    }
+    if let Some(items) = schema.get_mut("items")
+        && !convert_schema(items, root, depth + 1)
+    {
+        return false;
+    }
+    if let Some(any_of) = schema.get_mut("anyOf")
+        && !any_of.as_array_mut().is_some_and(|branches| {
+            !branches.is_empty()
+                && branches
+                    .iter_mut()
+                    .all(|node| convert_schema(node, root, depth + 1))
+        })
+    {
+        return false;
+    }
+    for name in ["$defs", "definitions"] {
+        if let Some(definitions) = schema.get_mut(name)
+            && !definitions.as_object_mut().is_some_and(|defs| {
+                defs.values_mut()
+                    .all(|node| convert_schema(node, root, depth + 1))
+            })
+        {
+            return false;
+        }
+    }
+    schema.remove("default");
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn makes_a_detached_copy_strict_and_preserves_open_objects_on_fallback() {
+        let raw = json!({
+            "properties":{"outer":{"type":"object","properties":{"name":{"type":"string"}}}},
+            "required":[],
+        });
+        let converted =
+            serde_json::to_value(strict_mcp_input_schema(raw.as_object().unwrap()).unwrap())
+                .unwrap();
+        assert_eq!(converted["required"], json!(["outer"]));
+        assert_eq!(converted["additionalProperties"], false);
+        assert_eq!(
+            converted["properties"]["outer"]["required"],
+            json!(["name"])
+        );
+        assert_eq!(
+            converted["properties"]["outer"]["additionalProperties"],
+            false
+        );
+        assert_eq!(raw["required"], json!([]));
+        for raw in [
+            json!({"properties": {}, "additionalProperties": true}),
+            json!({"properties":{"nested":{"type":"object","additionalProperties":{}}}}),
+            json!({"properties":{"nested":{"$ref":"https://invalid.example/schema"}}}),
+            json!({"properties":{"nested":{"type":"string","pattern":"^[a-z]+$"}}}),
+        ] {
+            assert!(strict_mcp_input_schema(raw.as_object().unwrap()).is_none());
+        }
+    }
+}
