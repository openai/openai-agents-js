+// Reserve workspace mutations before dispatch tasks can be scheduled out of order.
+// Automatic callbacks remain concurrent, but later mutations await their settlement.
+// Manual callbacks stay independent so they can unblock an automatic callback.
+#[derive(Default)]
+struct OrderedWorkspaceCalls {
+    state: std::sync::Mutex<WorkspaceDispatchState>,
+}
+
+#[derive(Default)]
+struct WorkspaceDispatchState {
+    waiting: VecDeque<WorkspaceWaiter>,
+    callbacks: Vec<tokio::sync::watch::Receiver<Option<bool>>>,
+    failed: bool,
+}
+
+struct AutomaticCallbackLease {
+    calls: Arc<OrderedWorkspaceCalls>,
+    settled: tokio::sync::watch::Sender<Option<bool>>,
+    success: bool,
+}
+
+impl Drop for AutomaticCallbackLease {
+    fn drop(&mut self) {
+        if !self.success {
+            self.calls
+                .state
+                .lock()
+                .expect("workspace dispatch queue poisoned")
+                .failed = true;
+        }
+        let _ = self.settled.send(Some(self.success));
+    }
+}
+
+struct WorkspaceWaiter {
+    identity: Arc<()>,
+    ready: Option<tokio::sync::oneshot::Sender<()>>,
+}
+
+struct WorkspaceTicket {
+    lease: WorkspaceLease,
+    ready: tokio::sync::oneshot::Receiver<()>,
+    callbacks: Vec<tokio::sync::watch::Receiver<Option<bool>>>,
+    failed: bool,
+}
+
+struct WorkspaceLease {
+    calls: Arc<OrderedWorkspaceCalls>,
+    identity: Arc<()>,
+}
+
+impl OrderedWorkspaceCalls {
+    fn callbacks_at_drain(&self) -> (Vec<tokio::sync::watch::Receiver<Option<bool>>>, bool) {
+        let mut state = self
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        state
+            .callbacks
+            .retain(|callback| callback.borrow().is_none());
+        (state.callbacks.clone(), state.failed)
+    }
+
+    fn reserve_callback(self: &Arc<Self>) -> AutomaticCallbackLease {
+        let (settled, waiting) = tokio::sync::watch::channel(None);
+        let mut state = self
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        state
+            .callbacks
+            .retain(|callback| callback.borrow().is_none());
+        state.callbacks.push(waiting);
+        AutomaticCallbackLease {
+            calls: Arc::clone(self),
+            settled,
+            success: false,
+        }
+    }
+
+    fn reserve(self: &Arc<Self>) -> WorkspaceTicket {
+        let (sender, ready) = tokio::sync::oneshot::channel();
+        let identity = Arc::new(());
+        let mut state = self
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        state
+            .callbacks
+            .retain(|callback| callback.borrow().is_none());
+        let callbacks = state.callbacks.clone();
+        let failed = state.failed;
+        let waiting = &mut state.waiting;
+        let sender = if waiting.is_empty() {
+            let _ = sender.send(());
+            None
+        } else {
+            Some(sender)
+        };
+        waiting.push_back(WorkspaceWaiter {
+            identity: Arc::clone(&identity),
+            ready: sender,
+        });
+        WorkspaceTicket {
+            lease: WorkspaceLease {
+                calls: Arc::clone(self),
+                identity,
+            },
+            ready,
+            callbacks,
+            failed,
+        }
+    }
+}
+
+impl Drop for WorkspaceLease {
+    fn drop(&mut self) {
+        let mut state = self
+            .calls
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        let waiting = &mut state.waiting;
+        let Some(position) = waiting
+            .iter()
+            .position(|entry| Arc::ptr_eq(&entry.identity, &self.identity))
+        else {
+            return;
+        };
+        waiting.remove(position);
+        // Removing a cancelled middle waiter cannot release the next mutation
+        // while the original head is still running.
+        if position == 0
+            && let Some(next) = waiting.front_mut()
+            && let Some(ready) = next.ready.take()
+        {
+            let _ = ready.send(());
+        }
+    }
+}
