+fn is_compaction_control_item(item: &ResponseItem) -> bool {
+    matches!(item, ResponseItem::Message { role, .. } if role == "system" || role == "developer")
+        || matches!(
+            item,
+            ResponseItem::ConfigurationUpdate { .. }
+                | ResponseItem::CompactionTrigger { .. }
+                | ResponseItem::AdditionalTools { .. }
+                | ResponseItem::AgentMessage { .. }
+        )
+        || crate::context_manager::rollback_context_update(item).is_some()
+}
+
+/// Validate a borrowed replacement without changing the captured/live window.
+fn validate_compaction_window(
+    history: &ContextManager,
+    captured_items: &[ResponseItem],
+    items: &[ResponseItem],
+) -> CodexResult<()> {
+    use codex_protocol::openai_models::InputModality;
+
+    let mut captured_controls = captured_items
+        .iter()
+        .filter(|item| is_compaction_control_item(item));
+    for item in items.iter().filter(|item| is_compaction_control_item(item)) {
+        if !captured_controls.any(|captured| captured == item) {
+            return Err(CodexErr::InvalidRequest(
+                "Compacted window contains a new or modified instruction or control item".into(),
+            ));
+        }
+    }
+
+    let mut candidate = history.clone();
+    candidate.replace_annotated(
+        items
+            .iter()
+            .cloned()
+            .map(ResponseItemEnvelope::new)
+            .collect(),
+    );
+    let projected = candidate.for_prompt(&[
+        InputModality::Text,
+        InputModality::Image,
+        InputModality::Audio,
+    ]);
+    if projected != items {
+        return Err(CodexErr::InvalidRequest(
+            "Compacted window must contain complete tool pairs".into(),
+        ));
+    }
+    Ok(())
+}
+
+/// Only conversation candidates participate in the optional default predicate.
+fn compaction_candidate_indexes(items: &[ResponseItem]) -> Vec<usize> {
+    items
+        .iter()
+        .enumerate()
+        .filter_map(|(index, item)| {
+            (!is_compaction_control_item(item)
+                && !matches!(item, ResponseItem::Message { role, .. } if role == "user")
+                && !matches!(
+                    item,
+                    ResponseItem::Compaction { .. } | ResponseItem::ContextCompaction { .. }
+                ))
+            .then_some(index)
+        })
+        .collect()
+}
