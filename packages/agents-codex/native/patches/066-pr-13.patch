+        let history = ContextManager::new();
+        let developer = item(json!({
+            "type": "message", "role": "developer",
+            "content": [{"type": "input_text", "text": "original developer"}],
+        }));
+        let system = item(json!({
+            "type": "message", "role": "system",
+            "content": [{"type": "input_text", "text": "original system"}],
+        }));
+        let changed = item(json!({
+            "type": "message", "role": "developer",
+            "content": [{"type": "input_text", "text": "modified developer"}],
+        }));
+        let captured = [developer.clone(), system.clone()];
+        validate_compaction_window(&history, &captured, &captured).unwrap();
+        validate_compaction_window(&history, &captured, std::slice::from_ref(&system)).unwrap();
+        for replacement in [
+            vec![changed],
+            vec![developer.clone(), developer.clone()],
+            vec![system, developer],
+        ] {
+            assert!(validate_compaction_window(&history, &captured, &replacement).is_err());
+        }
