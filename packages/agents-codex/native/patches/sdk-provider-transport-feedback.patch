+// TOML config has no null; preserve explicit disabled overrides with a named value.
+mod nullable_websocket_option {
+    use serde::Deserialize;
+    pub use serde_with::rust::double_option::serialize;
+
+    pub fn deserialize<'de, D, T>(deserializer: D) -> Result<Option<Option<T>>, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+        T: serde::Deserialize<'de>,
+    {
+        #[derive(serde::Deserialize)]
+        #[serde(untagged)]
+        enum Limit<T> {
+            Value(T),
+            Disabled(String),
+        }
+        match Option::<Limit<T>>::deserialize(deserializer)? {
+            None => Ok(Some(None)),
+            Some(Limit::Value(value)) => Ok(Some(Some(value))),
+            Some(Limit::Disabled(value)) if value == "disabled" => Ok(Some(None)),
+            Some(Limit::Disabled(_)) => Err(serde::de::Error::custom(
+                "expected an integer, null, or disabled",
+            )),
+        }
+    }
+}
