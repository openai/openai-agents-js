+) -> CodexResult<RealtimeResponseOptions> {
+    let response: Response = match response {
+        Some(value @ Value::Object(_)) => serde_json::from_value(value)
+            .map_err(|_| invalid("Unsupported or invalid raw Realtime response options"))?,
+        Some(_) => return Err(invalid("Raw Realtime response options must be an object")),
+        None => Response::default(),
+    };
+    if response.metadata.as_ref().is_some_and(|metadata| {
+        metadata.len() > 16
+            || metadata
+                .iter()
+                .any(|(key, value)| key.chars().count() > 64 || value.chars().count() > 512)
+    }) {
+        return Err(invalid(
+            "Raw Realtime response metadata exceeds provider limits",
+        ));
+    }
+    if response.input.iter().flatten().any(|item| {
+        !matches!(
+            item["type"].as_str(),
+            Some("message" | "function_call" | "function_call_output")
+        ) && !(item["type"] == "item_reference"
+            && item["id"]
+                .as_str()
+                .is_some_and(|id| !id.is_empty() && id.len() <= 512)
+            && item.as_object().is_some_and(|fields| fields.len() == 2))
+    }) {
+        return Err(invalid("Unsupported raw Realtime response input item"));
+    }
+    if let Some(tools) = &response.tools {
+        let mut names = BTreeSet::new();
+        if tools.len() > 128
+            || tools.iter().any(|RealtimeResponseTool::Function(tool)| {
+                tool.name.is_empty()
+                    || tool.name.len() > 128
+                    || !tool.parameters.is_object()
+                    || !names.insert(tool.name.as_str())
+            })
+        {
+            return Err(invalid(
+                "Invalid raw Realtime response function declarations",
+            ));
+        }
+    }
+    Ok(RealtimeResponseOptions {
+        conversation: response.conversation,
+        input: response.input,
+        instructions: response.instructions,
+        output_modality: response.output_modalities.map(|[modality]| modality),
+        max_output_tokens: response.max_output_tokens,
+        metadata: response.metadata,
+        parallel_tool_calls: response.parallel_tool_calls,
+        reasoning: response
+            .reasoning
+            .map(|Reasoning { effort }| RealtimeReasoning { effort }),
+        prompt: response
+            .prompt
+            .map(response_prompt)
+            .transpose()
+            .map_err(|_| invalid("Unsupported or invalid raw Realtime response prompt"))?,
+        audio_output: response
+            .audio
+            .as_ref()
+            .map(response_audio)
+            .transpose()
+            .map_err(|_| invalid("Unsupported or invalid raw Realtime response audio"))?
+            .flatten(),
+        tools: response.tools,
+        tool_choice: response.tool_choice,
+        event_id,
+    })
+}
+
+fn completion<T: Send + 'static>(
+    mut reply: Reply<Option<Value>>,
+    convert: fn(T) -> Option<Value>,
+) -> Reply<T> {
+    let (tx, rx) = oneshot::channel();
+    // The session dispatcher must remain free to process close while a
+    // generation-owned command waits for its provider receipt.
+    tokio::spawn(async move {
+        tokio::select! {
+            result = rx => {
+                let _ = reply.send(result.unwrap_or(Err(CodexErr::TurnAborted)).map(convert));
+            }
+            () = reply.closed() => {}
+        }
+    });
+    tx
+}
+
+async fn validate_connection(sess: &Arc<Session>, generation: &str) -> CodexResult<()> {
+    let state = sess.conversation.state.lock().await;
+    let conversation = state
+        .conversation
+        .as_ref()
+        .filter(|conversation| {
+            conversation.handoff.sdk.as_ref().is_some_and(|sdk| {
+                sdk.generation == generation && sdk.active.load(Ordering::Acquire)
+            })
+        })
+        .ok_or_else(|| invalid("SDK Realtime generation is stale"))?;
+    if conversation.handoff.event_parser != RealtimeEventParser::RealtimeV2 {
+        return Err(invalid("Raw client events require RealtimeV2"));
+    }
+    Ok(())
+}
+
+pub(crate) async fn handle_send_event_sdk(
+    sess: &Arc<Session>,
+    generation: String,
+    mut value: Value,
+    reply: Reply<Option<Value>>,
+) {
+    let (event, event_id) = match parse_event(&mut value) {
+        Ok(event) => event,
+        Err(error) => {
+            let _ = reply.send(Err(error));
+            return;
+        }
+    };
+    if let Err(error) = validate_connection(sess, &generation).await {
+        let _ = reply.send(Err(error));
+        return;
+    }
+    match event {
+        ClientEvent::ResponseCreate { response } => {
+            let result = match response_options(response, event_id) {
+                Ok(options) => {
+                    sess.conversation
+                        .sdk_enqueue(&generation, SdkRealtimeCommand::RequestResponse(options))
+                        .await
+                }
+                Err(error) => Err(error),
+            };
+            let _ = reply.send(result.map(|()| None));
+        }
+        ClientEvent::ResponseCancel { response_id } => {
+            if response_id
+                .as_ref()
+                .is_some_and(|id| id.is_empty() || id.len() > 512)
+            {
+                let _ = reply.send(Err(invalid("Raw Realtime response ID is invalid")));
+                return;
+            }
+            dispatch_interrupt_sdk(
+                sess,
+                generation,
+                response_id,
+                event_id,
+                None,
+                None,
+                completion(reply, |receipt: RealtimeInterruptReceipt| {
+                    Some(serde_json::json!(receipt))
+                }),
+            )
+            .await;
+        }
+        ClientEvent::ItemCreate {
+            item,
+            previous_item_id,
+        } => {
+            if item.get("type").and_then(Value::as_str) == Some("mcp_approval_response") {
+                dispatch_raw_approval(sess, generation, item, previous_item_id, event_id, reply)
+                    .await;
+                return;
+            }
+            let mut item = match item {
+                Value::Object(item)
+                    if matches!(
+                        item.get("type").and_then(Value::as_str),
+                        Some("message" | "function_call" | "function_call_output")
+                    ) =>
+                {
+                    item
+                }
+                _ => {
+                    let _ = reply.send(Err(invalid("Unsupported raw Realtime conversation item")));
+                    return;
+                }
+            };
+            item.entry("id").or_insert_with(|| {
+                Value::String(format!("item_{}", uuid::Uuid::new_v4().simple()))
+            });
+            handle_history_sdk(
+                sess,
+                generation,
+                Request::Create {
+                    item: Value::Object(item),
+                    previous: previous_item_id,
+                    event_id,
+                    reply: completion(reply, |_| None),
+                },
+            )
+            .await;
+        }
+        ClientEvent::ItemRetrieve { item_id } => {
+            handle_history_sdk(
+                sess,
+                generation,
+                Request::Item {
+                    id: item_id,
+                    event_id,
+                    reply: completion(reply, Some),
+                },
+            )
+            .await;
+        }
+        ClientEvent::ItemDelete { item_id } => {
+            handle_delete_item_sdk(
+                sess,
+                generation,
+                item_id,
+                event_id,
+                completion(reply, |_| None),
+            )
+            .await;
+        }
+        ClientEvent::AudioAppend { audio } => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::RawAudio {
+                    audio,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::AudioClear {} | ClientEvent::AudioCommit {} => {
+            let control = if matches!(event, ClientEvent::AudioClear {}) {
+                AudioBufferControl::Clear
+            } else {
+                AudioBufferControl::Commit
+            };
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::AudioControl {
+                    control,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::ItemTruncate {
+            item_id,
+            content_index,
+            audio_end_ms,
+        } => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::PlaybackControl {
+                    control: RealtimePlaybackControl::Truncate {
+                        item_id,
+                        content_index,
+                        audio_end_ms,
+                    },
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::OutputClear {} => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::PlaybackControl {
+                    control: RealtimePlaybackControl::Clear,
+                    event_id,
+                    reply,
+                }
+            })
+            .await;
+        }
+        ClientEvent::SessionUpdate { session } => match session_update(session) {
+            Ok(update) => {
+                dispatch_update_sdk(
+                    sess,
+                    generation,
+                    update,
+                    None,
+                    event_id,
+                    completion(reply, |_| None),
+                )
+                .await
+            }
+            Err(error) => {
+                let _ = reply.send(Err(error));
+            }
+        },
+        ClientEvent::ProviderEvent => {
+            dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+                SdkRealtimeCommand::RawProviderEvent {
+                    payload: value.to_string(),
+                    reply,
+                }
+            })
+            .await;
+        }
+    }
+}
+
+fn parse_event(value: &mut Value) -> CodexResult<(ClientEvent, Option<String>)> {
+    let mut retained_bytes = 0;
+    codex_api::charge_realtime_json_storage(value, &mut retained_bytes)
+        .map_err(|_| invalid("Raw Realtime event exceeds its 8 MiB estimated storage limit"))?;
+    let fields = value
+        .as_object_mut()
+        .ok_or_else(|| invalid("Raw Realtime event must be an object"))?;
+    if !fields
+        .get("type")
+        .and_then(Value::as_str)
+        .is_some_and(|name| !name.is_empty() && name.len() <= 512)
+    {
+        return Err(invalid("Raw Realtime event type is invalid"));
+    }
+    let original_id = fields.remove("event_id");
+    let event_id = match &original_id {
+        Some(Value::String(id)) if !id.is_empty() && id.len() <= 512 => Some(id.clone()),
+        None | Some(Value::Null) => None,
+        Some(_) => return Err(invalid("Raw Realtime event ID is invalid")),
+    };
+    let event = ClientEvent::deserialize(&*value)
+        .map_err(|_| invalid("Unsupported or invalid raw Realtime client event"))?;
+    if matches!(event, ClientEvent::ProviderEvent)
+        && let Some(original_id) = original_id
+    {
+        value["event_id"] = original_id;
+    }
+    Ok((event, event_id))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ApprovalResponse {
+    #[serde(rename = "type")]
+    kind: String,
+    id: Option<String>,
+    approval_request_id: String,
+    approve: bool,
+    reason: Option<String>,
+}
+
+async fn dispatch_raw_approval(
+    sess: &Arc<Session>,
+    generation: String,
+    item: Value,
+    previous: Option<String>,
+    event_id: Option<String>,
+    reply: Reply<Option<Value>>,
+) {
+    let response = serde_json::from_value::<ApprovalResponse>(item);
+    let response = match response {
+        Ok(response)
+            if response.kind == "mcp_approval_response"
+                && !response.approval_request_id.is_empty()
+                && response.approval_request_id.len() <= 512
+                && response.approval_request_id != "root"
+                && response.id.as_ref().is_none_or(|id| {
+                    !id.is_empty()
+                        && id.len() <= 512
+                        && id != "root"
+                        && id != &response.approval_request_id
+                })
+                && previous
+                    .as_ref()
+                    .is_none_or(|id| id == &response.approval_request_id) =>
+        {
+            response
+        }
+        _ => {
+            let _ = reply.send(Err(invalid(
+                "Unsupported or invalid raw Hosted MCP approval response",
+            )));
+            return;
+        }
+    };
+    dispatch_sdk_control(sess, generation, completion(reply, |_| None), |reply| {
+        SdkRealtimeCommand::HostedMcpApprovalResponse {
+            request_id: response.approval_request_id,
+            approve: response.approve,
+            reason: response.reason,
+            item_id: response.id,
+            event_id,
+            reply,
+        }
+    })
+    .await;
+}
diff --git a/codex-rs/core/src/realtime_conversation/raw_settings.rs b/codex-rs/core/src/realtime_conversation/raw_settings.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cb2bcca110b02df30a0f262c4ecdeb157675a256
--- /dev/null
+++ b/codex-rs/core/src/realtime_conversation/raw_settings.rs
@@ -0,0 +1,326 @@
+//! Translate provider session and response settings into native settings.
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::realtime_settings::RealtimeAudioFormat;
+use codex_protocol::realtime_settings::RealtimePrompt;
+use codex_protocol::realtime_settings::RealtimeResponseAudioOutput;
+use codex_protocol::realtime_settings::RealtimeSessionTool;
+use codex_protocol::realtime_settings::RealtimeSessionUpdate;
+use serde_json::Map;
+use serde_json::Value;
+
+fn invalid() -> CodexErr {
+    CodexErr::InvalidRequest("Unsupported or invalid raw Realtime session settings".into())
+}
+
+fn object<'a>(value: &'a Value, keys: &[&str]) -> CodexResult<&'a Map<String, Value>> {
+    let fields = value.as_object().ok_or_else(invalid)?;
+    if fields.keys().any(|key| !keys.contains(&key.as_str())) {
+        return Err(invalid());
+    }
+    Ok(fields)
+}
+
+fn nonempty_string(value: Option<&Value>) -> bool {
+    value
+        .and_then(Value::as_str)
+        .is_some_and(|value| !value.trim().is_empty())
+}
+
+fn format(value: &Value) -> CodexResult<RealtimeAudioFormat> {
+    let fields = object(value, &["type", "rate"])?;
+    Ok(match fields.get("type").and_then(Value::as_str) {
+        Some("audio/pcm")
+            if fields
+                .get("rate")
+                .is_none_or(|rate| rate.as_u64() == Some(24000)) =>
+        {
+            RealtimeAudioFormat::Pcm24k
+        }
+        Some("audio/pcmu") if !fields.contains_key("rate") => RealtimeAudioFormat::G711Ulaw,
+        Some("audio/pcma") if !fields.contains_key("rate") => RealtimeAudioFormat::G711Alaw,
+        _ => return Err(invalid()),
+    })
+}
+
+// Protocol DTOs intentionally tolerate extra fields on several settings. Raw
+// provider input must name only supported leaves before those DTOs decode it.
+fn nested(name: &str, value: &Value) -> CodexResult<()> {
+    if value.is_null() {
+        return if matches!(
+            name,
+            "noise_reduction" | "transcription" | "turn_detection" | "prompt" | "tracing"
+        ) {
+            Ok(())
+        } else {
+            Err(invalid())
+        };
+    }
+    match name {
+        "noise_reduction" => {
+            object(value, &["type"])?;
+        }
+        "transcription" => {
+            object(
+                value,
+                &[
+                    "model",
+                    "language",
+                    "prompt",
+                    "keywords",
+                    "languages",
+                    "delay",
+                ],
+            )?;
+        }
+        "turn_detection" => {
+            let keys: &[&str] = match value.get("type").and_then(Value::as_str) {
+                Some("server_vad") => &[
+                    "type",
+                    "model_version",
+                    "create_response",
+                    "interrupt_response",
+                    "threshold",
+                    "prefix_padding_ms",
+                    "silence_duration_ms",
+                    "idle_timeout_ms",
+                ],
+                Some("semantic_vad") => &[
+                    "type",
+                    "model_version",
+                    "create_response",
+                    "interrupt_response",
+                    "eagerness",
+                ],
+                _ => return Err(invalid()),
+            };
+            object(value, keys)?;
+        }
+        "voice" => {
+            let voice = if value.is_object() {
+                object(value, &["id"])?.get("id")
+            } else {
+                Some(value)
+            };
+            if !nonempty_string(voice) {
+                return Err(invalid());
+            }
+        }
+        "tool_choice" if value.is_object() => {
+            object(value, &["type", "name"])?;
+        }
+        "reasoning" => {
+            object(value, &["effort"])?;
+        }
+        "tracing" if value.is_object() => {
+            object(value, &["workflow_name", "group_id", "metadata"])?;
+        }
+        "prompt" => {
+            let fields = object(value, &["id", "version", "variables"])?;
+            if !nonempty_string(fields.get("id")) {
+                return Err(invalid());
+            }
+            if let Some(variables) = fields.get("variables").filter(|value| !value.is_null()) {
+                for value in variables.as_object().ok_or_else(invalid)?.values() {
+                    if value.is_string() {
+                        continue;
+                    }
+                    let keys: &[&str] = match value.get("type").and_then(Value::as_str) {
+                        Some("input_text") => &["type", "text"],
+                        Some("input_image") => &["type", "image_url", "file_id", "detail"],
+                        Some("input_file") => {
+                            &["type", "file_url", "file_id", "file_data", "filename"]
+                        }
+                        _ => return Err(invalid()),
+                    };
+                    object(value, keys)?;
+                }
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+pub(super) fn response_prompt(value: Value) -> CodexResult<Option<RealtimePrompt>> {
+    nested("prompt", &value)?;
+    serde_json::from_value(value).map_err(|_| invalid())
+}
+
+pub(super) fn response_audio(value: &Value) -> CodexResult<Option<RealtimeResponseAudioOutput>> {
+    let Some(output) = object(value, &["output"])?.get("output") else {
+        return Ok(None);
+    };
+    let output = object(output, &["format", "voice"])?;
+    let format = output.get("format").map(format).transpose()?;
+    let voice = output
+        .get("voice")
+        .map(|value| {
+            nested("voice", value)?;
+            serde_json::from_value(value.clone()).map_err(|_| invalid())
+        })
+        .transpose()?;
+    Ok(Some(RealtimeResponseAudioOutput { format, voice }))
+}
+
+/// Decode the `session` object before checking the native tool catalog.
+pub(super) fn session_update(value: Value) -> CodexResult<RealtimeSessionUpdate> {
+    let fields = object(
+        &value,
+        &[
+            "type",
+            "model",
+            "instructions",
+            "output_modalities",
+            "audio",
+            "tools",
+            "tool_choice",
+            "prompt",
+            "tracing",
+            "max_output_tokens",
+            "parallel_tool_calls",
+            "reasoning",
+        ],
+    )?;
+    if fields
+        .get("type")
+        .is_some_and(|value| value.as_str() != Some("realtime"))
+    {
+        return Err(invalid());
+    }
+    let mut update = Map::new();
+    for name in [
+        "model",
+        "instructions",
+        "tool_choice",
+        "prompt",
+        "tracing",
+        "max_output_tokens",
+        "parallel_tool_calls",
+        "reasoning",
+    ] {
+        if let Some(value) = fields.get(name) {
+            nested(name, value)?;
+            update.insert(name.into(), value.clone());
+        }
+    }
+    if let Some(value) = fields.get("output_modalities") {
+        let modalities = value
+            .as_array()
+            .filter(|values| values.len() == 1)
+            .ok_or_else(invalid)?;
+        if !matches!(modalities[0].as_str(), Some("text" | "audio")) {
+            return Err(invalid());
+        }
+        update.insert("output_modality".into(), modalities[0].clone());
+    }
+    if let Some(audio) = fields.get("audio") {
+        for (direction, section) in object(audio, &["input", "output"])? {
+            let names: &[&str] = if direction == "input" {
+                &[
+                    "format",
+                    "noise_reduction",
+                    "transcription",
+                    "turn_detection",
+                ]
+            } else {
+                &["format", "voice", "speed"]
+            };
+            for (name, value) in object(section, names)? {
+                let (key, translated) = if name == "format" {
+                    (
+                        if direction == "input" {
+                            "input_format"
+                        } else {
+                            "output_format"
+                        },
+                        serde_json::to_value(format(value)?).map_err(|_| invalid())?,
+                    )
+                } else {
+                    nested(name, value)?;
+                    (
+                        match name.as_str() {
+                            "voice" => "output_voice",
+                            "speed" => "output_speed",
+                            name => name,
+                        },
+                        value.clone(),
+                    )
+                };
+                update.insert(key.into(), translated);
+            }
+        }
+    }
+    let mut update: RealtimeSessionUpdate =
+        serde_json::from_value(Value::Object(update)).map_err(|_| invalid())?;
+    update.raw_tools = fields
+        .get("tools")
+        .map(|value| {
+            value
+                .as_array()
+                .filter(|tools| tools.len() <= 128)
+                .ok_or_else(invalid)?
+                .iter()
+                .map(|tool| {
+                    let mut tool = tool.clone();
+                    if tool["type"] == "function"
+                        && let Some(fields) = tool.as_object_mut()
+                    {
+                        fields.entry("parameters").or_insert_with(
+                            || serde_json::json!({"type": "object", "properties": {}}),
+                        );
+                    }
+                    serde_json::from_value::<RealtimeSessionTool>(tool).map_err(|_| invalid())
+                })
+                .collect()
+        })
+        .transpose()?;
+    Ok(update)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
