+        let cancelled = request(LIMIT + 1);
+        state.observe_id(&cancelled.item_id).unwrap();
+        assert!(state.observe_caller_call(&cancelled, false).unwrap());
+        state.finish_caller_response(cancelled.response_id.as_deref().unwrap(), true);
+        for index in 1..=LIMIT {
