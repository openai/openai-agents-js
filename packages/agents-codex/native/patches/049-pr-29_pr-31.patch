+        let oldest = request(1);
+        assert!(!state.is_detached_caller_call(&oldest.call_id, &oldest.item_id));
+        let newest = request(LIMIT);
+        assert!(state.is_detached_caller_call(&newest.call_id, &newest.item_id));
+
+        let imported = [
