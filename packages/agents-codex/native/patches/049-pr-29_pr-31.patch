+        assert!(matches!(
+            receipt.try_recv(),
+            Err(tokio::sync::oneshot::error::TryRecvError::Empty)
+        ));
+        state
+            .observe_added(&output, Some(Some("caller-item")))
+            .unwrap();
+        state.created(&output, true).unwrap();
+        receipt.await.unwrap().unwrap();
