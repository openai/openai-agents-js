+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compaction_checkpoint_publishes_after_flush_despite_late_cancel_and_stop() {
+    let (session, turn, events, mut fences, store) =
+        compaction_checkpoint_session(true, |_| {}).await;
+    let stop = codex_extension_api::TurnSamplingStop::default();
+    turn.extension_data.insert(stop.clone());
+    let cancel = CancellationToken::new();
+    let before = compaction_checkpoint_live_state(&session).await;
+    let compact = start_compaction_checkpoint(session.clone(), turn, cancel.clone());
+    let append = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    let finalization = session
+        .services
+        .thread_extension_data
+        .get::<crate::tasks::TaskFinalization>()
+        .unwrap();
+    assert!(finalization.0.try_lock().is_err());
+    assert_eq!(compaction_checkpoint_live_state(&session).await, before);
+    cancel.cancel();
+    stop.request();
+    append.release.send(Ok(())).unwrap();
+    let flush = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(finalization.0.try_lock().is_err());
+    assert_eq!(compaction_checkpoint_live_state(&session).await, before);
+    assert!(events.try_recv().is_err());
+    // Host-owned retained facts and acceptance-order reservations may arrive while flushing.
+    let (delivery, _) =
+        session.record_delivered_assistant_message(codex_history::RetainedUserMessage {
+            origin: codex_history::UserInputOrigin::User,
+            turn_id: "synthetic-host-turn".into(),
+            message_id: Some("synthetic-delivery".into()),
+            text: "May I run tests?".into(),
+            complete: true,
+            phase: None,
+        });
+    let retained = session
+        .state
+        .lock()
+        .await
+        .history
+        .retained_context()
+        .clone();
+    assert_ne!(serde_json::to_value(&retained).unwrap(), before["retained"]);
+    assert!(
+        !delivery.is_finished(),
+        "delivery persistence must follow the checkpoint"
+    );
+    flush.release.send(Ok(())).unwrap();
+    timeout(Duration::from_secs(2), compact)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    delivery.await.unwrap();
+    assert!(finalization.0.try_lock().is_ok());
+    let after = compaction_checkpoint_live_state(&session).await;
+    assert_eq!(
+        after["window_number"],
+        before["window_number"].as_u64().unwrap() + 1
+    );
+    assert_eq!(after["previous_window_id"], before["window_id"]);
+    assert_eq!(after["first_window_id"], before["first_window_id"]);
+    assert_eq!(after["effort_compacted"], true);
+    assert_eq!(after["pending_hooks"], 1);
+    let state = session.state.lock().await;
+    assert_eq!(state.history.retained_context(), &retained);
+    assert_eq!(state.history.annotated_items().len(), 1);
+    assert!(matches!(&state.history.annotated_items()[0].item,
+        ResponseItem::Message { content, .. } if matches!(&content[0],
+            ContentItem::InputText { text } if text == "replacement summary")));
+    let (_, count, originals) = state.sdk_originals.snapshot(None).unwrap();
+    assert_eq!(count, 3);
+    assert!(originals.last().unwrap().contains("raw summary output"));
+    drop(state);
+    let stored = stored_compaction_checkpoints(&store, &session).await;
+    let checkpoint_index = stored
+        .iter()
+        .position(|item| matches!(item, RolloutItem::Compacted(_)))
+        .unwrap();
+    let delivery_index = stored.iter().position(|item| matches!(item,
+        RolloutItem::RetainedContext(codex_history::RetainedContextEvent::DeliveredAssistantMessage { message, .. })
+            if message.message_id.as_deref() == Some("synthetic-delivery"))).unwrap();
+    assert!(checkpoint_index < delivery_index);
+    let checkpoint = stored
+        .iter()
+        .find_map(|item| match item {
+            RolloutItem::Compacted(checkpoint) => Some(checkpoint),
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(checkpoint.window_number, after["window_number"].as_u64());
+    assert_eq!(checkpoint.window_id.as_deref(), after["window_id"].as_str());
+    assert_eq!(
+        checkpoint.replacement_history.as_deref(),
+        Some(session.clone_history().await.annotated_items())
+    );
+    assert!(stored.iter().any(|item| matches!(item,
+        RolloutItem::ResponseItem(envelope) if envelope.metadata.as_ref()
+            .is_some_and(|metadata| metadata.compaction_output
+                && metadata.delivered_assistant_message.is_none()
+                && metadata.sender_user_messages.is_none()))));
+    assert!(matches!(
+        events.try_recv().unwrap().msg,
+        EventMsg::RawResponseItem(_)
+    ));
+    assert!(events.try_recv().is_err());
+}
