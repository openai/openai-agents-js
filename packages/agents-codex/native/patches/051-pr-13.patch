+async fn commit_compaction_checkpoint(
+    session: Arc<Session>,
+    turn: Arc<TurnContext>,
+    cancel: CancellationToken,
+) -> CodexResult<()> {
+    let step = StepContext::for_test(turn);
+    let (window_number, window_ids) = session.state.lock().await.preview_new_context_window();
+    session
+        .replace_compacted_history_with_output(
+            vec![ResponseItemEnvelope::new(user_message(
+                "replacement summary",
+            ))],
+            step.to_turn_context_item(),
+            WorldStateSnapshot::default(),
+            CompactedHistoryMetadata {
+                input_goal_ids: Default::default(),
+                message: "replacement summary".into(),
+                window_number,
+                window_ids,
+                compaction_response_id: Some("synthetic-compaction".into()),
+                compaction_model_hash: None,
+                reviewer_compaction_hash: None,
+            },
+            Some(CompletedCompactionOutput {
+                source: &step,
+                registered_turn: &step.turn,
+                cancellation_token: &cancel,
+                items: vec![assistant_message("raw summary output")],
+            }),
+        )
+        .await
+}
