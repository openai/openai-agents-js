+fn start_compaction_checkpoint(
+    session: Arc<Session>,
+    turn: Arc<TurnContext>,
+    cancel: CancellationToken,
+) -> tokio::task::JoinHandle<CodexResult<()>> {
+    tokio::spawn(commit_compaction_checkpoint(session, turn, cancel))
+}
