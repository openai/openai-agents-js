+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compaction_checkpoint_pre_sampling_failure_records_prompt_before_error() {
+    const PROMPT: &str = "original pre-sampling prompt";
+    let server = start_mock_server().await;
+    mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("summary", "raw summary output"),
+            ev_completed("synthetic-compaction"),
+        ]),
+    )
+    .await;
+    let (session, turn, events, mut fences, store) =
+        compaction_checkpoint_session(true, |config| {
+            config.model_provider.name = "OpenAI (test)".into();
+            config.model_provider.base_url = Some(format!("{}/v1", server.uri()));
+            config.model_provider.supports_websockets = false;
+            config.features.disable(Feature::TokenBudget).unwrap();
+            config.model_auto_compact_token_limit_scope =
+                codex_protocol::config_types::AutoCompactTokenLimitScope::BodyAfterPrefix;
+            config.model_auto_compact_token_limit = Some(1);
+        })
+        .await;
+    // The seed answer is the last model item. Give it a provider usage
+    // receipt so it contributes to the next turn's compaction threshold.
+    let output_tokens = turn.config.token_budget.as_ref().map_or(1024, |budget| {
+        budget.fallback_buffer_tokens().saturating_add(1024)
+    });
+    session
+        .update_token_usage_info(
+            &turn,
+            Some(&TokenUsage {
+                input_tokens: 64,
+                output_tokens,
+                total_tokens: 64 + output_tokens,
+                ..Default::default()
+            }),
+        )
+        .await
+        .unwrap();
+    assert!(
+        crate::session::context_window::context_window_token_status(&session, &turn)
+            .await
+            .token_limit_reached
+    );
+    let before = compaction_checkpoint_live_state(&session).await;
+    session
+        .spawn_task(
+            turn.clone(),
+            vec![TurnInput::UserInput {
+                content: vec![UserInput::Text {
+                    text: PROMPT.into(),
+                    text_elements: Vec::new(),
+                }],
+                client_id: None,
+                metadata: Default::default(),
+            }],
+            crate::tasks::RegularTask::new(),
+        )
+        .await;
+    let append = timeout(Duration::from_secs(5), fences.recv())
+        .await
+        .expect("pre-sampling compaction must reach its checkpoint append")
+        .unwrap();
+    let owner = {
+        let active = session.active_turn.lock().await;
+        active
+            .as_ref()
+            .unwrap()
+            .task
+            .as_ref()
+            .unwrap()
+            .handle
+            .owner()
+            .clone()
+    };
+    append
+        .release
+        .send(Err("synthetic checkpoint append rejection".into()))
+        .unwrap();
+    timeout(Duration::from_secs(5), owner.join())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_compaction_checkpoint_failure_events(
+        &events,
+        &turn,
+        &compaction_checkpoint_persistence_error(),
+        false,
+        Some(PROMPT),
+    );
+    let after = compaction_checkpoint_live_state(&session).await;
+    assert_eq!(after["pending_hooks"], before["pending_hooks"]);
+    assert_eq!(after["window_id"], before["window_id"]);
+    let model_context = after["model_context"].to_string();
+    assert!(model_context.find("original answer").unwrap() < model_context.find(PROMPT).unwrap());
+    assert_eq!(model_context.matches(PROMPT).count(), 1);
+    assert!(!model_context.contains("raw summary output"));
+    assert!(
+        !stored_compaction_checkpoints(&store, &session)
+            .await
+            .iter()
+            .any(|item| matches!(item, RolloutItem::Compacted(_)))
+    );
+    let requests = server.received_requests().await.unwrap();
+    let responses: Vec<_> = requests
+        .iter()
+        .filter(|request| request.url.path() == "/v1/responses")
+        .collect();
+    assert_eq!(responses.len(), 1);
+    assert!(!String::from_utf8_lossy(&responses[0].body).contains(PROMPT));
+}
