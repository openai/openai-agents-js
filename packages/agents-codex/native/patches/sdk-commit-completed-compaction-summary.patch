+async fn compaction_checkpoint_failure_keeps_live_state(fail_flush: bool) {
+    let (session, turn, events, mut fences, store) =
+        compaction_checkpoint_session(true, |_| {}).await;
+    let before = compaction_checkpoint_live_state(&session).await;
+    let compact = start_compaction_checkpoint(session.clone(), turn, CancellationToken::new());
+    let append = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    // Direct readers must finish while the writer has not acknowledged its append.
+    assert_eq!(
+        timeout(
+            Duration::from_secs(2),
+            compaction_checkpoint_live_state(&session)
+        )
+        .await
+        .unwrap(),
+        before,
+    );
+    assert!(
+        !stored_compaction_checkpoints(&store, &session)
+            .await
+            .iter()
+            .any(|item| matches!(item, RolloutItem::Compacted(_)))
+    );
+    if fail_flush {
+        append.release.send(Ok(())).unwrap();
+        let flush = timeout(Duration::from_secs(2), fences.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(compaction_checkpoint_live_state(&session).await, before);
+        // An acknowledged append can already have stored a checkpoint despite failed flush.
+        assert!(
+            stored_compaction_checkpoints(&store, &session)
+                .await
+                .iter()
+                .any(|item| matches!(item, RolloutItem::Compacted(_)))
+        );
+        flush
+            .release
+            .send(Err("synthetic checkpoint flush failure".into()))
+            .unwrap();
+    } else {
+        append
+            .release
+            .send(Err("synthetic checkpoint append rejection".into()))
+            .unwrap();
+    }
+    let error = timeout(Duration::from_secs(2), compact)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap_err();
+    assert!(
+        matches!(error.details(), codex_protocol::error::CodexErrorDetails::Fatal(message)
+        if message == "Canonical thread persistence failed; turn completion stopped")
+    );
+    assert_eq!(compaction_checkpoint_live_state(&session).await, before);
+    assert_eq!(
+        stored_compaction_checkpoints(&store, &session)
+            .await
+            .iter()
+            .any(|item| matches!(item, RolloutItem::Compacted(_))),
+        fail_flush
+    );
+    assert!(
+        events.try_recv().is_err(),
+        "failed checkpoint published raw output"
+    );
+    assert!(
+        matches!(
+            session.ensure_rollout_durable().await,
+            Err(error) if matches!(error.details(), codex_protocol::error::CodexErrorDetails::Fatal(_))
+        ),
+        "writer failure must remain sticky"
+    );
+}
