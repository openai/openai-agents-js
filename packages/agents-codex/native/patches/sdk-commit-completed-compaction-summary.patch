+async fn compaction_checkpoint_publishes_after_flush_despite_late_cancel_and_stop() {
+    let (session, turn, events, mut fences, store) =
+        compaction_checkpoint_session(true, |_| {}).await;
+    let stop = codex_extension_api::TurnSamplingStop::default();
+    turn.extension_data.insert(stop.clone());
