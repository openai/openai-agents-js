+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(checkpoint.window_number, after["window_number"].as_u64());
+    assert_eq!(checkpoint.window_id.as_deref(), after["window_id"].as_str());
+    assert_eq!(
+        checkpoint.replacement_history.as_deref(),
+        Some(session.clone_history().await.annotated_items())
