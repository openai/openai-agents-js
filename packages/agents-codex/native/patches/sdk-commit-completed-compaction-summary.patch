+fn compaction_checkpoint_persistence_error() -> ErrorEvent {
+    CodexErr::Fatal("Canonical thread persistence failed; turn completion stopped".into())
+        .to_error_event(None)
+}
+
+#[test_case::test_case(false, false; "normal completion reports checkpoint fatal")]
+#[test_case::test_case(true, false; "retirement reports checkpoint fatal")]
+#[test_case::test_case(true, true; "retirement keeps earlier fatal")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compaction_checkpoint_failed_flush_settles_once(retired: bool, earlier_fatal: bool) {
+    let (session, turn, events, mut fences, store) =
+        compaction_checkpoint_session(true, |_| {}).await;
+    let flush = hold_owned_compaction_flush(&session, &turn, &mut fences).await;
+    let before = compaction_checkpoint_live_state(&session).await;
+    let expected = if earlier_fatal {
+        let prior = CodexErr::Fatal("original task fatal".into()).to_error_event(None);
+        session
+            .send_event(&turn, EventMsg::Error(prior.clone()))
+            .await;
+        prior
+    } else {
+        compaction_checkpoint_persistence_error()
+    };
+    let (cancel, owner) = {
+        let active = session.active_turn.lock().await;
+        let task = active.as_ref().unwrap().task.as_ref().unwrap();
+        (task.cancellation_token.clone(), task.handle.owner().clone())
+    };
+    let abort = retired.then(|| {
+        let session = session.clone();
+        let turn = turn.clone();
+        tokio::spawn(async move {
+            session
+                .abort_turn_if_active(&turn.sub_id, TurnAbortReason::Interrupted, None)
+                .await
+        })
+    });
+    if retired {
+        timeout(Duration::from_secs(2), cancel.cancelled())
+            .await
+            .unwrap();
+    }
+    flush
+        .release
+        .send(Err("synthetic checkpoint flush failure".into()))
+        .unwrap();
+    if let Some(abort) = abort {
+        assert!(
+            timeout(Duration::from_secs(2), abort)
+                .await
+                .unwrap()
+                .unwrap()
+        );
+    }
+    timeout(Duration::from_secs(2), owner.join())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_compaction_checkpoint_failure_events(&events, &turn, &expected, retired, None);
+    let after = compaction_checkpoint_live_state(&session).await;
+    assert_eq!(after["pending_hooks"], before["pending_hooks"]);
+    assert_eq!(after["window_id"], before["window_id"]);
+    let model_context = after["model_context"].to_string();
+    assert!(model_context.contains("original input"));
+    assert!(!model_context.contains("replacement summary"));
+    assert!(
+        stored_compaction_checkpoints(&store, &session)
+            .await
+            .iter()
+            .any(|item| matches!(item, RolloutItem::Compacted(_)))
+    );
+}
