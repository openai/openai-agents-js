+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compaction_checkpoint_detached_completion_yields_to_abort_error() {
+    let (session, turn, events, mut fences, _store) =
+        compaction_checkpoint_session(true, |_| {}).await;
+    session
+        .spawn_task(
+            turn.clone(),
+            Vec::new(),
+            NeverEndingTask {
+                kind: TaskKind::Regular,
+                listen_to_cancellation_token: true,
+            },
+        )
+        .await;
+    let cancel = {
+        let active = session.active_turn.lock().await;
+        let task = active.as_ref().unwrap().task.as_ref().unwrap();
+        assert!(Arc::ptr_eq(&task.turn_context, &turn));
+        task.cancellation_token.clone()
+    };
+    let checkpoint = start_compaction_checkpoint(session.clone(), turn.clone(), cancel);
+    let append = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    append.release.send(Ok(())).unwrap();
+    let flush = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    flush
+        .release
+        .send(Err("synthetic checkpoint flush failure".into()))
+        .unwrap();
+    let writer_error = timeout(Duration::from_secs(2), checkpoint)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap_err();
+    let finalization = session
+        .services
+        .thread_extension_data
+        .get::<crate::tasks::TaskFinalization>()
+        .unwrap();
+    let held = finalization.0.lock().await;
+    let completing = session.on_task_finished(turn.clone(), Err(writer_error));
+    tokio::pin!(completing);
+    assert!(futures::poll!(completing.as_mut()).is_pending());
+
+    let earlier = CodexErr::Fatal("original strict Guardian abort".into()).to_error_event(None);
+    let aborting = session.abort_turn_if_active(
+        &turn.sub_id,
+        TurnAbortReason::Interrupted,
+        Some(earlier.clone()),
+    );
+    tokio::pin!(aborting);
+    assert!(futures::poll!(aborting.as_mut()).is_pending());
+    assert!(session.active_turn.lock().await.is_none());
+    drop(held);
+    let ((), aborted) = timeout(Duration::from_secs(2), async {
+        tokio::join!(completing, aborting)
+    })
+    .await
+    .unwrap();
+    assert!(aborted);
+    assert_compaction_checkpoint_failure_events(&events, &turn, &earlier, true, None);
+}
