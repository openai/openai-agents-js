+    assert!(stored.iter().any(|item| matches!(item,
+        RolloutItem::ResponseItem(envelope) if envelope.metadata.as_ref()
+            .is_some_and(|metadata| metadata.compaction_output
+                && metadata.delivered_assistant_message.is_none()
+                && metadata.sender_user_messages.is_none()))));
+    assert!(matches!(
+        events.try_recv().unwrap().msg,
+        EventMsg::RawResponseItem(_)
