+fn assert_compaction_checkpoint_failure_events(
+    events: &async_channel::Receiver<Event>,
+    turn: &TurnContext,
+    expected: &ErrorEvent,
+    retired: bool,
+    original_prompt: Option<&str>,
+) {
+    let mut notices = 0;
+    let mut settlements = 0;
+    let mut prompts = 0;
+    while let Ok(event) = events.try_recv() {
+        match event.msg {
+            EventMsg::Error(error) => {
+                assert_eq!(settlements, 0, "error must precede terminal delivery");
+                assert_eq!(error, *expected);
+                assert_eq!(prompts, usize::from(original_prompt.is_some()));
+                notices += 1;
+            }
+            EventMsg::TurnAborted(aborted) => {
+                assert!(retired, "uncancelled task aborted");
+                assert_eq!(notices, 1);
+                assert_eq!(aborted.turn_id.as_deref(), Some(turn.sub_id.as_str()));
+                assert_eq!(aborted.error.as_ref(), Some(expected));
+                settlements += 1;
+            }
+            EventMsg::TurnComplete(completed) => {
+                assert!(!retired, "retired task completed normally");
+                assert_eq!(notices, 1);
+                assert_eq!(completed.turn_id, turn.sub_id);
+                assert_eq!(completed.error.as_ref(), Some(expected));
+                assert!(completed.last_agent_message.is_none());
+                settlements += 1;
+            }
+            EventMsg::ContextCompacted(_)
+            | EventMsg::ItemCompleted(ItemCompletedEvent {
+                item: TurnItem::ContextCompaction(_),
+                ..
+            }) => panic!("unexpected compaction success"),
+            EventMsg::UserMessage(message)
+                if original_prompt.is_some_and(|prompt| message.message == prompt) =>
+            {
+                assert_eq!(notices, 0, "original prompt must precede the failure");
+                prompts += 1;
+            }
+            EventMsg::RawResponseItem(raw) => {
+                assert!(
+                    !serde_json::to_string(&raw.item)
+                        .unwrap()
+                        .contains("raw summary output")
+                );
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(notices, 1);
+    assert_eq!(settlements, 1);
+    assert_eq!(prompts, usize::from(original_prompt.is_some()));
+}
