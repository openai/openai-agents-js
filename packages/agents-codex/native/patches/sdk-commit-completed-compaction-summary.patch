+    assert_eq!(after["previous_window_id"], before["window_id"]);
+    assert_eq!(after["first_window_id"], before["first_window_id"]);
+    assert_eq!(after["effort_compacted"], true);
+    assert_eq!(after["pending_hooks"], 1);
+    let state = session.state.lock().await;
+    assert_eq!(state.history.retained_context(), &retained);
+    assert_eq!(state.history.annotated_items().len(), 1);
+    assert!(matches!(&state.history.annotated_items()[0].item,
+        ResponseItem::Message { content, .. } if matches!(&content[0],
+            ContentItem::InputText { text } if text == "replacement summary")));
+    let (_, count, originals) = state.sdk_originals.snapshot(None).unwrap();
+    assert_eq!(count, 3);
+    assert!(originals.last().unwrap().contains("raw summary output"));
+    drop(state);
+    let stored = stored_compaction_checkpoints(&store, &session).await;
+    let checkpoint_index = stored
+        .iter()
+        .position(|item| matches!(item, RolloutItem::Compacted(_)))
+        .unwrap();
+    let delivery_index = stored.iter().position(|item| matches!(item,
+        RolloutItem::RetainedContext(codex_history::RetainedContextEvent::DeliveredAssistantMessage { message, .. })
+            if message.message_id.as_deref() == Some("synthetic-delivery"))).unwrap();
+    assert!(checkpoint_index < delivery_index);
+    let checkpoint = stored
