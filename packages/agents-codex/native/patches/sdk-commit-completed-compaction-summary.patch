+    let before = compaction_checkpoint_live_state(&session).await;
+    let compact = start_compaction_checkpoint(session.clone(), turn, cancel.clone());
+    let append = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    let finalization = session
+        .services
+        .thread_extension_data
+        .get::<crate::tasks::TaskFinalization>()
+        .unwrap();
+    assert!(finalization.0.try_lock().is_err());
+    assert_eq!(compaction_checkpoint_live_state(&session).await, before);
+    cancel.cancel();
+    stop.request();
+    append.release.send(Ok(())).unwrap();
+    let flush = timeout(Duration::from_secs(2), fences.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(finalization.0.try_lock().is_err());
+    assert_eq!(compaction_checkpoint_live_state(&session).await, before);
+    assert!(events.try_recv().is_err());
+    // Host-owned retained facts and acceptance-order reservations may arrive while flushing.
+    let (delivery, _) =
+        session.record_delivered_assistant_message(codex_history::RetainedUserMessage {
+            origin: codex_history::UserInputOrigin::User,
+            turn_id: "synthetic-host-turn".into(),
+            message_id: Some("synthetic-delivery".into()),
+            text: "May I run tests?".into(),
+            complete: true,
+            phase: None,
+        });
+    let retained = session
+        .state
+        .lock()
+        .await
+        .history
+        .retained_context()
+        .clone();
+    assert_ne!(serde_json::to_value(&retained).unwrap(), before["retained"]);
+    assert!(
+        !delivery.is_finished(),
+        "delivery persistence must follow the checkpoint"
+    );
+    flush.release.send(Ok(())).unwrap();
+    timeout(Duration::from_secs(2), compact)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    delivery.await.unwrap();
+    assert!(finalization.0.try_lock().is_ok());
+    let after = compaction_checkpoint_live_state(&session).await;
+    assert_eq!(
+        after["window_number"],
+        before["window_number"].as_u64().unwrap() + 1
