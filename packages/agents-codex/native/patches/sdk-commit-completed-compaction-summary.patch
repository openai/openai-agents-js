+// The store holds only Compacted batches, leaving seed records and ordinary flushes alone.
+async fn compaction_checkpoint_session(
+    persisted: bool,
+    configure: impl FnOnce(&mut Config),
+) -> (
+    Arc<Session>,
+    Arc<TurnContext>,
+    async_channel::Receiver<Event>,
+    mpsc::UnboundedReceiver<TerminalFlush>,
+    Arc<TerminalStore>,
+) {
+    let (session, turn, events) = compaction_checkpoint_context(configure).await;
+    let mut session = Arc::try_unwrap(session).ok().expect("unshared session");
+    let (flushes, pending) = mpsc::unbounded_channel();
+    let store = Arc::new(TerminalStore {
+        inner: InMemoryThreadStore::default(),
+        terminal_seen: std::sync::atomic::AtomicBool::new(false),
+        fail_append: false,
+        compaction_checkpoint: true,
+        hold_append: std::sync::atomic::AtomicBool::new(true),
+        flushes,
+    });
+    if persisted {
+        attach_terminal_thread_store(&mut session, store.clone()).await;
+    }
+    let step = StepContext::for_test(turn.clone());
+    session
+        .record_conversation_items(
+            &turn,
+            &step.settings.model_info,
+            &[
+                user_message("original input"),
+                assistant_message("original answer"),
+            ],
+        )
+        .await;
+    session.flush_rollout().await.unwrap();
+    {
+        let mut state = session.state.lock().await;
+        state.set_auto_compact_window_estimated_prefill(123);
+        state.reasoning_effort_pin.pin(
+            "synthetic-model",
+            codex_protocol::openai_models::ReasoningEffort::Medium,
+        );
+    }
+    while events.try_recv().is_ok() {}
+    (Arc::new(session), turn, events, pending, store)
