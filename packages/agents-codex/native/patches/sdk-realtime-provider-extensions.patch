@@ -6,6 +6,31 @@
 use serde_json::Value;

 use crate::protocol::RealtimeOutputModality;
+
+/// Validate explicit provider extensions before they enter a managed wire object.
+pub fn validate_provider_extensions(
+    data: &BTreeMap<String, Value>,
+    managed: &[&str],
+) -> serde_json::Result<()> {
+    if data.len() > 64
+        || data.keys().any(|name| {
+            name.is_empty()
+                || name.len() > 128
+                || name.starts_with("_sdk_")
+                || matches!(
+                    name.as_str(),
+                    "provider_data" | "providerData" | "__proto__" | "constructor" | "prototype"
+                )
+                || managed.contains(&name.as_str())
+        })
+        || serde_json::to_vec(data)?.len() > 64 * 1024
+    {
+        return Err(serde::ser::Error::custom(
+            "Invalid Realtime provider extensions",
+        ));
+    }
+    Ok(())
+}

