     }
 
     pub fn requested(&self) -> bool {
-        self.0.load(Ordering::Acquire)
+        self.requested.load(Ordering::Acquire)
+            || self
+                .graph
+                .as_ref()
+                .is_some_and(|stop| stop.load(Ordering::Acquire))
+    }
+
+    /// Serialize a synchronous context commit with stop reservation.
+    /// The callback must not block, await, or call back into the host.
+    pub fn try_commit<T>(&self, commit: impl FnOnce() -> T) -> Option<T> {
+        let _commit = self
+            .commit
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        (!self.requested()).then(commit)
     }
