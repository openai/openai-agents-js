+    graph: Option<Arc<AtomicBool>>,
+    commit: Arc<std::sync::Mutex<()>>,
+}
 
 impl TurnSamplingStop {
+    /// Create an independent turn stop that also follows this graph stop.
+    pub fn for_turn(&self) -> Self {
+        Self {
+            requested: Arc::default(),
+            graph: Some(Arc::clone(&self.requested)),
+            commit: Arc::clone(&self.commit),
+        }
