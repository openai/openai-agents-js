+pub(super) fn classify_raw_session_tools(
+    configuration: &codex_api::RealtimeAcceptedConfiguration,
+    tools: &mut [RealtimeSessionTool],
+) -> codex_protocol::error::Result<BTreeSet<String>> {
+    let source = configuration
+        .native_source
+        .as_ref()
+        .and_then(|source| source.as_any().downcast_ref::<RealtimeToolSource>());
+    let mut caller_managed = BTreeSet::new();
+    for tool in tools {
+        let RealtimeSessionTool::Function(function) = tool else {
+            continue;
+        };
+        if let Some((source, declaration)) = source.and_then(|source| {
+            source
+                .declarations
+                .iter()
+                .find(|declaration| declaration.spec.name == function.name)
+                .map(|declaration| (source, declaration))
+        }) {
+            // Raw replacements use the same frozen source as typed wire-only updates.
+            let captured = wire_definition(declaration)?;
+            if source.selection_id.is_empty() || !matches_definition(&captured, function) {
+                return Err(CodexErr::InvalidRequest(
+                    "Raw Realtime tool conflicts with a captured native declaration".into(),
+                ));
+            }
+            *function = captured;
+        } else {
+            caller_managed.insert(function.name.clone());
+        }
+    }
+    Ok(caller_managed)
+}
