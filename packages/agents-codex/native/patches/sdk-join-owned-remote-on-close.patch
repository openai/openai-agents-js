+#[tokio::test]
+async fn checked_shutdown_rejects_ack_without_exit_for_returned_remote_process() {
+    tokio::time::pause();
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    session
+        .services
+        .thread_extension_data
+        .insert(crate::ConfirmRemoteProcessTermination);
+    let manager = &session.services.unified_exec_manager;
+    let policy = manager.remote_confirmation_policy(&session.services.local_agent_runtime);
+    let mut process = crate::unified_exec::process_tests::remote_process(
+        codex_exec_server::WriteStatus::Accepted,
+        /*terminate_error*/ None,
+        codex_sandboxing::SandboxType::None,
+    )
+    .await;
+    process.enable_remote_turn_cleanup_for_test(policy.clone());
+    // The fixture records the handle as delivered and never reports an exit.
+    insert_remote_shutdown_process_instance(&session, &turn, Arc::new(process)).await;
+    assert_eq!(
+        manager.terminate_all_processes_checked().await,
+        (true, false)
+    );
+    assert!(policy.failed());
+}
+
+#[tokio::test]
+async fn checked_shutdown_returns_failure_when_remote_never_acknowledges() {
+    tokio::time::pause();
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let manager = &session.services.unified_exec_manager;
+    let policy = manager.remote_confirmation_policy(&session.services.local_agent_runtime);
+    let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let mut process = crate::unified_exec::process_tests::remote_process_with_termination_controls(
+        codex_exec_server::WriteStatus::Accepted,
+        /*terminate_error*/ None,
+        codex_sandboxing::SandboxType::None,
+        Arc::clone(&calls),
+        /*terminate_entered*/ None,
+        /*terminate_release*/ Some(Arc::new(Notify::new())),
+    )
+    .await;
+    process.enable_remote_turn_cleanup_for_test(policy.clone());
+    insert_remote_shutdown_process_instance(&session, &turn, Arc::new(process)).await;
+    let result = tokio::time::timeout(
+        Duration::from_secs(6),
+        manager.terminate_all_processes_checked(),
+    )
+    .await
+    .expect("checked close must finish even if the peer holds the stop reply");
+    assert_eq!(result, (true, false));
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(policy.failed());
 }
 
 #[test]
