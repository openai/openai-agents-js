+        let history = ContextManager::new();
+        let items = vec![
+            item(
+                json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"before"}]}),
+            ),
+            item(json!({"type":"compaction","encrypted_content":"opaque"})),
+            item(
+                json!({"type":"function_call","call_id":"call","name":"historic","arguments":"{}"}),
+            ),
+            item(json!({"type":"function_call_output","call_id":"call","output":"done"})),
+            item(
+                json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"after"}]}),
+            ),
+        ];
+        validate_compaction_window(&history, &items).unwrap();
+        assert!(history.raw_items().next().is_none());
+        assert_eq!(compaction_candidate_indexes(&items), vec![0, 2, 3, 4]);
+    }
+
+    #[test]
+    fn full_window_validation_rejects_incomplete_pairs_without_mutating_the_source() {
+        let history = ContextManager::new();
+        for value in [
+            json!({"type":"function_call","call_id":"call","name":"historic","arguments":"{}"}),
+            json!({"type":"function_call_output","call_id":"call","output":"done"}),
+        ] {
+            assert!(validate_compaction_window(&history, &[item(value)]).is_err());
+            assert!(history.raw_items().next().is_none());
+        }
+    }
+}
