+//! Narrow SDK-owned helpers for the private plain-run owner.
+
+use codex_extension_api::{ModelToolAdmission, TurnSamplingStop};
+use codex_protocol::model_request_controls::ModelRequestControls;
+use codex_protocol::models::{BaseInstructions, ResponseItem};
+pub use codex_rollout_trace::InferenceTraceContext;
+use std::sync::Arc;
+use tokio::sync::oneshot;
+use tokio::task::JoinHandle;
+
+pub fn prompt(
+    input: Vec<ResponseItem>,
+    base_instructions: BaseInstructions,
+    request_controls: ModelRequestControls,
+    sampling_stop: Arc<TurnSamplingStop>,
+    admission: Arc<dyn ModelToolAdmission>,
+) -> crate::Prompt {
+    crate::Prompt {
+        input,
+        base_instructions,
+        request_controls,
+        sampling_stop: Some(sampling_stop),
+        tool_admission: Some(admission),
+        parallel_tool_calls: true,
+        ..Default::default()
+    }
+}
+
+pub fn metadata(
+    installation_id: String,
+    session_id: String,
+    thread_id: String,
+    turn_id: String,
+    window_id: String,
+) -> crate::CodexResponsesMetadata {
+    let mut metadata =
+        crate::CodexResponsesMetadata::new(installation_id, session_id, thread_id, window_id);
+    metadata.turn_id = Some(turn_id.clone());
+    metadata.root_turn_id = Some(turn_id);
+    metadata.request_kind = Some(crate::responses_metadata::CodexResponsesRequestKind::Turn);
+    metadata
+}
+
+/// Taking handles preserves ResponseStream's consumer-dropped cancellation.
+/// Signal this attempt's producer stop, drop its stream, and join both handles.
+/// Keep the separate run-wide sampling stop open only when retrying.
+pub fn take_tasks(
+    stream: &mut crate::ResponseStream,
+) -> (
+    Option<JoinHandle<()>>,
+    Option<JoinHandle<()>>,
+    Option<oneshot::Sender<()>>,
+) {
+    (
+        stream.mapper_task.take(),
+        stream.producer_task.take(),
+        stream.producer_stop.take(),
+    )
+}
+
+/// Reuse the same model-specific guidance as the ordinary sampling retry owner.
+pub fn content_filter_guidance(model: &codex_protocol::openai_models::ModelInfo) -> ResponseItem {
+    crate::context::ContextualUserFragment::into(crate::context::ContentFilterGuidance {
+        text: codex_prompts::ResolvedModelMessages::from_model(model)
+            .content_filter_guidance()
+            .to_string(),
+    })
+}
