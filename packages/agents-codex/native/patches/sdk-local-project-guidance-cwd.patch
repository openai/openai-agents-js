index 0000000000000000000000000000000000000000..1ebfbce4d306668d222256b4a3ed910cd2c00206
--- /dev/null
+++ b/codex-rs/core/src/project_read_path.rs
@@ -0,0 +1,54 @@
+use codex_utils_path_uri::PathUri;
+use codex_utils_path_uri::PathUriParseError;
+
+/// Thread-local mapping from a declared cwd to its admitted filesystem path.
+pub struct ProjectReadPathMapping {
+    environment_id: String,
+    declared_cwd: PathUri,
+    canonical_cwd: PathUri,
+}
+
+impl ProjectReadPathMapping {
+    pub fn new(environment_id: String, declared_cwd: PathUri, canonical_cwd: PathUri) -> Self {
+        Self {
+            environment_id,
+            declared_cwd,
+            canonical_cwd,
+        }
+    }
+
+    pub fn resolve(
+        mapping: Option<&Self>,
+        environment_id: &str,
+        cwd: &PathUri,
+        path: &str,
+    ) -> Result<ProjectReadPath, PathUriParseError> {
+        let logical = cwd.join(path)?;
+        let rebased = if let Some(mapping) = mapping
+            && mapping.environment_id == environment_id
+            && &mapping.declared_cwd == cwd
+            && let Some(relative) = logical.relative_path_from(&mapping.declared_cwd)
+        {
+            Some(mapping.canonical_cwd.join(&relative)?)
+        } else {
+            None
+        };
+        Ok(ProjectReadPath { logical, rebased })
+    }
+}
+
+pub struct ProjectReadPath {
+    // The tool reports the declared spelling even when its sandbox reads the pinned path.
+    pub(crate) logical: PathUri,
+    rebased: Option<PathUri>,
+}
+
+impl ProjectReadPath {
+    pub(crate) fn read_path(&self) -> &PathUri {
+        self.rebased.as_ref().unwrap_or(&self.logical)
+    }
+
+    pub fn into_read_path(self) -> PathUri {
+        self.rebased.unwrap_or(self.logical)
+    }
+}
