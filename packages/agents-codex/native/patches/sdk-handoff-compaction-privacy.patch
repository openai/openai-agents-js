+    pub(crate) async fn project_handoff_compaction_input(
+        &self,
+        input: Vec<ResponseItem>,
+    ) -> CodexResult<(Vec<ResponseItem>, bool)> {
+        let Some(captured) = self.captured_agent_profile().await? else {
+            return Ok((input, false));
+        };
+        let Some(presentation) = captured
+            .profile
+            .data
+            .get::<codex_protocol::agent_profile::AgentProfileHandoffPresentation>()
+            .filter(|_| handoff_presentation_is_live(&captured.profile))
+        else {
+            return Ok((input, false));
+        };
+        let original = crate::client_common::Prompt {
+            input,
+            ..Default::default()
+        };
+        let projected = crate::prepared_request::apply_handoff_presentation(
+            &original,
+            &presentation,
+            &presentation.destination,
+            &handoff_presentation_anchor(&captured.profile),
+        )
+        .map_err(invalid)?;
+        let changed = !original
+            .input
+            .iter()
+            .filter(|item| {
+                !matches!(item,
+            ResponseItem::Message { role, .. } if role != "user" && role != "assistant")
+            })
+            .eq(projected.input.iter().filter(|item| {
+                !matches!(item,
+                ResponseItem::Message { role, .. } if role != "user" && role != "assistant")
+            }));
+        Ok((projected.input, changed))
+    }
+
+    pub(crate) async fn validate_native_compaction_view(&self) -> CodexResult<()> {
+        let input = self.clone_history().await.raw_items().cloned().collect();
+        let (_, filtered) = self.project_handoff_compaction_input(input).await?;
+        if filtered {
+            return Err(invalid(
+                "Native compaction cannot combine with a filtered handoff presentation",
+            ));
+        }
+        Ok(())
+    }
