+
+/// Explicit Responses search options, separate from Core's own search executor.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct ProviderToolSearch {
+    #[serde(flatten)]
+    pub provider_data: serde_json::Map<String, serde_json::Value>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub execution: Option<ProviderToolSearchExecution>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub description: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub parameters: Option<serde_json::Value>,
+}
+
+impl ProviderToolSearch {
+    pub fn searches_on_provider(&self) -> bool {
+        self.execution != Some(ProviderToolSearchExecution::Client)
+    }
+}
