+#[test]
+fn matching_trusted_extension_cannot_be_replaced_as_builtin_workspace_patch() {
+    let mut registry = ToolRegistry::default();
+    let other: Arc<dyn CoreToolRuntime> = Arc::new(OtherTrustedPatchHandler);
+    registry.register_trusted(Arc::clone(&other));
+    assert!(!registry.register_external(Arc::new(crate::tools::handlers::application_apply_patch::ApplicationApplyPatchHandler::new())));
+    let retained = registry.tools.get(&ToolName::plain("apply_patch").with_default_namespace()).unwrap();
+    assert!(Arc::ptr_eq(&retained.runtime, &other));
+    assert!(registry.first_collision().is_some());
+}
