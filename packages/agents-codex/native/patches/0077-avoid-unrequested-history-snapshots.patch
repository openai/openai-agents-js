+    #[tokio::test]
+    async fn history_materialization_metadata_only_reads_and_updates_omit_history() {
+        let store = InMemoryThreadStore::default();
+        let thread_id = ThreadId::default();
+        store
+            .create_thread(create_thread_params(thread_id, ThreadHistoryMode::Legacy))
+            .await
+            .unwrap();
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id,
+                items: vec![history_materialization_item("stored")],
+            })
+            .await
+            .unwrap();
+        let read = store
+            .read_thread(ReadThreadParams {
+                thread_id,
+                include_archived: false,
+                include_history: false,
+            })
+            .await
+            .unwrap();
+        assert_eq!(read.thread_id, thread_id);
+        assert!(read.history.is_none());
+        let updated = ThreadStore::update_thread_metadata(
+            &store,
+            UpdateThreadMetadataParams {
+                thread_id,
+                patch: ThreadMetadataPatch {
+                    name: Some(Some("updated".to_string())),
+                    ..Default::default()
+                },
+                include_archived: false,
+            },
+        )
+        .await
+        .unwrap()
+        .expect("in-memory update returns the thread");
+        assert_eq!(updated.name.as_deref(), Some("updated"));
+        assert!(updated.history.is_none());
+        let history = store
+            .load_history(LoadThreadHistoryParams {
+                thread_id,
+                include_archived: false,
+            })
+            .await
+            .unwrap();
+        assert_eq!(history.items.len(), 2);
+        assert_eq!(
+            serde_json::to_value(&history.items[1]).unwrap(),
+            serde_json::to_value(history_materialization_item("stored")).unwrap()
+        );
+    }
