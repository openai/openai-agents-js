+    #[tokio::test]
+    async fn history_materialization_absent_history_stays_empty_and_missing_thread_errors() {
+        let store = InMemoryThreadStore::default();
+        let thread_id = ThreadId::default();
+        store
+            .create_thread(create_thread_params(thread_id, ThreadHistoryMode::Legacy))
+            .await
+            .unwrap();
+        // Existing threads may have no stored history. Keep this explicit fixture distinct
+        // from a missing thread, which must still fail before history construction.
+        store.state.lock().await.histories.remove(&thread_id);
+        for include_history in [false, true] {
+            let read = store
+                .read_thread(ReadThreadParams {
+                    thread_id,
+                    include_archived: false,
+                    include_history,
+                })
+                .await
+                .unwrap();
+            if include_history {
+                let history = read.history.expect("requested empty history");
+                assert_eq!(history.thread_id, thread_id);
+                assert_eq!(history.revision, None);
+                assert!(history.items.is_empty());
+            } else {
+                assert!(read.history.is_none());
+            }
+        }
+        store.state.lock().await.created_threads.remove(&thread_id);
+        for include_history in [false, true] {
+            let error = store
+                .read_thread(ReadThreadParams {
+                    thread_id,
+                    include_archived: false,
+                    include_history,
+                })
+                .await
+                .unwrap_err();
+            assert!(
+                matches!(error, ThreadStoreError::ThreadNotFound { thread_id: missing } if missing == thread_id)
+            );
+        }
+    }
