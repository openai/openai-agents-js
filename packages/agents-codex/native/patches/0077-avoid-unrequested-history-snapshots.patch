+    #[tokio::test]
+    async fn history_materialization_full_read_is_an_ordered_detached_snapshot() {
+        let store = InMemoryThreadStore::default();
+        let thread_id = ThreadId::default();
+        store
+            .create_thread(create_thread_params(thread_id, ThreadHistoryMode::Legacy))
+            .await
+            .unwrap();
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id,
+                items: vec![history_materialization_item("first")],
+            })
+            .await
+            .unwrap();
+        let mut snapshot = store
+            .read_thread(ReadThreadParams {
+                thread_id,
+                include_archived: false,
+                include_history: true,
+            })
+            .await
+            .unwrap()
+            .history
+            .unwrap();
+        assert_eq!(snapshot.thread_id, thread_id);
+        assert_eq!(snapshot.revision, None);
+        assert_eq!(snapshot.items.len(), 2);
+        assert!(
+            matches!(&snapshot.items[0], RolloutItem::SessionMeta(meta) if meta.meta.id == thread_id)
+        );
+        assert_eq!(
+            serde_json::to_value(&snapshot.items[1]).unwrap(),
+            serde_json::to_value(history_materialization_item("first")).unwrap()
+        );
+        let original = serde_json::to_value(&snapshot.items).unwrap();
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id,
+                items: vec![history_materialization_item("second")],
+            })
+            .await
+            .unwrap();
+        assert_eq!(serde_json::to_value(&snapshot.items).unwrap(), original);
+
+        let RolloutItem::ResponseItem(envelope) = &mut snapshot.items[1] else {
+            panic!("expected response item")
+        };
+        let codex_protocol::models::ResponseItem::Message { content, .. } = &mut envelope.item
+        else {
+            panic!("expected message")
+        };
+        let codex_protocol::models::ContentItem::InputText { text } = &mut content[0] else {
+            panic!("expected input text")
+        };
+        text.push_str("-snapshot-only");
+        snapshot
+            .items
+            .push(history_materialization_item("snapshot-only"));
+        let current = store
+            .read_thread(ReadThreadParams {
+                thread_id,
+                include_archived: false,
+                include_history: true,
+            })
+            .await
+            .unwrap()
+            .history
+            .unwrap();
+        let mut expected = original.as_array().unwrap().clone();
+        expected.push(serde_json::to_value(history_materialization_item("second")).unwrap());
+        assert_eq!(
+            serde_json::to_value(&current.items).unwrap(),
+            serde_json::Value::Array(expected)
+        );
+    }
