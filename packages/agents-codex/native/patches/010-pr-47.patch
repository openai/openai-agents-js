+            .with_sampler(ScopeSampler {
+                inner: Box::new(Sampler::AlwaysOn),
+            })
+            .with_simple_exporter(InMemorySpanExporter::default())
+            .build();
+        global::set_tracer_provider(provider.clone());
+        for enabled in [true, false] {
+            configure_pipeline(enabled);
+            for disabled in [false, true] {
+                for span_first in [true, false] {
+                    let root: Value = serde_json::from_str(
+                        &start_trace_span(
+                            &json!({
+                                "name": "workflow", "kind": "workflow", "disabled": disabled,
+                                "include_sensitive_data": false,
+                            })
+                            .to_string(),
+                        )
+                        .unwrap(),
+                    )
+                    .unwrap();
+                    let root_key = root["handle"].as_str().unwrap();
+                    let parent = context(root_key).unwrap();
+                    let policy = policy_for_context(&parent).unwrap();
+                    let native = build_span(
+                        "native-lease-fixture",
+                        opentelemetry::trace::SpanBuilder::from_name("intermediate"),
+                        &parent,
+                    );
+                    assert_eq!(native.is_recording(), enabled && !disabled);
+                    let identity = native.span_context().clone();
+                    assert!(identity.is_valid());
+                    // Lifecycle capture reparses the native span's identity; this Context
+                    // deliberately owns no ScopedSpan, only its remote carrier and policy.
+                    let capture = Context::new()
+                        .with_remote_span_context(identity.clone())
+                        .with_value(policy.clone());
+                    let active = capture.attach();
+                    let first = ContextLease::capture().unwrap();
+                    let second = ContextLease::capture().unwrap();
+                    let alias = retain_trace_context(first.token()).unwrap();
+                    let carrier = trace_carrier(first.token()).unwrap();
+                    drop(active);
+                    let assert_policy = || {
+                        let restored = crate::context_from_w3c_trace_context(&carrier).unwrap();
+                        let restored = policy_for_context(&restored)
+                            .expect("live lease must retain intermediate identity policy");
+                        assert!(Arc::ptr_eq(&restored, &policy));
+                        assert_eq!(restored.disabled, disabled);
+                        assert!(!restored.include_sensitive_data);
+                    };
+                    let mut native = Some(native);
+                    if span_first {
+                        drop(native.take());
+                    }
+                    assert_policy();
+                    drop(first);
+                    assert_policy();
+                    release_trace_context(&alias);
+                    assert_policy();
+                    drop(second);
+                    assert_eq!(policy_for_span(&identity).is_some(), !span_first);
+                    drop(native);
+                    assert!(
