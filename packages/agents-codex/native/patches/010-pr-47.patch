+#[cfg(test)]
+mod tracing_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn question_tracing_keeps_original_turn_policy_after_origin_ends() {
+        const CHILD: &str = "CODEX_OWNED_QUESTION_TRACE_TEST";
+        if std::env::var_os(CHILD).is_none() {
+            let status = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "owned_question::tracing_tests::question_tracing_keeps_original_turn_policy_after_origin_ends"])
+                .env(CHILD, "1").status().unwrap();
+            assert!(status.success());
+            return;
+        }
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        codex_otel::sdk_trace::configure_pipeline(false);
+        let origin: serde_json::Value = serde_json::from_str(&codex_otel::sdk_trace::start_trace_span(
+            r#"{"name":"question origin","kind":"workflow","trace_id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","disabled":true,"include_sensitive_data":false}"#,
+        ).unwrap()).unwrap();
+        let handle = origin["handle"].as_str().unwrap();
+        let attached = codex_otel::sdk_trace::context(handle).unwrap().attach();
+        turn.extension_data
+            .insert(codex_otel::sdk_trace::CapturedContext::capture());
+        drop(attached);
+        let question = OwnedQuestion {
+            session: Arc::new(session),
+            turn: Arc::new(turn),
+            state: Arc::new(Mutex::new(TurnState::default())),
+            key: QuestionKey::Approval("fixture".into()),
+            identity: None,
+            url_receipt: None,
+        };
+        codex_otel::sdk_trace::end_trace_span(handle, r#"{"status":"ok"}"#).unwrap();
+        codex_otel::sdk_trace::release_trace_span(handle);
+        let retained = question.tracing_context().unwrap();
+        let token = retained.token().to_owned();
+        let context: serde_json::Value =
+            serde_json::from_str(&codex_otel::sdk_trace::trace_span_context(&token).unwrap())
+                .unwrap();
+        assert_eq!(context["trace_id"], "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
+        assert_eq!(context["disabled"], true);
+        assert_eq!(context["include_sensitive_data"], false);
+        drop(question);
+        assert!(codex_otel::sdk_trace::context(&token).is_ok());
+        drop(retained);
+        assert!(codex_otel::sdk_trace::context(&token).is_err());
+    }
+}
