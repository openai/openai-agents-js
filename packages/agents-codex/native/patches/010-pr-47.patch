+fn event(
+    s: &mut Routes,
+    span: &SpanData,
+    lifecycle: &str,
+    root_descriptor: Option<Value>,
+    credential: Option<Arc<HostTraceCredential>>,
+) {
+    s.sequence += 1;
+    let sequence = s.sequence;
+    if s.processors.is_empty() {
+        return;
+    }
+    let credential_required = credential.is_some();
+    // A timed-out provider shutdown may still receive a previously opened span end.
+    let credential = credential.filter(|_| !s.credentials_closed);
+    // Native fields are copied into an immutable, bounded JSON snapshot. Never copy policy.
+    let attrs = attributes(span);
+    let mut value = json!({"sequence":sequence,"processor_ids":s.processors,"lifecycle":lifecycle,"trace_id":span.span_context.trace_id().to_string(),"span_id":span.span_context.span_id().to_string(),"parent_span_id":if span.parent_span_id==opentelemetry::trace::SpanId::INVALID {None}else{Some(span.parent_span_id.to_string())},"name":truncate(&span.name,4096),"kind":format!("{:?}",span.span_kind).to_ascii_lowercase(),"start_time_unix_nanos":span.start_time.duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos().to_string(),"end_time_unix_nanos":if lifecycle=="end" {Some(span.end_time.duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos().to_string())}else{None},"attributes":attrs,"dropped_attributes_count":span.dropped_attributes_count,"outcome":match span.status { opentelemetry::trace::Status::Error{..}=>"error",opentelemetry::trace::Status::Ok=>"ok",_=>"unset" }});
+    if credential_required {
+        value["credential_required"] = json!(true);
+    }
+    if serde_json::to_vec(&value).map_or(MAX_BYTES + 1, |v| v.len()) > 65536 {
+        dropped(s, sequence);
+        return;
+    }
+    if let Some(descriptor) = root_descriptor {
+        if serde_json::to_vec(&descriptor).map_or(MAX_BYTES + 1, |v| v.len()) > 65536 {
+            dropped(s, sequence);
+            return;
+        }
+        value["__root_descriptor"] = descriptor;
+    }
+    let Ok(encoded) = serde_json::to_vec(&value) else {
+        dropped(s, sequence);
+        return;
+    };
+    let bytes = encoded.len();
+    if s.pending.len() >= s.delivery.max_queue_size as usize
+        || bytes > (s.delivery.max_queue_bytes as usize).saturating_sub(s.bytes)
+    {
+        dropped(s, sequence);
+        return;
+    }
+    if s.queue.is_empty() {
+        s.queued_since = Some(Instant::now());
+    }
+    s.bytes += bytes;
+    s.pending.insert(sequence);
+    s.queue.push_back((sequence, value, bytes, credential));
+}
+fn truncate(s: &str, max: usize) -> String {
+    let mut end = s.len().min(max);
+    while !s.is_char_boundary(end) {
+        end -= 1;
+    }
+    s[..end].to_owned()
+}
+pub fn drain_trace_events(max_count: usize) -> Result<String, String> {
+    let mut s = lock();
+    let mut events = Vec::new();
+    let mut root_descriptors = BTreeMap::new();
+    let mut credential_routes = BTreeMap::new();
+    let cutoff = s
+        .flush_snapshot
+        .map(|(barrier, _, _)| barrier)
+        .filter(|barrier| s.pending.range(..=*barrier).next().is_some());
+    let trigger =
+        ((s.delivery.max_queue_size as f64 * s.delivery.export_trigger_ratio) as usize).max(1);
+    let ready = cutoff.is_some()
+        || s.delivery.schedule_delay_ms == 0
+        || s.queue.len() >= trigger
+        || s.queued_since.is_some_and(|since| {
+            since.elapsed() >= Duration::from_millis(s.delivery.schedule_delay_ms as u64)
+        });
+    s.draining |= ready;
+    let count = if s.draining {
+        max_count.min(s.delivery.max_batch_size as usize)
+    } else {
+        0
+    };
+    for _ in 0..count {
+        if s.queue
+            .front()
+            .is_some_and(|(seq, _, _, _)| cutoff.is_some_and(|cutoff| *seq > cutoff))
+        {
+            break;
+        }
+        let Some((seq, mut value, bytes, credential)) = s.queue.pop_front() else {
+            break;
+        };
+        s.bytes -= bytes;
+        s.delivered = seq;
+        if let Some(descriptor) = value
+            .as_object_mut()
+            .and_then(|event| event.remove("__root_descriptor"))
+        {
+            root_descriptors.insert(seq.to_string(), descriptor);
+        }
+        if let Some(host) = credential {
+            credential_routes.insert(
+                seq.to_string(),
+                json!({
+                    "identity": host.credential.identity,
+                    "headers": host.credential.overlay(&HashMap::new()),
+                    "processor_ids": host.processor_ids,
+                }),
+            );
+        }
+        events.push(value);
+    }
+    if s.queue.is_empty() {
+        s.queued_since = None;
+        s.draining = false;
+    }
+    let through = cutoff.unwrap_or(s.sequence);
+    if s.queue.front().is_none_or(|(seq, _, _, _)| *seq > through) {
+        s.delivered = s.delivered.max(through);
+    }
+    serde_json::to_string(&json!({"events":events,"root_descriptors":root_descriptors,"credential_routes":credential_routes,"dropped_records":s.dropped,"failed_deliveries":s.failed,"through_sequence":s.delivered})).map_err(|_| "trace event serialization failed".into())
+}
+pub fn ack_trace_events(sequence: u64, failed: u64) -> Result<(), String> {
+    let mut s = lock();
+    if sequence > s.delivered || sequence < s.acknowledged {
+        return Err("invalid trace event acknowledgment".into());
+    }
+    if sequence > s.acknowledged {
+        s.failed = s.failed.saturating_add(failed);
+        if let Some((barrier, _, captured_failed)) = &mut s.flush_snapshot {
+            if sequence <= *barrier {
+                *captured_failed = captured_failed.saturating_add(failed);
+            }
+        }
+        s.acknowledged = sequence;
+        s.pending.retain(|pending| *pending > sequence);
+    }
+    Ok(())
+}
+pub(crate) fn current_barrier() -> u64 {
+    lock().sequence
