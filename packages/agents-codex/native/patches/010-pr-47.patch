+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn timed_out_log_flush_observes_early_terminal_deadline() {
+    use opentelemetry::InstrumentationScope;
+    use opentelemetry::logs::{Logger as _, LoggerProvider as _};
+    use opentelemetry_sdk::logs::{
+        BatchConfigBuilder, BatchLogProcessor, LogBatch, LogExporter, LogProcessor, SdkLogRecord,
+        SdkLoggerProvider,
+    };
+    const CHILD: &str = "CODEX_LOG_FLUSH_DEADLINE_TEST";
+    if std::env::var_os(CHILD).is_none() {
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "provider::shutdown_tests::timed_out_log_flush_observes_early_terminal_deadline",
+            ])
+            .env(CHILD, "1")
+            .status()
+            .unwrap();
+        assert!(status.success());
+        return;
+    }
+    #[derive(Debug)]
+    struct PendingExporter {
+        calls: Arc<AtomicUsize>,
+        dropped_futures: Arc<AtomicUsize>,
+        block: Arc<AtomicBool>,
+        credentials: Arc<()>,
+    }
+    impl LogExporter for PendingExporter {
+        async fn export(&self, _: LogBatch<'_>) -> OTelSdkResult {
+            struct Active(Arc<AtomicUsize>, Arc<()>);
+            impl Drop for Active {
+                fn drop(&mut self) {
+                    self.0.fetch_add(1, Ordering::SeqCst);
+                }
+            }
+            let _active = Active(self.dropped_futures.clone(), self.credentials.clone());
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            if self.block.load(Ordering::SeqCst) {
+                std::future::pending::<()>().await;
+            }
+            Ok(())
+        }
+    }
+    #[derive(Debug)]
+    struct TrackedProcessor {
+        inner: BatchLogProcessor,
+        completed: Arc<AtomicUsize>,
+    }
+    impl LogProcessor for TrackedProcessor {
+        fn emit(&self, record: &mut SdkLogRecord, scope: &InstrumentationScope) {
+            self.inner.emit(record, scope);
+        }
+        fn force_flush(&self) -> OTelSdkResult {
+            let result = self.inner.force_flush();
+            self.completed.fetch_add(1, Ordering::SeqCst);
+            result
+        }
+        fn shutdown_with_timeout(&self, timeout: Duration) -> OTelSdkResult {
+            self.inner.shutdown_with_timeout(timeout)
+        }
+        fn set_resource(&mut self, resource: &opentelemetry_sdk::Resource) {
+            self.inner.set_resource(resource);
+        }
+    }
+    let calls = Arc::new(AtomicUsize::new(0));
+    let dropped_futures = Arc::new(AtomicUsize::new(0));
+    let completed = Arc::new(AtomicUsize::new(0));
+    let block = Arc::new(AtomicBool::new(false));
+    let credentials = Arc::new(());
+    let weak_credentials = Arc::downgrade(&credentials);
+    let terminal = super::LogShutdown::new();
+    let processor = BatchLogProcessor::builder(super::DeadlineLogExporter::new(
+        PendingExporter {
+            calls: calls.clone(),
+            dropped_futures: dropped_futures.clone(),
+            block: block.clone(),
+            credentials,
+        },
+        terminal.clone(),
+    ))
+    .with_batch_config(
+        BatchConfigBuilder::default()
+            .with_max_export_batch_size(1)
+            .with_scheduled_delay(Duration::from_secs(60))
+            .build(),
+    )
+    .build();
+    let logger_provider = SdkLoggerProvider::builder()
+        .with_log_processor(TrackedProcessor {
+            inner: processor,
+            completed: completed.clone(),
+        })
+        .build();
+    let logger = logger_provider.logger("deadline-test");
+    let mut provider = OtelProvider {
+        logger: Some(logger_provider),
+        tracer_provider: None,
+        tracer: None,
+        metrics: None,
+        trace_shutdown: None,
+        log_shutdown: Some(terminal.clone()),
+        shutdown_started: AtomicBool::new(false),
+        shutdown_worker: None,
+    };
+    provider.prepare_shutdown_worker().unwrap();
+    crate::sdk_trace_routes::configure_log_shutdown(Some(&terminal));
+    let state = tokio::sync::Mutex::new(provider);
+    let owner = state.lock().await;
+    // Successful nonterminal flushes leave this same provider usable.
+    for expected in 1..=2 {
+        logger.emit(logger.create_log_record());
+        assert_eq!(
+            owner
+                .force_flush_with_timeout(Duration::from_secs(1))
+                .await
+                .status,
+            "success"
+        );
+        assert_eq!(calls.load(Ordering::SeqCst), expected);
+    }
+    block.store(true, Ordering::SeqCst);
+    logger.emit(logger.create_log_record());
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while calls.load(Ordering::SeqCst) != 3 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    logger.emit(logger.create_log_record());
+    logger.emit(logger.create_log_record());
+    assert_eq!(
+        owner
+            .force_flush_with_timeout(Duration::from_millis(15))
+            .await
+            .status,
+        "timeout"
+    );
+    assert_eq!(completed.load(Ordering::SeqCst), 2);
+    assert!(weak_credentials.upgrade().is_some());
+    assert!(state.try_lock().is_err());
+    // This is the binding's early publication path, before it can acquire STATE.
+    let early = std::time::Instant::now() + Duration::from_millis(20);
+    crate::sdk_trace_routes::begin_shutdown(early + Duration::from_secs(1));
+    crate::sdk_trace_routes::begin_shutdown(early);
+    terminal.begin(early + Duration::from_secs(2));
+    tokio::time::timeout(Duration::from_millis(300), async {
+        while completed.load(Ordering::SeqCst) != 3 || weak_credentials.upgrade().is_some() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert_eq!(*terminal.deadline.borrow(), Some(early));
+    assert_eq!(
+        calls.load(Ordering::SeqCst),
+        3,
+        "queued log exports must never enter the exporter"
+    );
+    assert_eq!(dropped_futures.load(Ordering::SeqCst), 3);
+    drop(owner);
+    state
+        .into_inner()
+        .shutdown_with_timeout(Duration::from_secs(1))
+        .await
+        .unwrap();
+}
