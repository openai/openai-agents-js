+fn retained_root_descriptor(
+    span: &SpanData,
+    lifecycle: &str,
+    policy: Option<&crate::sdk_trace::ScopePolicy>,
+    start_sequence: u64,
+) -> Option<Value> {
+    let owner = &policy?.root_descriptor;
+    if span.parent_span_id == opentelemetry::trace::SpanId::INVALID {
+        owner.snapshot.get_or_init(|| {
+            let mut attrs = attributes(span);
+            attrs.retain(|key, _| key.starts_with("sdk.metadata.") || key == "sdk.group_id");
+            json!({"name":truncate(&span.name,4096),"attributes":attrs,"start_sequence":start_sequence})
+        });
+        if lifecycle == "end" {
+            owner
+                .ended
+                .store(true, std::sync::atomic::Ordering::Release);
+        }
+        return None;
+    }
+    if !owner.ended.load(std::sync::atomic::Ordering::Acquire) {
+        return None;
+    }
+    owner.snapshot.get().cloned()
