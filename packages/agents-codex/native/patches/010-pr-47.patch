+#[derive(Debug)]
+pub(crate) struct LogShutdown {
+    deadline: tokio::sync::watch::Sender<Option<std::time::Instant>>,
+    runtime: Mutex<Option<tokio::runtime::Handle>>,
+}
+impl LogShutdown {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            deadline: tokio::sync::watch::channel(None).0,
+            runtime: Mutex::new(tokio::runtime::Handle::try_current().ok()),
+        })
+    }
+    pub(crate) fn begin(&self, deadline: std::time::Instant) {
+        // Async terminal callers also support providers constructed outside a runtime.
+        let mut runtime = self.runtime.lock().unwrap_or_else(|e| e.into_inner());
+        if runtime.is_none() {
+            *runtime = tokio::runtime::Handle::try_current().ok();
+        }
+        drop(runtime);
+        self.deadline.send_if_modified(|current| {
+            if current.is_none_or(|previous| deadline < previous) {
+                *current = Some(deadline);
+                true
+            } else {
+                false
+            }
+        });
+    }
+    fn expired(&self) -> bool {
+        self.deadline
+            .borrow()
+            .is_some_and(|deadline| deadline <= std::time::Instant::now())
+    }
+    async fn cancelled(&self) {
+        let mut changes = self.deadline.subscribe();
+        loop {
+            let deadline = *changes.borrow_and_update();
+            if let Some(deadline) = deadline {
+                if deadline <= std::time::Instant::now() {
+                    return;
+                }
+                let runtime = self
+                    .runtime
+                    .lock()
+                    .unwrap_or_else(|e| e.into_inner())
+                    .clone();
+                if let Some(runtime) = runtime {
+                    // SDK BatchLogProcessor polls on a plain OS thread. Construct
+                    // the timer on the captured runtime, then poll it without an EnterGuard.
+                    let sleep = {
+                        let _entered = runtime.enter();
+                        tokio::time::sleep_until(deadline.into())
+                    };
+                    tokio::select! {
+                        biased;
+                        _ = sleep => return,
+                        _ = changes.changed() => {}
+                    }
+                    continue;
+                }
+                // Synchronous legacy callers without a runtime retain their
+                // existing transport timeout. SDK bounded shutdown always has one.
+            }
+            let _ = changes.changed().await;
+        }
+    }
