+use opentelemetry_sdk::trace::ShouldSample;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+#[derive(Debug)]
+pub struct ScopePolicy {
+    pub disabled: bool,
+    pub include_sensitive_data: bool,
+    pub(crate) credential: Option<crate::sdk_trace_routes::TraceCredentialLease>,
+    pub(crate) root_descriptor: Arc<RootDescriptor>,
+    pub workflow_span_id: Option<SpanId>,
+    // The SDK uses this process-local key only to select JavaScript storage.
+    callback_storage_key: Option<CallbackStorageKey>,
+    callback_release: Option<CallbackRelease>,
+}
+
+impl ScopePolicy {
+    fn without_callback_release(&self) -> Self {
+        Self {
+            disabled: self.disabled,
+            include_sensitive_data: self.include_sensitive_data,
+            credential: self.credential.clone(),
+            root_descriptor: self.root_descriptor.clone(),
+            workflow_span_id: self.workflow_span_id,
+            callback_storage_key: self.callback_storage_key.clone(),
+            callback_release: None,
+        }
+    }
+}
+
+struct CallbackRelease(Option<Box<dyn FnOnce() + Send + Sync>>);
+
+impl std::fmt::Debug for CallbackRelease {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("CallbackRelease")
+    }
+}
+
+impl Drop for CallbackRelease {
+    fn drop(&mut self) {
+        if let Some(release) = self.0.take() {
+            release();
+        }
+    }
+}
+
+#[derive(Clone)]
+struct CallbackStorageKey(String);
+
+impl std::fmt::Debug for CallbackStorageKey {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("CallbackStorageKey")
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct RootDescriptor {
+    pub snapshot: OnceLock<Value>,
+    pub metadata: OnceLock<String>,
+    pub ended: AtomicBool,
+}
+impl std::fmt::Debug for RootDescriptor {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("RootDescriptor")
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct ScopeSampler {
+    inner: Box<dyn ShouldSample>,
+}
+impl Default for ScopeSampler {
+    fn default() -> Self {
+        Self {
+            inner: opentelemetry_sdk::trace::Config::default().sampler,
+        }
+    }
+}
+impl ShouldSample for ScopeSampler {
+    fn should_sample(
+        &self,
+        parent: Option<&Context>,
+        trace_id: TraceId,
+        name: &str,
+        kind: &SpanKind,
+        attributes: &[KeyValue],
+        links: &[opentelemetry::trace::Link],
+    ) -> SamplingResult {
+        if parent
+            .and_then(policy_for_context)
+            .is_some_and(|p| p.disabled)
+        {
+            SamplingResult {
+                decision: SamplingDecision::Drop,
+                attributes: Vec::new(),
+                trace_state: Default::default(),
+            }
+        } else {
+            self.inner
+                .should_sample(parent, trace_id, name, kind, attributes, links)
+        }
+    }
+}
+
+type Identity = (TraceId, SpanId);
+struct PolicyRegistration {
+    identity: Identity,
+    policy: Arc<ScopePolicy>,
+}
+impl Drop for PolicyRegistration {
+    fn drop(&mut self) {
+        let mut entries = policies().lock().unwrap_or_else(|e| e.into_inner());
+        if entries
+            .get(&self.identity)
+            .is_some_and(|entry| std::ptr::eq(entry.as_ptr(), self))
+        {
+            entries.remove(&self.identity);
+        }
+    }
+}
+fn policies() -> &'static Mutex<HashMap<Identity, Weak<PolicyRegistration>>> {
+    static POLICIES: OnceLock<Mutex<HashMap<Identity, Weak<PolicyRegistration>>>> = OnceLock::new();
+    POLICIES.get_or_init(Default::default)
+}
+fn policy_registration(span: &SpanContext) -> Option<Arc<PolicyRegistration>> {
+    // Release the registry lock before upgrading: dropping the final upgraded
+    // owner removes its entry and must never run while this lock is held.
+    let registration = policies()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(&(span.trace_id(), span.span_id()))
+        .cloned();
+    registration.and_then(|registration| registration.upgrade())
+}
+fn retain_policy(span: &SpanContext, policy: Arc<ScopePolicy>) -> Arc<PolicyRegistration> {
+    let identity = (span.trace_id(), span.span_id());
+    let mut entries = policies().lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(owner) = entries.get(&identity).and_then(Weak::upgrade) {
+        return owner;
+    }
+    let owner = Arc::new(PolicyRegistration { identity, policy });
+    entries.insert(identity, Arc::downgrade(&owner));
+    owner
+}
+pub fn policy_for_span(span: &SpanContext) -> Option<Arc<ScopePolicy>> {
+    policy_registration(span).map(|registration| registration.policy.clone())
+}
+pub fn policy_for_context(context: &Context) -> Option<Arc<ScopePolicy>> {
+    context
+        .get::<Arc<ScopePolicy>>()
+        .cloned()
+        .or_else(|| policy_for_span(context.span().span_context()))
+}
+pub fn restore_policy(context: Context) -> Context {
+    match policy_for_context(&context) {
+        Some(policy) => context.with_value(policy),
+        None => context,
+    }
+}
+pub fn scoped_capture_allowed() -> bool {
+    policy_for_context(&Context::current())
+        .is_none_or(|policy| !policy.disabled && policy.include_sensitive_data)
+}
+pub fn scoped_trace_enabled() -> bool {
+    policy_for_context(&Context::current()).is_none_or(|policy| !policy.disabled)
+}
+
+/// Retains policy through sampled-out spans too; processor callbacks alone cannot do that.
+pub struct ScopedSpan {
+    span: Option<global::BoxedSpan>,
+    span_context: SpanContext,
+    _registration: Option<Arc<PolicyRegistration>>,
+}
+pub fn wrap_span(span: global::BoxedSpan, parent: &Context) -> ScopedSpan {
+    let span_context = span.span_context().clone();
+    let registration =
+        policy_for_context(parent).map(|policy| retain_policy(&span_context, policy));
+    ScopedSpan {
+        span: Some(span),
+        span_context,
+        _registration: registration,
+    }
+}
+impl Drop for ScopedSpan {
+    fn drop(&mut self) {
+        if let Some(span) = self.span.as_mut() {
+            span.end();
+        }
+    }
+}
+impl opentelemetry::trace::Span for ScopedSpan {
+    fn add_event_with_timestamp<T: Into<Cow<'static, str>>>(
+        &mut self,
+        name: T,
+        time: SystemTime,
+        attributes: Vec<KeyValue>,
+    ) {
+        if let Some(span) = self.span.as_mut() {
+            span.add_event_with_timestamp(name, time, attributes);
+        }
+    }
+    fn span_context(&self) -> &SpanContext {
+        &self.span_context
+    }
+    fn is_recording(&self) -> bool {
+        self.span.as_ref().is_some_and(|span| span.is_recording())
+    }
+    fn set_attribute(&mut self, value: KeyValue) {
+        if let Some(span) = self.span.as_mut() {
+            span.set_attribute(value);
+        }
+    }
+    fn set_status(&mut self, value: Status) {
+        if let Some(span) = self.span.as_mut() {
+            span.set_status(value);
+        }
+    }
+    fn update_name<T: Into<Cow<'static, str>>>(&mut self, value: T) {
+        if let Some(span) = self.span.as_mut() {
+            span.update_name(value);
+        }
+    }
+    fn add_link(&mut self, value: SpanContext, attributes: Vec<KeyValue>) {
+        if let Some(span) = self.span.as_mut() {
+            span.add_link(value, attributes);
+        }
+    }
+    fn end_with_timestamp(&mut self, time: SystemTime) {
+        if let Some(span) = self.span.as_mut() {
+            span.end_with_timestamp(time);
+        }
+    }
+}
+static PIPELINE_ENABLED: AtomicBool = AtomicBool::new(true);
+pub fn configure_pipeline(enabled: bool) {
+    PIPELINE_ENABLED.store(enabled, Ordering::Release);
+}
+/// A disabled SDK signal does not consult or replace another application's provider.
+pub fn build_span(
+    service_name: &'static str,
+    builder: opentelemetry::trace::SpanBuilder,
+    parent: &Context,
+) -> ScopedSpan {
+    if PIPELINE_ENABLED.load(Ordering::Acquire) {
+        return wrap_span(
+            global::tracer(service_name).build_with_context(builder, parent),
+            parent,
+        );
+    }
+    let policy = policy_for_context(parent);
+    if policy.is_none() {
+        return ScopedSpan {
+            span: None,
+            span_context: SpanContext::NONE,
+            _registration: None,
+        };
+    }
+    use opentelemetry_sdk::trace::{IdGenerator, RandomIdGenerator};
+    let generator = RandomIdGenerator::default();
+    let inherited = parent.span().span_context().clone();
+    let trace_id = if inherited.is_valid() {
+        inherited.trace_id()
+    } else {
+        builder.trace_id.unwrap_or_else(|| generator.new_trace_id())
+    };
+    let span_context = SpanContext::new(
+        trace_id,
+        builder.span_id.unwrap_or_else(|| generator.new_span_id()),
+        opentelemetry::trace::TraceFlags::default(),
+        false,
+        inherited.trace_state().clone(),
+    );
+    let registration = policy.map(|policy| retain_policy(&span_context, policy));
+    ScopedSpan {
+        span: None,
+        span_context,
+        _registration: registration,
+    }
+}
+
+struct Handle {
+    context: Context,
+    _registration: Option<Arc<PolicyRegistration>>,
+    parent_span_id: Option<String>,
+    ended: Mutex<bool>,
+}
+fn handles() -> &'static Mutex<HashMap<String, Arc<Handle>>> {
+    static HANDLES: OnceLock<Mutex<HashMap<String, Arc<Handle>>>> = OnceLock::new();
+    HANDLES.get_or_init(Default::default)
+}
+fn token(prefix: &str) -> String {
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    format!("{prefix}{}", NEXT.fetch_add(1, Ordering::Relaxed))
+}
+fn resolve(handle: &str) -> Result<Arc<Handle>, String> {
+    handles()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(handle)
+        .cloned()
+        .ok_or_else(|| "Unknown or released native tracing context".into())
+}
+#[derive(Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Options {
+    name: String,
+    #[serde(default)]
+    kind: String,
+    parent: Option<String>,
+    restrictions_parent: Option<String>,
+    #[serde(default)]
+    restrictions_parents: Vec<String>,
+    #[serde(default)]
+    detached: bool,
+    trace_id: Option<String>,
+    group_id: Option<String>,
+    metadata: Option<Box<serde_json::value::RawValue>>,
+    disabled: Option<bool>,
+    include_sensitive_data: Option<bool>,
+    credential_ref: Option<String>,
+}
+#[derive(Serialize)]
+struct Readback<'a> {
+    handle: String,
+    trace_id: String,
+    span_id: String,
+    parent_span_id: Option<String>,
+    workflow_span_id: Option<String>,
+    disabled: bool,
+    include_sensitive_data: bool,
+    root_metadata: Option<&'a str>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    callback_storage_key: Option<&'a str>,
+}
+fn readback(
+    key: &str,
+    handle: &Handle,
+    callback_storage_key: Option<&CallbackStorageKey>,
+) -> Result<String, String> {
+    let span = handle.context.span();
+    let span = span.span_context();
+    let policy = policy_for_context(&handle.context).ok_or("Native tracing policy unavailable")?;
+    serde_json::to_string(&Readback {
+        handle: key.into(),
+        trace_id: span.trace_id().to_string(),
+        span_id: span.span_id().to_string(),
+        parent_span_id: handle.parent_span_id.clone(),
+        workflow_span_id: policy.workflow_span_id.map(|id| id.to_string()),
+        disabled: policy.disabled,
+        include_sensitive_data: policy.include_sensitive_data,
+        root_metadata: policy.root_descriptor.metadata.get().map(String::as_str),
+        callback_storage_key: callback_storage_key.map(|key| key.0.as_str()),
+    })
+    .map_err(|_| "Native tracing context could not serialize".into())
+}
+fn parse_trace_id(value: &str) -> Result<TraceId, String> {
+    let value = value.strip_prefix("trace_").unwrap_or(value);
+    if value.len() != 32 || !value.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("trace_id must contain 32 nonzero hexadecimal digits".into());
+    }
+    let id = TraceId::from_hex(value).map_err(|_| "Invalid trace_id")?;
+    if id == TraceId::INVALID {
+        return Err("trace_id must be nonzero".into());
+    }
+    Ok(id)
+}
+fn bounded_value(value: &Value, depth: usize) -> Result<(), String> {
+    if depth > 8 {
+        return Err("Tracing metadata exceeds maximum depth of 8".into());
+    }
+    match value {
+        Value::String(s) if s.len() > 4096 => Err("Tracing string exceeds 4096 UTF-8 bytes".into()),
+        Value::Array(values) => {
+            if values.len() > 64 {
+                return Err("Tracing arrays may contain at most 64 entries".into());
+            }
+            for value in values {
+                bounded_value(value, depth + 1)?;
+            }
+            Ok(())
+        }
+        Value::Object(values) => {
+            if values.len() > 64 {
+                return Err("Tracing objects may contain at most 64 fields".into());
+            }
+            for (key, value) in values {
+                if key.len() > 256 {
+                    return Err("Tracing key exceeds 256 UTF-8 bytes".into());
+                }
+                bounded_value(value, depth + 1)?;
+            }
+            Ok(())
+        }
+        _ => Ok(()),
+    }
+}
+// Validate opaque metadata with typed serde containers, without Value's private-map visitor.
+// Return canonical JSON so escaped strings keep the existing encoded-attribute byte limit.
+fn bounded_metadata_json(
+    encoded: &str,
+    depth: usize,
+) -> Result<Box<serde_json::value::RawValue>, String> {
+    if depth > 8 {
+        return Err("Tracing metadata exceeds maximum depth of 8".into());
+    }
+    let encoded = encoded.trim_start();
+    let serialized = if encoded.starts_with('"') {
+        let value: String =
+            serde_json::from_str(encoded).map_err(|_| "Invalid tracing metadata")?;
+        if value.len() > 4096 {
+            return Err("Tracing string exceeds 4096 UTF-8 bytes".into());
+        }
+        serde_json::value::to_raw_value(&value)
+    } else if encoded.starts_with('[') {
+        let values: Vec<&serde_json::value::RawValue> =
+            serde_json::from_str(encoded).map_err(|_| "Invalid tracing metadata")?;
+        if values.len() > 64 {
+            return Err("Tracing arrays may contain at most 64 entries".into());
+        }
+        let values = values
+            .iter()
+            .map(|value| bounded_metadata_json(value.get(), depth + 1))
+            .collect::<Result<Vec<_>, _>>()?;
+        serde_json::value::to_raw_value(&values)
+    } else if encoded.starts_with('{') {
+        let values: std::collections::BTreeMap<String, &serde_json::value::RawValue> =
+            serde_json::from_str(encoded).map_err(|_| "Invalid tracing metadata")?;
+        if values.len() > 64 {
+            return Err("Tracing objects may contain at most 64 fields".into());
+        }
+        let mut bounded = std::collections::BTreeMap::new();
+        for (key, value) in values {
+            if key.len() > 256 {
+                return Err("Tracing key exceeds 256 UTF-8 bytes".into());
+            }
+            bounded.insert(key, bounded_metadata_json(value.get(), depth + 1)?);
+        }
+        serde_json::value::to_raw_value(&bounded)
+    } else {
+        return serde_json::value::RawValue::from_string(encoded.to_owned())
+            .map_err(|_| "Invalid tracing metadata".into());
+    };
+    serialized.map_err(|_| "Invalid tracing metadata".into())
+}
+fn metadata_attribute_value(value: &serde_json::value::RawValue) -> Result<String, String> {
+    let encoded = if value.get().starts_with('"') {
+        serde_json::from_str::<String>(value.get()).map_err(|_| "Invalid tracing metadata")?
+    } else {
+        value.get().to_owned()
+    };
+    if encoded.len() > 4096 {
+        return Err("Encoded tracing metadata value exceeds 4096 UTF-8 bytes".into());
+    }
+    Ok(encoded)
+}
