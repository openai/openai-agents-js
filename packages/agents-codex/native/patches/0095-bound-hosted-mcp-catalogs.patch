@@ -8,6 +8,90 @@ use serde_json::{Value, json};
 use std::collections::VecDeque;
 use std::sync::Arc;
 
+// Allocation policy, not a provider protocol catalog limit.
+pub(super) const MAX_HOSTED_MCP_TOOLS: usize = 1024;
+
+fn charge(bytes: &mut usize, additional: usize) -> Result<(), ObserveError> {
+    *bytes = bytes.saturating_add(additional);
+    if *bytes > super::methods::SDK_WIRE_BYTES_CAPACITY {
+        return Err(ObserveError::Capacity);
+    }
+    Ok(())
+}
+
+fn json_bytes(value: &Value, bytes: &mut usize, depth: usize) -> Result<(), ObserveError> {
+    // Bound container/scalar/key allocations without serializing or cloning.
+    if depth > 128 {
+        return Err(ObserveError::Capacity);
+    }
+    charge(bytes, 256)?;
+    match value {
+        Value::String(text) => charge(bytes, text.len().saturating_mul(4))?,
+        Value::Array(values) => {
+            for value in values {
+                json_bytes(value, bytes, depth + 1)?;
+            }
+        }
+        Value::Object(values) => {
+            for (key, value) in values {
+                charge(bytes, 128usize.saturating_add(key.len().saturating_mul(4)))?;
+                json_bytes(value, bytes, depth + 1)?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+fn catalog_bytes(item_id: &str, label: &str) -> Result<usize, ObserveError> {
+    let mut bytes = 512;
+    charge(&mut bytes, item_id.len().saturating_mul(4))?;
+    charge(&mut bytes, label.len().saturating_mul(4))?;
+    Ok(bytes)
+}
+
+fn listed_tool_bytes(
+    name: &str,
+    description: Option<&str>,
+    schema: &Value,
+    bytes: &mut usize,
+) -> Result<(), ObserveError> {
+    charge(bytes, 256)?;
+    charge(bytes, name.len().saturating_mul(4))?;
+    charge(bytes, description.map_or(0, str::len).saturating_mul(4))?;
+    json_bytes(schema, bytes, 0)
+}
+
+pub(super) fn event_bytes(event: &RealtimeEvent) -> Result<usize, ObserveError> {
+    if let RealtimeEvent::HostedMcpToolsListed(catalog) = event {
+        if catalog.tools.len() > MAX_HOSTED_MCP_TOOLS {
+            return Err(ObserveError::Capacity);
+        }
+        let mut bytes = catalog_bytes(&catalog.item_id, &catalog.server_label)?;
+        for tool in &catalog.tools {
+            listed_tool_bytes(
+                &tool.name,
+                tool.description.as_deref(),
+                &tool.input_schema,
+                &mut bytes,
+            )?;
+        }
+        Ok(bytes)
+    } else {
+        // Admit structured errors before serializing, and retain their allocation
+        // charge in the same queue permits as the serialized event.
+        let mut bytes = 0;
+        if let RealtimeEvent::HostedMcpCallCompleted(call) = event {
+            if let Some(error) = &call.error {
+                json_bytes(error, &mut bytes, 0)?;
+            }
+        }
+        let encoded = serde_json::to_vec(event).map_err(|_| ObserveError::Invalid)?;
+        charge(&mut bytes, encoded.len())?;
+        Ok(bytes)
+    }
+}
