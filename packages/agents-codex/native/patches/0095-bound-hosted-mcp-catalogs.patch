+    #[test]
+    fn hosted_catalog_structures_share_queue_permits_and_release_on_drop() {
+        use codex_protocol::protocol::{RealtimeHostedMcpListedTool, RealtimeHostedMcpToolsListed};
+        let event = RealtimeEvent::HostedMcpToolsListed(RealtimeHostedMcpToolsListed {
+            item_id: "catalog".into(),
+            server_label: "docs".into(),
+            tools: vec![
+                RealtimeHostedMcpListedTool {
+                    name: "x".into(),
+                    description: None,
+                    input_schema: serde_json::json!({}),
+                };
+                1024
+            ],
+        });
+        let budget = Arc::new(tokio::sync::Semaphore::new(SDK_WIRE_BYTES_CAPACITY));
+        let mut queued = Vec::new();
+        let mut rejected = false;
+        for _ in 0..17 {
+            let mut message =
+                QueuedWireMessage::new(Ok(Message::Text("{}".into())), Some(Arc::clone(&budget)))
+                    .unwrap();
+            if message
+                .charge_hosted_events(vec![event.clone()], Some(Arc::clone(&budget)))
+                .is_err()
+            {
+                rejected = true;
+                break;
+            }
+            queued.push(message);
+        }
+        assert!(
+            rejected,
+            "compact catalogs must charge their retained structure"
+        );
+        assert!(queued.len() > 1);
+        assert!(budget.available_permits() < SDK_WIRE_BYTES_CAPACITY);
+        drop(queued);
+        assert_eq!(budget.available_permits(), SDK_WIRE_BYTES_CAPACITY);
+    }
