+                    description: None,
+                    input_schema: serde_json::json!({}),
+                };
+                1024
+            ],
+        });
+        let budget = Arc::new(tokio::sync::Semaphore::new(SDK_WIRE_BYTES_CAPACITY));
+        let mut queued = Vec::new();
+        let mut rejected = false;
+        for _ in 0..17 {
+            let mut message =
+                QueuedWireMessage::new(Ok(Message::Text("{}".into())), Some(Arc::clone(&budget)))
+                    .unwrap();
+            if message
+                .charge_hosted_events(vec![event.clone()], Some(Arc::clone(&budget)))
+                .is_err()
+            {
+                rejected = true;
+                break;
+            }
