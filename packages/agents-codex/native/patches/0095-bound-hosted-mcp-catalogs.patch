+    fn hosted_catalog_structures_share_queue_permits_and_release_on_drop() {
+        use codex_protocol::protocol::{RealtimeHostedMcpListedTool, RealtimeHostedMcpToolsListed};
+        let event = RealtimeEvent::HostedMcpToolsListed(RealtimeHostedMcpToolsListed {
+            item_id: "catalog".into(),
