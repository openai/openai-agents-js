+#[cfg(test)]
+mod explicit_prompt_cache_tests {
+    use super::*;
+
+    #[test]
+    fn mode_patch_and_clear_keep_ttl_independent() {
+        let mut controls: ModelRequestControls = serde_json::from_value(serde_json::json!({
+            "prompt_cache_ttl": "30m", "prompt_cache_mode": "explicit"
+        }))
+        .unwrap();
+        assert_eq!(
+            controls.prompt_cache_mode,
+            Some(Some(PromptCacheMode::Explicit))
+        );
+        assert!(!controls.is_empty());
+        let clear: ModelRequestControls = serde_json::from_value(serde_json::json!({
+            "prompt_cache_mode": null
+        }))
+        .unwrap();
+        controls.apply_patch(&clear);
+        assert_eq!(controls.prompt_cache_mode, Some(None));
+        assert_eq!(
+            controls.prompt_cache_ttl,
+            Some(Some(PromptCacheTtl::Minutes30))
+        );
+        assert!(
+            serde_json::from_value::<ModelRequestControls>(serde_json::json!({
+                "prompt_cache_mode": "invalid"
+            }))
+            .is_err()
+        );
+    }
+}
