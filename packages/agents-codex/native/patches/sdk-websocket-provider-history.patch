@@ -24,6 +24,169 @@ use serde_json::json;
 use wiremock::matchers::{method, path};
 use wiremock::{Mock, ResponseTemplate};
 
+#[tokio::test]
+async fn websocket_history_advances_on_the_same_socket_with_only_new_input() -> Result<()> {
+    for store in [true, false] {
+        let server = responses::start_websocket_server(vec![
+            vec![
+                vec![
+                    responses::ev_response_created("resp_before"),
+                    responses::ev_assistant_message("answer_before", "Before."),
+                    responses::ev_completed("resp_before"),
+                ],
+                vec![
+                    responses::ev_response_created("resp_after"),
+                    responses::ev_assistant_message("answer_after", "After."),
+                    responses::ev_completed("resp_after"),
+                ],
+            ],
+            vec![vec![responses::ev_completed("resp_unsafe_reconnect")]],
+        ])
+        .await;
+        let mut builder = test_codex().with_config(move |config| {
+            config.sdk_provider_history =
+                Some(ProviderHistorySelection::PreviousResponse { id: None });
+            config.sdk_request_controls.store = Some(Some(store));
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+        });
+        let test = builder.build_with_websocket_server(&server).await?;
+        for text in ["Before reopen.", "After reopen."] {
+            test.codex
+                .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                    text: text.into(),
+                    text_elements: vec![],
+                }]))
+                .await?;
+            let terminal = wait_for_event(&test.codex, |event| {
+                matches!(event, EventMsg::TurnComplete(_))
+            })
+            .await;
+            assert!(
+                matches!(&terminal, EventMsg::TurnComplete(done) if done.error.is_none()),
+                "{terminal:?}"
+            );
+        }
+        let requests = server.single_connection();
+        assert_eq!(requests.len(), 2);
+        let first = requests[0].body_json();
+        assert!(first.get("previous_response_id").is_none(), "{first}");
+        let second = requests[1].body_json();
+        assert_eq!(second["type"], "response.create");
+        assert_eq!(second["previous_response_id"], "resp_before");
+        assert_eq!(second["store"], store);
+        let input = second["input"].as_array().unwrap();
+        assert_eq!(input.len(), 1, "{second}");
+        assert_eq!(input[0]["role"], "user");
+        assert_eq!(input[0]["content"][0]["text"], "After reopen.");
+        let reference = test
+            .codex
+            .thread_settings_snapshot()
+            .await
+            .provider_history
+            .unwrap();
+        assert!(!reference.pending);
+        assert_eq!(reference.stored_response, Some(store));
+        assert_eq!(
+            reference.selection,
+            ProviderHistorySelection::PreviousResponse {
+                id: Some("resp_after".into()),
+            }
+        );
+        let rollout = test.codex.rollout_path().unwrap();
+        test.codex.submit(Op::Shutdown).await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::ShutdownComplete)
+        })
+        .await;
+        if !store {
+            test.thread_manager
+                .remove_thread(&test.session_configured.thread_id)
+                .await;
+            drop(test.codex);
+            let mut config = test.config.clone();
+            config.sdk_provider_history = Some(ProviderHistorySelection::PreviousResponse {
+                id: Some("resp_after".into()),
+            });
+            let resumed = test
+                .thread_manager
+                .resume_legacy_thread_from_rollout(
+                    config,
+                    rollout,
+                    test.thread_manager.auth_manager(),
+                    None,
+                    Default::default(),
+                )
+                .await?;
