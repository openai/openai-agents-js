+#[cfg(target_os = "linux")]
+pub(super) async fn create_file_exclusive(
+    anchor: PathBuf,
+    path: PathBuf,
+    contents: Vec<u8>,
+) -> io::Result<()> {
+    tokio::task::spawn_blocking(move || {
+        let anchor_relative = anchor.strip_prefix("/").map_err(io::Error::other)?;
+        let relative = path.strip_prefix(&anchor).map_err(io::Error::other)?;
+        // Reject traversal before opening or creating anything.
+        let mut dirs = components(&path)?;
+        let anchor_depth = components(&anchor)?.len();
+        if dirs.len() <= anchor_depth {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "path must name a file below its writable root"));
+        }
+        dirs.drain(..anchor_depth);
+        dirs.pop();
+        let resolve = rustix::fs::ResolveFlags::BENEATH | rustix::fs::ResolveFlags::NO_SYMLINKS;
+        let base = rustix::fs::openat2(
+            root()?,
+            if anchor_relative.as_os_str().is_empty() { Path::new(".") } else { anchor_relative },
+            directory_access_flags() | OFlags::DIRECTORY | OFlags::CLOEXEC,
+            Mode::empty(),
+            resolve,
+        ).map_err(io::Error::from)?;
+        let resolve = resolve | rustix::fs::ResolveFlags::NO_XDEV;
+        let mut parent = base.try_clone()?;
+        let mut prefix = PathBuf::new();
+        for part in dirs {
+            prefix.push(&part);
+            let open_parent = || {
+                rustix::fs::openat2(
+                    &base,
+                    &prefix,
+                    directory_access_flags() | OFlags::DIRECTORY | OFlags::CLOEXEC,
+                    Mode::empty(),
+                    resolve,
+                )
+            };
+            parent = match open_parent() {
+                Ok(next) => next,
+                Err(rustix::io::Errno::NOENT) => {
+                    match mkdirat(&parent, &part, Mode::from_raw_mode(0o777)) {
+                        Ok(()) | Err(rustix::io::Errno::EXIST) => {}
+                        Err(error) => return Err(io::Error::from(error)),
+                    }
+                    open_parent().map_err(io::Error::from)?
+                }
+                Err(error) => return Err(io::Error::from(error)),
+            };
+        }
+        // Re-resolve the entire leaf below the pinned writable root. A
+        // replaced directory or symlink cannot redirect the final create.
+        let file = rustix::fs::openat2(
+            &base,
+            relative,
+            OFlags::WRONLY | OFlags::CREATE | OFlags::EXCL | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::from_raw_mode(0o666),
+            resolve,
+        )
+        .map_err(io::Error::from)?;
+        std::fs::File::from(file).write_all(&contents)
+    })
+    .await
+    .map_err(|error| io::Error::other(format!("filesystem task failed: {error}")))?
+}
