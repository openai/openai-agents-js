+#[cfg(target_os = "linux")]
+pub(super) async fn create_file_exclusive(path: PathBuf, contents: Vec<u8>) -> io::Result<()> {
+    tokio::task::spawn_blocking(move || {
+        let relative = path.strip_prefix("/").map_err(io::Error::other)?;
+        // Resolve the full path beneath the container root in a single syscall.
+        // No intermediate symlink or concurrent rename can redirect the create.
+        let file = rustix::fs::openat2(
+            root()?,
+            relative,
+            OFlags::WRONLY | OFlags::CREATE | OFlags::EXCL | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::from_raw_mode(0o666),
+            rustix::fs::ResolveFlags::BENEATH | rustix::fs::ResolveFlags::NO_SYMLINKS,
+        )
+        .map_err(io::Error::from)?;
+        std::fs::File::from(file).write_all(&contents)
+    })
+    .await
+    .map_err(|error| io::Error::other(format!("filesystem task failed: {error}")))?
+}
