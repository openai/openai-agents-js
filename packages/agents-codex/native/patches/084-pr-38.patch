+#[tokio::test]
+async fn executor_profile_spawn_keeps_the_immutable_empty_owner_ceiling() {
+    let (home, config) = test_config().await;
+    let harness = child_source_memory_harness(home, config);
+    let mut options = StartThreadOptions::new(harness.config.clone());
+    options
+        .thread_extension_init
+        .insert(codex_extension_api::ToolPolicy {
+            allowed_tools: Some(Vec::new()),
+            ..Default::default()
+        });
+    let parent = harness.manager.start_thread(options).await.unwrap();
+    let parent_id = parent.thread_id;
+    let parent = parent.thread;
+    // Mutable extension data cannot replace the Session's captured ceiling.
+    parent
+        .thread_extension_data()
+        .insert(codex_extension_api::ToolPolicy {
+            allowed_tools: Some(vec![codex_tools::ToolName::plain("unadmitted")]),
+            ..Default::default()
+        });
+    for (marked, source_present) in [(true, true), (false, true), (true, false)] {
+        let turn = parent.session.new_default_turn().await;
+        let step = parent
+            .session
+            .capture_step_context(turn, &CancellationToken::new())
+            .await
+            .unwrap();
+        if marked {
+            step.extension_data
+                .insert(codex_extension_api::AgentProfileExecutorTools {
+                    allowed: std::collections::HashSet::new(),
+                });
+        }
+        let child_id = harness
+            .spawn_anonymous_child(
+                parent_id,
+                SpawnAgentOptions {
+                    parent_thread_id: Some(parent_id),
+                    spawning_source: source_present
+                        .then(|| crate::AgentSpawnSource::from_step_context(Arc::clone(&step))),
+                    ..Default::default()
+                },
+            )
+            .await;
+        let child = harness.manager.get_thread(child_id).await.unwrap();
+        let expected = (marked && source_present).then(Vec::new);
+        assert_eq!(child.session.tool_policy.allowed_tools, expected);
+        if marked && source_present {
+            // SDK startup retains the actual spawning grant in child thread data.
+            child.thread_extension_data().insert(
+                (*step
+                    .extension_data
+                    .get::<codex_extension_api::AgentProfileExecutorTools>()
+                    .unwrap())
+                .clone(),
+            );
+            let child_step = child
+                .session
+                .capture_step_context(
+                    child.session.new_default_turn().await,
+                    &CancellationToken::new(),
+                )
+                .await
+                .unwrap();
+            assert!(
+                child_step
+                    .extension_data
+                    .get::<codex_extension_api::AgentProfileExecutorTools>()
+                    .is_some()
+            );
+            let nested_id = harness
+                .spawn_anonymous_child(
+                    child_id,
+                    SpawnAgentOptions {
+                        parent_thread_id: Some(child_id),
+                        spawning_source: Some(crate::AgentSpawnSource::from_step_context(
+                            child_step,
+                        )),
+                        ..Default::default()
+                    },
+                )
+                .await;
+            let nested = harness.manager.get_thread(nested_id).await.unwrap();
+            assert_eq!(nested.session.tool_policy.allowed_tools, Some(Vec::new()));
