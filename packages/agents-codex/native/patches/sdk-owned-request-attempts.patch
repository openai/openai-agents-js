diff --git a/codex-rs/core/src/session/sdk_request_attempts.rs b/codex-rs/core/src/session/sdk_request_attempts.rs
new file mode 100644
index 0000000..c52309e
--- /dev/null
+++ b/codex-rs/core/src/session/sdk_request_attempts.rs
@@ -0,0 +1,273 @@
+//! Content-free send-start counts for one owned SDK native turn.
+use std::sync::{Arc, Mutex, Weak};
+
+use codex_extension_api::ExtensionData;
+use codex_protocol::error::{CodexErr, Result as CodexResult};
+use serde::Serialize;
+
+const OPERATIONS: [&str; 3] = ["generation", "compaction", "internal"];
+const TRANSPORTS: [&str; 3] = ["http_sse", "http_json", "websocket"];
+
+#[derive(Debug, Default)]
+struct Capture {
+    turn_id: Option<String>,
+    root_turn_id: Option<String>,
+    counts: [[[u64; 3]; 3]; 2],
+    borrowed: bool,
+    overflowed: bool,
+    finished: bool,
+}
+
+#[derive(Clone, Debug)]
+enum Owner {
+    Root(Arc<Mutex<Capture>>),
+    Child(Weak<Mutex<Capture>>),
+}
+
+#[derive(Clone, Debug)]
+pub struct SdkRequestAttemptsLink(Arc<Mutex<Capture>>);
+
+impl SdkRequestAttemptsLink {
+    pub fn seal(&self, turn_id: &str) {
+        let mut capture = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if capture.turn_id.as_deref().is_none_or(|id| id == turn_id) {
+            capture.turn_id.get_or_insert_with(|| turn_id.to_owned());
+            capture.finished = true;
+        }
+    }
+
+    pub fn read(&self, turn_id: &str) -> CodexResult<String> {
+        SdkRequestAttempts(Owner::Root(self.0.clone())).finish(turn_id)
+    }
+
+    pub fn attach(&self, store: &ExtensionData) {
+        store.insert(SdkRequestAttempts(Owner::Child(Arc::downgrade(&self.0))));
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct SdkRequestAttempts(Owner);
+
+impl Default for SdkRequestAttempts {
+    fn default() -> Self {
+        Self(Owner::Root(Arc::default()))
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct AttemptRoute {
+    capture: Weak<Mutex<Capture>>,
+    owner: usize,
+    operation: usize,
+    http_transport: usize,
+}
+
+impl codex_extension_api::ModelRequestAttemptsObserver for AttemptRoute {
+    fn send_started(&self, transport: codex_extension_api::ModelRequestTransport) {
+        self.record(match transport {
+            codex_extension_api::ModelRequestTransport::HttpSse => 0,
+            codex_extension_api::ModelRequestTransport::HttpJson => 1,
+            codex_extension_api::ModelRequestTransport::Websocket => 2,
+        });
+    }
+}
+
+impl AttemptRoute {
+    pub(crate) fn with_http_mode(mut self, buffered: bool) -> Self {
+        self.http_transport = usize::from(buffered);
+        self
+    }
+    pub(crate) fn record(&self, transport: usize) {
+        let Some(capture) = self.capture.upgrade() else {
+            return;
+        };
+        let mut capture = capture
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if capture.finished || capture.overflowed {
+            return;
+        }
+        let transport = if transport < 2 {
+            self.http_transport
+        } else {
+            transport
+        };
+        let count = &mut capture.counts[self.owner][self.operation][transport];
+        match count.checked_add(1) {
+            Some(next) => *count = next,
+            None => capture.overflowed = true,
+        }
+    }
+
+    pub(crate) fn borrowed(&self) {
+        if let Some(capture) = self.capture.upgrade() {
+            let mut capture = capture
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if !capture.finished {
+                capture.borrowed = true;
+            }
+        }
+    }
+}
+
+#[derive(Serialize)]
+struct Count {
+    owner: &'static str,
+    operation: &'static str,
+    transport: &'static str,
+    count: String,
+}
+
+#[derive(Serialize)]
+struct Report {
+    availability: &'static str,
+    counts: Vec<Count>,
+    borrowed_requests_unavailable: bool,
+}
+
+impl SdkRequestAttempts {
+    pub(crate) fn child_link(&self) -> SdkRequestAttemptsLink {
+        SdkRequestAttemptsLink(match &self.0 {
+            Owner::Root(capture) => capture.clone(),
+            Owner::Child(capture) => capture.upgrade().expect("request attempts root ended"),
+        })
+    }
+
+    /// Root identities come from native turn metadata, never passive events.
+    pub(crate) fn route(
+        &self,
+        turn_id: &str,
+        root_turn_id: &str,
+        operation: usize,
+    ) -> Option<AttemptRoute> {
+        let (capture, owner) = match &self.0 {
+            Owner::Root(capture) => (capture.clone(), 0),
+            Owner::Child(capture) => (capture.upgrade()?, 1),
+        };
+        let mut state = capture
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.finished {
+            return None;
+        }
+        if owner == 0 {
+            if state.turn_id.as_deref().is_some_and(|id| id != turn_id) {
+                return None;
+            }
+            state.turn_id.get_or_insert_with(|| turn_id.to_owned());
+            state
+                .root_turn_id
+                .get_or_insert_with(|| root_turn_id.to_owned());
+        }
+        if state.root_turn_id.as_deref() != Some(root_turn_id) {
+            return None;
+        }
+        Some(AttemptRoute {
+            capture: Arc::downgrade(&capture),
+            owner,
+            operation,
+            http_transport: 0,
+        })
+    }
+
+    pub(crate) fn finish(&self, turn_id: &str) -> CodexResult<String> {
+        let Owner::Root(capture) = &self.0 else {
+            return Err(CodexErr::InvalidRequest(
+                "Request attempts belong to the root turn".into(),
+            ));
+        };
+        let mut capture = capture
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !capture.finished {
+            return Err(CodexErr::InvalidRequest(
+                "Request attempts require native turn settlement".into(),
+            ));
+        }
+        if capture.turn_id.as_deref().is_some_and(|id| id != turn_id) {
+            return Err(CodexErr::InvalidRequest(
+                "Request attempts belong to a different turn".into(),
+            ));
+        }
+        if capture.overflowed {
+            return Err(CodexErr::InvalidRequest(
+                "Request attempt counter overflow".into(),
+            ));
+        }
+        let mut counts = Vec::new();
+        for (owner, operations) in capture.counts.iter().enumerate() {
+            for (operation, transports) in operations.iter().enumerate() {
+                for (transport, count) in transports.iter().enumerate() {
+                    if *count != 0 {
+                        counts.push(Count {
+                            owner: if owner == 0 { "root" } else { "child" },
+                            operation: OPERATIONS[operation],
+                            transport: TRANSPORTS[transport],
+                            count: count.to_string(),
+                        });
+                    }
+                }
+            }
+        }
+        serde_json::to_string(&Report {
+            availability: if !capture.borrowed {
+                "complete"
+            } else if counts.is_empty() {
+                "unavailable"
+            } else {
+                "partial"
+            },
+            counts,
+            borrowed_requests_unavailable: capture.borrowed,
+        })
+        .map_err(|_| CodexErr::InvalidRequest("Unable to encode request attempts".into()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::{Value, json};
+
+    #[test]
+    fn settlement_keeps_failures_and_rejects_foreign_descendants() {
+        let root = SdkRequestAttempts::default();
+        let route = root.route("turn", "turn", 0).unwrap();
+        route.record(0);
+        route.record(0);
+        let store = ExtensionData::new("child");
+        root.child_link().attach(&store);
+        let child = store.get::<SdkRequestAttempts>().unwrap();
+        assert!(child.route("child-turn", "older-root", 0).is_none());
+        child.route("child-turn", "turn", 1).unwrap().record(2);
+        route.borrowed();
+        root.child_link().seal("turn");
+        let report: Value = serde_json::from_str(&root.finish("turn").unwrap()).unwrap();
+        assert_eq!(
+            report,
+            json!({"availability":"partial", "counts":[
+            {"owner":"root","operation":"generation","transport":"http_sse","count":"2"},
+            {"owner":"child","operation":"compaction","transport":"websocket","count":"1"}
+        ], "borrowed_requests_unavailable":true})
+        );
+        route.record(0);
+        assert!(child.route("child-turn", "turn", 0).is_none());
+    }
+
+    #[test]
+    fn zero_and_borrowed_only_have_distinct_availability() {
+        let zero = SdkRequestAttempts::default();
+        zero.child_link().seal("turn");
+        let report: Value = serde_json::from_str(&zero.finish("turn").unwrap()).unwrap();
+        assert_eq!(report["availability"], "complete");
+        let borrowed = SdkRequestAttempts::default();
+        borrowed.route("turn", "turn", 0).unwrap().borrowed();
+        borrowed.child_link().seal("turn");
+        let report: Value = serde_json::from_str(&borrowed.finish("turn").unwrap()).unwrap();
+        assert_eq!(report["availability"], "unavailable");
+    }
+}
