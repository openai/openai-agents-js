+// Explicit IDs must never attach a new span to another live owner's policy.
+fn reserve_policy(
+    identity: Identity,
+    policy: Arc<ScopePolicy>,
+) -> Result<Arc<PolicyRegistration>, String> {
+    let mut entries = policies().lock().unwrap_or_else(|e| e.into_inner());
+    if entries
+        .get(&identity)
+        .is_some_and(|owner| owner.strong_count() > 0)
+    {
+        return Err("Native tracing span identity is already active".into());
+    }
+    let owner = Arc::new(PolicyRegistration { identity, policy });
+    entries.insert(identity, Arc::downgrade(&owner));
+    Ok(owner)
+}
