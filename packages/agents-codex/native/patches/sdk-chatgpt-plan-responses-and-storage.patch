+pub(super) async fn check_plan_binding(
+    id: ThreadId,
+    rollout_path: &std::path::Path,
+    expected: &str,
+) -> ThreadStoreResult<()> {
+    let header = codex_rollout::read_session_meta_line(rollout_path)
+        .await
+        .map_err(thread_store_io_error)?;
+    if header.meta.id != id
+        || !crate::chatgpt_plan_binding_matches(
+            Some(expected),
+            header.meta.model_provider.as_deref(),
+        )
+    {
+        return Err(ThreadStoreError::InvalidRequest {
+            message: "Session requires matching Sign in with ChatGPT registration and account"
+                .to_owned(),
+        });
+    }
+    Ok(())
