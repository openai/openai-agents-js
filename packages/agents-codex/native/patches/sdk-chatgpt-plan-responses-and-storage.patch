+/// Preserve the SDK's bounded diagnostic body and actual HTTP metadata.
+pub fn map_chatgpt_plan_http_error(err: ApiError) -> CodexErr {
+    let ApiError::Transport(TransportError::Http {
+        status,
+        headers,
+        body,
+        retry_after,
+        ..
+    }) = err
+    else {
+        return map_api_error(err);
+    };
+    let mut error = CodexErr::UnexpectedStatus(UnexpectedResponseError {
+        status,
+        body: body.unwrap_or_default(),
+        user_message: None,
+        url: None,
+        cf_ray: None,
+        request_id: extract_request_tracking_id(headers.as_ref()).filter(|id| {
+            !id.is_empty() && id.len() <= 256 && id.bytes().all(|byte| byte.is_ascii_graphic())
+        }),
+        identity_authorization_error: None,
+        identity_error_code: None,
+    });
+    if let Some(retry_after) = retry_after {
+        error = error.with_retry_after(retry_after);
+    }
+    error
+}
