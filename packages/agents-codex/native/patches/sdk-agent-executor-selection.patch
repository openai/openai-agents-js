+/// Exact executor tools admitted by the current host Agent's Environment.
+/// The thread-level tool policy remains a ceiling.
+#[derive(Clone, Debug, Default)]
+pub struct AgentProfileExecutorTools {
+    pub allowed: std::collections::HashSet<String>,
+}
+
+impl AgentProfileExecutorTools {
+    pub fn permits(&self, tool: &codex_tools::ToolName) -> bool {
+        !tool.is_default_namespace()
+            || !matches!(
+                tool.name.as_str(),
+                "exec_command" | "write_stdin" | "apply_patch" | "project_glob" | "project_grep"
+            )
+            || self.allowed.contains(tool.name.as_str())
+    }
+}
