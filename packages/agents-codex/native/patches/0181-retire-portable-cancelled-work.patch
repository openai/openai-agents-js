+// Provider-added defaults are allowed. Caller-supplied values must be retained;
+// map keys and positional array values retain their actual schema meanings.
+pub fn contains_expected(accepted: &Value, expected: &Value) -> bool {
+    contains_expected_at(accepted, expected, MatchSite::Session)
+}
+#[derive(Clone, Copy, PartialEq)]
+enum MatchSite {
+    Session,
+    Tools,
+    HostedTool,
+    Value,
+}
+fn contains_expected_at(accepted: &Value, expected: &Value, site: MatchSite) -> bool {
+    match (accepted, expected) {
+        (Value::Object(accepted), Value::Object(expected)) => {
+            let hosted = site == MatchSite::HostedTool;
+            expected.iter().all(|(key, value)| {
+                // Credential values are write-only provider inputs. The ordered
+                // ACK accepts our request; it does not disclose those secrets.
+                if hosted && matches!(key.as_str(), "authorization" | "headers") {
+                    return true;
+                }
+                accepted.get(key).is_some_and(|accepted| {
+                    contains_expected_at(
+                        accepted,
+                        value,
+                        if site == MatchSite::Session && key == "tools" {
+                            MatchSite::Tools
+                        } else {
+                            MatchSite::Value
+                        },
+                    )
+                })
+            })
+        }
+        (Value::Array(accepted), Value::Array(expected)) => {
+            accepted.len() == expected.len()
+                && accepted.iter().zip(expected).all(|(accepted, expected)| {
+                    contains_expected_at(
+                        accepted,
+                        expected,
+                        if site == MatchSite::Tools && expected["type"] == "mcp" {
+                            MatchSite::HostedTool
+                        } else {
+                            MatchSite::Value
+                        },
+                    )
+                })
+        }
+        (Value::Number(accepted), Value::Number(expected)) => {
+            // Tolerate integer/float spelling only where neither side can lose
+            // integer precision. Large metadata integers must still match exactly.
+            let lossless = |number: &serde_json::Number| {
+                const EXACT_INTEGER_LIMIT: u64 = 1 << 53;
+                if let Some(value) = number.as_i64() {
+                    value.unsigned_abs() <= EXACT_INTEGER_LIMIT
+                } else if let Some(value) = number.as_u64() {
+                    value <= EXACT_INTEGER_LIMIT
+                } else {
+                    number
+                        .as_f64()
+                        .is_some_and(|value| value.abs() <= EXACT_INTEGER_LIMIT as f64)
+                }
+            };
+            accepted == expected
+                || (lossless(accepted)
+                    && lossless(expected)
+                    && accepted.as_f64() == expected.as_f64())
+        }
+        _ => accepted == expected,
+    }
+}
