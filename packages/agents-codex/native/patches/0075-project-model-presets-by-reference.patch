+#[tokio::test]
+async fn preset_projection_handles_hidden_only_and_empty_static_catalogs() {
+    let models = vec![
+        remote_model_with_visibility("second", "Second", 1, "none"),
+        remote_model_with_visibility("first", "First", 0, "hide"),
+    ];
+    let manager = static_manager_for_tests(ModelsResponse { models });
+    let actual = manager
+        .list_models(RefreshStrategy::Offline, DEFAULT_HTTP_CLIENT_FACTORY)
+        .await;
+    assert_eq!(
+        actual
+            .iter()
+            .map(|preset| preset.id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["first", "second"]
+    );
+    assert!(actual[0].is_default);
+    assert!(!actual[1].is_default);
+    assert!(actual.iter().all(|preset| !preset.show_in_picker));
+    assert_eq!(manager.try_list_models().unwrap(), actual);
