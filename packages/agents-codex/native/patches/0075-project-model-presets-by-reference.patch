+#[tokio::test]
+async fn preset_projection_obeys_api_key_discovery_rollback_for_both_catalog_sources() {
+    let models = vec![remote_model("dynamic-preset", "Dynamic Preset", 0)];
+    let bundled = load_remote_models_from_file().unwrap();
+    for explicit in [false, true] {
+        let endpoint = TestModelsEndpoint::without_refresh(vec![models.clone()]);
+        let auth = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("test-key"));
+        let mut manager = OpenAiModelsManager::new_without_cache(endpoint.clone(), Some(auth));
+        if explicit {
+            manager = manager.with_provider_catalog();
+        }
+        manager.set_api_key_model_discovery_enabled(true);
+        let expected_dynamic = manager.build_available_models(models.clone());
+        assert_eq!(
+            manager
+                .list_models(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+                .await,
+            expected_dynamic
+        );
+        assert_eq!(endpoint.fetch_count(), 1);
+
+        manager.set_api_key_model_discovery_enabled(false);
+        let expected_fallback = manager.build_available_models(if explicit {
+            Vec::new()
+        } else {
+            bundled.clone()
+        });
+        assert_eq!(
+            manager
+                .list_models(RefreshStrategy::Offline, DEFAULT_HTTP_CLIENT_FACTORY)
+                .await,
+            expected_fallback
+        );
+        assert_eq!(manager.try_list_models().unwrap(), expected_fallback);
+        let guard = manager.remote_models.write().await;
+        assert!(manager.try_list_models().is_err());
+        drop(guard);
+
+        manager.set_api_key_model_discovery_enabled(true);
+        assert_eq!(
+            manager
+                .list_models(RefreshStrategy::Offline, DEFAULT_HTTP_CLIENT_FACTORY)
+                .await,
+            expected_dynamic
+        );
+        assert_eq!(manager.try_list_models().unwrap(), expected_dynamic);
+        assert_eq!(endpoint.fetch_count(), 1);
+    }
+}
