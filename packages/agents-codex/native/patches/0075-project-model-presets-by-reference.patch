+#[tokio::test]
+async fn preset_projection_preserves_stable_order_auth_and_default_selection() {
+    let hidden = remote_model_with_visibility("hidden", "Hidden", -3, "hide");
+    let mut backend_only = remote_model("backend-only", "Backend Only", -2);
+    backend_only.supported_in_api = false;
+    let first_tie = remote_model("tie-b", "First Tie", 0);
+    let mut second_tie = remote_model("tie-a", "Second Tie", 0);
+    second_tie.default_reasoning_level = Some(
+        codex_protocol::openai_models::ReasoningEffort::Custom("provider:custom".to_string()),
+    );
+    let duplicate = remote_model("tie-b", "Duplicate Slug", 0);
+    let last = remote_model("last", "Last", 7);
+    let models = vec![last, first_tie, hidden, backend_only, second_tie, duplicate];
+
+    for uses_codex_backend in [false, true] {
+        let auth = uses_codex_backend.then(|| {
+            AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        });
+        let manager = StaticModelsManager::new(
+            auth,
+            ModelsResponse {
+                models: models.clone(),
+            },
+        );
+        let actual = manager
+            .list_models(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        assert_eq!(actual, manager.build_available_models(models.clone()));
+        assert_eq!(manager.try_list_models().unwrap(), actual);
+        let expected_names = if uses_codex_backend {
+            vec![
+                "Hidden",
+                "Backend Only",
+                "First Tie",
+                "Second Tie",
+                "Duplicate Slug",
+                "Last",
+            ]
+        } else {
+            vec![
+                "Hidden",
+                "First Tie",
+                "Second Tie",
+                "Duplicate Slug",
+                "Last",
+            ]
+        };
+        assert_eq!(
+            actual
+                .iter()
+                .map(|preset| preset.display_name.as_str())
+                .collect::<Vec<_>>(),
+            expected_names
+        );
+        assert_eq!(
+            actual
+                .iter()
+                .filter(|preset| preset.is_default)
+                .map(|preset| preset.id.as_str())
+                .collect::<Vec<_>>(),
+            vec![if uses_codex_backend {
+                "backend-only"
+            } else {
+                "tie-b"
+            }]
+        );
+        assert!(!actual[0].show_in_picker);
+        assert_eq!(
+            actual
+                .iter()
+                .find(|preset| preset.id == "tie-a")
+                .unwrap()
+                .default_reasoning_effort
+                .as_str(),
+            "provider:custom"
+        );
+    }
+}
