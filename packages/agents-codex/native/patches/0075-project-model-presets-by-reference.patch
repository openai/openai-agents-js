+#[cfg(test)]
+mod borrowed_model_preset_tests {
+    use super::*;
+
+    #[test]
+    fn borrowed_preset_matches_owned_conversion_with_populated_metadata() {
+        let custom = ReasoningEffort::Custom("provider:deliberate".to_string());
+        let mut info = super::tests::test_model(Some(ModelMessages {
+            instructions_template: Some("instructions not included in a preset".repeat(1024)),
+            ..ModelMessages::default()
+        }));
+        info.slug = "provider/模型".to_string();
+        info.display_name = "Model Δ".to_string();
+        info.description = Some("Description".to_string());
+        info.model_specialty = Some("specialty".to_string());
+        info.default_reasoning_level = Some(custom.clone());
+        info.supported_reasoning_levels = vec![ReasoningEffortPreset {
+            effort: custom.clone(),
+            description: "Provider effort".to_string(),
+        }];
+        info.additional_speed_tiers = vec!["priority".to_string()];
+        info.service_tiers = vec![ModelServiceTier {
+            id: "priority".to_string(),
+            name: "Priority".to_string(),
+            description: "Priority processing".to_string(),
+        }];
+        info.default_service_tier = Some("priority".to_string());
+        info.available_access_programs = Some(ModelAccessPrograms {
+            cyber: vec![crate::turn_input::CyberAccessProgram::DaybreakBlue],
+        });
+        info.upgrade = Some(ModelInfoUpgrade {
+            model: "next-model".to_string(),
+            migration_markdown: "Migration details".to_string(),
+            retirement_at: Some(
+                chrono::DateTime::parse_from_rfc3339("2027-01-02T03:04:05Z")
+                    .unwrap()
+                    .with_timezone(&chrono::Utc),
+            ),
+        });
+        info.availability_nux = Some(ModelAvailabilityNux {
+            message: "Available now".to_string(),
+        });
+        info.visibility = ModelVisibility::Hide;
+        info.supported_in_api = false;
+        info.input_modalities = vec![InputModality::Audio, InputModality::Text];
+        info.multi_agent_version = Some(MultiAgentVersion::V2);
+        info.multi_agent_reasoning_effort = Some(custom.clone());
+        info.used_fallback_model_metadata = true;
+
+        let expected = ModelPreset::from(info.clone());
+        let actual = ModelPreset::from(&info);
+        // Compare the Rust values: JSON equality would omit multi_agent_version.
+        assert_eq!(actual, expected);
+        assert_eq!(actual.multi_agent_version, Some(MultiAgentVersion::V2));
+        assert_eq!(actual.default_reasoning_effort, custom);
+        assert!(!actual.show_in_picker);
+        assert!(!actual.supported_in_api);
+        assert_eq!(
+            actual.upgrade.as_ref().unwrap().migration_config_key,
+            info.slug
+        );
+    }
+
