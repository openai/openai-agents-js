+#[tokio::test]
+async fn preset_projection_obeys_identity_empty_catalog_and_try_lock_authority() {
+    let bundled = load_remote_models_from_file().unwrap();
+    assert!(!bundled.is_empty(), "fallback control must have models");
+    for explicit in [false, true] {
+        for identity in [Some("test-provider"), Some("other-provider"), None] {
+            for empty in [false, true] {
+                let endpoint = TestModelsEndpoint::without_refresh(Vec::new());
+                let mut manager = OpenAiModelsManager::new_without_cache(endpoint.clone(), None);
+                if explicit {
+                    manager = manager.with_provider_catalog();
+                }
+                let models = if empty {
+                    Vec::new()
+                } else {
+                    vec![remote_model("selected", "Selected", 0)]
+                };
+                {
+                    let mut entry = manager.remote_models.write().await;
+                    entry.identity = identity.map(str::to_string);
+                    entry.models = models.clone();
+                }
+                let expected_source = if identity == Some("test-provider") {
+                    models
+                } else if explicit {
+                    Vec::new()
+                } else {
+                    bundled.clone()
+                };
+                let expected = manager.build_available_models(expected_source);
+                assert_eq!(
+                    manager.try_list_models().unwrap(),
+                    expected,
+                    "explicit={explicit}, identity={identity:?}, empty={empty}"
+                );
+                assert_eq!(
+                    manager
+                        .list_models(RefreshStrategy::Offline, DEFAULT_HTTP_CLIENT_FACTORY)
+                        .await,
+                    expected
+                );
+                assert_eq!(endpoint.fetch_count(), 0);
+
+                // Even a fallback catalog must not turn lock contention into a successful read.
+                let guard = manager.remote_models.write().await;
+                assert!(manager.try_list_models().is_err());
+                drop(guard);
+                assert_eq!(manager.try_list_models().unwrap(), expected);
+            }
+        }
+    }
+}
