 type SharedModelsEndpointClient = Arc<dyn ModelsEndpointClient>;
 
+// Copy only picker metadata while the catalog is borrowed. Sort after releasing its guard.
+fn project_model_presets(models: &[ModelInfo]) -> Vec<(i32, ModelPreset)> {
+    models
+        .iter()
+        .map(|model| (model.priority, ModelPreset::from(model)))
+        .collect()
+}
+
+fn build_available_projection(
+    mut projected: Vec<(i32, ModelPreset)>,
+    auth_manager: Option<&AuthManager>,
+) -> Vec<ModelPreset> {
+    // Stable sorting retains catalog order on ties, as in the owned path.
+    projected.sort_by_key(|(priority, _)| *priority);
+    let presets = projected.into_iter().map(|(_, preset)| preset).collect();
+    build_available_presets(presets, auth_manager)
+}
+
+// Call after releasing the catalog guard, as in the owned-catalog path.
+fn build_available_presets(
+    mut presets: Vec<ModelPreset>,
+    auth_manager: Option<&AuthManager>,
+) -> Vec<ModelPreset> {
+    let uses_codex_backend = auth_manager.is_some_and(AuthManager::current_auth_uses_codex_backend);
+    presets = ModelPreset::filter_by_auth(presets, uses_codex_backend);
+    ModelPreset::mark_default_by_picker_visibility(&mut presets);
+    presets
+}
