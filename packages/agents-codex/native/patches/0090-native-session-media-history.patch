+#[instrument(level = "trace", skip_all)]
+pub(crate) async fn run_hooks_and_record_inputs(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    model_info: &ModelInfo,
+    input: &[TurnInput],
+    persist_context: PersistContext,
+) -> CodexResult<bool> {
+    if sess.captured_provider_image_reference_policy()
+        == codex_protocol::provider_reference_profile::ProviderImageReferencePolicy::QualifiedStandardResponses
+    {
+        let supported = crate::image_preparation::inline_data_url_low_detail_supported(
+            &turn_context.config, model_info,
+        );
+        let reference_policy = crate::image_preparation::reference_policy_for_model(
+            sess.captured_provider_image_reference_policy(), model_info.use_responses_lite, supported,
+        );
+        // Validate the entire incoming batch before hooks or history preparation.
+        for item in input {
+            match item {
+                TurnInput::UserInput { content, .. } => {
+                    for part in content {
+                        if let UserInput::Image { image, detail } = part {
+                            crate::image_preparation::validate_live_image_format(
+                                image, *detail, supported, reference_policy,
+                            ).map_err(CodexErr::Fatal)?;
+                        }
+                    }
+                }
+                TurnInput::ResponseItem(item) | TurnInput::FunctionCallOutput(item) => {
+                    crate::image_preparation::validate_inline_image_items(
+                        &item.item, supported, reference_policy,
+                    ).map_err(CodexErr::Fatal)?;
+                }
+                TurnInput::InterAgentCommunication(_) => {}
+            }
+        }
+    }
+
+    // Cancellation can reach this path before Guardian's tools and context are
+    // resolved. Only finalized evidence may enter reusable reviewer history.
+    if sess
+        .services
+        .thread_extension_data
+        .get::<crate::guardian::PendingReviewContext>()
+        .is_some()
+    {
+        return Ok(false);
+    }
+    let mut blocked_input = false;
+    let mut accepted_user_input = false;
+    for input_item in input {
+        let hook_outcome = inspect_pending_input(sess, turn_context, input_item).await;
+        if hook_outcome.should_stop {
+            blocked_input = true;
+            record_additional_contexts(sess, turn_context, hook_outcome.additional_contexts).await;
+        } else {
+            if matches!(input_item, TurnInput::UserInput { content, .. } if !content.is_empty()) {
+                accepted_user_input = true;
+            }
+            // Tool outputs retain their durability barrier, including in mixed input batches.
+            let input_persist_context = if persist_context == PersistContext::SteeredUserInput
+                && matches!(input_item, TurnInput::FunctionCallOutput(_))
+            {
+                PersistContext::Standard
+            } else {
+                persist_context
+            };
+            record_pending_input(
+                sess,
+                turn_context,
+                model_info,
+                input_item.clone(),
+                hook_outcome.additional_contexts,
+                input_persist_context,
+            )
+            .await;
+        }
+    }
+    Ok(blocked_input && !accepted_user_input)
+}
+
+fn turn_user_input(input: &[TurnInput]) -> Vec<UserInput> {
+    input
+        .iter()
+        .filter_map(|item| match item {
+            TurnInput::UserInput { content, .. } => Some(content.as_slice()),
+            TurnInput::ResponseItem(_)
+            | TurnInput::FunctionCallOutput(_)
+            | TurnInput::InterAgentCommunication(_) => None,
+        })
+        .flatten()
+        .cloned()
+        .collect()
+}
