+            content_index: None,
+            snapshot: true,
+            text: "private".into(),
+            capture_complete: true,
+        };
+        let first = budget.capture_retained(fact.clone(), 600_000, 400).unwrap();
+        let second = budget.capture_retained(fact, 600_000, 400).unwrap();
+        assert!(matches!(second, ResponseFact::CaptureTruncated));
+        assert!(600_000 + encoded_len(&first) + 400 <= RESPONSE_FACT_BYTES);
+        assert!(budget.is_exhausted());
+        let mut oversized = ResponseFactBudget::default();
+        assert!(matches!(
