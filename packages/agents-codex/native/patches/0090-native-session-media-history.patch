+    pub fn has_wire_values(&self) -> bool {
+        self.max_output_tokens.as_ref().is_some_and(Option::is_some)
+            || self.temperature.as_ref().is_some_and(Option::is_some)
+            || self.top_p.as_ref().is_some_and(Option::is_some)
+            || self.top_logprobs.as_ref().is_some_and(Option::is_some)
+            || self
+                .parallel_tool_calls
+                .as_ref()
+                .is_some_and(Option::is_some)
+            || self.verbosity.as_ref().is_some_and(Option::is_some)
+            || self.metadata.as_ref().is_some_and(Option::is_some)
+            || self.store.as_ref().is_some_and(Option::is_some)
+            || self
+                .prompt_cache_retention
+                .as_ref()
+                .is_some_and(Option::is_some)
+            || self.prompt_cache_ttl.as_ref().is_some_and(Option::is_some)
+            || self.named_tool_choice.as_ref().is_some_and(Option::is_some)
+    }
+}
