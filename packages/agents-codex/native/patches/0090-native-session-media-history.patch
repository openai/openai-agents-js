+//! Provider-owned file references shared by user input and tool output.
+//! Validation performs no host file access, network access, upload, or content estimation.
+
+use base64::Engine;
+use base64::engine::general_purpose::{STANDARD, STANDARD_NO_PAD};
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use serde::de::Error as _;
+use serde_json::Value;
+use std::collections::HashMap;
+use ts_rs::TS;
+
+#[derive(Clone, PartialEq, Eq, Serialize, JsonSchema, TS)]
+pub struct InputFile {
+    #[serde(flatten)]
+    source: InputFileSource,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    filename: Option<String>,
+}
+
+#[derive(Clone, PartialEq, Eq, Serialize, TS)]
+#[serde(untagged)]
+#[ts(untagged)]
+pub enum InputFileSource {
+    Id { file_id: String },
+    Data { file_data: String },
+    Url { file_url: String },
+}
+
+impl JsonSchema for InputFileSource {
+    fn schema_name() -> String {
+        "InputFileSource".into()
+    }
+    fn json_schema(_: &mut schemars::r#gen::SchemaGenerator) -> schemars::schema::Schema {
+        use schemars::schema::{
+            InstanceType, ObjectValidation, Schema, SchemaObject, SubschemaValidation,
+        };
+        let keys = ["file_id", "file_data", "file_url"];
+        let choices = keys
+            .iter()
+            .map(|key| {
+                let mut object = ObjectValidation::default();
+                object.required.insert((*key).into());
+                object.properties.insert(
+                    (*key).into(),
+                    SchemaObject {
+                        instance_type: Some(InstanceType::String.into()),
+                        string: Some(Box::new(schemars::schema::StringValidation {
+                            min_length: Some(1),
+                            ..Default::default()
+                        })),
+                        ..Default::default()
+                    }
+                    .into(),
+                );
+                for other in keys.iter().filter(|other| *other != key) {
+                    object
+                        .properties
+                        .insert((*other).into(), Schema::Bool(false));
+                }
+                SchemaObject {
+                    instance_type: Some(InstanceType::Object.into()),
+                    object: Some(Box::new(object)),
+                    ..Default::default()
+                }
+                .into()
+            })
+            .collect();
+        SchemaObject {
+            subschemas: Some(Box::new(SubschemaValidation {
+                one_of: Some(choices),
+                ..Default::default()
+            })),
+            ..Default::default()
+        }
+        .into()
+    }
+}
+
+impl std::fmt::Debug for InputFile {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        // File bytes and URL queries must not enter ordinary diagnostic previews.
+        f.debug_struct("InputFile")
+            .field("source", &self.source_kind())
+            .finish_non_exhaustive()
+    }
+}
+
+impl InputFile {
+    pub fn from_file_id(file_id: String, filename: Option<String>) -> Result<Self, String> {
+        Self::new(InputFileSource::Id { file_id }, filename)
+    }
+    pub fn from_file_data(file_data: String, filename: Option<String>) -> Result<Self, String> {
+        Self::new(InputFileSource::Data { file_data }, filename)
+    }
+    pub fn from_file_url(file_url: String, filename: Option<String>) -> Result<Self, String> {
+        Self::new(InputFileSource::Url { file_url }, filename)
+    }
+    fn new(source: InputFileSource, filename: Option<String>) -> Result<Self, String> {
+        let value = match &source {
+            InputFileSource::Id { file_id } => file_id,
+            InputFileSource::Data { file_data } => {
+                let payload = if file_data
+                    .get(..5)
+                    .is_some_and(|prefix| prefix.eq_ignore_ascii_case("data:"))
+                {
+                    let (metadata, payload) = file_data[5..]
+                        .split_once(',')
+                        .ok_or("file_data must contain base64 data")?;
+                    if !metadata.to_ascii_lowercase().ends_with(";base64") {
+                        return Err("file_data must contain base64 data".into());
+                    }
+                    payload
+                } else {
+                    file_data.as_str()
+                };
+                // Validate inline bytes locally, without retaining a decoded cache or estimating document tokens.
+                if payload.is_empty()
+                    || STANDARD
+                        .decode(payload)
+                        .or_else(|_| STANDARD_NO_PAD.decode(payload))
+                        .is_err()
+                {
+                    return Err("file_data must contain base64 data".into());
+                }
+                file_data
+            }
+            InputFileSource::Url { file_url } => {
+                let parsed = gix_url::parse(file_url.as_bytes().into())
+                    .map_err(|_| "file_url must be an absolute HTTPS URL".to_owned())?;
+                if parsed.scheme != gix_url::Scheme::Https
+                    || parsed.host.as_deref().is_none_or(str::is_empty)
+                {
+                    return Err("file_url must be an absolute HTTPS URL".into());
+                }
+                file_url
+            }
+        };
+        if value.trim().is_empty() {
+            return Err("file source must be nonempty".into());
+        }
+        Ok(Self { source, filename })
+    }
+    /// Validate against actual current metadata captured by the live owner, never a saved claim.
+    pub fn validate_for_model(
+        &self,
+        profile: crate::provider_reference_profile::ProviderImageReferencePolicy,
+        model: &crate::openai_models::ModelInfo,
+    ) -> Result<(), String> {
+        if profile != crate::provider_reference_profile::ProviderImageReferencePolicy::QualifiedStandardResponses || model.use_responses_lite {
+            return Err("file input requires the current qualified standard Responses route".into());
+        }
+        if self
+            .inline_mime_type()
+            .is_some_and(|mime| mime.eq_ignore_ascii_case("application/pdf"))
+            && !model
+                .input_modalities
+                .contains(&crate::openai_models::InputModality::Image)
+        {
+            return Err("PDF input requires a model declaring image input support".into());
+        }
+        Ok(())
+    }
+    pub fn into_parts(self) -> (InputFileSource, Option<String>) {
+        (self.source, self.filename)
+    }
+    pub fn source(&self) -> &InputFileSource {
+        &self.source
+    }
+    pub fn filename(&self) -> Option<&str> {
+        self.filename.as_deref()
+    }
+    pub fn source_kind(&self) -> &'static str {
+        match self.source {
+            InputFileSource::Id { .. } => "file_id",
+            InputFileSource::Data { .. } => "file_data",
+            InputFileSource::Url { .. } => "file_url",
+        }
+    }
+    /// A caller-declared inline MIME type, not a claim about opaque IDs or URLs.
+    pub fn inline_mime_type(&self) -> Option<&str> {
+        let InputFileSource::Data { file_data } = &self.source else {
+            return None;
+        };
+        if !file_data
+            .get(..5)
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case("data:"))
+        {
+            return None;
+        }
+        file_data[5..]
+            .split_once(',')?
+            .0
+            .split(';')
+            .next()
+            .filter(|mime| !mime.is_empty())
+    }
+}
+
+impl<'de> Deserialize<'de> for InputFile {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let mut fields = HashMap::<String, Value>::deserialize(deserializer)?;
+        let filename = fields
+            .remove("filename")
+            .filter(|value| !value.is_null())
+            .map(serde_json::from_value)
+            .transpose()
+            .map_err(D::Error::custom)?;
+        let id = fields.remove("file_id");
+        let data = fields.remove("file_data");
+        let url = fields.remove("file_url");
+        let source = match (id, data, url) {
+            (Some(Value::String(file_id)), None, None) => InputFileSource::Id { file_id },
+            (None, Some(Value::String(file_data)), None) => InputFileSource::Data { file_data },
+            (None, None, Some(Value::String(file_url))) => InputFileSource::Url { file_url },
+            _ => {
+                return Err(D::Error::custom(
+                    "file must contain exactly one file_id, file_data, or file_url",
+                ));
+            }
+        };
+        Self::new(source, filename).map_err(D::Error::custom)
+    }
+}
