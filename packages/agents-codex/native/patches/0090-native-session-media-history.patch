+#[tokio::test]
+async fn qualified_references_keep_detail_order_and_success_on_insert_and_replay() {
+    let mut content = vec![FunctionCallOutputContentItem::InputText {
+        text: "caption".into(),
+    }];
+    for detail in [
+        ImageDetail::Auto,
+        ImageDetail::Low,
+        ImageDetail::High,
+        ImageDetail::Original,
+    ] {
+        content.push(FunctionCallOutputContentItem::InputImage {
+            image: ImageReference::Inline {
+                image_url: "https://example.invalid/never-fetch.png".into(),
+            },
+            detail: Some(detail),
+        });
+        content.push(FunctionCallOutputContentItem::InputImage {
+            image: ImageReference::File {
+                file_id: "file-provider-owned".into(),
+            },
+            detail: Some(detail),
+        });
+    }
+    let item = ResponseItem::FunctionCallOutput {
+        id: None,
+        call_id: Some("call-images".into()),
+        name: None,
+        namespace: None,
+        output: FunctionCallOutputPayload {
+            body: FunctionCallOutputBody::ContentItems(content),
+            success: Some(false),
+        },
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let mut items = vec![item.clone()];
+    for _boundary in ["insertion", "replay"] {
+        let metadata = prepare_response_items(
+            "references",
+            &mut items,
+            ImagePreparationMode::DetailBased,
+            ProviderImageReferencePolicy::QualifiedStandardResponses,
+            ImageResizeNoticeMode::Disabled,
+            &NoReferenceIoStore,
+        )
+        .await;
+        assert!(metadata.is_empty());
+        assert_eq!(items, vec![item.clone()]);
+    }
+    // A different current host policy may reject recorded remote URLs. History
+    // contains references, never authority to opt the restoring host back in.
+    prepare_response_items(
+        "references",
+        &mut items,
+        ImagePreparationMode::DetailBased,
+        ProviderImageReferencePolicy::PrepareInline,
+        ImageResizeNoticeMode::Disabled,
+        &NoReferenceIoStore,
+    )
+    .await;
+    let ResponseItem::FunctionCallOutput { output, .. } = &items[0] else {
+        panic!("output")
+    };
+    let FunctionCallOutputBody::ContentItems(content) = &output.body else {
+        panic!("content")
+    };
+    assert_eq!(
+        content[0],
+        FunctionCallOutputContentItem::InputText {
+            text: "caption".into()
+        }
+    );
+    for pair in content[1..].chunks_exact(2) {
+        assert_eq!(
+            pair[0],
+            FunctionCallOutputContentItem::InputText {
+                text: REMOTE_IMAGE_URL_PLACEHOLDER.into()
+            }
+        );
+        assert!(matches!(
+            pair[1],
+            FunctionCallOutputContentItem::InputImage {
+                image: ImageReference::File { .. },
+                ..
+            }
+        ));
+    }
+    assert_eq!(output.success, Some(false));
+}
