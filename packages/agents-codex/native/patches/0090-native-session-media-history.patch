+// Isolate the broader JS finalizer rule without introducing a new storage
+// adapter: the controlled task returns the same secondary Fatal classification
+// that a pre-finalizer flush failure produces. This test does not perform failing
+// store I/O; actual flush/fence failure remains a separate qualification case.
+struct ModelErrorThenSecondaryTaskFailure;
+impl crate::tasks::SessionTask for ModelErrorThenSecondaryTaskFailure {
+    fn kind(&self) -> crate::state::TaskKind {
+        crate::state::TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "test.preexisting_primary_no_file"
+    }
+    async fn run(
+        self: Arc<Self>,
+        session: Arc<crate::session::session::Session>,
+        turn: Arc<crate::session::turn_context::TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        _cancellation: CancellationToken,
+    ) -> crate::tasks::SessionTaskResult {
+        let original =
+            codex_protocol::error::CodexErr::Fatal("original model error without file".into());
+        session
+            .emit_turn_error_lifecycle(turn.as_ref(), original.to_codex_protocol_error(), &original)
+            .await;
+        session
+            .send_event(
+                turn.as_ref(),
+                codex_protocol::protocol::EventMsg::Error(original.to_error_event(None)),
+            )
+            .await;
+        Err(codex_protocol::error::CodexErr::Fatal(
+            "controlled secondary task failure".into(),
+        ))
+    }
+}
+#[tokio::test]
+async fn reported_model_error_stays_primary_for_secondary_task_failure_without_owned_file_fatal() {
+    let (session, turn, events, records) = owned_spawn_session().await;
+    assert!(
+        !session
+            .services
+            .code_mode_service
+            .has_pending_fatal_for_turn(&turn)
+    );
+    session
+        .spawn_task(
+            Arc::clone(&turn),
+            Vec::new(),
+            ModelErrorThenSecondaryTaskFailure,
+        )
+        .await;
+    let mut errors = Vec::new();
+    let complete = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            match events.recv().await.unwrap().msg {
+                codex_protocol::protocol::EventMsg::Error(error) => errors.push(error),
+                codex_protocol::protocol::EventMsg::TurnComplete(event) => break event,
+                codex_protocol::protocol::EventMsg::TurnAborted(_) => {
+                    panic!("secondary failure replaced the original failed terminal")
+                }
+                _ => {}
+            }
+        }
+    })
+    .await
+    .unwrap();
+    let expected =
+        codex_protocol::error::CodexErr::Fatal("original model error without file".into())
+            .to_error_event(None)
+            .message;
+    assert_eq!(errors.len(), 1);
+    assert_eq!(errors[0].message, expected);
+    assert_eq!(complete.error.as_ref().unwrap().message, expected);
+    assert!(complete.tool_completion.is_none());
+    assert_eq!(records.lock().unwrap().as_slice(), &[turn.sub_id.clone()]);
+    assert!(
