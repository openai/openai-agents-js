+//! One local invocation clock; never drop the invocation future on expiry.
+use codex_extension_api::TurnSamplingStop;
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+pub(crate) fn selected_timeout_ms(
+    timeout: Option<u32>,
+    source: &codex_protocol::protocol::SessionSource,
+) -> Option<u32> {
+    use codex_protocol::protocol::{SessionSource, SubAgentSource};
+    if source.is_internal()
+        || matches!(
+            source,
+            SessionSource::SubAgent(SubAgentSource::Review | SubAgentSource::Compact)
+        )
+        || crate::guardian::is_basic_session_source(source)
+    {
+        None
+    } else {
+        timeout
+    }
+}
+
+struct RequestTasks {
+    handles: Vec<tokio::task::JoinHandle<()>>,
+    errors: Vec<String>,
+}
+
+pub(crate) struct ModelInvocationDeadline {
+    tasks: std::sync::OnceLock<tokio::sync::Mutex<RequestTasks>>,
+    state: std::sync::OnceLock<Arc<codex_extension_api::ModelInvocationDeadlineState>>,
+    timeout_ms: Option<u32>,
+    turn_stop: Option<Arc<TurnSamplingStop>>,
+    started: CancellationToken,
+    owned_task: std::sync::OnceLock<Arc<super::owned_turn_stop::OwnedTurnTask>>,
+    accepted: CancellationToken,
+    request_cancel: CancellationToken,
+    stream_stop: Mutex<Option<CancellationToken>>,
+    producer_stop: Mutex<Option<tokio::sync::oneshot::Sender<()>>>,
+}
+
+impl ModelInvocationDeadline {
+    pub(crate) fn new(
+        timeout_ms: Option<u32>,
+        request_cancel: CancellationToken,
+        turn_stop: Option<Arc<TurnSamplingStop>>,
+    ) -> Self {
+        let owner = Self::new_deferred(timeout_ms, request_cancel, turn_stop);
+        owner.start();
+        owner
+    }
+
+    pub(crate) fn new_deferred(
+        timeout_ms: Option<u32>,
+        request_cancel: CancellationToken,
+        turn_stop: Option<Arc<TurnSamplingStop>>,
+    ) -> Self {
+        Self {
+            tasks: std::sync::OnceLock::new(),
+            owned_task: std::sync::OnceLock::new(),
+            state: std::sync::OnceLock::new(),
+            timeout_ms,
+            turn_stop,
+            started: CancellationToken::new(),
+            accepted: CancellationToken::new(),
+            request_cancel,
+            stream_stop: Mutex::new(None),
+            producer_stop: Mutex::new(None),
+        }
+    }
+
+    /// The first factory starts the only clock. Retry preparation uses this same state.
+    pub(crate) fn start(&self) {
+        if let Some(ms) = self.timeout_ms {
+            self.state.get_or_init(|| {
+                let state = Arc::new(codex_extension_api::ModelInvocationDeadlineState::new(
+                    Instant::now() + std::time::Duration::from_millis(u64::from(ms)),
+                    self.request_cancel.clone(),
+                ));
+                if let Some(stop) = &self.turn_stop {
+                    stop.install_model_deadline(state.clone());
+                }
+                state
+            });
+            self.started.cancel();
+        }
+    }
+
+    pub(crate) fn cancellation_token(&self) -> CancellationToken {
+        self.request_cancel.clone()
+    }
+
+    pub(crate) fn attach_task_stop(&self, task: Arc<super::owned_turn_stop::OwnedTurnTask>) {
+        let _ = self.owned_task.set(task);
+    }
+
+    pub(crate) fn attach_tasks(&self, tasks: [Option<tokio::task::JoinHandle<()>>; 2]) {
+        let tasks_owner = self.tasks.get_or_init(|| {
+            tokio::sync::Mutex::new(RequestTasks {
+                handles: Vec::new(),
+                errors: Vec::new(),
+            })
+        });
+        // A retry starts only after the previous attempt's retire_tasks completed.
+        // Outer abort joins the sampler before taking this lock. Register without
+        // an await so cancellation cannot detach freshly returned handles.
+        let mut owned = tasks_owner
+            .try_lock()
+            .expect("request retirement overlaps registration");
+        assert!(
+            owned.handles.is_empty(),
+            "prior attempt request tasks are still live"
+        );
+        owned.handles.extend(tasks.into_iter().flatten());
+    }
