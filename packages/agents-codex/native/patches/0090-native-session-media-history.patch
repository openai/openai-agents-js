+    let (session, turn, events, release, mut flushes, _store) = gated_terminal_session(false).await;
+    assert!(
+        session
+            .input_queue
+            .reserve_tool_completion(
+                &session.active_turn,
+                &turn.sub_id,
+                &CancellationToken::new()
+            )
+            .await
+    );
+    turn.extension_data
+        .insert(crate::session::turn::ValidatedToolCompletion(
+            selected_tool_value(),
+        ));
+    release.notify_one();
+    let held = timeout(Duration::from_secs(2), flushes.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    let (_unrelated, next_context) = make_session_and_context().await;
+    let next_context = Arc::new(next_context);
+    let next_release = Arc::new(Notify::new());
+    let replacement = tokio::spawn({
+        let session = session.clone();
+        let next_context = next_context.clone();
+        let release = next_release.clone();
+        async move {
+            session
+                .spawn_task(next_context, Vec::new(), TerminalTask { release })
+                .await;
+        }
+    });
+    tokio::task::yield_now().await;
+    assert!(!replacement.is_finished());
+    assert!(Arc::ptr_eq(
+        &session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .task
+            .as_ref()
+            .unwrap()
+            .turn_context,
+        &turn
+    ));
+    held.release.send(Ok(())).unwrap();
+    recv_terminal_event(&events, TerminalEventKind::TurnComplete).await;
+    timeout(Duration::from_secs(2), replacement)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(Arc::ptr_eq(
+        &session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .task
+            .as_ref()
+            .unwrap()
+            .turn_context,
+        &next_context
+    ));
+    next_release.notify_one();
+}
