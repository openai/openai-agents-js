+struct PendingBody {
+    polls: Arc<AtomicUsize>,
+    dropped: Arc<AtomicBool>,
+}
+impl Stream for PendingBody {
+    type Item = Result<Bytes, TransportError>;
+    fn poll_next(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        self.polls.fetch_add(1, Ordering::SeqCst);
+        Poll::Pending
+    }
+}
+impl Drop for PendingBody {
+    fn drop(&mut self) {
+        self.dropped.store(true, Ordering::SeqCst);
+    }
+}
+#[tokio::test]
+async fn lazy_body_is_not_polled_at_headers_and_drop_releases_pending_body_directly() {
+    for stage in 0..3 {
+        let polls = Arc::new(AtomicUsize::new(0));
+        let dropped = Arc::new(AtomicBool::new(false));
+        let mut headers = HeaderMap::new();
+        headers.insert(
+            "openai-model",
+            http::HeaderValue::from_static("synthetic-json-model"),
+        );
+        let (_, mut events) = response_stream(
+            StreamResponse {
+                status: StatusCode::OK,
+                headers,
+                bytes: Box::pin(PendingBody {
+                    polls: polls.clone(),
+                    dropped: dropped.clone(),
+                }),
+            },
+            Duration::from_secs(5),
+            None,
+        );
+        assert_eq!(polls.load(Ordering::SeqCst), 0);
+        if stage > 0 {
+            assert!(matches!(
+                events.next().await,
+                Some(Ok(ResponseEvent::ServerModel(_)))
+            ));
+            assert_eq!(polls.load(Ordering::SeqCst), 0);
+            let reset = events.next().await;
+            assert!(default_header_reset(reset.as_ref()));
+            assert_eq!(polls.load(Ordering::SeqCst), 0);
+        }
+        if stage > 1 {
+            assert!(
+                tokio::time::timeout(Duration::from_millis(1), events.next())
+                    .await
+                    .is_err()
+            );
+            assert!(polls.load(Ordering::SeqCst) > 0);
+        }
+        drop(events);
+        assert!(dropped.load(Ordering::SeqCst));
+    }
+}
