+#[test]
+fn retained_provider_references_follow_current_profile_without_changing_history() {
+    use codex_extension_api::ProviderImageReferencePolicy::{
+        PrepareInline, QualifiedStandardResponses,
+    };
+    let mut prompt = prompt_with_image_outputs(Some(ImageDetail::Low));
+    for item in &mut prompt.input {
+        match item {
+            ResponseItem::Message { content, .. } => {
+                for part in content {
+                    if let ContentItem::InputImage { image, .. } = part {
+                        *image = ImageReference::Inline {
+                            image_url: "https://example.invalid/current.png".into(),
+                        };
+                    }
+                }
+            }
+            ResponseItem::FunctionCallOutput { output, .. } => {
+                for part in output.content_items_mut().unwrap() {
+                    if let FunctionCallOutputContentItem::InputImage { image, .. } = part {
+                        *image = ImageReference::Inline {
+                            image_url: "https://example.invalid/current.png".into(),
+                        };
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    let canonical = prompt.input.clone();
+    let mut model = model_info_from_slug("gpt-5.4");
+    model.use_responses_lite = false;
+    prompt.provider_image_reference_policy = Some(QualifiedStandardResponses);
+    let standard = prompt.get_formatted_input_for_request(&model);
+    assert!(
+        serde_json::to_string(&standard)
+            .unwrap()
+            .contains("https://example.invalid/current.png")
+    );
+    model.use_responses_lite = true;
+    let lite = prompt.get_formatted_input_for_request(&model);
+    assert!(
+        !serde_json::to_string(&lite)
+            .unwrap()
+            .contains("https://example.invalid/current.png")
+    );
+    model.use_responses_lite = false;
+    prompt.provider_image_reference_policy = Some(PrepareInline);
+    let unqualified = prompt.get_formatted_input_for_request(&model);
+    assert!(
+        !serde_json::to_string(&unqualified)
+            .unwrap()
