+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn provider_image_reference_child_start_uses_current_authority(case: &str, preserved: bool) {
+    let server = start_mock_server().await;
+    let qualified_parent = case != "unqualified_parent" && case != "explicit_qualified";
+    let f = fixture(
+        &server,
+        qualified_parent.then_some(ProviderImageReferencePolicy::QualifiedStandardResponses),
+    )
+    .await;
+    if !qualified_parent {
+        // A late extension marker cannot create parent authority.
+        f.root
+            .thread
+            .session
+            .services
+            .thread_extension_data
+            .insert(ProviderImageReferencePolicy::QualifiedStandardResponses);
+    }
+    let mut config = f.config.clone();
+    if case == "lite" {
+        config.model = Some(LITE.into());
+    }
+    if case == "unified" {
+        config.model = Some(UNIFIED.into());
+    }
+    if case == "changed_provider_id" {
+        config.model_provider_id = "different-provider".into();
+    }
+    if case == "changed_provider_config" {
+        config.model_provider.name.push_str(" changed");
+    }
+    let mut options = StartThreadOptions::new(config.clone());
+    options.initial_history = InitialHistory::Forked(
+        image_items()
+            .into_iter()
+            .map(|item| RolloutItem::ResponseItem(item.into()))
+            .collect(),
+    );
+    options.session_source = Some(child_source(f.root.thread_id));
+    if case == "isolated" {
+        options
+            .thread_extension_init
+            .insert(SessionIsolation::Isolated);
+    }
+    if case == "internal" {
+        options.session_source = Some(SessionSource::Internal(
+            InternalSessionSource::MemoryConsolidation,
+        ));
+    }
+    if case == "explicit_inline" {
+        options
+            .thread_extension_init
+            .insert(ProviderImageReferencePolicy::PrepareInline);
+    }
+    if case == "explicit_qualified" {
+        options
+            .thread_extension_init
+            .insert(ProviderImageReferencePolicy::QualifiedStandardResponses);
+    }
+    let auth = if case == "changed_auth" {
+        AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+    } else {
+        f.manager.auth_manager()
+    };
+    let mut request =
+        ThreadSpawnRequest::new(options, auth, f.manager.agent_control_for_config(&config));
+    request.parent_thread_id = Some(f.root.thread_id);
+    if case == "source_only_parent" {
+        request.parent_thread_id = None;
+    }
+    if case == "mismatched_parent" {
+        request.parent_thread_id = Some(ThreadId::new());
+    }
+    if case == "missing_parent" {
+        let id = ThreadId::new();
+        request.parent_thread_id = Some(id);
+        request.options.session_source = Some(child_source(id));
+    }
+    if case == "history_only_parent" {
+        // Persist a real child first: stored lineage alone must not qualify a later start.
+        let mut saved_options = StartThreadOptions::new(config.clone());
+        saved_options.initial_history = request.options.initial_history.clone();
+        saved_options.session_source = Some(child_source(f.root.thread_id));
+        saved_options.history_mode = Some(ThreadHistoryMode::Legacy);
+        saved_options
+            .thread_extension_init
+            .insert(ProviderImageReferencePolicy::QualifiedStandardResponses);
+        let mut saved_request = ThreadSpawnRequest::new(
+            saved_options,
+            f.manager.auth_manager(),
+            f.manager.agent_control_for_config(&config),
+        );
+        saved_request.parent_thread_id = Some(f.root.thread_id);
+        let saved = f
+            .manager
+            .state
+            .spawn_thread(saved_request)
+            .await
+            .expect("persisted child");
+        saved.thread.ensure_rollout_materialized().await;
+        saved.thread.flush_rollout().await.expect("child rollout");
+        let path = saved.thread.rollout_path().expect("child path");
+        saved
+            .thread
+            .shutdown_and_wait()
+            .await
+            .expect("unload saved child");
+        f.manager.remove_thread(&saved.thread_id).await;
+        let history = RolloutRecorder::get_rollout_history(&path)
+            .await
+            .expect("saved child history");
+        assert_eq!(
+            history.get_resumed_parent_thread_id(),
+            Some(f.root.thread_id)
+        );
+        request.options.initial_history = history;
+        request.parent_thread_id = None;
+    }
+
+    let child = f
+        .manager
+        .state
+        .spawn_thread(request)
+        .await
+        .expect("child start");
+    assert_reference_output(
+        &request_existing_images(&server, &child.thread, false).await,
+        preserved,
+    );
+    child
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("child shutdown");
+    f.manager
+        .shutdown_all_threads_bounded(std::time::Duration::from_secs(10))
+        .await;
+}
