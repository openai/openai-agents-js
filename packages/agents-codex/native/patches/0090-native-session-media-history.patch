+//! Select only typed provider refusal/probability members, never arbitrary bodies.
+use codex_protocol::response_facts::{ProbabilityToken, ResponseFact};
+use serde_json::Value;
+
+fn probabilities(
+    raw: &Value,
+    item_id: Option<String>,
+    output_index: Option<u64>,
+    content_index: Option<u64>,
+    snapshot: bool,
+    delta: Option<String>,
+) -> Option<ResponseFact> {
+    let value = raw.get("logprobs")?;
+    if value.is_null() {
+        return None;
+    }
+    match serde_json::from_value::<Vec<ProbabilityToken>>(value.clone()) {
+        Ok(tokens) => Some(ResponseFact::TextProbabilities {
+            item_id,
+            output_index,
+            content_index,
+            snapshot,
+            delta,
+            tokens,
+            capture_complete: true,
+        }),
+        Err(_) => Some(ResponseFact::MalformedProbabilities),
+    }
+}
+
+pub(crate) fn event_facts(raw: &Value) -> Vec<ResponseFact> {
+    let kind = raw.get("type").and_then(Value::as_str).unwrap_or_default();
+    let item_id = raw
+        .get("item_id")
+        .and_then(Value::as_str)
+        .map(str::to_owned);
+    let output_index = raw.get("output_index").and_then(Value::as_u64);
+    let content_index = raw.get("content_index").and_then(Value::as_u64);
+    match kind {
+        "response.refusal.delta" | "response.refusal.done" => {
+            let snapshot = kind.ends_with(".done");
+            let text = raw
+                .get(if snapshot { "refusal" } else { "delta" })
+                .and_then(Value::as_str);
+            text.map(|text| {
+                vec![ResponseFact::Refusal {
+                    item_id,
+                    content_index,
+                    snapshot,
+                    text: text.to_owned(),
+                    capture_complete: true,
+                }]
+            })
+            .unwrap_or_default()
+        }
+        "response.output_text.delta" => probabilities(
+            raw,
+            item_id,
+            output_index,
+            content_index,
+            false,
+            raw.get("delta").and_then(Value::as_str).map(str::to_owned),
+        )
+        .into_iter()
+        .collect(),
+        "response.output_item.added" | "response.output_item.done" => raw
+            .get("item")
+            .map(|item| output_item_facts(item, output_index, kind.ends_with(".done")))
+            .unwrap_or_default(),
+        _ => Vec::new(),
+    }
+}
+
+pub(crate) fn output_item_facts(
+    item: &Value,
+    output_index: Option<u64>,
+    capture_probabilities: bool,
+) -> Vec<ResponseFact> {
+    if item.get("type").and_then(Value::as_str) != Some("message")
+        || item.get("role").and_then(Value::as_str) != Some("assistant")
+    {
+        return Vec::new();
+    }
+    let item_id = item.get("id").and_then(Value::as_str).map(str::to_owned);
+    let Some(content) = item.get("content").and_then(Value::as_array) else {
+        return Vec::new();
+    };
+    let mut facts = Vec::new();
+    for (index, part) in content.iter().enumerate() {
+        let content_index = u64::try_from(index).ok();
+        match part.get("type").and_then(Value::as_str) {
+            Some("refusal") => {
+                if let Some(text) = part.get("refusal").and_then(Value::as_str) {
+                    facts.push(ResponseFact::Refusal {
+                        item_id: item_id.clone(),
+                        content_index,
+                        snapshot: true,
+                        text: text.to_owned(),
+                        capture_complete: true,
+                    });
+                }
+            }
+            Some("output_text") if capture_probabilities => {
+                if let Some(fact) = probabilities(
+                    part,
+                    item_id.clone(),
+                    output_index,
+                    content_index,
+                    true,
+                    None,
+                ) {
+                    facts.push(fact);
+                }
+            }
+            _ => {}
+        }
+    }
+    facts
+}
+
+pub(crate) fn contains_refusal(item: &Value) -> bool {
+    item.get("type").and_then(Value::as_str) == Some("message")
+        && item.get("role").and_then(Value::as_str) == Some("assistant")
+        && item
+            .get("content")
+            .and_then(Value::as_array)
+            .is_some_and(|content| {
+                content.iter().any(|part| {
+                    part.get("type").and_then(Value::as_str) == Some("refusal")
+                        && part.get("refusal").and_then(Value::as_str).is_some()
+                })
+            })
+}
