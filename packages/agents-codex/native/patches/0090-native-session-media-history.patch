+#[tokio::test]
+async fn real_held_http_body_returns_headers_and_drop_retires_owned_socket() -> anyhow::Result<()> {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    for poll_body in [false, true] {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+        let address = listener.local_addr()?;
+        let client = client(format!("http://{address}"))?;
+        let mut server = tokio::spawn(async move {
+            let (mut socket, _) = listener.accept().await?;
+            let mut request = Vec::new();
+            let mut chunk = [0u8; 4096];
+            let header_end = loop {
+                let count = socket.read(&mut chunk).await?;
+                anyhow::ensure!(count > 0, "request closed before headers");
+                request.extend_from_slice(&chunk[..count]);
+                if let Some(end) = request.windows(4).position(|p| p == b"\r\n\r\n") {
+                    break end + 4;
+                }
+            };
+            let length = String::from_utf8_lossy(&request[..header_end])
+                .lines()
+                .find_map(|line| {
+                    let (name, value) = line.split_once(':')?;
+                    name.eq_ignore_ascii_case("content-length")
+                        .then(|| value.trim().parse::<usize>().unwrap())
+                })
+                .unwrap_or(0);
+            while request.len() - header_end < length {
+                let count = socket.read(&mut chunk).await?;
+                anyhow::ensure!(count > 0, "request body closed");
+                request.extend_from_slice(&chunk[..count]);
+            }
+            socket.write_all(b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 10000\r\nConnection: close\r\n\r\n").await?;
+            let count = socket.read(&mut chunk).await?;
+            anyhow::ensure!(count == 0, "response-body owner did not release its socket");
+            Ok::<_, anyhow::Error>(())
+        });
+        let result: anyhow::Result<()> = async {
+            let (_, mut events) = tokio::time::timeout(
+                Duration::from_secs(5),
+                client.json_request(request(), Default::default()),
+            )
+            .await??;
+            if poll_body {
+                let reset = events.next().await;
+                anyhow::ensure!(
+                    default_header_reset(reset.as_ref()),
+                    "expected default quota reset before body"
+                );
+                anyhow::ensure!(
+                    tokio::time::timeout(Duration::from_millis(10), events.next())
+                        .await
+                        .is_err(),
+                    "held body must remain pending"
+                );
+            }
+            drop(events);
+            Ok(())
+        }
+        .await;
+        if result.is_err() {
+            server.abort();
+        }
+        let joined = tokio::time::timeout(Duration::from_secs(5), &mut server).await;
+        let retirement = match joined {
+            Ok(joined) => joined.map_err(anyhow::Error::from).and_then(|r| r),
+            Err(error) => {
+                server.abort();
+                let _ = server.await;
+                Err(error.into())
+            }
+        };
+        result?;
+        retirement?;
+        drop(client);
+    }
+    Ok(())
+}
