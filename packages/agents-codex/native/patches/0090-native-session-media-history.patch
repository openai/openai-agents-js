+        ProbabilityToken {
+            token: "t".repeat(size),
+            bytes: Some(vec![116]),
+            logprob: (-1).into(),
+            top_logprobs: Some(vec![ProbabilityAlternative {
+                token: "private-alternative".repeat(size),
+                bytes: Some(vec![1, 2]),
+                logprob: (-2).into(),
+            }]),
+        }
+    }
+    fn probabilities(tokens: Vec<ProbabilityToken>) -> ResponseFact {
+        ResponseFact::TextProbabilities {
+            item_id: Some("item".into()),
+            output_index: Some(0),
+            content_index: Some(0),
+            snapshot: false,
+            delta: Some("t".into()),
+            tokens,
+            capture_complete: true,
+        }
+    }
+    #[test]
+    fn cumulative_frames_keep_whole_tokens_and_reserve_refusal() {
+        let mut budget = ResponseFactBudget::default();
+        let mut retained = Vec::new();
+        for _ in 0..500 {
+            if let Some(fact) = budget.capture(probabilities(vec![token(128); 10])) {
+                retained.push(fact);
+            }
+        }
+        let refusal = budget
+            .capture(ResponseFact::Refusal {
+                item_id: Some("refusal".into()),
+                content_index: Some(0),
+                snapshot: true,
+                text: "private-refusal".repeat(2000),
+                capture_complete: true,
+            })
+            .unwrap();
+        let ResponseFact::Refusal {
+            text,
+            capture_complete,
+            ..
+        } = &refusal
+        else {
+            panic!("refusal reservation must remain usable");
+        };
+        assert!(!text.is_empty());
+        assert!(!capture_complete);
+        assert!(encoded_text_len(text) <= REFUSAL_TEXT_BYTES);
+        retained.push(refusal);
+        assert!(retained.iter().map(encoded_len).sum::<usize>() <= RESPONSE_FACT_BYTES);
+        assert!(retained.iter().any(|fact| matches!(
+            fact,
+            ResponseFact::TextProbabilities {
+                capture_complete: false,
+                ..
+            }
+        )));
+        for fact in retained {
+            if let ResponseFact::TextProbabilities { tokens, .. } = fact {
+                for captured in tokens {
+                    assert_eq!(captured, token(128));
+                }
+            }
+        }
+    }
+    #[test]
+    fn escaped_unicode_refusal_prefix_is_valid_and_cumulatively_bounded() {
+        let mut budget = ResponseFactBudget::default();
+        let mut encoded = 0;
+        for _ in 0..100 {
+            let fact = budget.capture(ResponseFact::Refusal {
+                item_id: None,
+                content_index: None,
+                snapshot: false,
+                text: "🧪\"\n".repeat(1000),
+                capture_complete: true,
+            });
+            if let Some(ResponseFact::Refusal { text, .. }) = fact {
+                encoded += encoded_text_len(&text);
+            }
+        }
+        assert!(encoded <= REFUSAL_TEXT_BYTES);
+    }
+    #[test]
+    fn global_budget_includes_every_fact_and_one_exhaustion_marker() {
+        let mut budget = ResponseFactBudget::default();
+        let mut bytes = 0;
+        let mut markers = 0;
+        for _ in 0..2000 {
+            if let Some(fact) = budget.capture(ResponseFact::Refusal {
+                item_id: Some("r".repeat(1024)),
+                content_index: None,
+                snapshot: false,
+                text: String::new(),
+                capture_complete: true,
+            }) {
+                markers += usize::from(matches!(fact, ResponseFact::CaptureTruncated));
+                bytes += encoded_len(&fact);
+            }
+        }
+        assert_eq!(markers, 1);
+        assert!(bytes <= RESPONSE_FACT_BYTES);
+    }
+    #[test]
+    fn absent_and_empty_provider_bytes_and_alternatives_remain_distinct() {
+        let missing: ProbabilityToken =
+            serde_json::from_value(serde_json::json!({"token":"a","logprob":-1})).unwrap();
+        let empty: ProbabilityToken = serde_json::from_value(
+            serde_json::json!({"token":"a","logprob":-1,"bytes":[],"top_logprobs":[]}),
+        )
+        .unwrap();
+        assert_eq!(missing.bytes, None);
+        assert_eq!(missing.top_logprobs, None);
+        assert_eq!(empty.bytes, Some(vec![]));
+        assert_eq!(empty.top_logprobs, Some(vec![]));
+        assert!(
+            serde_json::from_value::<ProbabilityToken>(
+                serde_json::json!({"token":"a","logprob":"NaN"})
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn default_diagnostics_never_format_content() {
+        let fact = ResponseFact::Refusal {
+            item_id: None,
+            content_index: None,
+            snapshot: true,
+            text: "private-refusal".into(),
+            capture_complete: true,
+        };
+        assert!(!format!("{fact:?}").contains("private-refusal"));
+        assert!(!format!("{:?}", probabilities(vec![token(1)])).contains("private-alternative"));
+    }
+    #[test]
+    fn record_metadata_and_escaping_consume_the_same_budget() {
+        let mut budget = ResponseFactBudget::default();
+        let fact = ResponseFact::Refusal {
+            item_id: None,
+            content_index: None,
+            snapshot: true,
+            text: "private".into(),
+            capture_complete: true,
+        };
+        let first = budget.capture_retained(fact.clone(), 600_000, 400).unwrap();
+        let second = budget.capture_retained(fact, 600_000, 400).unwrap();
+        assert!(matches!(second, ResponseFact::CaptureTruncated));
+        assert!(600_000 + encoded_len(&first) + 400 <= RESPONSE_FACT_BYTES);
+        assert!(budget.is_exhausted());
+        let mut oversized = ResponseFactBudget::default();
+        assert!(matches!(
+            oversized.capture_retained(probabilities(vec![token(1)]), RESPONSE_FACT_BYTES + 1, 400),
+            Some(ResponseFact::CaptureTruncated)
+        ));
+        assert_eq!(oversized.used, 400);
+    }
+}
