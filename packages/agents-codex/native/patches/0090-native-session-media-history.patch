+/// Whether the exact current formatting configuration retains Low inline data images.
+/// This does not grant route or model authority; callers retain their existing checks.
+pub fn inline_data_url_low_detail_supported(
+    config: &crate::config::Config,
+    model_info: &ModelInfo,
+) -> bool {
+    unified_image_budget_enabled(&config.features, model_info)
+}
+
+/// Rejects the known lossy formatting path without reading or preparing image bytes.
+pub fn validate_inline_image_detail(
+    image: &ImageReference,
+    detail: Option<ImageDetail>,
+    inline_data_url_low_detail_supported: bool,
+) -> Result<(), String> {
+    if !inline_data_url_low_detail_supported
+        && detail == Some(ImageDetail::Low)
+        && matches!(image, ImageReference::Inline { image_url } if is_data_url(image_url))
+    {
+        return Err(
+            "detail 'low' is not supported for inline image data by the current image format"
+                .into(),
+        );
+    }
+    Ok(())
+}
+
+pub(crate) fn validate_live_image_format(
+    image: &ImageReference,
+    detail: Option<ImageDetail>,
+    supported: bool,
+    reference_policy: ProviderImageReferencePolicy,
+) -> Result<(), String> {
+    if reference_policy != ProviderImageReferencePolicy::QualifiedStandardResponses
+        && (matches!(image, ImageReference::File { .. })
+            || matches!(image, ImageReference::Inline { image_url } if is_remote_image_url(image_url)))
+    {
+        return Err("current image format cannot preserve provider image references".into());
+    }
+    validate_inline_image_detail(image, detail, supported)
+}
+
+pub(crate) fn validate_inline_image_items(
+    item: &ResponseItem,
+    supported: bool,
+    reference_policy: ProviderImageReferencePolicy,
+) -> Result<(), String> {
+    match item {
+        ResponseItem::Message { content, .. } => {
+            for part in content {
+                if let ContentItem::InputImage { image, detail } = part {
+                    validate_live_image_format(image, *detail, supported, reference_policy)?;
+                }
+            }
+        }
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => {
+            if let Some(parts) = output.content_items() {
+                for part in parts {
+                    if let FunctionCallOutputContentItem::InputImage { image, detail } = part {
+                        validate_live_image_format(image, *detail, supported, reference_policy)?;
+                    }
+                }
+            }
+        }
+        _ => {}
+    }
+    Ok(())
