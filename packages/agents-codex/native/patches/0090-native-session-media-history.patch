+                    "unsupported returned file".into(),
+                    backend.clone()
+                )
+        );
+        session.cancel_code_mode_owner(&turn).await;
+        task.return_after_cancel.cancel();
+        owner_gate_is_held(&session).await;
+        release_late.cancel();
+        late_done.cancelled().await;
+        backend.terminate_release.cancel();
+        let mut errors = Vec::new();
+        let complete = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            loop {
+                match events.recv().await.unwrap().msg {
+                    codex_protocol::protocol::EventMsg::Error(error) => errors.push(error),
+                    codex_protocol::protocol::EventMsg::TurnComplete(event) => break event,
+                    codex_protocol::protocol::EventMsg::TurnAborted(_) => {
+                        panic!("owned fatal lost its failure classification")
+                    }
+                    _ => {}
+                }
+            }
+        })
+        .await
+        .unwrap();
+        let expected = if prior_primary {
+            "original model failure"
+        } else {
+            "unsupported returned file"
+        };
+        let expected = codex_protocol::error::CodexErr::Fatal(expected.into())
+            .to_error_event(None)
+            .message;
