+async fn explicit_output_cap_stops_after_retained_typed_limit_but_uncapped_policy_remains() {
+    for explicit_cap in [false, true] {
+        let mut observation = terminal_observation("configured-output-cap");
+        if let ResponseEvent::ResponseObserved(value) = &mut observation {
+            value.status = codex_protocol::protocol::ResponseObservationStatus::Incomplete;
+            value.incomplete_reason =
+                Some(codex_protocol::protocol::ResponseIncompleteReason::MaxOutputTokens);
+        }
+        let api_stream = futures::stream::iter([
+            Ok(observation),
+            Err(ApiError::Stream(
+                "Incomplete response returned, reason: max_output_tokens".into(),
+            )),
+        ]);
+        let (mut stream, _) = super::map_response_events(
+            None,
+            api_stream,
+            test_session_telemetry(),
+            InferenceTraceAttempt::disabled(),
+            test_model_provider(),
+            explicit_cap,
+        );
+        assert!(matches!(
+            stream.next().await,
+            Some(Ok(ResponseEvent::ResponseObserved(_)))
+        ));
+        let error = tokio::time::timeout(Duration::from_secs(5), stream.next())
+            .await
+            .expect("mapper must retire")
+            .expect("limit error")
+            .unwrap_err();
+        assert_eq!(error.retry_delay(1).is_none(), explicit_cap);
+    }
+}
