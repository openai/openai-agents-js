+// Isolate the broader JS finalizer rule without introducing a new storage
+// adapter: the controlled task returns the same secondary Fatal classification
+// that a pre-finalizer flush failure produces. This test does not perform failing
+// store I/O; actual flush/fence failure remains a separate qualification case.
+struct ModelErrorThenSecondaryTaskFailure;
+impl crate::tasks::SessionTask for ModelErrorThenSecondaryTaskFailure {
+    fn kind(&self) -> crate::state::TaskKind {
+        crate::state::TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "test.preexisting_primary_no_file"
