+pub(super) fn normalize_output_file(
+    scope: &mut v8::PinScope<'_, '_>,
+    value: v8::Local<'_, v8::Value>,
+) -> Result<FunctionCallOutputContentItem, ()> {
+    let result = (|| -> Result<_, String> {
+        if !scope.get_slot::<super::RuntimeState>().is_some_and(|owner| owner.reference_profile == codex_protocol::provider_reference_profile::ProviderImageReferencePolicy::QualifiedStandardResponses) {
+            return Err("file output requires the current qualified Responses route".into());
+        }
+        let value =
+            v8_value_to_json(scope, value)?.ok_or("file expects an object with one file source")?;
+        let file = serde_json::from_value::<codex_protocol::input_file::InputFile>(value).map_err(
+            |_| "file expects exactly one file_id, file_data, or HTTPS file_url".to_owned(),
+        )?;
+        Ok(FunctionCallOutputContentItem::InputFile { file })
+    })();
+    match result {
+        Ok(item) => Ok(item),
+        Err(error) => {
+            throw_type_error(scope, &error);
+            Err(())
+        }
+    }
+}
