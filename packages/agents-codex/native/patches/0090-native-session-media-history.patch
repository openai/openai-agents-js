+use super::*;
+use bytes::Bytes;
+use codex_client::TransportError;
+use futures::Stream;
+use http::HeaderMap;
+use http::StatusCode;
+use serde_json::json;
+use std::pin::Pin;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::task::{Context, Poll};
+
+type Events = Vec<Result<ResponseEvent, ApiError>>;
+
+// Even absent quota headers emit Core's explicit default-reset snapshot. Do not
+// discard arbitrary events: every fixture here expects this exact header prefix.
+fn default_header_reset(event: Option<&Result<ResponseEvent, ApiError>>) -> bool {
+    matches!(event, Some(Ok(ResponseEvent::RateLimits(
+        codex_protocol::protocol::RateLimitSnapshot {
+            limit_id: Some(id), limit_name: None, normal_model_slug: None,
+            primary: None, secondary: None, credits: None, individual_limit: None,
+            spend_control_reached: None, plan_type: None, rate_limit_reached_type: None,
+        }
+    ))) if id == "codex")
+}
+fn terminal(status: &str, output: Value) -> Value {
+    json!({"id":"resp-json","status":status,"output":output,"usage":{
+        "input_tokens":10,"output_tokens":4,"total_tokens":14,
+        "input_tokens_details":{"cached_tokens":2},"output_tokens_details":{"reasoning_tokens":1}}})
+}
+fn message(id: &str, text: &str) -> Value {
+    json!({"type":"message","id":id,"role":"assistant","phase":"final_answer", "content":[
+        {"type":"output_text","text":text,"annotations":[{"type":"url_citation","url":"https://example.com","start_index":0,"end_index":1,"title":"source"}]}]})
+}
+fn from_bytes(body: Vec<u8>) -> BoxStream<'static, Result<ResponseEvent, ApiError>> {
+    response_stream(
+        StreamResponse {
+            status: StatusCode::OK,
+            headers: HeaderMap::new(),
+            bytes: Box::pin(futures::stream::iter([Ok(Bytes::from(body))])),
+        },
+        Duration::from_secs(5),
+        None,
+    )
+    .1
+}
+async fn collect(value: Value) -> Events {
+    tokio::time::timeout(
+        Duration::from_secs(5),
+        from_bytes(serde_json::to_vec(&value).unwrap()).collect(),
+    )
+    .await
+    .expect("lazy projection must settle")
+}
+#[tokio::test]
+async fn unicode_multi_item_blank_tail_and_citations_retain_full_done_items() {
+    let first = message("msg-first", "Résumé 👋\n終わり");
+    let last = message("msg-last", " \n");
+    let events = collect(terminal("completed", json!([first.clone(), last.clone()]))).await;
+    let text: Vec<_> = events
+        .iter()
+        .filter_map(|e| match e {
+            Ok(ResponseEvent::OutputTextDelta(s)) => Some(s.as_str()),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(text, ["Résumé 👋\n終わり", " \n"]);
+    let done: Vec<_> = events
+        .iter()
+        .filter_map(|e| match e {
+            Ok(ResponseEvent::OutputItemDone(item)) => Some(serde_json::to_value(item).unwrap()),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(done, [first, last]);
+    assert!(
+        events
+            .iter()
+            .filter_map(|e| match e {
+                Ok(ResponseEvent::OutputItemAdded(ResponseItem::Message { content, .. })) =>
+                    Some(content),
+                _ => None,
+            })
+            .all(Vec::is_empty)
+    );
+    assert!(
+        matches!(events.last(), Some(Ok(ResponseEvent::Completed {response_id,..})) if response_id=="resp-json")
+    );
+}
