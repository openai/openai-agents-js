+enum InvocationDeadlineOutcome { Active, Accepted, Cancelled, Expired }
+
+#[derive(Debug)]
+pub struct ModelInvocationDeadlineState {
+    expires_at: tokio::time::Instant,
+    outcome: std::sync::Mutex<InvocationDeadlineOutcome>,
+    request_cancel: tokio_util::sync::CancellationToken,
+    settled: tokio_util::sync::CancellationToken,
+    requested: std::sync::OnceLock<std::sync::Arc<std::sync::atomic::AtomicBool>>,
+}
+
+impl ModelInvocationDeadlineState {
+    pub fn new(expires_at: tokio::time::Instant, request_cancel: tokio_util::sync::CancellationToken) -> Self {
+        Self { expires_at, outcome: std::sync::Mutex::new(InvocationDeadlineOutcome::Active),
+            request_cancel, settled: tokio_util::sync::CancellationToken::new(),
+            requested: std::sync::OnceLock::new() }
+    }
+    pub fn bind_stop_flag(&self, requested: std::sync::Arc<std::sync::atomic::AtomicBool>) {
+        assert!(self.requested.set(requested).is_ok(), "deadline stop flag bound twice");
+    }
+    pub fn expires_at(&self) -> tokio::time::Instant { self.expires_at }
+    pub fn settled(&self) -> tokio_util::sync::CancellationToken { self.settled.clone() }
+    pub fn expired(&self) -> bool {
+        *self.outcome.lock().unwrap_or_else(std::sync::PoisonError::into_inner) == InvocationDeadlineOutcome::Expired
+    }
+    fn refresh(&self, outcome: &mut InvocationDeadlineOutcome) {
+        if *outcome != InvocationDeadlineOutcome::Active { return; }
+        // An external cancellation already observed before expiry stays cancellation.
+        // Expiry reserves its status before it cancels this same request token.
+        if self.request_cancel.is_cancelled() {
+            *outcome = InvocationDeadlineOutcome::Cancelled;
+        } else if tokio::time::Instant::now() >= self.expires_at {
+            *outcome = InvocationDeadlineOutcome::Expired;
+            if let Some(requested) = self.requested.get() {
+                requested.store(true, std::sync::atomic::Ordering::Release);
+            }
+        }
+    }
+    fn notify(&self, outcome: InvocationDeadlineOutcome) {
+        // Wake other owners only after releasing the status mutex.
+        if outcome == InvocationDeadlineOutcome::Expired { self.request_cancel.cancel(); }
+        if outcome != InvocationDeadlineOutcome::Active { self.settled.cancel(); }
+    }
+    fn observe(&self) -> InvocationDeadlineOutcome {
+        let current = {
+            let mut outcome = self.outcome.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            self.refresh(&mut outcome);
+            *outcome
+        };
+        self.notify(current);
+        current
+    }
+    pub fn expire_if_due(&self) -> bool { self.observe() == InvocationDeadlineOutcome::Expired }
+    pub fn denies_admission(&self) -> bool {
+        matches!(self.observe(), InvocationDeadlineOutcome::Cancelled | InvocationDeadlineOutcome::Expired)
+    }
+    /// Run only native synchronous entry bookkeeping under this gate.
+    pub fn admit<T>(&self, enter: impl FnOnce() -> T) -> Option<T> {
+        let (result, current) = {
+            let mut outcome = self.outcome.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            self.refresh(&mut outcome);
+            let result = match *outcome {
+                InvocationDeadlineOutcome::Active | InvocationDeadlineOutcome::Accepted => Some(enter()),
+                InvocationDeadlineOutcome::Cancelled | InvocationDeadlineOutcome::Expired => None,
+            };
+            (result, *outcome)
+        };
+        self.notify(current);
+        result
+    }
+    pub fn accept_outcome(&self) -> bool {
+        let current = {
+            let mut outcome = self.outcome.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            self.refresh(&mut outcome);
+            if *outcome == InvocationDeadlineOutcome::Active { *outcome = InvocationDeadlineOutcome::Accepted; }
+            *outcome
+        };
+        self.notify(current);
+        current == InvocationDeadlineOutcome::Accepted
+    }
+    pub fn cancel(&self) {
+        let current = {
+            let mut outcome = self.outcome.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            if *outcome == InvocationDeadlineOutcome::Active { *outcome = InvocationDeadlineOutcome::Cancelled; }
+            *outcome
+        };
+        self.notify(current);
+    }
+}
