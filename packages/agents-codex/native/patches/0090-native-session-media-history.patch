+async fn pre_sampling_compaction_or_report(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    client_session: &mut ModelClientSession,
+    input: &[TurnInput],
+    cancellation_token: &CancellationToken,
+    prepared_current_step: Option<Arc<StepContext>>,
+    input_was_recorded: bool,
+) -> CodexResult<bool> {
+    let result = run_pre_sampling_compact(
+        sess,
+        turn_context,
+        client_session,
+        cancellation_token,
+        prepared_current_step.clone(),
+    )
+    .await;
+    if let Some(current) = prepared_current_step {
+        sess.set_last_known_step_context(&current).await;
+    }
+    if let Err(err) = result {
+        // Ordinary preparation has not recorded input yet; deferred recovery has.
+        if !input_was_recorded {
+            let _ = run_hooks_and_record_inputs(
+                sess,
+                turn_context,
+                &turn_context.capture_current_model_info(),
+                input,
+                PersistContext::Standard,
+            )
+            .await;
+        }
+        if matches!(err.details(), CodexErrorDetails::TurnAborted) {
+            return Err(err);
+        }
+        if matches!(err.details(), CodexErrorDetails::ToolCollision(_)) {
+            return Err(err);
+        }
+        let error = err.to_codex_protocol_error();
+        sess.emit_turn_error_lifecycle(turn_context.as_ref(), error.clone(), &err)
+            .await;
+        // Publish the failure only after prompt hooks finish, so clients cannot react to
+        // an error by steering follow-up input into a turn still preserving its prompt.
+        let message_prefix = match turn_context.provider.capabilities().remote_compaction {
+            RemoteCompactionSupport::V2 => Some("Error running remote compact task".to_string()),
+            RemoteCompactionSupport::Unsupported => None,
+        };
+        sess.send_event(
+            turn_context.as_ref(),
+            EventMsg::Error(err.to_error_event(message_prefix)),
+        )
+        .await;
+        error!("Failed to run pre-sampling compact");
+        return Ok(false);
+    }
+
+    Ok(true)
+}
+
+#[instrument(level = "trace", skip_all)]
+async fn run_pre_sampling_compact(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    client_session: &mut ModelClientSession,
+    cancellation_token: &CancellationToken,
+    prepared_current_step: Option<Arc<StepContext>>,
+) -> CodexResult<()> {
+    maybe_run_previous_model_inline_compact(
+        sess,
+        turn_context,
+        client_session,
+        cancellation_token,
+        prepared_current_step.clone(),
+    )
+    .await?;
+    let token_status =
+        super::context_window::context_window_token_status(sess.as_ref(), turn_context.as_ref())
+            .await;
+    // Compact if the configured auto-compaction budget or usable context window is exhausted.
+    if token_status.token_limit_reached {
+        // Pre-turn compaction runs before run_turn creates the normal sampling step.
+        let step_context = match prepared_current_step {
+            Some(step) => step,
+            None => {
+                sess.capture_step_context(Arc::clone(turn_context), cancellation_token)
+                    .await?
+            }
+        };
+        let world_state = Arc::new(sess.build_world_state_for_step(&step_context).await?);
+        run_auto_compact(
+            sess,
+            Arc::clone(&step_context),
+            step_context,
+            client_session,
+            world_state,
+            cancellation_token,
+            CompactionReason::ContextLimit,
+            CompactionPhase::PreTurn,
+        )
+        .await?;
+    }
+    Ok(())
+}
+
+/// Returns true only when both turns declare compaction compatibility hashes and they differ.
+/// A missing hash does not provide enough information to trigger compaction.
+fn comp_hash_changed(previous: Option<&str>, current: Option<&str>) -> bool {
+    previous
+        .zip(current)
+        .is_some_and(|(previous, current)| previous != current)
+}
+
+/// Runs pre-sampling compaction against the previous model when its compaction compatibility
+/// hash changed or when switching to a smaller context-window model.
+///
+/// Returns `Err(_)` only when compaction was attempted and failed.
+async fn maybe_run_previous_model_inline_compact(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    client_session: &mut ModelClientSession,
+    cancellation_token: &CancellationToken,
+    prepared_current_step: Option<Arc<StepContext>>,
+) -> CodexResult<()> {
+    let Some(previous_turn_settings) = sess.previous_turn_settings().await else {
+        return Ok(());
+    };
+    let should_compact_for_comp_hash_change = comp_hash_changed(
+        previous_turn_settings.comp_hash.as_deref(),
+        turn_context.model_info().comp_hash.as_deref(),
+    );
+    let previous_model = previous_turn_settings.model;
+    if !should_compact_for_comp_hash_change && previous_model == turn_context.model_info().slug {
+        return Ok(());
+    }
+    let mut previous_model_turn_context = turn_context
+        .with_model(previous_model.clone(), &sess.services.models_manager)
+        .await;
+    // `with_model` preserves the current turn's access program. Restore the previous
+    // turn's program so compaction uses the same model/cyber_access_program pair as that turn.
+    // Combining the previous model with the current turn's program can produce a pair
+    // that the server rejects.
+    previous_model_turn_context.cyber_access_program = cyber_access_program::for_provider(
+        &previous_model_turn_context.config.model_provider_id,
+        previous_turn_settings.cyber_access_program,
+    );
+    let previous_model_turn_context = Arc::new(previous_model_turn_context);
+
+    let reason = if should_compact_for_comp_hash_change {
+        CompactionReason::CompHashChanged
+    } else {
+        let Some(old_context_window) = previous_model_turn_context.model_context_window() else {
+            return Ok(());
+        };
+        let Some(new_context_window) = turn_context.model_context_window() else {
+            return Ok(());
+        };
+        let Some(active_context_tokens) = sess.get_total_token_usage().await else {
+            // Unknown file expansion cannot justify a guessed model-switch compaction.
+            return Ok(());
+        };
+        let previous_model_limit_reached =
+            match turn_context.config.model_auto_compact_token_limit_scope {
+                AutoCompactTokenLimitScope::Total => {
+                    let new_auto_compact_limit = turn_context
+                        .model_info()
+                        .auto_compact_token_limit()
+                        .unwrap_or(i64::MAX);
+                    active_context_tokens > new_auto_compact_limit
+                        || active_context_tokens >= new_context_window
+                }
+                AutoCompactTokenLimitScope::BodyAfterPrefix => {
+                    active_context_tokens >= new_context_window
+                }
+            };
+        if !previous_model_limit_reached
+            || previous_model_turn_context.model_info().slug == turn_context.model_info().slug
+            || old_context_window <= new_context_window
+        {
+            return Ok(());
+        }
+        CompactionReason::ModelDownshift
+    };
+
+    let step_context = if prepared_current_step.is_some() {
+        sess.capture_speculative_step_context(previous_model_turn_context, cancellation_token)
+            .await?
+    } else {
+        sess.capture_step_context(previous_model_turn_context, cancellation_token)
+            .await?
+    };
+    // The previous model summarizes the old window; the current model owns its replacement.
+    // Reuse the replacement step if the compaction request needs to fall back to that model.
+    let replacement_step_context = match prepared_current_step {
+        Some(step) => step,
+        None => {
+            sess.capture_speculative_step_context(Arc::clone(turn_context), cancellation_token)
+                .await?
+        }
+    };
+    let world_state = Arc::new(
+        sess.build_world_state_for_step(&replacement_step_context)
+            .await?,
+    );
+    run_auto_compact(
+        sess,
+        step_context,
+        replacement_step_context,
+        client_session,
+        world_state,
+        cancellation_token,
+        reason,
+        CompactionPhase::PreTurn,
+    )
+    .await?;
+    Ok(())
+}
+
+/// `world_state` belongs to `replacement_step_context`, which may differ from the compactor.
+#[allow(clippy::too_many_arguments)]
+#[instrument(
+    level = "trace",
+    skip_all,
+    fields(reason = ?reason, phase = ?phase)
+)]
+async fn run_auto_compact(
+    sess: &Arc<Session>,
+    step_context: Arc<StepContext>,
+    replacement_step_context: Arc<StepContext>,
+    client_session: &mut ModelClientSession,
+    world_state: Arc<WorldState>,
+    cancellation_token: &CancellationToken,
+    reason: CompactionReason,
+    phase: CompactionPhase,
+) -> CodexResult<()> {
+    let turn_context = &step_context.turn;
+    if sess
+        .services
+        .extensions
+        .model_request_contributors()
+        .iter()
+        .any(|contributor| contributor.prepares_request(&turn_context.extension_data))
+    {
+        if matches!(phase, CompactionPhase::PostTurn) {
+            return Ok(());
+        }
+        let err = CodexErr::Fatal("automatic compaction is unsupported for an operation with prepare_request; shorten the input or start a new operation".into());
+        return Err(err);
+    }
+
+    if matches!(phase, CompactionPhase::PreTurn)
+        && crate::guardian::is_basic_session_source(&turn_context.session_source)
+        && !crate::guardian::should_compact_guardian_input(sess)?
+    {
+        return Ok(());
+    }
+    let _profile_guard = turn_context.turn_timing_state.begin_compaction();
+    let _compaction_span = trace_span!(
+        "codex.compaction",
+        codex.turn.phase = "compaction",
+        conversation.id = %sess.thread_id,
+        turn.id = %turn_context.sub_id,
+    );
+    if turn_context.config.features.enabled(Feature::TokenBudget) {
+        // Compaction is the reset request, so force a new context window
+        // instead of consuming a pending `new_context` tool request.
+        crate::compact_token_budget::run_inline_auto_compact_task(
+            Arc::clone(sess),
+            replacement_step_context,
+            world_state,
+        )
+        .await?;
+        return Ok(());
+    }
+
+    if crate::model_request::turn_sampling_stop(&turn_context.extension_data)
+        .is_some_and(|stop| stop.requested())
+    {
+        // The native interrupt still owns task cancellation and cleanup.
+        cancellation_token.cancelled().await;
+        return Err(CodexErr::TurnAborted);
+    }
+
+    match turn_context.provider.capabilities().remote_compaction {
+        RemoteCompactionSupport::V2 => {
+            emit_compact_metric(
+                &sess.services.session_telemetry,
+                "remote_v2",
+                /*manual*/ false,
+            );
+            run_inline_remote_auto_compact_task_v2(
+                Arc::clone(sess),
+                step_context,
+                replacement_step_context,
+                client_session,
+                world_state,
+                reason,
+                phase,
+            )
+            .await?;
+        }
+        RemoteCompactionSupport::Unsupported => {
+            emit_compact_metric(
+                &sess.services.session_telemetry,
+                "local",
+                /*manual*/ false,
+            );
+            run_inline_auto_compact_task(
+                Arc::clone(sess),
+                Arc::clone(turn_context),
+                replacement_step_context,
+                world_state,
+                reason,
+                phase,
+            )
+            .await?;
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn collect_explicit_app_ids_from_skill_items(
+    skill_items: &[ResponseItem],
+    connectors: &[connectors::AppInfo],
+    skill_name_counts_lower: &HashMap<String, usize>,
+) -> HashSet<String> {
+    if skill_items.is_empty() || connectors.is_empty() {
+        return HashSet::new();
+    }
+
+    let skill_messages = skill_items
+        .iter()
+        .filter_map(|item| match item {
+            ResponseItem::Message { content, .. } => {
+                content.iter().find_map(|content_item| match content_item {
+                    ContentItem::InputText { text } => Some(text.clone()),
+                    _ => None,
+                })
+            }
+            _ => None,
+        })
+        .collect::<Vec<String>>();
+    if skill_messages.is_empty() {
+        return HashSet::new();
+    }
+
+    let mentions = collect_tool_mentions_from_messages(&skill_messages);
+    let mention_names_lower = mentions
+        .plain_names
+        .iter()
+        .map(|name| name.to_ascii_lowercase())
+        .collect::<HashSet<String>>();
+    let mut connector_ids = mentions
+        .paths
+        .iter()
+        .filter(|path| tool_kind_for_path(path) == ToolMentionKind::App)
+        .filter_map(|path| app_id_from_path(path).map(str::to_string))
+        .collect::<HashSet<String>>();
+
+    let connector_slug_counts = build_connector_slug_counts(connectors);
+    for connector in connectors {
+        let slug = codex_connectors::metadata::connector_mention_slug(connector);
+        let connector_count = connector_slug_counts.get(&slug).copied().unwrap_or(0);
+        let skill_count = skill_name_counts_lower.get(&slug).copied().unwrap_or(0);
+        if connector_count == 1 && skill_count == 0 && mention_names_lower.contains(&slug) {
+            connector_ids.insert(connector.id.clone());
+        }
+    }
+
+    connector_ids
+}
+
+#[instrument(level = "trace", skip_all)]
+pub(crate) fn build_prompt(
+    input: Vec<ResponseItem>,
+    step_context: &StepContext,
+    base_instructions: BaseInstructions,
+) -> Prompt {
+    let turn_context = &step_context.turn;
+    let mut input = input;
+    if crate::tools::spec_plan::has_selected_tool_plan(&step_context.extension_data) {
+        input.retain_mut(|item| step_context.tool_router.project_tool_catalog_item(item));
+    }
+    Prompt {
+        prefer_buffered_response: false,
+        input,
+        tools: if step_context.uses_incremental_tools() {
+            Arc::default()
+        } else {
+            step_context.tool_router.model_visible_specs()
+        },
+        parallel_tool_calls: true,
+        tool_choice: step_context.settings.tool_choice(),
+        request_controls: Default::default(),
+        tool_admission: None,
+        sampling_stop: None,
+        prepared_request_admission: None,
+        base_instructions,
+        output_schema: turn_context.final_output_json_schema.clone(),
+        output_schema_strict: !crate::guardian::is_basic_session_source(
+            &turn_context.session_source,
+        ),
+        provider_image_reference_policy: None,
+        cyber_access_program: turn_context.cyber_access_program,
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+#[allow(deprecated)]
+#[instrument(level = "trace",
+    skip_all,
+    fields(
+        turn_id = %step_context.turn.sub_id,
+        model = %step_context.settings.model_info.slug,
+        cwd = %step_context.turn.cwd.display()
+    )
+)]
+async fn run_sampling_request(
+    sess: Arc<Session>,
+    step_context: Arc<StepContext>,
+    turn_store: Arc<codex_extension_api::ExtensionData>,
+    turn_diff_tracker: SharedTurnDiffTracker,
+    client_session: &mut ModelClientSession,
+    input: Vec<ResponseItem>,
+    cancellation_token: CancellationToken,
+) -> CodexResult<(SamplingRequestResult, Vec<ResponseItem>)> {
+    if sess.captured_provider_image_reference_policy() == codex_protocol::provider_reference_profile::ProviderImageReferencePolicy::QualifiedStandardResponses {
+        // Install before checking failure: late dispatch can stop this same request boundary.
+        step_context.turn.extension_data.get_or_init(codex_extension_api::TurnSamplingStop::default);
+    }
+    if let Some(error) = sess
+        .services
+        .code_mode_service
+        .pending_fatal_for_turn(step_context.turn.as_ref())
+        .await
+    {
+        return Err(CodexErr::Fatal(error));
+    }
+    let turn_context = Arc::clone(&step_context.turn);
+    let preempt = step_context.preempt.clone().unwrap_or_default();
+    let _input_watch = if let Some(preempt) = &step_context.preempt {
+        sess.input_queue
+            .watch_user_input(&sess.active_turn, &turn_context.sub_id, preempt.clone())
+            .await
+    } else {
+        None
+    };
+    let base_instructions = sess.get_prompt_base_instructions().await;
+
+    let tool_runtime = ToolCallRuntime::new(
+        Arc::clone(&sess),
+        Arc::clone(&step_context),
+        Arc::clone(&turn_diff_tracker),
+    );
+    sess.services.code_mode_service.bind_step_runtime(
+        &sess,
+        Arc::clone(&step_context),
+        Arc::clone(&turn_diff_tracker),
+    );
+    let max_retries = turn_context.provider.info().stream_max_retries();
+    let mut retry_state = ResponsesStreamRetryState::default();
+    let mut recovery_attempt = 0;
+    let mut initial_input = Some(input);
+    let mut original_input = None;
+    let mut executed_tool_calls_by_output = HashMap::new();
+    let timeout_ms = super::model_invocation_deadline::selected_timeout_ms(
+        step_context.settings.invocation_timeout_ms(),
+        &turn_context.session_source,
+    );
+    let invocation_deadline = timeout_ms.map(|ms| {
+        let stop = turn_context
+            .extension_data
+            .get_or_init(codex_extension_api::TurnSamplingStop::default);
+        let owner = Arc::new(
+            super::model_invocation_deadline::ModelInvocationDeadline::new_deferred(
+                Some(ms),
+                cancellation_token.child_token(),
+                Some(stop),
+            ),
+        );
+        turn_store.insert(owner.clone());
+        owner
+    });
+    let cancellation_token = invocation_deadline.as_ref().map_or_else(
+        || cancellation_token.clone(),
+        |owner| owner.cancellation_token(),
+    );
+    let invocation = async {
+        loop {
+            // Running code-mode cells can request review while this response is in flight.
+            // Keep the latest received ID until response.created replaces it.
+            let prompt_input = if let Some(input) = initial_input.take() {
+                input
+            } else {
+                sess.clone_history()
+                    .await
+                    .for_prompt(&step_context.settings.model_info.input_modalities)
+            };
+            let mut prompt_input = prompt_input;
+            sess.services
+                .executed_tool_calls
+                .attach_to_prompt(&mut prompt_input, &mut executed_tool_calls_by_output);
+            let mut prompt = build_prompt(
+                prompt_input,
+                step_context.as_ref(),
+                base_instructions.clone(),
+            );
+            prompt.request_controls = step_context.settings.request_controls().clone();
+            prompt.prefer_buffered_response = sess
+                .services
+                .thread_extension_data
+                .get::<crate::BufferedResponsesPreference>()
+                .is_some_and(|mode| mode.0);
+            prompt.tool_admission = Some(crate::model_request::tool_admission(
+                sess.thread_id.to_string(),
+                Arc::clone(&step_context.turn.extension_data),
+                Arc::clone(&step_context.tool_router),
+            ));
+            prompt.sampling_stop =
+                crate::model_request::turn_sampling_stop(&step_context.turn.extension_data);
+            prompt.provider_image_reference_policy = sess.request_image_reference_policy(
+                &step_context.turn,
+                &step_context.settings.model_info,
+            );
+            if super::model_invocation_deadline::selected_timeout_ms(
+                step_context.settings.invocation_timeout_ms(),
+                &turn_context.session_source,
+            )
+            .is_some()
+                && prompt.sampling_stop.is_none()
+            {
+                prompt.sampling_stop = Some(
+                    turn_context
+                        .extension_data
+                        .get_or_init(codex_extension_api::TurnSamplingStop::default),
+                );
+            }
+            let responses_metadata = sess
+                .responses_metadata(step_context.as_ref(), CodexResponsesRequestKind::Turn)
+                .await;
+            let editors: Vec<_> = sess
+                .services
+                .extensions
+                .model_request_contributors()
+                .iter()
+                .filter(|contributor| contributor.prepares_request(&turn_context.extension_data))
+                .collect();
+            if !editors.is_empty() {
+                if editors.len() != 1
+                    || turn_context.provider.info().supports_websockets
+                    || step_context.settings.model_info.use_responses_lite
+                    || step_context.realtime.active
+                    || turn_context.config.features.enabled(Feature::CodeMode)
+                    || matches!(
+                        turn_context.session_source,
+                        SessionSource::SubAgent(_) | SessionSource::Internal(_)
+                    )
+                {
+                    return Err(CodexErr::Fatal("prepare_request requires a standard Responses (non-Lite) model, Responses HTTP (supports_websockets=false), and direct-root eager function/MCP tools".into()));
+                }
+            }
+            if crate::guardian::is_basic_session_source(&turn_context.session_source) {
+                crate::guardian::prepare_guardian_prompt(
+                    &sess,
+                    &mut prompt,
+                    step_context.as_ref(),
+                    &responses_metadata,
+                )
+                .await?;
+            }
+            // The original prompt remains authoritative for history and retry bookkeeping.
+            let mut sampling_prompt = Cow::Borrowed(&prompt);
+            if !editors.is_empty() {
+                let data = crate::prepared_request::snapshot(&prompt).map_err(CodexErr::Fatal)?;
+                let admission = prompt.tool_admission.clone().ok_or_else(|| {
+                    CodexErr::Fatal("prepared request has no selected tool admission".into())
+                })?;
+                let output = editors[0]
+                    .prepare_request(codex_extension_api::PreparedRequestInput {
+                        admission,
+                        recovery_attempt,
+                        data,
+                    })
+                    .or_cancel(&preempt)
+                    .or_cancel(&cancellation_token)
+                    .await??
+                    .map_err(CodexErr::Fatal)?;
+                if cancellation_token.is_cancelled() || preempt.is_cancelled() {
+                    return Err(CodexErr::TurnAborted);
+                }
+                output.admission.admit_request().map_err(CodexErr::Fatal)?;
+                if let Some(data) = output.data {
+                    sampling_prompt = Cow::Owned(
+                        crate::prepared_request::apply(&prompt, data).map_err(CodexErr::Fatal)?,
+                    );
+                }
+                sampling_prompt.to_mut().prepared_request_admission = Some(output.admission);
+            }
+            crate::file_admission::validate_response_items(
+                sess.captured_provider_image_reference_policy(),
+                &step_context.settings.model_info,
+                &sampling_prompt.input,
+            )
+            .map_err(CodexErr::Fatal)?;
+            let err = match try_run_sampling_request(
+                tool_runtime.clone(),
+                Arc::clone(&sess),
+                Arc::clone(&step_context),
+                Arc::clone(&turn_store),
+                client_session,
+                &responses_metadata,
+                Arc::clone(&turn_diff_tracker),
+                &sampling_prompt,
+                cancellation_token.child_token(),
+                invocation_deadline.clone(),
+            )
+            .await
+            {
+                Ok(output) => {
+                    return Ok((output, original_input.unwrap_or(prompt.input)));
+                }
+                Err(err) => {
+                    if let Some(snapshot) = err.api_rate_limits().cloned() {
+                        sess.emit_api_rate_limits(&turn_context, snapshot).await;
+                    }
+                    match err.details() {
+                        CodexErrorDetails::ContextWindowExceeded => {
+                            sess.set_total_tokens_full(&turn_context, &step_context.settings)
+                                .await;
+                            return Err(err);
+                        }
+                        CodexErrorDetails::UsageLimitReached(e) => {
+                            let rate_limits = e.rate_limits.clone();
+                            if let Some(rate_limits) = rate_limits {
+                                sess.update_rate_limits(&turn_context, *rate_limits).await;
+                            }
+                            return Err(err);
+                        }
+                        _ => err,
+                    }
+                }
+            };
+
+            let original_input = original_input.get_or_insert(prompt.input);
+
+            let retry = handle_response_stream_error(
+                &mut retry_state,
+                max_retries,
+                err,
+                client_session,
+                &sess,
+                &step_context,
+                ResponsesStreamRequest::Sampling,
+            )
+            .or_cancel(&preempt)
+            .or_cancel(&cancellation_token)
+            .await?;
+            if cancellation_token.is_cancelled() {
+                return Err(CodexErr::TurnAborted);
+            }
+            if preempt.is_cancelled() {
+                return Ok((
+                    SamplingRequestResult {
+                        settled_tools: SettledDirectTools::default(),
+                        needs_follow_up: true,
+                        last_agent_message: None,
+                    },
+                    std::mem::take(original_input),
+                ));
+            }
+            retry??;
+            recovery_attempt += 1;
+            turn_context.turn_timing_state.record_sampling_retry();
+        }
+    };
+    let outcome = match &invocation_deadline {
+        Some(owner) => owner.run(invocation).await,
+        None => invocation.await,
+    };
+    if invocation_deadline
+        .as_ref()
+        .is_some_and(|owner| owner.expired())
+        && !outcome.as_ref().err().is_some_and(|error| {
+            matches!(
+                error.details(),
+                CodexErrorDetails::ModelInvocationDeadlineExceeded(_)
+            )
+        })
+    {
+        let cleanup = outcome
+            .as_ref()
+            .err()
+            .filter(|error| !matches!(error.details(), CodexErrorDetails::TurnAborted))
+            .map(|error| format!("; invocation retirement failed: {error}"))
+            .unwrap_or_default();
+        return Err(CodexErr::ModelInvocationDeadlineExceeded(cleanup));
+    }
+    outcome
+}
+
+pub(crate) struct PreparedToolRecommendations {
+    auth: Option<CodexAuth>,
+    endpoint_candidates: Option<Vec<DiscoverableTool>>,
+}
+
+#[instrument(level = "trace", skip_all)]
+pub(crate) async fn prepare_tool_recommendations(
+    sess: &Session,
+    turn_context: &TurnContext,
+) -> PreparedToolRecommendations {
+    let loaded_plugins = sess
+        .services
+        .plugins_manager
+        .plugins_for_config(&turn_context.config.plugins_config_input())
+        .await
+        .without_plugins(&turn_context.disabled_plugin_ids);
+    let tool_suggest_is_enabled = tool_suggest_enabled(turn_context);
+    let auth = if tool_suggest_is_enabled {
+        sess.services.auth_manager.auth().await
+    } else {
+        None
+    };
+    let endpoint_candidates = if tool_suggest_is_enabled {
+        let plugins_config = turn_context.config.plugins_config_input();
+        sess.services
+            .plugins_manager
+            .recommended_plugin_candidates_for_config(RecommendedPluginCandidatesInput {
+                plugins_config: &plugins_config,
+                loaded_plugins: &loaded_plugins,
+                auth: auth.as_ref(),
+                disabled_tools: &turn_context.config.tool_suggest.disabled_tools,
+                app_server_client_name: turn_context.app_server_client_name.as_deref(),
+            })
+            .await
+    } else {
+        None
+    };
+
+    PreparedToolRecommendations {
+        auth,
+        endpoint_candidates,
+    }
+}
