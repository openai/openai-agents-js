+#[tokio::test]
+async fn file_primitive_emits_typed_source_and_rejects_unsupported_format() {
+    let service = InProcessCodeModeSession::with_reference_profile(
+        CodeModeSessionCellExecutionLimits::default(),
+        codex_protocol::provider_reference_profile::ProviderImageReferencePolicy::QualifiedStandardResponses,
+    );
+    let response = execute(
+        &service,
+        ExecuteRequest {
+            source: "file({file_id: 'file-reference', filename: 'report.pdf'});".into(),
+            yield_time_ms: None,
+            ..execute_request("")
+        },
+    )
+    .await;
+    let RuntimeResponse::Result {
+        content_items,
+        error_text,
+        ..
+    } = response
+    else {
+        panic!("cell must settle");
+    };
+    assert!(error_text.is_none());
+    assert!(
+        matches!(content_items.as_slice(), [FunctionCallOutputContentItem::InputFile { file }]
+        if file == &codex_protocol::input_file::InputFile::from_file_id("file-reference".into(), Some("report.pdf".into())).unwrap())
+    );
+    let response = execute(
+        &service,
+        ExecuteRequest {
+            source: "file({file_id: 'file-reference', file_url: 'https://example.invalid/second-source'});".into(),
+            yield_time_ms: None,
+            ..execute_request("")
+        },
+    )
+    .await;
+    let RuntimeResponse::Result {
+        content_items,
+        error_text,
+        ..
+    } = response
+    else {
+        panic!("cell must settle");
+    };
+    assert!(
+        content_items.is_empty(),
+        "invalid file formatting must emit no File"
+    );
+    assert!(error_text.is_some_and(|text| text.contains("file expects exactly one")));
+}
