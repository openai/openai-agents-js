+    async fn run(
+        self: Arc<Self>,
+        session: Arc<crate::session::session::Session>,
+        turn: Arc<crate::session::turn_context::TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        _cancellation: CancellationToken,
+    ) -> crate::tasks::SessionTaskResult {
+        let original =
+            codex_protocol::error::CodexErr::Fatal("original model error without file".into());
+        session
+            .emit_turn_error_lifecycle(turn.as_ref(), original.to_codex_protocol_error(), &original)
+            .await;
+        session
+            .send_event(
+                turn.as_ref(),
+                codex_protocol::protocol::EventMsg::Error(original.to_error_event(None)),
+            )
+            .await;
+        Err(codex_protocol::error::CodexErr::Fatal(
+            "controlled secondary task failure".into(),
+        ))
+    }
+}
