+/// Resolve one retained sampled batch across same-ID recovery starts. Outcome
+/// data preserves sibling facts; only the later live policy can authorize a finish.
+fn recovered_tools_from_history(
+    candidates: &codex_extension_api::RecoveredToolCompletionCandidates,
+    thread_id: codex_protocol::ThreadId,
+    turn_id: &str,
+    history: &[RolloutItem],
+) -> CodexResult<SettledDirectTools> {
+    let invalid = || CodexErr::InvalidRequest("Invalid recovered tool completion batch".into());
+    if candidates.turn_id != turn_id || candidates.call_ids.is_empty() {
+        return Err(invalid());
+    }
+    let anchors = history
+        .iter()
+        .enumerate()
+        .filter_map(|(index, item)| match item {
+            RolloutItem::ResponseObservationRecord(record)
+                if record.id == candidates.response_observation_id =>
+            {
+                Some((index, record))
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    let [(anchor, record)] = anchors.as_slice() else {
+        return Err(invalid());
+    };
+    if record.thread_id != thread_id
+        || record.turn_id != turn_id
+        || record.observation.status
+            != codex_protocol::protocol::ResponseObservationStatus::Completed
+    {
+        return Err(invalid());
+    }
+    // A recovery appends a new TurnStarted after this observation. The batch
+    // starts at its preceding provider terminal or original turn start, never
+    // at the latest same-ID recovery start.
+    let original_start = history[..*anchor]
+        .iter()
+        .rposition(|item| matches!(item, RolloutItem::EventMsg(EventMsg::TurnStarted(_))))
+        .ok_or_else(invalid)?;
+    if !matches!(&history[original_start], RolloutItem::EventMsg(EventMsg::TurnStarted(start))
+        if start.turn_id == turn_id)
+        || history[*anchor + 1..].iter().any(|item| {
+            matches!(item, RolloutItem::ResponseObservationRecord(record)
+                if record.thread_id == thread_id && record.turn_id == turn_id)
+        })
+    {
+        return Err(invalid());
+    }
+    let start = history[original_start + 1..*anchor]
+        .iter()
+        .rposition(|item| matches!(item, RolloutItem::ResponseObservationRecord(_)))
+        .map_or(original_start + 1, |index| original_start + index + 2);
+    let call_id = |item: &ResponseItem| match item {
+        ResponseItem::FunctionCall { call_id, .. }
