+async fn wait_for_child_event<T>(
+    thread: &Arc<CodexThread>,
+    matcher: impl Fn(&EventMsg) -> Option<T>,
+) -> T {
+    tokio::time::timeout(std::time::Duration::from_secs(30), async {
+        loop {
+            let event = thread.next_event().await.expect("thread event");
+            if let Some(value) = matcher(&event.msg) {
+                return value;
+            }
+            assert!(!matches!(event.msg, EventMsg::Error(_)), "{event:?}");
+        }
+    })
+    .await
+    .expect("child event deadline")
+}
+
+async fn complete_turn(thread: &Arc<CodexThread>) {
+    wait_for_child_event(thread, |event| {
+        matches!(event, EventMsg::TurnComplete(_)).then_some(())
+    })
+    .await;
+}
+
+fn reference_content(request: &ResponsesRequest, full_history: bool) -> Value {
+    if !full_history {
+        return request.function_call_output(CALL)["output"].clone();
+    }
+    // Native full forks retain user messages, but deliberately omit tool calls and outputs.
+    let message = request
+        .input()
+        .into_iter()
+        .find(|item| {
+            item["role"] == "user"
+                && item["content"]
+                    .as_array()
+                    .is_some_and(|content| content.iter().any(|item| item["text"] == "caption"))
+        })
+        .expect("retained user image message");
+    message["content"].clone()
+}
+
+async fn request_existing_images(
+    server: &wiremock::MockServer,
+    thread: &Arc<CodexThread>,
+    full_history: bool,
+) -> Value {
+    let id = thread.session.thread_id.to_string();
+    let response = mount_sse_once_match(
+        server,
+        header("thread-id", id),
+        sse_completed("existing-images"),
+    )
+    .await;
+    thread
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "inspect existing images".into(),
+            text_elements: vec![],
+        }]))
+        .await
+        .expect("turn");
+    complete_turn(thread).await;
+    reference_content(&response.single_request(), full_history)
+}
+
+fn assert_reference_output(output: &Value, preserved: bool) {
+    assert_eq!(output[0]["text"], "caption");
+    if preserved {
+        assert_eq!(output[1]["image_url"], IMAGE_URL);
+        assert_eq!(output[1]["detail"], "low");
+    } else {
+        assert_eq!(output[1]["type"], "input_text");
+        assert_eq!(
+            output[1]["text"],
+            "image content omitted because remote image URLs are not supported"
+        );
+    }
+    assert_eq!(output[2]["file_id"], "file-child");
+}
