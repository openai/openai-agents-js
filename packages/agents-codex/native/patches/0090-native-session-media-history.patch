+#[cfg(test)]
+mod image_reference_tests {
+    use super::*;
+    use crate::models::{FunctionCallOutputContentItem, ImageDetail, ImageReference};
+    use serde_json::json;
+
+    #[test]
+    fn old_image_url_wire_shape_retains_omitted_high_detail() {
+        let wire = json!({"type":"inputImage", "imageUrl":"https://example.invalid/image.png"});
+        let item: DynamicToolCallOutputContentItem = serde_json::from_value(wire.clone()).unwrap();
+        assert_eq!(serde_json::to_value(&item).unwrap(), wire);
+        assert_eq!(
+            FunctionCallOutputContentItem::from(item),
+            FunctionCallOutputContentItem::InputImage {
+                image: ImageReference::Inline {
+                    image_url: "https://example.invalid/image.png".into()
+                },
+                detail: Some(ImageDetail::High),
+            }
+        );
+    }
+
+    #[test]
+    fn each_source_and_explicit_detail_round_trips_without_becoming_text() {
+        for source in [
+            json!({"imageUrl":"data:image/png;base64,AA=="}),
+            json!({"imageUrl":"https://example.invalid/image.png"}),
+            json!({"fileId":"file-image"}),
+        ] {
+            for detail in ["auto", "low", "high", "original"] {
+                let mut wire = source.clone();
+                wire["type"] = json!("inputImage");
+                wire["detail"] = json!(detail);
+                let item: DynamicToolCallOutputContentItem =
+                    serde_json::from_value(wire.clone()).unwrap();
+                assert_eq!(serde_json::to_value(&item).unwrap(), wire);
+                let converted =
+                    serde_json::to_value(FunctionCallOutputContentItem::from(item)).unwrap();
+                assert_eq!(converted["detail"], detail);
+                assert_eq!(converted["type"], "input_image");
+                if let Some(id) = source.get("fileId") {
+                    assert_eq!(&converted["file_id"], id);
+                }
+                if let Some(url) = source.get("imageUrl") {
+                    assert_eq!(&converted["image_url"], url);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn malformed_source_cardinality_and_detail_are_rejected() {
+        for image in [
+            json!({"type":"inputImage"}),
+            json!({"type":"inputImage","imageUrl":"https://example.invalid/i","fileId":"file-i"}),
+            json!({"type":"inputImage","imageUrl":null,"fileId":"file-i"}),
+            json!({"type":"inputImage","imageUrl":""}),
+            json!({"type":"inputImage","fileId":7}),
+            json!({"type":"inputImage","fileId":"file-i","detail":"ultra"}),
+        ] {
+            assert!(serde_json::from_value::<DynamicToolCallOutputContentItem>(image).is_err());
+        }
+    }
+    #[test]
+    fn generated_image_contract_keeps_exclusive_sources_and_nonempty_schema_strings() {
+        let schema = serde_json::to_value(schemars::schema_for!(DynamicToolCallOutputContentItem))
+            .expect("generated schema");
+        let image = schema["oneOf"]
+            .as_array()
+            .expect("content variants")
+            .iter()
+            .find(|variant| variant["properties"]["type"]["enum"] == json!(["inputImage"]))
+            .expect("image variant");
+        for source in ["imageUrl", "fileId"] {
+            let branch = image["anyOf"]
+                .as_array()
+                .expect("source variants")
+                .iter()
+                .find(|branch| branch["properties"].get(source).is_some())
+                .expect("source branch");
+            assert_eq!(branch["properties"][source]["minLength"], 1);
+        }
+        assert_eq!(image["not"]["required"], json!(["fileId", "imageUrl"]));
+        let typescript = DynamicToolCallOutputContentItem::decl();
+        assert!(typescript.contains("{ imageUrl: string; fileId?: never }"));
+        assert!(typescript.contains("{ fileId: string; imageUrl?: never }"));
+    }
