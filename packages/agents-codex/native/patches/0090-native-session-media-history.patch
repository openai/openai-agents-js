+//! File admission uses current route ownership and model metadata; it never fetches content.
+use codex_protocol::input_file::InputFile;
+use codex_protocol::models::{ContentItem, FunctionCallOutputContentItem, ResponseItem};
+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::provider_reference_profile::ProviderImageReferencePolicy;
+
+pub(crate) fn validate_file(
+    file: &InputFile,
+    profile: ProviderImageReferencePolicy,
+    model: &ModelInfo,
+) -> Result<(), String> {
+    file.validate_for_model(profile, model)
+}
+
+pub(crate) fn validate_response_items<'a>(
+    profile: ProviderImageReferencePolicy,
+    model: &ModelInfo,
+    items: impl IntoIterator<Item = &'a ResponseItem>,
+) -> Result<(), String> {
+    for item in items {
+        match item {
+            ResponseItem::Message { content, .. } => {
+                for part in content {
+                    if let ContentItem::InputFile { file } = part {
+                        validate_file(file, profile, model)?;
+                    }
+                }
+            }
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                if let Some(parts) = output.content_items() {
+                    for part in parts {
+                        if let FunctionCallOutputContentItem::InputFile { file } = part {
+                            validate_file(file, profile, model)?;
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn contains_file(item: &ResponseItem) -> bool {
+    match item {
+        ResponseItem::Message { content, .. } => content
+            .iter()
+            .any(|item| matches!(item, ContentItem::InputFile { .. })),
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => {
+            output.content_items().is_some_and(|items| {
+                items
+                    .iter()
+                    .any(|item| matches!(item, FunctionCallOutputContentItem::InputFile { .. }))
+            })
+        }
+        _ => false,
+    }
+}
