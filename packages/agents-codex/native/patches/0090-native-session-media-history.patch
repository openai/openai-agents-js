+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+        {
+            let _ = producer.send(());
+        }
+    }
+
+    pub(crate) fn cancel_for_retirement(&self) {
+        self.request_cancel.cancel();
+        self.stop_owned_streams();
+    }
+
+    /// Cancellation drops a borrow, never the stored JoinHandle. The outer abort
+    /// owner joins the sampler first, then can resume these exact joins.
+    pub(crate) async fn retire_tasks(&self) -> Vec<String> {
+        self.stop_owned_streams();
+        let Some(tasks) = self.tasks.get() else {
+            return Vec::new();
+        };
+        let mut tasks = tasks.lock().await;
+        while let Some(task) = tasks.handles.last_mut() {
+            let result = task.await;
+            // Record the completed result before removing its handle. No await
+            // separates these steps, so cancellation cannot detach the handle.
+            if let Err(error) = result {
+                if !error.is_cancelled() {
+                    tasks
+                        .errors
+                        .push(format!("request task retirement failed: {error}"));
+                }
+            }
+            tasks.handles.pop();
+        }
+        tasks.errors.clone()
+    }
+
+    pub(crate) fn abort_error(
+        &self,
+        primary: Option<codex_protocol::protocol::ErrorEvent>,
+        errors: Vec<String>,
+    ) -> Option<codex_protocol::protocol::ErrorEvent> {
+        if self.expired() {
+            let mut causes = errors;
+            if let Some(primary) = primary {
+                causes.push(primary.message);
+            }
+            let suffix = if causes.is_empty() {
+                String::new()
+            } else {
+                format!("; {}", causes.join("; "))
+            };
+            return Some(
+                codex_protocol::error::CodexErr::ModelInvocationDeadlineExceeded(suffix)
+                    .to_error_event(None),
+            );
+        }
+        if errors.is_empty() {
+            return primary;
+        }
+        let details = format!("model request retirement failed: {}", errors.join("; "));
+        match primary {
+            Some(mut primary) => {
+                primary.message.push_str(&format!("; {details}"));
+                Some(primary)
+            }
+            None => Some(codex_protocol::error::CodexErr::Fatal(details).to_error_event(None)),
+        }
+    }
+
+    pub(crate) fn expired(&self) -> bool {
+        self.state.get().is_some_and(|state| state.expired())
+    }
+
+    pub(crate) fn attach_stream_stop(
+        &self,
+        stop: CancellationToken,
+        producer: Option<tokio::sync::oneshot::Sender<()>>,
+    ) {
+        if let Some(producer) = producer {
+            if self.expired() {
+                let _ = producer.send(());
+            } else {
+                *self
+                    .producer_stop
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(producer);
+            }
+        }
+        let mut current = self
+            .stream_stop
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if self.expired() {
+            stop.cancel();
+        }
+        *current = Some(stop);
+    }
+
+    fn expire(&self) {
+        if let Some(state) = self.state.get() {
+            state.expire_if_due();
+        }
+        if !self.expired() {
+            return;
+        }
+        if let Some(task) = self.owned_task.get() {
+            task.request_stop();
+        }
+        self.request_cancel.cancel();
+        self.stop_owned_streams();
+    }
+
+    pub(crate) fn accept_terminal(&self) -> bool {
+        match self.state.get() {
+            Some(state) => state.accept_outcome(),
+            None => {
+                self.accepted.cancel();
+                true
+            }
+        }
+    }
+
+    pub(crate) fn accept_outcome(&self) {
+        if let Some(state) = self.state.get() {
+            state.accept_outcome();
+        }
+        self.accepted.cancel();
+    }
+
+    /// Poll timer and invocation together, retaining the invocation's awaits.
+    /// Acceptance here precedes mapper/tool/durability cleanup in the caller.
+    pub(crate) async fn run<F: Future>(&self, invocation: F) -> F::Output {
+        let watchdog = async {
+            tokio::select! {
+                biased;
+                _ = self.accepted.cancelled() => return,
+                _ = self.started.cancelled() => {},
+            }
+            if let Some(state) = self.state.get() {
+                let settled = state.settled();
+                tokio::select! {
+                    biased;
+                    _ = settled.cancelled() => {},
+                    _ = tokio::time::sleep_until(state.expires_at()) => { state.expire_if_due(); },
+                    _ = self.request_cancel.cancelled() => state.cancel(),
+                }
+                if state.expired() {
+                    self.expire();
+                }
+            }
+        };
+        let invoke = async {
+            let outcome = invocation.await;
+            self.accept_outcome();
+            outcome
+        };
+        let (_, outcome) = tokio::join!(biased; watchdog, invoke);
+        outcome
+    }
+}
