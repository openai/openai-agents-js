+fn recovered_batch_fixture() -> (
+    codex_protocol::ThreadId,
+    codex_extension_api::RecoveredToolCompletionCandidates,
+    Vec<RolloutItem>,
+) {
+    use codex_history::ResponseItemEnvelope;
+    use codex_protocol::protocol::{
+        ResponseObservation, ResponseObservationRecord, ResponseObservationStatus, TurnStartedEvent,
+    };
+    let thread = codex_protocol::ThreadId::new();
+    let started = || {
+        RolloutItem::EventMsg(EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: "recovered".into(),
+            root_turn_id: None,
+            trace_id: None,
+            started_at: None,
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        }))
+    };
+    let call = |id: &str| {
+        RolloutItem::ResponseItem(ResponseItemEnvelope::new(
+            serde_json::from_value(serde_json::json!({
+                "type":"function_call", "call_id":id,"name":"answer","arguments":"{}",
+            }))
+            .unwrap(),
+        ))
+    };
+    let output = |id: &str| {
+        RolloutItem::ResponseItem(ResponseItemEnvelope::new(
+            serde_json::from_value(serde_json::json!({
+                "type":"function_call_output", "call_id":id,"output":"accepted body",
+            }))
+            .unwrap(),
+        ))
+    };
+    let observation = |id: &str| {
+        RolloutItem::ResponseObservationRecord(ResponseObservationRecord {
+            id: id.into(),
+            thread_id: thread,
+            turn_id: "recovered".into(),
+            observation: ResponseObservation {
+                upstream_request_id: None,
+                response_id: Some(id.into()),
+                status: ResponseObservationStatus::Completed,
+                incomplete_reason: None,
+                usage: None,
+            },
+        })
+    };
+    let candidates = codex_extension_api::RecoveredToolCompletionCandidates {
+        turn_id: "recovered".into(),
+        response_observation_id: "batch".into(),
+        call_ids: ["prefix", "fresh", "suffix"]
+            .into_iter()
+            .map(str::to_owned)
+            .collect(),
+        outcomes: ["prefix", "fresh", "suffix"]
+            .into_iter()
+            .map(|id| (id.to_owned(), true))
+            .collect(),
+    };
+    let history = vec![
+        started(),
+        call("earlier"),
+        observation("earlier-batch"),
+        output("earlier"),
+        call("prefix"),
+        call("fresh"),
+        call("suffix"),
+        observation("batch"),
+        output("prefix"),
+        started(),
+        output("fresh"),
+        output("suffix"),
+    ];
+    (thread, candidates, history)
+}
