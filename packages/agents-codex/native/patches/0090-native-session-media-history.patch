+//! Received, model-invisible response facts. Never use these as prompt input.
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+
+/// Cumulative encoded retained records per provider response, including all
+/// identity metadata, JSON escaping, and the storage envelope. Transport ingress
+/// limits remain independent.
+pub const RESPONSE_FACT_BYTES: usize = 1_048_576;
+/// Cumulative JSON-encoded refusal string contents within the response budget.
+pub const REFUSAL_TEXT_BYTES: usize = 16_384;
+
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub struct ProbabilityAlternative {
+    pub token: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub bytes: Option<Vec<u8>>,
+    #[schemars(with = "f64")]
+    #[ts(type = "number")]
+    pub logprob: serde_json::Number,
+}
+
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub struct ProbabilityToken {
+    pub token: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub bytes: Option<Vec<u8>>,
+    #[schemars(with = "f64")]
+    #[ts(type = "number")]
+    pub logprob: serde_json::Number,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub top_logprobs: Option<Vec<ProbabilityAlternative>>,
+}
+
+/// A delta is incremental. A fully captured snapshot replaces prior deltas for
+/// its item/part; a truncated snapshot must not discard earlier retained deltas.
+/// `capture_complete` describes capture of this record, never provider terminal status.
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub enum ResponseFact {
+    Refusal {
+        item_id: Option<String>,
+        content_index: Option<u64>,
+        snapshot: bool,
+        text: String,
+        capture_complete: bool,
+    },
+    TextProbabilities {
+        item_id: Option<String>,
+        output_index: Option<u64>,
+        content_index: Option<u64>,
+        snapshot: bool,
+        /// Original provider text delta; not a rendered/presentation segment.
+        delta: Option<String>,
+        tokens: Vec<ProbabilityToken>,
+        capture_complete: bool,
+    },
+    MalformedProbabilities,
+    CaptureTruncated,
+}
+
+// Default diagnostics must never render refusal or alternative-token contents.
+impl std::fmt::Debug for ProbabilityAlternative {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("ProbabilityAlternative(<private>)")
+    }
+}
+impl std::fmt::Debug for ProbabilityToken {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("ProbabilityToken(<private>)")
+    }
+}
+impl std::fmt::Debug for ResponseFact {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            Self::Refusal { .. } => "ResponseFact::Refusal(<private>)",
+            Self::TextProbabilities { .. } => "ResponseFact::TextProbabilities(<private>)",
+            Self::MalformedProbabilities => "ResponseFact::MalformedProbabilities",
+            Self::CaptureTruncated => "ResponseFact::CaptureTruncated",
+        })
+    }
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub struct ReceivedResponseFact {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub upstream_request_id: Option<String>,
+    pub fact: ResponseFact,
+}
+impl From<ResponseFact> for ReceivedResponseFact {
+    fn from(fact: ResponseFact) -> Self {
+        Self {
+            upstream_request_id: None,
+            fact,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub struct ResponseFactRecord {
+    pub id: String,
+    pub thread_id: crate::ThreadId,
+    pub turn_id: String,
+    /// Existing native dispatch UUID, distinct from all upstream identities.
+    pub request_id: Option<String>,
+    pub response_id: Option<String>,
+    #[serde(flatten)]
+    pub received: ReceivedResponseFact,
+}
+
+/// One budget per actual sampling response, including all streaming frames.
+/// Reserve one terminal capture marker. A truncated probability prefix always
+/// contains whole tokens together with every supplied alternative for that token.
+pub struct ResponseFactBudget {
+    used: usize,
+    refusal_remaining: usize,
+    exhausted: bool,
+    probabilities_exhausted: bool,
+}
+impl Default for ResponseFactBudget {
+    fn default() -> Self {
+        Self {
+            used: 0,
+            refusal_remaining: REFUSAL_TEXT_BYTES,
+            exhausted: false,
+            probabilities_exhausted: false,
+        }
+    }
+}
+fn encoded_len<T: Serialize>(value: &T) -> usize {
+    serde_json::to_vec(value)
+        .expect("typed response facts serialize")
+        .len()
+}
+fn encoded_text_len(value: &str) -> usize {
+    encoded_len(&value).saturating_sub(2)
+}
+fn truncate_text(text: &mut String, limit: usize) -> bool {
+    if encoded_text_len(text) <= limit {
+        return false;
+    }
+    let boundaries: Vec<usize> = text
+        .char_indices()
+        .map(|(i, _)| i)
+        .chain(std::iter::once(text.len()))
+        .collect();
+    let mut low = 0;
+    let mut high = boundaries.len();
+    while low + 1 < high {
+        let mid = (low + high) / 2;
+        if encoded_text_len(&text[..boundaries[mid]]) <= limit {
+            low = mid;
+        } else {
+            high = mid;
+        }
+    }
+    text.truncate(boundaries[low]);
+    true
+}
+impl ResponseFactBudget {
+    pub fn is_exhausted(&self) -> bool {
+        self.exhausted
+    }
+    #[cfg(test)]
+    fn capture(&mut self, fact: ResponseFact) -> Option<ResponseFact> {
+        self.capture_retained(fact, 0, encoded_len(&ResponseFact::CaptureTruncated))
+    }
+    /// The storage owner measures its actual record metadata/envelope and a
+    /// marker containing native correlation only, with provider IDs removed.
+    pub fn capture_retained(
+        &mut self,
+        mut fact: ResponseFact,
+        record_overhead: usize,
+        marker_bytes: usize,
+    ) -> Option<ResponseFact> {
+        if self.exhausted {
+            return None;
+        }
+        let available = RESPONSE_FACT_BYTES
+            .saturating_sub(self.used)
+            .saturating_sub(marker_bytes);
+        let available_fact = available.saturating_sub(record_overhead);
+        if let ResponseFact::Refusal { text, .. } = &mut fact {
+            let received_text = std::mem::take(text);
+            let mut envelope = fact.clone();
+            if let ResponseFact::Refusal {
+                capture_complete, ..
+            } = &mut envelope
+            {
+                *capture_complete = false;
+            }
+            let allowance = self
+                .refusal_remaining
+                .min(available_fact.saturating_sub(encoded_len(&envelope)));
+            let mut text = received_text;
+            let truncated = truncate_text(&mut text, allowance);
+            self.refusal_remaining = self
+                .refusal_remaining
+                .saturating_sub(encoded_text_len(&text));
+            if let ResponseFact::Refusal {
+                text: target,
+                capture_complete,
+                ..
+            } = &mut fact
+            {
+                *target = text;
+                *capture_complete &= !truncated;
+            }
+        }
+        let received = match &mut fact {
+            ResponseFact::TextProbabilities { tokens, .. } => {
+                if self.probabilities_exhausted {
+                    return None;
+                }
+                Some(std::mem::take(tokens))
+            }
+            _ => None,
+        };
+        if let Some(received) = received {
+            let received_len = received.len();
+            let mut envelope = fact.clone();
+            if let ResponseFact::TextProbabilities {
+                capture_complete, ..
+            } = &mut envelope
+            {
+                *capture_complete = false;
+            }
+            // Reserve room for refusal text plus one record's measured metadata;
+            // exceptionally large future item IDs still get explicit truncation.
+            let probability_allowance =
+                available_fact.saturating_sub(self.refusal_remaining + record_overhead + 512);
+            let mut size = encoded_len(&envelope);
+            if size > probability_allowance {
+                self.probabilities_exhausted = true;
+                if self.used.saturating_add(marker_bytes) <= RESPONSE_FACT_BYTES {
+                    self.used += marker_bytes;
+                    return Some(ResponseFact::CaptureTruncated);
+                }
+                return None;
+            }
+            let mut retained = Vec::new();
+            for token in received {
+                let cost = encoded_len(&token) + usize::from(!retained.is_empty());
+                if size.saturating_add(cost) > probability_allowance {
+                    break;
+                }
+                size += cost;
+                retained.push(token);
+            }
+            let truncated = retained.len() != received_len;
+            if let ResponseFact::TextProbabilities {
+                tokens,
+                capture_complete,
+                ..
+            } = &mut fact
+            {
+                *capture_complete &= !truncated;
+                *tokens = retained;
+            }
+            self.probabilities_exhausted = truncated;
+        }
+        let bytes = encoded_len(&fact).saturating_add(record_overhead);
+        if bytes > available {
+            self.exhausted = true;
+            if self.used.saturating_add(marker_bytes) <= RESPONSE_FACT_BYTES {
+                self.used += marker_bytes;
+                return Some(ResponseFact::CaptureTruncated);
+            }
+            return None;
+        }
+        self.used += bytes;
+        Some(fact)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn token(size: usize) -> ProbabilityToken {
+        ProbabilityToken {
+            token: "t".repeat(size),
+            bytes: Some(vec![116]),
+            logprob: (-1).into(),
+            top_logprobs: Some(vec![ProbabilityAlternative {
+                token: "private-alternative".repeat(size),
+                bytes: Some(vec![1, 2]),
+                logprob: (-2).into(),
+            }]),
+        }
+    }
+    fn probabilities(tokens: Vec<ProbabilityToken>) -> ResponseFact {
+        ResponseFact::TextProbabilities {
+            item_id: Some("item".into()),
+            output_index: Some(0),
+            content_index: Some(0),
+            snapshot: false,
+            delta: Some("t".into()),
+            tokens,
+            capture_complete: true,
+        }
+    }
+    #[test]
+    fn cumulative_frames_keep_whole_tokens_and_reserve_refusal() {
+        let mut budget = ResponseFactBudget::default();
+        let mut retained = Vec::new();
+        for _ in 0..500 {
+            if let Some(fact) = budget.capture(probabilities(vec![token(128); 10])) {
+                retained.push(fact);
+            }
+        }
+        let refusal = budget
+            .capture(ResponseFact::Refusal {
+                item_id: Some("refusal".into()),
+                content_index: Some(0),
+                snapshot: true,
+                text: "private-refusal".repeat(2000),
+                capture_complete: true,
+            })
+            .unwrap();
+        let ResponseFact::Refusal {
+            text,
+            capture_complete,
+            ..
+        } = &refusal
+        else {
+            panic!("refusal reservation must remain usable");
+        };
+        assert!(!text.is_empty());
+        assert!(!capture_complete);
+        assert!(encoded_text_len(text) <= REFUSAL_TEXT_BYTES);
+        retained.push(refusal);
+        assert!(retained.iter().map(encoded_len).sum::<usize>() <= RESPONSE_FACT_BYTES);
+        assert!(retained.iter().any(|fact| matches!(
+            fact,
+            ResponseFact::TextProbabilities {
+                capture_complete: false,
+                ..
+            }
+        )));
+        for fact in retained {
+            if let ResponseFact::TextProbabilities { tokens, .. } = fact {
+                for captured in tokens {
+                    assert_eq!(captured, token(128));
+                }
+            }
+        }
+    }
+    #[test]
+    fn escaped_unicode_refusal_prefix_is_valid_and_cumulatively_bounded() {
+        let mut budget = ResponseFactBudget::default();
+        let mut encoded = 0;
+        for _ in 0..100 {
+            let fact = budget.capture(ResponseFact::Refusal {
+                item_id: None,
+                content_index: None,
+                snapshot: false,
+                text: "🧪\"\n".repeat(1000),
+                capture_complete: true,
+            });
+            if let Some(ResponseFact::Refusal { text, .. }) = fact {
+                encoded += encoded_text_len(&text);
+            }
+        }
+        assert!(encoded <= REFUSAL_TEXT_BYTES);
+    }
+    #[test]
+    fn global_budget_includes_every_fact_and_one_exhaustion_marker() {
+        let mut budget = ResponseFactBudget::default();
+        let mut bytes = 0;
+        let mut markers = 0;
+        for _ in 0..2000 {
+            if let Some(fact) = budget.capture(ResponseFact::Refusal {
+                item_id: Some("r".repeat(1024)),
+                content_index: None,
+                snapshot: false,
+                text: String::new(),
+                capture_complete: true,
+            }) {
+                markers += usize::from(matches!(fact, ResponseFact::CaptureTruncated));
+                bytes += encoded_len(&fact);
+            }
+        }
+        assert_eq!(markers, 1);
+        assert!(bytes <= RESPONSE_FACT_BYTES);
+    }
+    #[test]
