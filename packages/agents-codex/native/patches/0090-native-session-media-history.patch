+    pub(super) fn take_fatal_for_cell(
+        &self,
+        id: &CellId,
+        current_turn: &crate::session::turn_context::TurnContext,
+    ) -> Option<(String, bool)> {
+        let receipt = self.receipt(id)?;
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !state
+            .cells
+            .get(id)
+            .and_then(Weak::upgrade)
+            .is_some_and(|current| Arc::ptr_eq(&current, &receipt))
+        {
+            return None;
+        }
+        let owner = receipt
+            .owner_turn
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .upgrade();
+        let owns_current_turn = owner
+            .as_ref()
+            .is_some_and(|owner| std::ptr::eq(owner.as_ref(), current_turn));
+        let consumed = owner.is_none();
+        // A foreign observer cannot erase an unretired owner's eventual decision.
+        let error = if !consumed {
+            receipt.pending_fatal()
+        } else {
+            receipt.take_fatal()
+        };
+        if consumed && error.is_some() && receipt.tasks.is_empty() && !receipt.has_cleanup_error() {
+            state.cells.remove(id);
+            state
+                .retired
+                .retain(|current| !Arc::ptr_eq(current, &receipt));
+        }
+        error.map(|error| (error, owns_current_turn))
+    }
+    fn fail_owned_dispatch(
+        self: &Arc<Self>,
+        receipt: &Arc<CellDispatchReceipt>,
+        message: String,
+        backend: Arc<dyn codex_code_mode::CodeModeSession>,
+    ) -> bool {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let Some(id) = receipt.cell_id() else {
+            return false;
+        };
+        if !state
+            .cells
+            .get(&id)
+            .and_then(Weak::upgrade)
+            .is_some_and(|current| Arc::ptr_eq(&current, receipt))
+        {
+            return false;
+        }
+        // An admitted callback may finish after admission/authority closes. Keep its
+        // result, but only the still-authorized owner may cancel a model task.
+        let owns_sampling = !state.closed
+            && receipt
+                .owner_turn
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .upgrade()
+                .is_some();
+        let first_failure = receipt.pending_fatal().is_none();
+        receipt.record_fatal(message);
+        if !first_failure {
+            return false;
+        }
+        receipt.forced.cancel();
+        self.close_locked(&mut state, receipt);
+        // Cleanup is tracked by the existing receipt, but does not await its own join.
+        let broker = Arc::clone(self);
+        let cleanup = Arc::clone(receipt);
+        receipt.tasks.spawn(async move {
+            broker.terminate_startup(&backend, &id, &cleanup).await;
+        });
+        owns_sampling
+    }
+
+    /// Retire model authority atomically with the fatal decision. Callback data,
+    /// step metadata, task tracking and cell identity remain on their existing owners.
+    pub(super) fn retire_turn(
+        &self,
+        turn: &crate::session::turn_context::TurnContext,
+    ) -> (Vec<Arc<CellDispatchReceipt>>, Option<String>) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let receipts = state
+            .all
+            .iter()
+            .filter_map(Weak::upgrade)
+            .filter(|receipt| receipt.belongs_to_turn(turn))
+            .collect::<Vec<_>>();
+        // Keep this value across awaits: a foreign wait can consume the live slot
+        // after authority retirement while cleanup is still joining.
+        let primary = receipts.iter().find_map(|receipt| receipt.pending_fatal());
+        for receipt in &receipts {
+            *receipt
+                .owner_turn
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner) = Weak::new();
+            if primary.is_some() {
+                self.close_locked(&mut state, receipt);
+            }
+        }
+        (receipts, primary)
+    }
