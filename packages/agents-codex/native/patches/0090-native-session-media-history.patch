+#[tokio::test]
+async fn external_abort_and_owned_finalizer_share_settlement_without_canceling_replacement() {
+    for finalizer_first in [false, true] {
+        let (session, turn, events, records) = owned_spawn_session().await;
+        let task = owned_task(false);
+        session
+            .spawn_task(Arc::clone(&turn), Vec::new(), task.clone())
+            .await;
+        task.started.cancelled().await;
+        let cell = retirement_delegate(&session, Arc::clone(&turn), "old-owner");
+        let backend = Arc::new(StartupBackend::new(false));
+        assert!(
+            session
+                .services
+                .code_mode_service
+                .session
+                .set(backend.clone())
+                .is_ok()
+        );
+        assert!(
+            session
+                .services
+                .code_mode_service
+                .dispatch_broker
+                .fail_owned_dispatch(
+                    &cell.receipt,
+                    "original owned fatal".into(),
+                    backend.clone()
+                )
+        );
+        session.cancel_code_mode_owner(&turn).await;
+        task.observed_cancel.cancelled().await;
+        if finalizer_first {
+            task.return_after_cancel.cancel();
+            owner_gate_is_held(&session).await;
+        }
+        let mut abort =
+            Box::pin(session.abort_all_tasks(codex_protocol::protocol::TurnAbortReason::Replaced));
+        assert!(futures::poll!(abort.as_mut()).is_pending());
+        // A has been taken by the external owner. B can be admitted while A's
+        // exact receipt set is joining; A must not consult B's state afterwards.
+        let (_, mut next) = make_session_and_context().await;
+        next.sub_id = turn.sub_id.clone();
+        let next = Arc::new(next);
+        let next_task = owned_task(false);
+        session
+            .spawn_task(Arc::clone(&next), Vec::new(), next_task.clone())
+            .await;
+        next_task.started.cancelled().await;
+        // A stale cancellation must not gain B's authority from an equal textual ID.
+        session.cancel_code_mode_owner(&turn).await;
+        assert!(!next_task.observed_cancel.is_cancelled());
+        assert!(
+            !session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .unwrap()
+                .task
+                .as_ref()
+                .unwrap()
+                .cancellation_token
+                .is_cancelled()
+        );
+        let new_cell = retirement_delegate(&session, Arc::clone(&next), "replacement-cell");
+        backend.terminate_release.cancel();
+        if !finalizer_first {
+            task.return_after_cancel.cancel();
+        }
+        tokio::time::timeout(std::time::Duration::from_secs(10), abort)
+            .await
+            .unwrap();
+        assert!(!next_task.observed_cancel.is_cancelled());
+        assert!(!new_cell.receipt.closed.is_cancelled());
+        assert!(!new_cell.receipt.forced.is_cancelled());
+        assert!(
+            session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .and_then(|active| active.task.as_ref())
+                .is_some_and(|task| Arc::ptr_eq(&task.turn_context, &next))
+        );
+        assert!(
+            !session
+                .services
+                .code_mode_service
+                .dispatch_broker
+                .has_unconsumed_fatal()
+        );
+        let mut errors = Vec::new();
+        let mut terminals = Vec::new();
+        while let Ok(event) = events.try_recv() {
+            match event.msg {
+                codex_protocol::protocol::EventMsg::Error(error) => errors.push(error),
+                codex_protocol::protocol::EventMsg::TurnAborted(event)
+                    if event.turn_id.as_deref() == Some(turn.sub_id.as_str()) =>
+                {
+                    terminals.push(event)
+                }
+                codex_protocol::protocol::EventMsg::TurnComplete(event)
+                    if event.turn_id == turn.sub_id =>
+                {
+                    panic!("A published completion after replacement: {event:?}")
+                }
+                _ => {}
+            }
+        }
+        assert_eq!(errors.len(), 1);
+        let expected = codex_protocol::error::CodexErr::Fatal("original owned fatal".into())
+            .to_error_event(None)
+            .message;
+        assert_eq!(errors[0].message, expected);
+        assert_eq!(terminals.len(), 1);
+        assert_eq!(terminals[0].error.as_ref().unwrap().message, expected);
+        assert_eq!(
+            records
+                .lock()
+                .unwrap()
+                .iter()
+                .filter(|id| *id == &turn.sub_id)
+                .count(),
+            1
+        );
+        next_task.return_after_cancel.cancel();
+        session
+            .abort_all_tasks(codex_protocol::protocol::TurnAbortReason::Replaced)
+            .await;
+    }
+}
