+#[test]
+fn file_local_cost_stays_unknown_while_measured_usage_is_preserved() {
+    use codex_protocol::input_file::InputFile;
+    for file in [
+        InputFile::from_file_id("file-opaque".into(), None).unwrap(),
+        InputFile::from_file_url("https://example.invalid/a".into(), None).unwrap(),
+        InputFile::from_file_data("JVBERi0=".into(), None).unwrap(),
+    ] {
+        let mut item = user_msg("before file");
+        let ResponseItem::Message { content, .. } = &mut item else {
+            unreachable!()
+        };
+        content.push(ContentItem::InputFile { file });
+        assert_eq!(estimate_item_token_count(&item), None);
+        let mut history = create_history_with_items(vec![assistant_msg("previous"), item.clone()]);
+        history.update_token_info(
+            &TokenUsage {
+                total_tokens: 100,
+                ..Default::default()
+            },
+            Some(4000),
+        );
+        assert_eq!(history.get_total_token_usage(true), None);
+        assert_eq!(
+            history.estimated_tokens_after_last_model_generated_item(),
+            None
+        );
+        assert_eq!(
+            history
+                .token_info
+                .as_ref()
+                .unwrap()
+                .last_token_usage
+                .total_tokens,
+            100
+        );
+        assert!(history.items.iter().any(|entry| entry.item == item));
+        // Actual provider usage stays measured; it does not reveal future opaque-file expansion.
+        let accepted = assistant_msg("provider accepted the file");
+        history.record_items([&accepted], TruncationPolicy::Tokens(10000));
+        history.update_token_info(
+            &TokenUsage {
+                total_tokens: 321,
+                ..Default::default()
+            },
+            Some(4000),
+        );
+        assert_eq!(history.get_total_token_usage(true), None);
+        assert_eq!(
+            history
+                .token_info
+                .as_ref()
+                .unwrap()
+                .last_token_usage
+                .total_tokens,
+            321
+        );
+        assert!(history.items.iter().any(|entry| entry.item == item));
+    }
+}
