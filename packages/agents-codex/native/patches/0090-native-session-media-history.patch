+/// An opaque provider reference. The SDK never fetches a URL or uploads a file ID.
+#[derive(Debug, Clone, Serialize, PartialEq, TS)]
+#[serde(untagged)]
+#[ts(untagged, export_to = "v2/")]
+pub enum DynamicImageReference {
+    #[ts(type = "{ imageUrl: string; fileId?: never }")]
+    Url {
+        #[serde(rename = "imageUrl")]
+        image_url: String,
+    },
+    #[ts(type = "{ fileId: string; imageUrl?: never }")]
+    File {
+        #[serde(rename = "fileId")]
+        file_id: String,
+    },
+}
+
+// Keep generated schemas aligned with source presence checks, including a null second source.
+impl JsonSchema for DynamicImageReference {
+    fn schema_name() -> String {
+        "DynamicImageReference".into()
+    }
+
+    fn json_schema(generator: &mut schemars::r#gen::SchemaGenerator) -> schemars::schema::Schema {
+        #[allow(dead_code)]
+        #[derive(JsonSchema)]
+        #[serde(untagged)]
+        enum Source {
+            Url {
+                #[serde(rename = "imageUrl")]
+                #[schemars(length(min = 1))]
+                image_url: String,
+            },
+            File {
+                #[serde(rename = "fileId")]
+                #[schemars(length(min = 1))]
+                file_id: String,
+            },
+        }
+        let mut schema = Source::json_schema(generator).into_object();
+        let both_sources = schemars::schema::SchemaObject {
+            object: Some(Box::new(schemars::schema::ObjectValidation {
+                required: ["imageUrl".into(), "fileId".into()].into_iter().collect(),
+                ..Default::default()
+            })),
+            ..Default::default()
+        };
+        schema.subschemas.get_or_insert_with(Default::default).not =
+            Some(Box::new(both_sources.into()));
+        schema.into()
+    }
+}
+
+impl<'de> Deserialize<'de> for DynamicToolCallOutputContentItem {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        #[derive(Deserialize)]
+        #[serde(tag = "type", rename_all = "camelCase")]
+        enum WireContent {
+            InputFile {
+                #[serde(flatten)]
+                file: crate::input_file::InputFile,
+            },
+            InputText {
+                text: String,
+            },
+            InputImage {
+                #[serde(flatten)]
+                image: HashMap<String, JsonValue>,
+                #[serde(default)]
+                detail: Option<crate::models::ImageDetail>,
+            },
+            InputAudio {
+                #[serde(rename = "audioUrl")]
+                audio_url: String,
+            },
+        }
+        Ok(match WireContent::deserialize(deserializer)? {
+            WireContent::InputFile { file } => Self::InputFile { file },
+            WireContent::InputText { text } => Self::InputText { text },
+            WireContent::InputAudio { audio_url } => Self::InputAudio { audio_url },
+            WireContent::InputImage { mut image, detail } => {
+                // Presence matters: a second source set to null is still invalid.
+                let image = match (image.remove("imageUrl"), image.remove("fileId")) {
+                    (Some(JsonValue::String(image_url)), None) if !image_url.is_empty() => {
+                        DynamicImageReference::Url { image_url }
+                    }
+                    (None, Some(JsonValue::String(file_id))) if !file_id.is_empty() => {
+                        DynamicImageReference::File { file_id }
+                    }
+                    _ => {
+                        return Err(D::Error::custom(
+                            "image must contain exactly one nonempty imageUrl or fileId",
+                        ));
+                    }
+                };
+                Self::InputImage { image, detail }
+            }
+        })
+    }
+}
