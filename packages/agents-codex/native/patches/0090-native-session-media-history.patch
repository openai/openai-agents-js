+//! Explicit native request preferences. These values never grant tool authority.
+use crate::ToolName;
+use crate::config_types::Verbosity;
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeMap;
+use ts_rs::TS;
+
+#[derive(Debug, Clone, Copy, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub enum PromptCacheRetention {
+    #[serde(rename = "in_memory")]
+    InMemory,
+    #[serde(rename = "24h")]
+    Hours24,
+}
+
+#[derive(Debug, Clone, Copy, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub enum PromptCacheTtl {
+    #[serde(rename = "30m")]
+    Minutes30,
+    #[serde(rename = "12h")]
+    Hours12,
+}
+
+/// Retain the caller's selection, including explicit clears, across capture/restore.
+/// This is also a sparse update: omitted members leave each owner's selection intact.
+#[derive(Debug, Clone, Default, Deserialize, Serialize, PartialEq, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRequestControls {
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, type = "number | null")]
+    #[schemars(with = "Option<u64>")]
+    pub max_output_tokens: Option<Option<u64>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<f64>")]
+    #[schemars(with = "Option<f64>")]
+    pub temperature: Option<Option<f64>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<f64>")]
+    #[schemars(with = "Option<f64>")]
+    pub top_p: Option<Option<f64>>,
+    /// Request chosen-token probabilities and up to this many alternatives (0..=20).
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, type = "number | null")]
+    #[schemars(with = "Option<u8>")]
+    pub top_logprobs: Option<Option<u8>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<bool>")]
+    #[schemars(with = "Option<bool>")]
+    pub parallel_tool_calls: Option<Option<bool>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<Verbosity>")]
+    #[schemars(with = "Option<Verbosity>")]
+    pub verbosity: Option<Option<Verbosity>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<BTreeMap<String, String>>")]
+    #[schemars(with = "Option<BTreeMap<String, String>>")]
+    pub metadata: Option<Option<BTreeMap<String, String>>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<bool>")]
+    #[schemars(with = "Option<bool>")]
+    pub store: Option<Option<bool>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<PromptCacheRetention>")]
+    #[schemars(with = "Option<PromptCacheRetention>")]
+    pub prompt_cache_retention: Option<Option<PromptCacheRetention>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<PromptCacheTtl>")]
+    #[schemars(with = "Option<PromptCacheTtl>")]
+    pub prompt_cache_ttl: Option<Option<PromptCacheTtl>>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        with = "serde_with::rust::double_option"
+    )]
+    #[ts(optional = nullable, as = "Option<ToolName>")]
+    #[schemars(with = "Option<ToolName>")]
+    pub named_tool_choice: Option<Option<ToolName>>,
+}
+
+impl ModelRequestControls {
+    pub fn is_empty(&self) -> bool {
+        self.max_output_tokens.is_none()
+            && self.temperature.is_none()
+            && self.top_p.is_none()
+            && self.top_logprobs.is_none()
+            && self.parallel_tool_calls.is_none()
+            && self.verbosity.is_none()
+            && self.metadata.is_none()
+            && self.store.is_none()
+            && self.prompt_cache_retention.is_none()
+            && self.prompt_cache_ttl.is_none()
+            && self.named_tool_choice.is_none()
+    }
+
+    pub fn apply_patch(&mut self, patch: &Self) {
+        if patch.max_output_tokens.is_some() {
+            self.max_output_tokens = patch.max_output_tokens;
+        }
+        if patch.temperature.is_some() {
+            self.temperature = patch.temperature;
+        }
+        if patch.top_p.is_some() {
+            self.top_p = patch.top_p;
+        }
+        if patch.top_logprobs.is_some() {
+            self.top_logprobs = patch.top_logprobs;
+        }
+        if patch.parallel_tool_calls.is_some() {
+            self.parallel_tool_calls = patch.parallel_tool_calls;
+        }
+        if patch.verbosity.is_some() {
+            self.verbosity = patch.verbosity;
+        }
+        if patch.metadata.is_some() {
+            self.metadata = patch.metadata.clone();
+        }
+        if patch.store.is_some() {
+            self.store = patch.store;
+        }
+        if patch.prompt_cache_retention.is_some() {
+            self.prompt_cache_retention = patch.prompt_cache_retention;
+        }
+        if patch.prompt_cache_ttl.is_some() {
+            self.prompt_cache_ttl = patch.prompt_cache_ttl;
+        }
+        if patch.named_tool_choice.is_some() {
+            self.named_tool_choice = patch.named_tool_choice.clone();
+        }
+    }
+
+    /// Check wire shapes independently of uncertain model-level support.
+    pub fn validate_shape(&self) -> Result<(), String> {
+        if self
+            .max_output_tokens
+            .flatten()
+            .is_some_and(|value| value == 0 || value > 9_007_199_254_740_991)
+        {
+            return Err("max_output_tokens must be a positive safe integer".into());
+        }
+        if self.top_logprobs.flatten().is_some_and(|value| value > 20) {
+            return Err("top_logprobs must be an integer between zero and 20".into());
+        }
