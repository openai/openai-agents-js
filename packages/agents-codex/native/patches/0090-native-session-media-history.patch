+//! Tool-origin completion keeps the original finishing task through the canonical fence.
+use super::*;
+use crate::tasks::SessionTask;
+use codex_protocol::turn_input::NotSubmittedReason;
+use codex_thread_store::*;
+use std::any::Any;
+use tokio::sync::{mpsc, oneshot};
+
+struct TerminalFlush {
+    release: oneshot::Sender<Result<(), String>>,
+}
+
+struct TerminalStore {
+    inner: InMemoryThreadStore,
+    terminal_seen: std::sync::atomic::AtomicBool,
+    fail_append: bool,
+    hold_append: std::sync::atomic::AtomicBool,
+    flushes: mpsc::UnboundedSender<TerminalFlush>,
+}
+
+macro_rules! terminal_delegate {
+    ($(fn $name:ident($param:ident: $params:ty) -> $result:ty;)*) => {
+        $(fn $name(&self, $param: $params) -> ThreadStoreFuture<'_, $result> {
+            ThreadStore::$name(&self.inner, $param)
+        })*
+    };
+}
+impl ThreadStore for TerminalStore {
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+    terminal_delegate! {
+        fn create_thread(params: CreateThreadParams) -> ();
+        fn resume_thread(params: ResumeThreadParams) -> Arc<Vec<RolloutItem>>;
+        fn discard_thread(thread_id: codex_protocol::ThreadId) -> ();
+        fn load_history(params: LoadThreadHistoryParams) -> StoredThreadHistory;
+        fn read_thread(params: ReadThreadParams) -> StoredThread;
+        fn read_thread_by_rollout_path(params: ReadThreadByRolloutPathParams) -> StoredThread;
+        fn list_threads(params: ListThreadsParams) -> ThreadPage;
+        fn update_thread_metadata(params: UpdateThreadMetadataParams) -> Option<StoredThread>;
+        fn archive_thread(params: ArchiveThreadParams) -> ();
+        fn unarchive_thread(params: ArchiveThreadParams) -> StoredThread;
+        fn delete_thread(params: DeleteThreadParams) -> ();
+        fn shutdown_thread(thread_id: codex_protocol::ThreadId) -> ();
+    }
+    fn append_items(&self, params: AppendThreadItemsParams) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move {
+            let terminal = params.items.iter().any(|item| matches!(item,
+                RolloutItem::EventMsg(EventMsg::TurnComplete(event)) if event.tool_completion.is_some()));
+            if terminal && self.fail_append {
+                return Err(ThreadStoreError::Internal {
+                    message: "terminal append failed".into(),
+                });
+            }
+            if terminal
+                && self
+                    .hold_append
+                    .swap(false, std::sync::atomic::Ordering::SeqCst)
+            {
+                let (release, pending) = oneshot::channel();
+                self.flushes
+                    .send(TerminalFlush { release })
+                    .expect("append observer");
+                pending
+                    .await
+                    .expect("release held terminal append")
+                    .map_err(|message| ThreadStoreError::Internal { message })?;
+            }
+            self.inner.append_items(params).await?;
+            if terminal {
+                self.terminal_seen
+                    .store(true, std::sync::atomic::Ordering::SeqCst);
+            }
+            Ok(())
+        })
+    }
+    fn persist_thread(
+        &self,
+        id: codex_protocol::ThreadId,
+        context: PersistContext,
+    ) -> ThreadStoreFuture<'_, ()> {
+        self.inner.persist_thread(id, context)
+    }
+    fn flush_thread(&self, id: codex_protocol::ThreadId) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move {
+            if self
+                .terminal_seen
+                .swap(false, std::sync::atomic::Ordering::SeqCst)
+            {
+                let (release, pending) = oneshot::channel();
+                self.flushes
+                    .send(TerminalFlush { release })
+                    .expect("flush observer");
+                pending
+                    .await
+                    .expect("release held terminal fence")
+                    .map_err(|message| ThreadStoreError::Internal { message })?;
+            }
+            self.inner.flush_thread(id).await
+        })
+    }
+}
+
+struct TerminalTask {
+    release: Arc<Notify>,
+}
+impl SessionTask for TerminalTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.terminal_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _context: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        _cancel: CancellationToken,
+    ) -> crate::tasks::SessionTaskResult {
+        self.release.notified().await;
+        Ok(None)
+    }
+}
+fn selected_tool_value() -> codex_protocol::protocol::ToolTurnCompletion {
+    codex_protocol::protocol::ToolTurnCompletion {
+        call_id: "call-authoritative".into(),
+        name: "answer".into(),
+        namespace: Some("domain".into()),
+        final_output: serde_json::json!({"answer": 42}),
+    }
+}
+async fn gated_terminal_session(
+    fail_append: bool,
+) -> (
+    Arc<Session>,
+    Arc<TurnContext>,
+    async_channel::Receiver<Event>,
+    Arc<Notify>,
+    mpsc::UnboundedReceiver<TerminalFlush>,
+    Arc<TerminalStore>,
+) {
+    let (session, context, events) = make_session_and_context_with_rx().await;
+    let mut session = Arc::try_unwrap(session).ok().expect("unshared session");
+    let (flushes, pending) = mpsc::unbounded_channel();
+    let store = Arc::new(TerminalStore {
+        inner: InMemoryThreadStore::default(),
+        terminal_seen: std::sync::atomic::AtomicBool::new(false),
+        fail_append,
+        hold_append: std::sync::atomic::AtomicBool::new(false),
+        flushes,
+    });
+    attach_terminal_thread_store(&mut session, store.clone()).await;
+    let session = Arc::new(session);
+    let release = Arc::new(Notify::new());
+    session
+        .spawn_task(
+            context.clone(),
+            Vec::new(),
+            TerminalTask {
+                release: release.clone(),
+            },
+        )
+        .await;
+    while events.try_recv().is_ok() {}
+    (session, context, events, release, pending, store)
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn tool_terminal_reservation_loses_to_accepted_steering() {
+    let (session, turn, _events, release, _flushes, _store) = gated_terminal_session(false).await;
+    let steer = submit_steer_only(
+        &session,
+        vec![UserInput::Text {
+            text: "steer wins".into(),
+            text_elements: Vec::new(),
+        }],
+        &turn.sub_id,
+    )
+    .await;
+    assert!(matches!(steer, TurnInputSubmission::Steered { .. }));
+    assert!(
+        !session
+            .input_queue
+            .reserve_tool_completion(
+                &session.active_turn,
+                &turn.sub_id,
+                &CancellationToken::new()
+            )
+            .await
+    );
+    release.notify_one();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn tool_terminal_flush_blocks_success_and_cancellation_joins_the_owner() {
+    let (session, turn, events, release, mut flushes, store) = gated_terminal_session(false).await;
+    struct Permit(Arc<std::sync::atomic::AtomicBool>);
+    impl Drop for Permit {
+        fn drop(&mut self) {
+            self.0.store(true, std::sync::atomic::Ordering::SeqCst);
+        }
+    }
+    let permit_released = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    session
+        .active_turn
+        .lock()
+        .await
+        .as_mut()
+        .unwrap()
+        .task
+        .as_mut()
+        .unwrap()
+        ._agent_execution_guard = Some(crate::agent::types::AgentExecutionGuard::new(Permit(
+        permit_released.clone(),
+    )));
+    assert!(
+        session
+            .input_queue
+            .reserve_tool_completion(
+                &session.active_turn,
+                &turn.sub_id,
+                &CancellationToken::new()
+            )
+            .await
+    );
+    turn.extension_data
+        .insert(crate::session::turn::ValidatedToolCompletion(
+            selected_tool_value(),
+        ));
+    release.notify_one();
+    let held = timeout(Duration::from_secs(2), flushes.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    let (reply, decision) = tokio::sync::oneshot::channel();
+    timeout(
+        Duration::from_secs(2),
+        session.interrupt_turn_if_no_pending_input(&turn.sub_id, reply),
+    )
+    .await
+    .expect("conditional interrupt must decide without joining its held fence");
+    assert!(
+        !decision.await.unwrap(),
+        "conditional interrupt cannot take a reserved owner"
+    );
+    assert!(
+        session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .is_some_and(|active| active.tool_completion_reserved.is_some())
+    );
+    assert!(!permit_released.load(std::sync::atomic::Ordering::SeqCst));
+    assert!(
+        events.try_recv().is_err(),
+        "no successful terminal event before flush acknowledgment"
+    );
+    assert!(matches!(
+        submit_steer_only(
+            &session,
+            vec![UserInput::Text {
+                text: "too late for old turn".into(),
+                text_elements: Vec::new(),
+            }],
+            &turn.sub_id
+        )
+        .await,
+        TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::NoActiveTurn
+        }
+    ));
+    let abort = tokio::spawn({
+        let session = session.clone();
+        async move {
+            session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+        }
+    });
+    tokio::task::yield_now().await;
+    assert!(
+        !abort.is_finished(),
+        "cancellation must join the reserved writer"
+    );
+    assert!(session.active_turn.lock().await.is_some());
+    held.release.send(Ok(())).unwrap();
+    let event = recv_terminal_event(&events, TerminalEventKind::TurnComplete).await;
+    let EventMsg::TurnComplete(done) = event.msg else {
+        unreachable!()
+    };
+    assert!(done.last_agent_message.is_none());
+    pretty_assertions::assert_eq!(done.tool_completion, Some(selected_tool_value()));
+    timeout(Duration::from_secs(2), abort)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(permit_released.load(std::sync::atomic::Ordering::SeqCst));
+    let history = store
+        .inner
+        .load_history(LoadThreadHistoryParams {
+            thread_id: session.thread_id,
+            include_archived: true,
+        })
+        .await
+        .unwrap();
+    assert!(history.items.iter().any(|item| matches!(item, RolloutItem::EventMsg(EventMsg::TurnComplete(done)) if done.tool_completion == Some(selected_tool_value()))));
+}
