+/// Project an SDK-owned retained reference for an unsupported current request profile.
+/// Only the request copy changes; canonical history and inline bytes stay untouched.
+pub(crate) fn withhold_unqualified_provider_references(
+    items: &mut [ResponseItem],
+    policy: Option<ProviderImageReferencePolicy>,
+) {
+    if policy != Some(ProviderImageReferencePolicy::PrepareInline) {
+        return;
+    }
+    for item in items {
+        match item {
+            ResponseItem::Message { .. } => {
+                if let Some(mut content) = to_annotated_content(item) {
+                    for part in &mut content {
+                        if matches!(part.content(), ContentItem::InputImage {
+                            image: ImageReference::Inline { image_url }, ..
+                        } if is_remote_image_url(image_url))
+                        {
+                            *part = AnnotatedContent::input_text(
+                                REMOTE_IMAGE_URL_PLACEHOLDER,
+                                ContentItemKind("images.preparation_error".into()),
+                            );
+                        }
+                    }
+                    let _ = set_annotated_content(item, content);
+                }
+            }
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                if let Some(content) = output.content_items_mut() {
+                    for part in content {
+                        if matches!(part, FunctionCallOutputContentItem::InputImage {
+                            image: ImageReference::Inline { image_url }, ..
+                        } if is_remote_image_url(image_url))
+                        {
+                            *part = FunctionCallOutputContentItem::InputText {
+                                text: REMOTE_IMAGE_URL_PLACEHOLDER.into(),
+                            };
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
