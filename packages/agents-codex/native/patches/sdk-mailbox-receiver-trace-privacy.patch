+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+pub enum ScopeRestriction {
+    #[default]
+    Unrestricted,
+    Disabled,
+    MetadataOnly,
+}
+
+impl ScopeRestriction {
+    /// Narrow capture without changing the submitting operation's parent or routing.
+    pub fn apply(self, context: Context, dispatch: Option<&tracing::Span>) -> Context {
+        if self == Self::Unrestricted {
+            return context;
+        }
+        let context = dispatch
+            .map(OpenTelemetrySpanExt::context)
+            .filter(|context| context.span().span_context().is_valid())
+            .unwrap_or(context);
+        let disabled = self == Self::Disabled;
+        let policy = match policy_for_context(&context) {
+            Some(policy) if policy.disabled || (!disabled && !policy.include_sensitive_data) => {
+                return context;
+            }
+            Some(policy) => ScopePolicy {
+                disabled,
+                include_sensitive_data: false,
+                callback_release: policy.callback_release.clone(),
+                ..policy.without_callback_release()
+            },
+            None => ScopePolicy {
+                disabled,
+                restriction_only: true,
+                ..ScopePolicy::default()
+            },
+        };
+        context.with_value(Arc::new(policy))
+    }
+}
