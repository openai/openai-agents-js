+#[tokio::test]
+async fn sdk_root_unowned_urls_keep_decline_route_without_owned_authority() {
+    tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        for group in [false, true] {
+            let router = ElicitationRequestRouter::default();
+            let authority = batch_authority();
+            let manager = ElicitationRequestManager::new(
+                authority.config.clone(),
+                None,
+                None,
+                router.clone(),
+            );
+            let extensions =
+                ClientMcpExtensions::new([("openai/sdk-root-prompts".to_owned(), json!({}))])
+                    .for_mcp_servers();
+            assert!(!extensions.contains("openai/sdk-root-prompts"));
+            let (events, received) = async_channel::unbounded();
+            let send = manager.make_sender_with_connection(
+                "one".into(),
+                Some(events),
+                &extensions,
+                Some(1),
+                /*sdk_root_prompts*/ true,
+            );
+            let request = if group {
+                Elicitation::UrlsRequired(vec![url("A"), url("B")])
+            } else {
+                Elicitation::Mcp(url("A"))
+            };
+            let task = tokio::spawn(async move {
+                codex_rmcp_client::scope_owner(None, send(RequestId::Number(77), request)).await
+            });
+            let mut tokens = Vec::new();
+            for _ in 0..if group { 2 } else { 1 } {
+                let event = received.recv().await.unwrap();
+                let EventMsg::ElicitationRequest(request) = &event.msg else {
+                    panic!("Expected unowned URL interaction");
+                };
+                assert_eq!(request.turn_id, None);
+                assert!(matches!(request.request, ElicitationRequest::Url { .. }));
+                let token = event_token(event);
+                let id = RequestId::String(token.clone().into());
+                assert!(router.owned_admission("one", &id).is_none());
+                // The SDK cannot capture an OwnedQuestion grant for this URL.
+                assert!(!router.resolve_owned(
+                    "one",
+                    &id,
+                    "successor-root",
+                    ElicitationResponse {
+                        action: ElicitationAction::Accept,
+                        content: None,
+                        meta: None,
+                    }
+                ));
+                tokens.push(token);
+            }
+            // Exercise the existing negative response route, without granting URL consent.
+            router
+                .resolve(
+                    "one".into(),
+                    RequestId::String(tokens[0].clone().into()),
+                    ElicitationResponse {
+                        action: ElicitationAction::Decline,
+                        content: None,
+                        meta: None,
+                    },
+                )
+                .await
+                .unwrap();
+            assert_eq!(
+                task.await.unwrap().unwrap().action,
+                if group {
+                    ElicitationAction::Cancel
+                } else {
+                    ElicitationAction::Decline
+                }
+            );
+        }
+    })
+    .await
+    .expect("Unowned URL routing must settle");
+}
