+
+/// Canonical local write grants, their filesystem identities, and Linux mounts.
+pub struct LocalWriteRoots<'a> {
+    roots: &'a [AbsolutePathBuf],
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    physical: PhysicalWriteRoots,
+    #[cfg(target_os = "linux")]
+    mounts: WritableMounts,
+}
+
+impl<'a> LocalWriteRoots<'a> {
+    pub fn new(roots: &'a [AbsolutePathBuf]) -> io::Result<Self> {
+        #[cfg(target_os = "linux")]
+        let mounts = if roots.is_empty() {
+            WritableMounts::default()
+        } else {
+            WritableMounts::new(roots, &fs::read("/proc/self/mountinfo")?)?
+        };
+        Ok(Self {
+            roots,
+            #[cfg(any(target_os = "linux", target_os = "macos"))]
+            physical: PhysicalWriteRoots::new(roots)?,
+            #[cfg(target_os = "linux")]
+            mounts,
+        })
+    }
+
+    /// Includes alternate paths to the same filesystem entries and Linux mounts.
+    pub fn contains_entry(&self, path: &Path) -> io::Result<bool> {
+        if self
+            .roots
+            .iter()
+            .any(|root| path.starts_with(root.as_path()))
+        {
+            return Ok(true);
+        }
+        #[cfg(any(target_os = "linux", target_os = "macos"))]
+        if self.physical.contains_entry(path)? {
+            return Ok(true);
+        }
+        #[cfg(target_os = "linux")]
+        return self.mounts.contains_entry(path);
+        #[cfg(not(target_os = "linux"))]
+        Ok(false)
+    }
+
+    /// Detect ordinary hard links to resolved helper files in local write grants.
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    pub fn contains_hard_link_to_any(&self, paths: &[PathBuf]) -> io::Result<bool> {
+        let mut linked_helpers = HashSet::new();
+        for path in paths {
+            let metadata = fs::symlink_metadata(path)?;
+            if metadata.is_file() && metadata.nlink() > 1 {
+                linked_helpers.insert((metadata.dev(), metadata.ino()));
+            }
+        }
+        if linked_helpers.is_empty() {
+            return Ok(false);
+        }
+
+        // A package manager may keep other links outside the grants. Walk the
+        // grants once for all multiply linked helpers and never follow symlinks.
+        let mut directories = Vec::new();
+        for root in self.roots {
+            if !self
+                .roots
+                .iter()
+                .any(|other| root != other && root.as_path().starts_with(other.as_path()))
+            {
+                directories.push((root.as_path(), root.as_path().to_path_buf()));
+            }
+        }
+        while let Some((root, directory)) = directories.pop() {
+            #[cfg(target_os = "linux")]
+            let (_directory_fd, entries) = read_helper_directory(root, &directory)?;
+            #[cfg(not(target_os = "linux"))]
+            let entries = fs::read_dir(&directory)?;
+            for entry in entries {
+                let entry = entry?;
+                let kind = entry.file_type()?;
+                if kind.is_dir() {
+                    directories.push((root, directory.join(entry.file_name())));
+                } else if kind.is_file() {
+                    let metadata = entry.metadata()?;
+                    if linked_helpers.contains(&(metadata.dev(), metadata.ino())) {
+                        return Ok(true);
+                    }
+                }
+            }
+        }
+        Ok(false)
+    }
+
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    pub fn contains_hard_link_to_any(&self, _paths: &[PathBuf]) -> io::Result<bool> {
+        Ok(false)
+    }
+
+    /// Includes physical ancestors of a grant and mounts below the protected path.
+    pub fn has_root_at_or_below(&self, path: &Path) -> io::Result<bool> {
+        if self
+            .roots
+            .iter()
+            .any(|root| root.as_path().starts_with(path))
+        {
+            return Ok(true);
+        }
+        #[cfg(any(target_os = "linux", target_os = "macos"))]
+        if self.physical.has_root_at_or_below(path)? {
+            return Ok(true);
+        }
+        #[cfg(target_os = "linux")]
+        return self.mounts.contains_descendant(path);
+        #[cfg(not(target_os = "linux"))]
+        Ok(false)
+    }
+}
+
+// A finite bind view can exceed PATH_MAX even when its original tree does not.
+// Keep the ordinary path walk fast; reopen only overlong paths one component at
+// a time. Retain the final descriptor until its ReadDir entries have been used.
+#[cfg(target_os = "linux")]
+fn read_helper_directory(
+    root: &Path,
+    directory: &Path,
+) -> io::Result<(Option<fs::File>, fs::ReadDir)> {
+    match fs::read_dir(directory) {
+        Ok(entries) => Ok((None, entries)),
+        Err(error) if error.raw_os_error() == Some(libc::ENAMETOOLONG) => {
+            let relative = directory.strip_prefix(root).map_err(io::Error::other)?;
+            // Preserve the existing grant-root lookup, including an explicit
+            // root alias. Descendants are still never followed through symlinks.
+            let mut opened = fs::File::open(root)?;
+            for component in relative {
+                let path =
+                    PathBuf::from(format!("/proc/self/fd/{}", opened.as_raw_fd())).join(component);
+                opened = fs::OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+                    .open(path)?;
+            }
+            let entries = fs::read_dir(format!("/proc/self/fd/{}", opened.as_raw_fd()))?;
+            Ok((Some(opened), entries))
+        }
+        Err(error) => Err(error),
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+type EntryIdentity = (u64, u64);
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+#[derive(Default)]
+struct PhysicalWriteRoots {
+    roots: HashSet<EntryIdentity>,
+    ancestors: HashSet<EntryIdentity>,
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+impl PhysicalWriteRoots {
+    fn new(roots: &[AbsolutePathBuf]) -> io::Result<Self> {
+        let mut physical = Self::default();
+        for root in roots {
+            physical.roots.insert(write_root_identity(root.as_path())?);
+            for ancestor in root.as_path().ancestors().skip(1) {
+                physical.ancestors.extend(entry_identity(ancestor)?);
+            }
+        }
+        Ok(physical)
+    }
+
+    fn contains_entry(&self, path: &Path) -> io::Result<bool> {
+        if self.roots.is_empty() {
+            return Ok(false);
+        }
+        // An alternate spelling can hide a grant even when only an ancestor
+        // of the proposed path already exists.
+        for ancestor in path.ancestors() {
+            if entry_identity(ancestor)?.is_some_and(|identity| self.roots.contains(&identity)) {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    fn has_root_at_or_below(&self, path: &Path) -> io::Result<bool> {
+        if self.roots.is_empty() {
+            return Ok(false);
+        }
+        Ok(entry_identity(path)?.is_some_and(|identity| {
+            self.roots.contains(&identity) || self.ancestors.contains(&identity)
+        }))
+    }
+}
+
+#[cfg(target_os = "linux")]
+struct Mount {
+    destination: PathBuf,
+    // Pseudo filesystems can have a non-path root, such as nsfs "mnt:[inode]".
+    backing: Option<PathBuf>,
+}
+
+#[cfg(target_os = "linux")]
+impl Mount {
+    fn backing_path(&self, path: &Path) -> Option<PathBuf> {
+        let relative = path.strip_prefix(&self.destination).ok()?;
+        Some(self.backing.as_ref()?.join(relative))
+    }
+}
+
+#[cfg(target_os = "linux")]
+#[derive(Eq, Hash, PartialEq)]
+struct BackingEntry {
+    visible: PathBuf,
+    backing: PathBuf,
+    identity: EntryIdentity,
+}
+
+#[cfg(target_os = "linux")]
+#[derive(Default)]
+struct WritableMounts {
+    mounts: Vec<Mount>,
+    identities: HashSet<EntryIdentity>,
+    backing_entries: HashSet<BackingEntry>,
+}
+
+#[cfg(target_os = "linux")]
+impl WritableMounts {
+    fn new(roots: &[AbsolutePathBuf], mountinfo: &[u8]) -> io::Result<Self> {
+        let mut grants = Self::default();
+        for line in mountinfo
+            .split(|&byte| byte == b'\n')
+            .filter(|line| !line.is_empty())
+        {
+            let mut fields = line.split(|&byte| byte == b' ').skip(3);
+            let (Some(backing), Some(destination)) = (fields.next(), fields.next()) else {
+                return Err(io::Error::other("invalid mountinfo entry"));
+            };
+            grants.mounts.push(Mount {
+                destination: decode_mountinfo_path(destination)?,
+                backing: backing
+                    .starts_with(b"/")
+                    .then(|| decode_mountinfo_path(backing))
+                    .transpose()?,
+            });
+        }
+        for root in roots {
+            grants.insert(root.as_path(), write_root_identity(root.as_path())?);
+        }
+        for index in 0..grants.mounts.len() {
+            let destination = &grants.mounts[index].destination;
+            if roots
+                .iter()
+                .any(|root| destination.starts_with(root.as_path()))
+                && let Some(identity) = entry_identity(destination)?
+            {
+                // Use the visible entry because mountinfo can also describe covered mounts.
+                grants.insert(&destination.clone(), identity);
+            }
+        }
+        Ok(grants)
+    }
+
+    fn insert(&mut self, path: &Path, identity: EntryIdentity) {
+        self.identities.insert(identity);
+        self.backing_entries
+            .extend(self.mounts.iter().filter_map(|mount| {
+                Some(BackingEntry {
+                    visible: path.to_path_buf(),
+                    backing: mount.backing_path(path)?,
+                    identity,
+                })
+            }));
+    }
+
+    fn contains_entry(&self, path: &Path) -> io::Result<bool> {
+        if self.identities.is_empty() {
+            return Ok(false);
+        }
+        let Some(identity) = entry_identity(path)? else {
+            return Ok(false);
+        };
+        if self.identities.contains(&identity) {
+            return Ok(true);
+        }
+        for mount in &self.mounts {
+            if let Some(backing) = mount.backing_path(path)
+                && self.contains_backing_path(&backing, identity)?
+            {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    fn contains_backing_path(&self, backing: &Path, identity: EntryIdentity) -> io::Result<bool> {
+        for entry in &self.backing_entries {
+            let Ok(relative) = backing.strip_prefix(&entry.backing) else {
+                continue;
+            };
+            // The protected path can be mounted from beneath a grant. Confirm the
+            // proposed writable name still exposes that inode without following a
+            // symlink out of the grant or through a covered mount.
+            let candidate = join_mount_relative(&entry.visible, relative);
+            if entry_identity(&candidate)? == Some(identity)
+                && fs::canonicalize(&candidate)? == candidate
+            {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    fn contains_descendant(&self, path: &Path) -> io::Result<bool> {
+        for mount in &self.mounts {
+            let (directory, backing) = if let Some(backing) = mount.backing_path(path) {
+                (path, backing)
+            } else if mount.destination.starts_with(path)
+                && let Some(backing) = &mount.backing
+            {
+                (mount.destination.as_path(), backing.clone())
+            } else {
+                continue;
+            };
+            if let Some(identity) = entry_identity(directory)?
+                && self.contains_backing_path(&backing, identity)?
+            {
+                return Ok(true);
+            }
+            for entry in &self.backing_entries {
+                // Mount roots propose a location. Stat the candidate to establish actual
+                // identity, including when a different mount covers the proposed path.
+                let Ok(relative) = entry.backing.strip_prefix(&backing) else {
+                    continue;
+                };
+                if entry_identity(&join_mount_relative(directory, relative))?
+                    == Some(entry.identity)
+                {
+                    return Ok(true);
+                }
+            }
+        }
+        Ok(false)
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn join_mount_relative(path: &Path, relative: &Path) -> PathBuf {
+    // Adding a slash to a file mount's own path makes it unstatable.
+    if relative.as_os_str().is_empty() {
+        path.to_path_buf()
+    } else {
+        path.join(relative)
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+fn write_root_identity(path: &Path) -> io::Result<EntryIdentity> {
+    entry_identity(path)?
+        .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "local writable root disappeared"))
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+fn entry_identity(path: &Path) -> io::Result<Option<EntryIdentity>> {
+    match fs::symlink_metadata(path) {
+        Ok(metadata) => Ok(Some((metadata.dev(), metadata.ino()))),
+        Err(error)
+            if matches!(
+                error.kind(),
+                io::ErrorKind::NotFound | io::ErrorKind::NotADirectory
+            ) =>
+        {
+            Ok(None)
+        }
+        Err(error) => Err(error),
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub fn decode_mountinfo_path(encoded: &[u8]) -> io::Result<PathBuf> {
+    let mut decoded = Vec::new();
+    let mut bytes = encoded.iter().copied();
+    while let Some(byte) = bytes.next() {
+        decoded.push(if byte == b'\\' {
+            let digits: Vec<_> = bytes.by_ref().take(3).collect();
+            match digits.as_slice() {
+                b"040" => b' ',
+                b"011" => b'\t',
+                b"012" => b'\n',
+                b"134" => b'\\',
+                _ => return Err(io::Error::other("invalid mountinfo path escape")),
+            }
+        } else {
+            byte
+        });
+    }
+    let path = PathBuf::from(std::ffi::OsString::from_vec(decoded));
+    if !path.is_absolute() {
+        return Err(io::Error::other("mountinfo path is not absolute"));
+    }
+    Ok(path)
+}
