+    /// Load model context from the exact local rollout selected for SDK recovery.
+    pub async fn load_model_context_for_rollout(
+        &self,
+        thread_id: ThreadId,
+        rollout_path: &std::path::Path,
+    ) -> ThreadStoreResult<StoredModelContext> {
+        model_context::load_from_rollout_path(self, thread_id, rollout_path).await
+    }
+
+    /// Resolve an authorized cold rollout route to the file used for history.
+    pub async fn resolve_cold_rollout_path(
+        &self,
+        rollout_path: &std::path::Path,
+    ) -> ThreadStoreResult<PathBuf> {
+        let route = self.config.codex_home.join(rollout_path);
+        let missing = |message: &str| ThreadStoreError::InvalidRequest {
+            message: message.to_string(),
+        };
+        let canonicalize = |path: PathBuf| async move {
+            tokio::fs::canonicalize(path)
+                .await
+                .map_err(|err| ThreadStoreError::Internal {
+                    message: err.to_string(),
+                })
+        };
+        let path = codex_rollout::existing_rollout_path(&route)
+            .await
+            .ok_or_else(|| missing("missing recorded rollout"))?;
+        let path = canonicalize(path).await?;
+        // An alias can hide the plain sibling beside its canonical target.
+        let selected = codex_rollout::existing_rollout_path(&path)
+            .await
+            .ok_or_else(|| missing("missing canonical rollout"))?;
+        if selected == path {
+            Ok(path)
+        } else {
+            canonicalize(selected).await
+        }
+    }
+
