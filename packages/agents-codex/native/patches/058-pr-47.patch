+
+#[derive(Clone)]
+enum MailboxTracePolicy {
+    Trigger(Arc<sdk_trace::ScopePolicy>),
+    Queued(Weak<sdk_trace::ScopePolicy>),
+}
+
+impl MailboxTracePolicy {
+    fn as_ptr(&self) -> *const sdk_trace::ScopePolicy {
+        match self {
+            Self::Trigger(policy) => Arc::as_ptr(policy),
+            Self::Queued(policy) => policy.as_ptr(),
+        }
+    }
+}
+
+impl MailboxTrace {
+    pub(super) fn from_submission(
+        submission_id: &str,
+        carrier: Option<W3cTraceContext>,
+        policy: Option<Arc<sdk_trace::ScopePolicy>>,
+        trigger_turn: bool,
+    ) -> Option<Self> {
+        let carrier = carrier?;
+        let policy = policy.map(|policy| {
+            if trigger_turn {
+                MailboxTracePolicy::Trigger(policy)
+            } else {
+                // Queue-only mail can veto another owner's trace without retaining its own lease.
+                MailboxTracePolicy::Queued(Arc::downgrade(&policy))
+            }
+        });
+        Some(Self {
+            submission_id: submission_id.to_owned(),
+            carrier,
+            policy,
+        })
+    }
+
+    fn same_owner(&self, other: &Self) -> bool {
+        self.carrier == other.carrier
+            && self
+                .policy
+                .as_ref()
+                .zip(other.policy.as_ref())
+                .is_some_and(|(left, right)| std::ptr::eq(left.as_ptr(), right.as_ptr()))
+    }
+}
