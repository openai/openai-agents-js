+    fn caller_trace(
+        trace_byte: &str,
+        disabled: bool,
+    ) -> (W3cTraceContext, Arc<sdk_trace::ScopePolicy>) {
+        let trace_id = trace_byte.repeat(16);
+        let options = json!({
+            "name": "mail sender",
+            "kind": "workflow",
+            "trace_id": trace_id,
+            "disabled": disabled,
+            "include_sensitive_data": !disabled,
+        });
+        let readback = sdk_trace::start_trace_span(&options.to_string()).expect("start caller");
+        let root: serde_json::Value = serde_json::from_str(&readback).expect("caller readback");
+        let handle = root["handle"].as_str().expect("caller handle");
+        let policy = sdk_trace::policy_for_context(&sdk_trace::context(handle).expect("context"))
+            .expect("policy");
+        sdk_trace::release_trace_span(handle);
+        let trace = W3cTraceContext {
+            traceparent: Some(format!("00-{trace_id}-0000000000000066-01")),
+            tracestate: None,
+        };
+        (trace, policy)
+    }
+
+    async fn submit(
+        session: &Arc<Session>,
+        id: &str,
+        message: &str,
+        trace_byte: &str,
+        disabled: bool,
+        trigger_turn: bool,
+    ) -> Arc<sdk_trace::ScopePolicy> {
+        let (trace, policy) = caller_trace(trace_byte, disabled);
+        let communication = InterAgentCommunication::new(
+            AgentPath::try_from("/root/sender").expect("sender path"),
+            AgentPath::root(),
+            Vec::new(),
+            message.to_owned(),
+            trigger_turn,
+        );
+        let start_options = codex_protocol::turn_input::TurnStartOptions {
+            parent_turn_id: trigger_turn.then(|| "caller-turn".to_string()),
+            ..Default::default()
+        };
+        let submission = Submission {
+            id: id.to_owned(),
+            op: Op::InterAgentCommunication {
+                communication: communication.clone(),
+                start_options: start_options.clone(),
+            },
+            trace: Some(trace.clone()),
+            trace_policy: Some(Arc::clone(&policy)),
+            turn_extension_init: None,
+            parent_turn_id: None,
+            root_turn_id: None,
+            residency_guard: None,
+        };
+        let dispatch = submission_dispatch_span(&submission);
+        let trace = super::input_queue::MailboxTrace::from_submission(
+            id,
+            Some(trace),
+            Some(Arc::clone(&policy)),
+            trigger_turn,
+        );
+        handlers::inter_agent_communication(
+            session,
+            submission.id,
+            communication,
+            start_options,
+            trace,
+        )
+        .instrument(dispatch)
+        .await;
+        policy
+    }
+
+    async fn submit_user(
+        session: &Arc<Session>,
+        id: &str,
+        text: &str,
+        (trace, policy): (W3cTraceContext, Arc<sdk_trace::ScopePolicy>),
+    ) -> CodexResult<()> {
+        let dispatch = info_span!("explicit_user");
+        let parent = codex_otel::context_from_w3c_trace_context(&trace)
+            .expect("explicit user carrier")
+            .with_value(policy);
+        codex_otel::set_parent_from_context(&dispatch, parent);
+        let result = super::turn_input::handle(
+            session,
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: text.to_owned(),
+                text_elements: Vec::new(),
+            }]),
+            TurnInputMode::StartIfIdle,
+            id.to_owned(),
+        )
+        .instrument(dispatch)
+        .await?;
+        assert_eq!(
+            result,
+            TurnInputSubmission::Started {
+                turn_id: id.to_owned(),
+            }
+        );
+        Ok(())
+    }
