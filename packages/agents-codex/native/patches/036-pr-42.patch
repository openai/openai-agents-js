+enum SdkHistoryEdit {
+    Replace { keep: usize, appended: Vec<String> },
+    Pop { allow_rebuild: bool },
+}
+
+impl Session {
+    pub(crate) async fn sdk_history_snapshot(
+        &self,
+        limit: Option<usize>,
+    ) -> codex_protocol::error::Result<(String, usize, Vec<String>)> {
+        if let Some(snapshot) = self.state.lock().await.sdk_originals.snapshot(limit) {
+            return Ok(snapshot);
+        }
+        Ok(self.sdk_load_original_history().await?.snapshot(limit))
+    }
+
+    /// Explicit history operations borrow a temporary catalog from the existing canonical store.
+    pub(crate) async fn sdk_load_original_history(
+        &self,
+    ) -> codex_protocol::error::Result<codex_history::sdk_originals::SdkOriginalHistory> {
+        use codex_protocol::error::CodexErr;
+        let unavailable =
+            || CodexErr::InvalidRequest("Canonical original history is unavailable".into());
+        let (token, total, fallback_policy) = {
+            let state = self.state.lock().await;
+            (
+                (
+                    state.sdk_originals.revision().map(str::to_owned),
+                    state.sdk_originals.read_token().1,
+                ),
+                state.sdk_originals.len(),
+                state.sdk_originals_replay_policy.unwrap_or(
+                    codex_utils_output_truncation::TruncationPolicy::Bytes(usize::MAX),
+                ),
+            )
+        };
+        if total == Some(0) {
+            return Ok(Default::default());
+        }
+        let live = self.live_thread().ok_or_else(unavailable)?;
+        // Reuse the existing canonical failure flag and durability barrier before trusting storage.
+        live.flush().await.map_err(|_| unavailable())?;
+        let persisted = live.load_history(false).await.map_err(|_| unavailable())?;
+        let originals = codex_history::sdk_originals::SdkOriginalHistory::replay(
+            &persisted.items,
+            |row| {
+                let mut projected = crate::context_manager::ContextManager::new();
+                // Captured per-record limits take precedence over the scalar legacy restore policy.
+                let normalized = if matches!(&row.item, ResponseItem::Message { .. }) {
+                    let mut normalized = row.clone();
+                    if let Some(content) =
+                        codex_context_fragments::to_annotated_content(&mut normalized.item)
+                    {
+                        let _ = codex_context_fragments::set_annotated_content(
+                            &mut normalized.item,
+                            content,
+                        );
+                    }
+                    Some(normalized)
+                } else {
+                    None
+                };
+                projected
+                    .replay_annotated_item(normalized.as_ref().unwrap_or(row), fallback_policy);
+                projected.annotated_items().last().cloned()
+            },
+            |items, turns| {
+                let mut history = crate::context_manager::ContextManager::new();
+                history.replace_annotated(items.to_vec());
+                history.drop_last_n_user_turns(turns);
+                history.annotated_items().to_vec()
+            },
+        );
+        let mut state = self.state.lock().await;
+        let current_token = (
+            state.sdk_originals.revision().map(str::to_owned),
+            state.sdk_originals.read_token().1,
+        );
+        if current_token != token
+            || total.is_some_and(|count| originals.items.len() != count)
+            || token
+                .0
+                .as_ref()
+                .is_some_and(|revision| originals.revision() != revision)
+        {
+            return Err(unavailable());
+        }
+        state.sdk_originals =
+            codex_history::sdk_originals::SdkOriginalHistoryCache::from(&originals);
+        Ok(originals)
+    }
+
+    /// Return only previously admitted projections within an original-value prefix.
+    pub(crate) async fn sdk_history_projection(
+        &self,
+        keep: Option<usize>,
+    ) -> codex_protocol::error::Result<Vec<ResponseItem>> {
+        let originals = self.sdk_load_original_history().await?;
+        let keep = keep
+            .unwrap_or(originals.items.len())
+            .min(originals.items.len());
+        Ok(originals.items[..keep]
+            .iter()
+            .filter_map(|item| item.projection.as_ref().map(|row| row.item.clone()))
+            .collect())
+    }
+
+    /// The SDK owns exclusive native ingress and the mutation permit throughout.
+    pub(crate) async fn sdk_replace_history(
+        &self,
+        expected_revision: &str,
+        keep: usize,
+        appended: Vec<String>,
+    ) -> codex_protocol::error::Result<String> {
+        let (revision, _, _) = self
+            .sdk_edit_history(
+                expected_revision,
+                SdkHistoryEdit::Replace { keep, appended },
+            )
+            .await?;
+        Ok(revision)
+    }
+
+    pub(crate) async fn sdk_pop_history(
+        &self,
+        expected_revision: &str,
+        allow_rebuild: bool,
+    ) -> codex_protocol::error::Result<(String, Option<String>, bool)> {
+        self.sdk_edit_history(expected_revision, SdkHistoryEdit::Pop { allow_rebuild })
+            .await
+    }
+
+    async fn sdk_edit_history(
+        &self,
+        expected_revision: &str,
+        edit: SdkHistoryEdit,
+    ) -> codex_protocol::error::Result<(String, Option<String>, bool)> {
+        use crate::context_manager::HistoryReplacement;
+        use codex_history::sdk_originals::{SdkOriginalItem, input_projection};
+        use codex_protocol::error::CodexErr;
+        let invalid = |message: &str| CodexErr::InvalidRequest(message.into());
+        let active = self.active_turn.lock().await;
+        if active.is_some() {
+            return Err(invalid("history transaction requires an idle thread"));
+        }
+        {
+            let state = self.state.lock().await;
+            if state
+                .sdk_originals
+                .revision()
+                .is_some_and(|revision| revision != expected_revision)
+            {
+                return Err(invalid("canonical history revision conflict"));
+            }
+            if let SdkHistoryEdit::Replace { keep, .. } = &edit
+                && state.sdk_originals.len().is_some_and(|total| *keep > total)
+            {
+                return Err(invalid("history keep exceeds snapshot length"));
+            }
+        }
+        let current = self.sdk_load_original_history().await?;
+        let mut state = self.state.lock().await;
+        if state.sdk_originals.revision() != Some(expected_revision) {
+            return Err(invalid("canonical history revision conflict"));
+        }
+        let (originals, envelopes, popped, rebuilt_context) = match edit {
+            SdkHistoryEdit::Replace { keep, appended } => {
+                if keep > current.items.len() {
+                    return Err(invalid("history keep exceeds snapshot length"));
+                }
+                let mut originals = current.prefix(keep);
+                for original in appended {
+                    let projection = input_projection(&original)
+                        .map_err(|_| invalid("Invalid canonical history item"))?
+                        .map(|mut item| {
+                            Self::assign_missing_response_item_id(&mut item);
+                            self.annotate_client_response_item(item)
+                        });
+                    originals.append(SdkOriginalItem {
+                        original,
+                        projection,
+                    });
+                }
+                let mut envelopes = current
+                    .retained_projection(state.history.annotated_items(), keep)
+                    .map_err(invalid)?;
+                envelopes.extend(
+                    originals.items[keep..]
+                        .iter()
+                        .filter_map(|item| item.projection.clone()),
+                );
+                (originals, envelopes, None, false)
+            }
+            SdkHistoryEdit::Pop { allow_rebuild } => {
+                let Some(pop) = current
+                    .prepare_pop(state.history.annotated_items(), allow_rebuild)
+                    .map_err(|error| {
+                        invalid(&format!(
+                            "{error}; raw pop can explicitly rebuild model context"
+                        ))
+                    })?
+                else {
+                    return Ok((current.revision().to_owned(), None, false));
+                };
+                (
+                    pop.originals,
+                    pop.projection,
+                    Some(pop.item),
+                    pop.rebuilt_context,
+                )
+            }
+        };
+        let mut projection_ids = std::collections::HashSet::new();
+        if envelopes
+            .iter()
+            .filter_map(|row| row.item.id())
+            .any(|id| !projection_ids.insert(id.to_string()))
+        {
+            return Err(invalid("canonical history item IDs must be unique"));
+        }
+        let revision = originals.revision().to_owned();
+        let checkpoint = codex_history::CompactedItem {
+            sdk_originals: Some(originals.clone().into()),
+            message: String::new(),
+            replacement_history: Some(envelopes.clone()),
+            guardian_history: None,
+            retained_context: Some(Default::default()),
+            mcp_resource_origins: self.services.mcp_runtime.resource_origin_checkpoint(),
+            window_number: Some(state.auto_compact_window_number()),
+            first_window_id: Some(state.auto_compact_window_ids().first_window_id.to_string()),
+            previous_window_id: state
+                .auto_compact_window_ids()
+                .previous_window_id
+                .map(|id| id.to_string()),
+            window_id: Some(state.auto_compact_window_ids().window_id.to_string()),
+            compaction_response_id: None,
+            latest_token_usage_record: state.latest_token_usage_record.clone(),
+            resume_metadata: Some(codex_history::CompactionResumeMetadata {
+                multi_agent_version: self.multi_agent_version(),
+                last_started_turn_id: state.last_started_turn_id.clone(),
+                previous_turn_settings: state.previous_turn_settings(),
+            }),
+        };
+        // Keep live state unchanged until both representations are durable.
+        if !self
+            .persist_rollout_items(&[codex_history::RolloutItem::Compacted(checkpoint)])
+            .await
+        {
+            return Err(CodexErr::Fatal(
+                "Canonical history commit outcome is uncertain".into(),
+            ));
+        }
+        self.flush_rollout()
+            .await
+            .map_err(|_| CodexErr::Fatal("Canonical history commit outcome is uncertain".into()))?;
+        state.replace_annotated_history(envelopes, None, HistoryReplacement::Reset);
+        state.sdk_originals =
+            codex_history::sdk_originals::SdkOriginalHistoryCache::from(&originals);
+        Ok((revision, popped, rebuilt_context))
+    }
+}
