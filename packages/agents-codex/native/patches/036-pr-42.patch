diff --git a/codex-rs/history/src/sdk_originals.rs b/codex-rs/history/src/sdk_originals.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4e66ef337e2234b3e7d819330767d8c42624dfa1
--- /dev/null
+++ b/codex-rs/history/src/sdk_originals.rs
@@ -0,0 +1,1570 @@
+//! Original SDK values and their separately admitted model projections.
+use codex_protocol::models::ResponseItem;
+use schemars::JsonSchema;
+use serde::{Deserialize, Deserializer, Serialize};
+use serde_json::value::RawValue;
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+
+use crate::ResponseItemEnvelope;
+
+/// A constant-size compaction reference, or the legacy complete replacement payload.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(untagged, deny_unknown_fields)]
+pub enum SdkOriginalHistoryCheckpoint {
+    Replace(SdkOriginalHistory),
+    Preserve {
+        #[serde(deserialize_with = "deserialize_preserve")]
+        preserve: bool,
+    },
+}
+
+fn deserialize_preserve<'de, D: Deserializer<'de>>(deserializer: D) -> Result<bool, D::Error> {
+    if bool::deserialize(deserializer)? {
+        Ok(true)
+    } else {
+        Err(serde::de::Error::custom(
+            "original history preservation must be true",
+        ))
+    }
+}
+
+impl SdkOriginalHistoryCheckpoint {
+    pub fn preserve() -> Self {
+        Self::Preserve { preserve: true }
+    }
+}
+
+impl From<SdkOriginalHistory> for SdkOriginalHistoryCheckpoint {
+    fn from(history: SdkOriginalHistory) -> Self {
+        Self::Replace(history)
+    }
+}
+
+/// The projection is fixed at admission. Restore never promotes an audit-only value.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize, JsonSchema)]
+pub struct SdkOriginalItem {
+    pub original: String,
+    pub projection: Option<ResponseItemEnvelope>,
+}
+
+impl SdkOriginalItem {
+    pub fn from_native(projection: ResponseItemEnvelope) -> Self {
+        Self {
+            original: serde_json::to_string(&projection.item).expect("response items serialize"),
+            projection: Some(projection),
+        }
+    }
+}
+
+/// Decode supported input once, without treating unknown or harness-only records as work.
+pub fn input_projection(value: &str) -> Result<Option<ResponseItem>, String> {
+    let fields: BTreeMap<String, &RawValue> = serde_json::from_str(value)
+        .map_err(|_| "canonical history items must be JSON objects".to_string())?;
+    let Some(kind) = fields
+        .get("type")
+        .and_then(|value| serde_json::from_str::<String>(value.get()).ok())
+    else {
+        return Ok(None);
+    };
+    if matches!(kind.as_str(), "configuration_update" | "compaction_trigger") {
+        return Ok(None);
+    }
+    let item: ResponseItem =
+        serde_json::from_str(value).map_err(|_| "Invalid canonical history item".to_string())?;
+    Ok(match item {
+        ResponseItem::Other
+        | ResponseItem::ConfigurationUpdate { .. }
+        | ResponseItem::CompactionTrigger { .. } => None,
+        ResponseItem::Message { ref role, .. } if role == "system" => None,
+        item => Some(item),
+    })
+}
+
+/// The serialized catalog has one owner and no public execution authority.
+#[derive(Clone, Debug, Serialize, JsonSchema)]
+pub struct SdkOriginalHistory {
+    format_version: u32,
+    pub items: Vec<SdkOriginalItem>,
+    #[serde(skip)]
+    index: OriginalIndex,
+    // Cold journal proof only. Checkpoint payloads never supply this authority.
+    #[serde(skip)]
+    post_checkpoint_start: Option<usize>,
+}
+
+/// Bounded hot originals plus constant-size revision metadata; the journal owns the full catalog.
+#[derive(Clone, Debug)]
+pub struct SdkOriginalHistoryCache {
+    index: Option<OriginalIndex>,
+    total: usize,
+    tail: std::collections::VecDeque<String>,
+    payload_bytes: usize,
+}
+
+impl SdkOriginalHistoryCache {
+    // Cache policy only: older/oversized originals remain in the canonical journal.
+    const MAX_RETAINED_BYTES: usize = 64 * 1024;
+
+    pub fn revision(&self) -> Option<&str> {
+        self.index.as_ref().map(|index| index.revision.as_str())
+    }
+    pub fn len(&self) -> Option<usize> {
+        self.index.as_ref().map(|_| self.total)
+    }
+    pub fn is_empty(&self) -> bool {
+        self.len() == Some(0)
+    }
+    /// Change detection during an explicit cold read, including an unloaded prefix.
+    pub fn read_token(&self) -> (Option<&str>, usize) {
+        (self.revision(), self.total)
+    }
+    pub fn retained_bytes(&self) -> usize {
+        self.payload_bytes + self.tail.capacity() * std::mem::size_of::<String>()
+    }
+
+    pub fn append(&mut self, original: String) {
+        if let Some(index) = &mut self.index {
+            index.append(self.total, &original);
+        }
+        self.total += 1;
+        self.cache(original);
+    }
+
+    fn cache(&mut self, original: String) {
+        self.payload_bytes += original.capacity();
+        self.tail.push_back(original);
+        while self.retained_bytes() > Self::MAX_RETAINED_BYTES {
+            if self.tail.len() == 1 {
+                self.tail.shrink_to_fit();
+                if self.retained_bytes() <= Self::MAX_RETAINED_BYTES {
+                    break;
+                }
+            }
+            let removed = self
+                .tail
+                .pop_front()
+                .expect("over-budget cache has a value");
+            self.payload_bytes -= removed.capacity();
+            if self.tail.is_empty() {
+                self.tail = Default::default();
+            }
+        }
+    }
+
+    pub fn snapshot(&self, limit: Option<usize>) -> Option<(String, usize, Vec<String>)> {
+        let revision = self.revision()?;
+        let count = limit.unwrap_or(self.total).min(self.total);
+        if count > self.tail.len() {
+            return None;
+        }
+        Some((
+            revision.to_owned(),
+            self.total,
+            self.tail
+                .iter()
+                .skip(self.tail.len() - count)
+                .cloned()
+                .collect(),
+        ))
+    }
+}
+
+impl Default for SdkOriginalHistoryCache {
+    fn default() -> Self {
+        Self {
+            index: Some(OriginalIndex::default()),
+            total: 0,
+            tail: Default::default(),
+            payload_bytes: 0,
+        }
+    }
+}
+
+impl SdkOriginalHistoryCache {
+    fn unloaded() -> Self {
+        Self {
+            index: None,
+            ..Default::default()
+        }
+    }
+
+    /// Resume keeps only hot bytes. A preserved prefix is read only on explicit demand.
+    pub fn replay_metadata(
+        records: &[crate::RolloutItem],
+        eligible: impl Fn(&ResponseItemEnvelope) -> bool,
+    ) -> Self {
+        let mut cache = Self::default();
+        for record in records {
+            match record {
+                crate::RolloutItem::ResponseItem(row) if eligible(row) => {
+                    cache.append(
+                        serde_json::to_string(&row.item).expect("response items serialize"),
+                    );
+                }
+                crate::RolloutItem::Compacted(checkpoint) => match &checkpoint.sdk_originals {
+                    Some(SdkOriginalHistoryCheckpoint::Replace(history)) => {
+                        cache = Self::from(history)
+                    }
+                    Some(SdkOriginalHistoryCheckpoint::Preserve { .. }) => cache = Self::unloaded(),
+                    None => {
+                        if let Some(items) = &checkpoint.replacement_history {
+                            cache = Self::default();
+                            for row in items.iter().filter(|row| eligible(row)) {
+                                cache.append(
+                                    serde_json::to_string(&row.item)
+                                        .expect("response items serialize"),
+                                );
+                            }
+                        }
+                    }
+                },
+                crate::RolloutItem::EventMsg(
+                    codex_protocol::protocol::EventMsg::ThreadRolledBack(_),
+                ) => cache = Self::unloaded(),
+                _ => {}
+            }
+        }
+        cache
+    }
+}
+
+impl From<&SdkOriginalHistory> for SdkOriginalHistoryCache {
+    fn from(history: &SdkOriginalHistory) -> Self {
+        let mut cache = Self {
+            index: Some(history.index.clone()),
+            total: history.items.len(),
+            ..Default::default()
+        };
+        // Build only the contiguous suffix that fits; never clone an oversized original.
+        for item in history.items.iter().rev() {
+            let cost = item.original.len() + std::mem::size_of::<String>();
+            if cache.retained_bytes().saturating_add(cost) > Self::MAX_RETAINED_BYTES {
+                break;
+            }
+            let original = item.original.clone();
+            cache.payload_bytes += original.capacity();
+            cache.tail.push_front(original);
+            if cache.retained_bytes() > Self::MAX_RETAINED_BYTES {
+                let removed = cache.tail.pop_front().expect("new cache value");
+                cache.payload_bytes -= removed.capacity();
+                cache.tail.shrink_to_fit();
+                break;
+            }
+        }
+        cache
+    }
+}
+
+#[derive(Clone, Debug)]
+struct OriginalIndex {
+    hash: Sha256,
+    revision: String,
+}
+
+impl OriginalIndex {
+    fn append(&mut self, total: usize, original: &str) {
+        if total != 0 {
+            self.hash.update(b",");
+        }
+        self.hash.update(original.as_bytes());
+        let mut completed = self.hash.clone();
+        completed.update(b"]");
+        self.revision = format!("{:x}", completed.finalize());
+    }
+}
+
+impl Default for OriginalIndex {
+    fn default() -> Self {
+        let mut hash = Sha256::new();
+        hash.update(b"[");
+        let mut completed = hash.clone();
+        completed.update(b"]");
+        Self {
+            hash,
+            revision: format!("{:x}", completed.finalize()),
+        }
+    }
+}
+
+impl Default for SdkOriginalHistory {
+    fn default() -> Self {
+        Self {
+            format_version: 1,
+            items: Vec::new(),
+            index: OriginalIndex::default(),
+            post_checkpoint_start: None,
+        }
+    }
+}
+
+impl PartialEq for SdkOriginalHistory {
+    fn eq(&self, other: &Self) -> bool {
+        self.format_version == other.format_version && self.items == other.items
+    }
+}
+
+impl<'de> Deserialize<'de> for SdkOriginalHistory {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        struct Stored {
+            format_version: u32,
+            items: Vec<SdkOriginalItem>,
+        }
+        let stored = Stored::deserialize(deserializer)?;
+        if stored.format_version != 1 {
+            return Err(serde::de::Error::custom(
+                "unsupported original history format",
+            ));
+        }
+        let mut history = Self::default();
+        for item in stored.items {
+            if serde_json::from_str::<BTreeMap<String, &RawValue>>(&item.original).is_err() {
+                return Err(serde::de::Error::custom("invalid original history value"));
+            }
+            history.append(item);
+        }
+        Ok(history)
+    }
+}
+
+/// Match the same client-owned pairs used by SDK context validation.
+#[doc(hidden)]
+pub fn client_tool_pair_part(item: &ResponseItem) -> Option<(&'static str, Option<&str>, bool)> {
+    let part = match item {
+        ResponseItem::FunctionCall { call_id, .. } => ("function", Some(call_id.as_str()), true),
+        ResponseItem::ApplyPatchCall { call_id, .. } => {
+            ("apply_patch", Some(call_id.as_str()), true)
+        }
+        ResponseItem::ApplyPatchCallOutput { call_id, .. } => {
+            ("apply_patch", Some(call_id.as_str()), false)
+        }
+        ResponseItem::ShellCall {
+            provider_fields, ..
+        }
+        | ResponseItem::ShellCallOutput {
+            provider_fields, ..
+        } => (
+            "shell",
+            provider_fields
+                .get("call_id")
+                .and_then(serde_json::Value::as_str),
+            matches!(item, ResponseItem::ShellCall { .. }),
+        ),
+        ResponseItem::LocalShellCall { call_id, .. } => ("function", call_id.as_deref(), true),
+        ResponseItem::FunctionCallOutput { call_id, .. } => ("function", call_id.as_deref(), false),
+        ResponseItem::ComputerCall { call_id, .. } => ("computer", Some(call_id.as_str()), true),
+        ResponseItem::ComputerCallOutput { call_id, .. } => {
+            ("computer", Some(call_id.as_str()), false)
+        }
+        ResponseItem::CustomToolCall { call_id, .. } => ("custom", Some(call_id.as_str()), true),
+        ResponseItem::CustomToolCallOutput { call_id, .. } => {
+            ("custom", Some(call_id.as_str()), false)
+        }
+        ResponseItem::McpApprovalRequest { id, .. } => {
+            ("mcp-approval", id.as_ref().map(|id| id.as_str()), true)
+        }
+        ResponseItem::McpApprovalResponse {
+            approval_request_id,
+            ..
+        } => ("mcp-approval", Some(approval_request_id.as_str()), false),
+        ResponseItem::ToolSearchCall {
+            call_id, execution, ..
+        } if execution != "server" => ("search", call_id.as_deref(), true),
+        ResponseItem::ToolSearchOutput {
+            call_id, execution, ..
+        } if execution != "server" => ("search", call_id.as_deref(), false),
+        _ => return None,
+    };
+    Some(part)
+}
+
+fn tail_tool_partner(items: &[SdkOriginalItem]) -> Option<usize> {
+    let (tail, retained) = items.split_last()?;
+    let (family, Some(id), false) = client_tool_pair_part(&tail.projection.as_ref()?.item)? else {
+        return None;
+    };
+    // Calls with the same key can occur again after their previous output.
+    // The nearest occurrence must be the call for this exact tail output.
+    for (index, row) in retained.iter().enumerate().rev() {
+        let Some((other_family, Some(other_id), is_call)) = row
+            .projection
+            .as_ref()
+            .and_then(|row| client_tool_pair_part(&row.item))
+        else {
+            continue;
+        };
+        if other_family == family && other_id == id {
+            return is_call.then_some(index);
+        }
+    }
+    None
+}
+
+pub struct SdkOriginalHistoryPop {
+    pub item: String,
+    pub originals: SdkOriginalHistory,
+    pub projection: Vec<ResponseItemEnvelope>,
+    pub rebuilt_context: bool,
+}
+
+// Legacy checkpoint decoding represents absent metadata as an empty metadata object.
+// All populated provenance, including retained-source revisions, must still match.
+fn same_admission_envelope(left: &ResponseItemEnvelope, right: &ResponseItemEnvelope) -> bool {
+    left.item == right.item
+        && left.metadata.clone().unwrap_or_default() == right.metadata.clone().unwrap_or_default()
+}
+
+fn resolved_projection(items: Vec<ResponseItemEnvelope>) -> Vec<ResponseItemEnvelope> {
+    let mut keep = vec![false; items.len()];
+    let mut pending = BTreeMap::new();
+    for (index, row) in items.iter().enumerate() {
+        match client_tool_pair_part(&row.item) {
+            None => keep[index] = true,
+            Some((family, Some(id), true)) => {
+                // A repeated call before its output leaves the pairing ambiguous.
+                pending
+                    .entry((family, id))
+                    .and_modify(|slot| *slot = None)
+                    .or_insert(Some(index));
+            }
+            Some((family, Some(id), false)) => {
+                if let Some(Some(call)) = pending.remove(&(family, id)) {
+                    keep[call] = true;
+                    keep[index] = true;
+                }
+            }
+            Some((_, None, _)) => {}
+        }
+    }
+    drop(pending);
+    items
+        .into_iter()
+        .zip(keep)
+        .filter_map(|(row, keep)| keep.then_some(row))
+        .collect()
+}
+
+impl SdkOriginalHistory {
+    pub fn revision(&self) -> &str {
+        &self.index.revision
+    }
+
+    pub fn append(&mut self, item: SdkOriginalItem) {
+        self.index.append(self.items.len(), &item.original);
+        self.items.push(item);
+    }
+
+    /// A hot suffix read clones only the requested values and uses the cached revision.
+    pub fn snapshot(&self, limit: Option<usize>) -> (String, usize, Vec<String>) {
+        let total = self.items.len();
+        let start = total.saturating_sub(limit.unwrap_or(total));
+        (
+            self.revision().to_owned(),
+            total,
+            self.items[start..]
+                .iter()
+                .map(|item| item.original.clone())
+                .collect(),
+        )
+    }
+
+    pub fn prefix(&self, keep: usize) -> Self {
+        let mut retained = Self::default();
+        for item in &self.items[..keep] {
+            retained.append(item.clone());
+        }
+        retained
+    }
+
+    pub fn projection(&self) -> Vec<ResponseItemEnvelope> {
+        self.items
+            .iter()
+            .filter_map(|item| item.projection.clone())
+            .collect()
+    }
+
+    /// Select an exact raw tail and keep an executable model projection.
+    /// The incomplete partner, if any, remains visible in originals for repair.
+    pub fn prepare_pop(
+        &self,
+        current: &[ResponseItemEnvelope],
+        allow_rebuild: bool,
+    ) -> Result<Option<SdkOriginalHistoryPop>, &'static str> {
+        let Some(last) = self.items.last() else {
+            return Ok(None);
+        };
+        let keep = self.items.len() - 1;
+        let partner = tail_tool_partner(&self.items);
+        let mut originals = self.prefix(keep);
+        if let Some(partner) = partner {
+            // Keep the original string. Future admission must use a complete pair.
+            originals.items[partner].projection = None;
+        }
+        let (projection, rebuilt_context) = if last.projection.is_none() {
+            (current.to_vec(), false)
+        } else {
+            match self.retained_projection_excluding(current, keep, partner) {
+                Ok(projection) => (projection, false),
+                Err(error) => {
+                    if let Some(projection) =
+                        self.projection_after_proven_native_pop(current, partner)
+                    {
+                        (projection, false)
+                    } else if allow_rebuild {
+                        (resolved_projection(originals.projection()), true)
+                    } else {
+                        return Err(error);
+                    }
+                }
+            }
+        };
+        Ok(Some(SdkOriginalHistoryPop {
+            item: last.original.clone(),
+            originals,
+            projection,
+            rebuilt_context,
+        }))
+    }
+
+    /// Subtract native admissions after the latest journal checkpoint without touching its summary.
+    /// Repeated equal envelopes and admissions inside Replace payloads stay conservative.
+    fn projection_after_proven_native_pop(
+        &self,
+        current: &[ResponseItemEnvelope],
+        partner: Option<usize>,
+    ) -> Option<Vec<ResponseItemEnvelope>> {
+        let start = self.post_checkpoint_start?;
+        let tail = self.items.len().checked_sub(1)?;
+        let mut removed = Vec::new();
+        for index in std::iter::once(tail).chain(partner) {
+            if index < start {
+                return None;
+            }
+            let stored = self.items[index].projection.as_ref()?;
+            if self
+                .items
+                .iter()
+                .filter(|item| {
+                    item.projection
+                        .as_ref()
+                        .is_some_and(|row| same_admission_envelope(row, stored))
+                })
+                .count()
+                != 1
+                || current
+                    .iter()
+                    .filter(|row| same_admission_envelope(row, stored))
+                    .count()
+                    != 1
+            {
+                return None;
+            }
+            let position = current
+                .iter()
+                .position(|row| same_admission_envelope(row, stored))?;
+            removed.push(position);
+        }
+        Some(
+            current
+                .iter()
+                .enumerate()
+                .filter(|(index, _)| !removed.contains(index))
+                .map(|(_, row)| row.clone())
+                .collect(),
+        )
+    }
+
+    /// Carry journal proof through a one-item raw pop that only subtracts exact native admissions.
+    fn boundary_after_pop_checkpoint(
+        &self,
+        next: &Self,
+        previous_window: &[ResponseItemEnvelope],
+        replacement: &[ResponseItemEnvelope],
+    ) -> Option<usize> {
+        let start = self.post_checkpoint_start?;
+        if next.items.len().checked_add(1)? != self.items.len() {
+            return None;
+        }
+        let mut removed = Vec::new();
+        for (index, item) in self.items.iter().enumerate() {
+            if let Some(next) = next.items.get(index) {
+                if next.original != item.original {
+                    return None;
+                }
+                if match (&next.projection, &item.projection) {
+                    (None, None) => true,
+                    (Some(next), Some(previous)) => same_admission_envelope(next, previous),
+                    _ => false,
+                } {
+                    continue;
+                }
+                if next.projection.is_some() {
+                    return None;
+                }
+            }
+            let Some(stored) = item.projection.as_ref() else {
+                continue;
+            };
+            if index < start
+                || self
+                    .items
+                    .iter()
+                    .filter(|item| {
+                        item.projection
+                            .as_ref()
+                            .is_some_and(|row| same_admission_envelope(row, stored))
+                    })
+                    .count()
+                    != 1
+                || previous_window
+                    .iter()
+                    .filter(|row| same_admission_envelope(row, stored))
+                    .count()
+                    != 1
+            {
+                return None;
+            }
+            removed.push(
+                previous_window
+                    .iter()
+                    .position(|row| same_admission_envelope(row, stored))?,
+            );
+        }
+        let expected: Vec<_> = previous_window
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| !removed.contains(index))
+            .map(|(_, row)| row.clone())
+            .collect();
+        (expected.len() == replacement.len()
+            && expected
+                .iter()
+                .zip(replacement)
+                .all(|(left, right)| same_admission_envelope(left, right)))
+        .then_some(start)
+    }
+
+    /// Preserve current model admission when retaining originals, without replaying old values.
+    pub fn retained_projection(
+        &self,
+        current: &[ResponseItemEnvelope],
+        keep: usize,
+    ) -> Result<Vec<ResponseItemEnvelope>, &'static str> {
+        self.retained_projection_excluding(current, keep, None)
+    }
+
+    fn retained_projection_excluding(
+        &self,
+        current: &[ResponseItemEnvelope],
+        keep: usize,
+        exclude: Option<usize>,
+    ) -> Result<Vec<ResponseItemEnvelope>, &'static str> {
+        if keep > self.items.len() {
+            return Err("history keep exceeds snapshot length");
+        }
+        if keep == 0 {
+            return Ok(Vec::new());
+        }
+        if keep == self.items.len() {
+            return Ok(current.to_vec());
+        }
+        // The current model window is an ordered subsequence of admitted
+        // originals until compaction introduces a summary. Never reconstruct
+        // that summary from originals or retain its deleted content implicitly.
+        // Legacy restore can mint retained-source versions absent from the journal.
+        // Compare persisted content/metadata, then retain the existing live envelope.
+        let matches = |stored: &SdkOriginalItem, current: &ResponseItemEnvelope| {
+            let Some(stored) = &stored.projection else {
+                return false;
+            };
+            if stored.item != current.item {
+                return false;
+            }
+            let mut stored_metadata = stored.metadata.clone().unwrap_or_default();
+            let mut current_metadata = current.metadata.clone().unwrap_or_default();
+            stored_metadata.retained_source = None;
+            current_metadata.retained_source = None;
+            stored_metadata == current_metadata
+        };
+        let unavailable = "cannot shorten original history across model compaction; use keep=0 to replace it explicitly";
+        let mut earliest = Vec::with_capacity(current.len());
+        let mut originals = self.items.iter().enumerate();
+        for row in current {
+            let Some((index, _)) = originals.find(|(_, item)| matches(item, row)) else {
+                return Err(unavailable);
+            };
+            earliest.push(index);
+        }
+        // The reverse match detects repeated equal items whose position relative to
+        // keep is ambiguous after model truncation. Neither pass reconstructs content.
+        let mut originals = self.items.iter().enumerate().rev();
+        let mut latest = Vec::with_capacity(current.len());
+        for row in current.iter().rev() {
+            let Some((index, _)) = originals.find(|(_, item)| matches(item, row)) else {
+                return Err(unavailable);
+            };
+            latest.push(index);
+        }
+        latest.reverse();
+        let mut retained = Vec::new();
+        for ((row, first), last) in current.iter().zip(earliest).zip(latest) {
+            let ambiguous_exclusion = exclude.is_some_and(|index| {
+                first != last && (first..=last).contains(&index) && matches(&self.items[index], row)
+            });
+            if (first < keep && last >= keep) || ambiguous_exclusion {
+                return Err(
+                    "cannot shorten original history across ambiguous repeated items; use keep=0 to replace it explicitly",
+                );
+            }
+            if first < keep && exclude != Some(first) {
+                retained.push(row.clone());
+            }
+        }
+        Ok(retained)
+    }
+
+    /// Legacy compaction defines the migration boundary. New compactions preserve journal originals.
+    pub fn replay(
+        records: &[crate::RolloutItem],
+        project: impl Fn(&ResponseItemEnvelope) -> Option<ResponseItemEnvelope>,
+        rewind: impl Fn(&[ResponseItemEnvelope], u32) -> Vec<ResponseItemEnvelope>,
+    ) -> Self {
+        let mut history = Self::default();
+        let mut previous_window: Option<Vec<ResponseItemEnvelope>> = None;
+        for record in records {
+            match record {
+                crate::RolloutItem::ResponseItem(envelope) => {
+                    if let Some(projection) = project(envelope) {
+                        if let Some(window) = &mut previous_window {
+                            window.push(projection.clone());
+                        }
+                        history.append(SdkOriginalItem {
+                            original: serde_json::to_string(&envelope.item)
+                                .expect("response items serialize"),
+                            projection: Some(projection),
+                        });
+                    }
+                    if envelope
+                        .metadata
+                        .as_ref()
+                        .is_some_and(|metadata| metadata.provider_compaction)
+                    {
+                        history.post_checkpoint_start = Some(history.items.len());
+                    }
+                }
+                crate::RolloutItem::Compacted(checkpoint) => {
+                    let preserved_start = match (
+                        &checkpoint.sdk_originals,
+                        previous_window.as_deref(),
+                        checkpoint.replacement_history.as_deref(),
+                    ) {
+                        (
+                            Some(SdkOriginalHistoryCheckpoint::Replace(next)),
+                            Some(previous),
+                            Some(replacement),
+                        ) => history.boundary_after_pop_checkpoint(next, previous, replacement),
+                        _ => None,
+                    };
+                    if let Some(originals) = &checkpoint.sdk_originals {
+                        match originals {
+                            SdkOriginalHistoryCheckpoint::Replace(originals) => {
+                                history = originals.clone();
+                            }
+                            SdkOriginalHistoryCheckpoint::Preserve { .. } => {}
+                        }
+                    } else if let Some(items) = &checkpoint.replacement_history {
+                        // Never resurrect values removed by an older canonical transaction.
+                        history = Self::default();
+                        for envelope in items {
+                            if let Some(projection) = project(envelope) {
+                                history.append(SdkOriginalItem {
+                                    original: serde_json::to_string(&envelope.item)
+                                        .expect("response items serialize"),
+                                    projection: Some(projection),
+                                });
+                            }
+                        }
+                    }
+                    history.post_checkpoint_start = preserved_start.or(Some(history.items.len()));
+                    previous_window = checkpoint.replacement_history.clone();
+                }
+                crate::RolloutItem::EventMsg(
+                    codex_protocol::protocol::EventMsg::ThreadRolledBack(event),
+                ) => {
+                    let projection = history.projection();
+                    let retained = rewind(&projection, event.num_turns);
+                    history = history.after_rollback(retained);
+                    history.post_checkpoint_start = None;
+                    previous_window = None;
+                }
+                _ => {}
+            }
+        }
+        history
+    }
+
+    fn after_rollback(&self, retained: Vec<ResponseItemEnvelope>) -> Self {
+        let retained_users: Vec<_> = retained
+            .iter()
+            .filter(|row| matches!(&row.item, ResponseItem::Message { role, .. } if role == "user"))
+            .map(|row| row.item.clone())
+            .collect();
+        let mut by_id: std::collections::HashMap<_, _> = retained
+            .iter()
+            .filter_map(|row| row.item.id().map(|id| (id.to_string(), row.clone())))
+            .collect();
+        let mut without_id: Vec<_> = retained
+            .into_iter()
+            .filter(|row| row.item.id().is_none())
+            .collect();
+        let mut retained_users = retained_users.iter();
+        let mut next_user = retained_users.next();
+        let mut matched = |row: &ResponseItemEnvelope| {
+            let found = next_user.is_some_and(|kept| {
+                row.item.id().map_or_else(
+                    || kept == &row.item,
+                    |id| kept.id().is_some_and(|kept_id| kept_id == id),
+                )
+            });
+            if found {
+                next_user = retained_users.next();
+            }
+            found
+        };
+        // Audit-only values belong to the user-turn prefix containing their admitted position.
+        let boundary = self
+            .items
+            .iter()
+            .position(|entry| {
+                entry.projection.as_ref().is_some_and(|row| {
+                    matches!(&row.item, ResponseItem::Message { role, .. } if role == "user")
+                        && !matched(row)
+                })
+            })
+            .unwrap_or(self.items.len());
+        let mut history = Self::default();
+        for entry in &self.items[..boundary] {
+            let mut entry = entry.clone();
+            if let Some(projection) = &entry.projection {
+                let retained = if let Some(id) = projection.item.id() {
+                    by_id.remove(id.as_str())
+                } else {
+                    without_id
+                        .iter()
+                        .position(|row| row.item == projection.item)
+                        .map(|index| without_id.remove(index))
+                };
+                let Some(retained) = retained else {
+                    continue;
+                };
+                entry.projection = Some(retained);
+            }
+            history.append(entry);
+        }
+        history
+    }
+}
