+            .unwrap();
+        let mut cache = SdkOriginalHistoryCache::replay_metadata(&[checkpoint], |_| true);
+        assert_eq!(cache.revision(), None);
+        assert_eq!(cache.len(), None);
+        assert_eq!(cache.snapshot(Some(0)), None);
+        let before = cache.read_token().1;
+        for n in 0..10_000 {
+            cache.append(json!({"type":"audit","n":n,"text":"x".repeat(128)}).to_string());
+            assert!(cache.retained_bytes() <= SdkOriginalHistoryCache::MAX_RETAINED_BYTES);
+        }
+        assert!(cache.read_token().1 > before);
+        assert_eq!(cache.snapshot(Some(1)), None);
+    }
