+    #[test]
+    fn idle_catalog_cache_stays_byte_bounded_across_ten_thousand_originals() {
+        let mut cache = SdkOriginalHistoryCache::default();
+        let mut journal = SdkOriginalHistory::default();
+        for n in 0..10_000 {
+            let original = json!({"type":"audit", "n":n, "text":"x".repeat(128)}).to_string();
+            cache.append(original.clone());
+            journal.append(SdkOriginalItem {
+                original,
+                projection: None,
+            });
+            assert!(cache.retained_bytes() <= SdkOriginalHistoryCache::MAX_RETAINED_BYTES);
+        }
+        assert_eq!(cache.snapshot(Some(0)), Some(journal.snapshot(Some(0))));
+        assert_eq!(cache.snapshot(Some(2)), Some(journal.snapshot(Some(2))));
+        assert!(cache.snapshot(None).is_none());
+        let restored = SdkOriginalHistoryCache::from(&journal);
+        assert!(restored.retained_bytes() <= SdkOriginalHistoryCache::MAX_RETAINED_BYTES);
+        assert_eq!(restored.snapshot(Some(2)), Some(journal.snapshot(Some(2))));
+    }
+
+    #[test]
+    fn preserved_model_checkpoint_keeps_metadata_unloaded_and_append_byte_bounded() {
+        let checkpoint: crate::RolloutItem =
