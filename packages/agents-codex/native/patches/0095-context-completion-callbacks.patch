+#[cfg(test)]
+mod context_projection_tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn context_projection_preserves_roles_and_matched_history_without_executing_it() {
+        let values = vec![
+            json!({"type":"message","role":"developer","content":[{"type":"input_text","text":"policy"}]}),
+            json!({"type":"function_call","name":"lookup","call_id":"old","arguments":"{}"}),
+            json!({"type":"function_call_output","call_id":"old","output":"historical"}),
+        ];
+        let parsed = parse_model_context_items(values.clone()).unwrap();
+        let encoded = serde_json::to_value(parsed).unwrap();
+        assert!(preserves(&json!(values), &encoded));
+    }
+
+    #[test]
+    fn context_projection_rejects_lossy_reference_and_unknown_fields_atomically() {
+        assert!(
+            parse_model_context_items(vec![json!({"type":"item_reference","id":"not-retained"})])
+                .is_err()
+        );
+        assert!(parse_model_context_items(vec![
+            json!({"type":"message","role":"user","content":[{"type":"input_text","text":"valid"}]}),
+            json!({"type":"message","role":"user","content":[{"type":"input_text","text":"valid"}],"unknown_authority":true}),
+        ]).is_err());
+    }
+}
