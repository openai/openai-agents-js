+#[tokio::test]
+async fn remote_launch_before_registration_is_joined_by_its_turn() {
+    let manager = Arc::new(UnifiedExecProcessManager::default());
+    let turn = Arc::new(codex_extension_api::ExtensionData::new("owner"));
+    let other_turn = Arc::new(codex_extension_api::ExtensionData::new("other"));
+    let (id, generation) = manager
+        .allocate_process_id(&turn)
+        .await
+        .expect("reserve id");
+    let (reply, response) = tokio::sync::oneshot::channel();
+    let starting = StartingRemoteProcess {
+        turn: Arc::clone(&turn),
+        generation,
+        start: async move { response.await.expect("test exec RPC should settle") }
+            .boxed()
+            .shared(),
+        stop: Arc::new(std::sync::OnceLock::new()),
+    };
+    manager
+        .process_store
+        .lock()
+        .await
+        .starting_remote_processes
+        .insert(id, starting.clone());
+
+    assert!(manager.join_unreturned_local_commands(&other_turn).await);
+    assert!(starting.stop.get().is_none());
+
+    let interrupt = manager.join_unreturned_local_commands(&turn);
+    tokio::pin!(interrupt);
+    assert!(futures::poll!(&mut interrupt).is_pending());
+    assert!(
+        manager
+            .process_store
+            .lock()
+            .await
+            .starting_remote_processes
+            .contains_key(&id)
+    );
+
+    let error = Arc::new(RemoteStartError {
+        process_id: codex_exec_server::ProcessId::from("executor-id"),
+        error: RemoteStartFailure::Executor(codex_exec_server::ExecServerError::Server {
+            code: -32602,
+            message: "invalid command".into(),
+        }),
+    });
+    assert!(reply.send(Err(error)).is_ok());
+    assert!(interrupt.await);
+    assert!(
+        !manager
+            .process_store
+            .lock()
+            .await
+            .starting_remote_processes
+            .contains_key(&id)
+    );
+}
