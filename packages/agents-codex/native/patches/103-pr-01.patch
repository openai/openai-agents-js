+    let (id, generation) = manager
+        .allocate_process_id(&turn)
+        .await
+        .expect("reserve id");
+    let start = async {
+        Err(Arc::new(RemoteStartError {
+            process_id: codex_exec_server::ProcessId::from("executor-id"),
+            error: RemoteStartFailure::Executor(codex_exec_server::ExecServerError::Closed),
+        }))
+    }
+    .boxed()
+    .shared();
+    manager
+        .process_store
+        .lock()
+        .await
+        .starting_remote_processes
+        .insert(
+            id,
+            StartingRemoteProcess {
+                turn: Arc::clone(&turn),
+                generation: generation.clone(),
+                start,
+                stop: Arc::new(std::sync::OnceLock::new()),
+            },
+        );
+
+    assert!(!manager.join_unreturned_local_commands(&turn).await);
+    let store = manager.process_store.lock().await;
+    assert!(store.owns_reservation(id, &generation));
+    let receipt = store
