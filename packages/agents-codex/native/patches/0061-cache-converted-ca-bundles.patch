+#[tokio::test]
+async fn converted_ca_cache_keeps_concurrent_bundles_separate() {
+    let (pem_a, server_a) = independent_ca("concurrent issuer A");
+    let (pem_b, server_b) = independent_ca("concurrent issuer B");
+    let temp = tempfile::TempDir::new().unwrap();
+    let path_a = temp.path().join("a.pem");
+    let path_b = temp.path().join("b.pem");
+    std::fs::write(&path_a, pem_a).unwrap();
+    std::fs::write(&path_b, pem_b).unwrap();
+    let env_a = BundleEnv {
+        preferred: Some(path_a),
+        fallback: None,
+    };
+    let env_b = BundleEnv {
+        preferred: None,
+        fallback: Some(path_b),
+    };
+    let barrier = std::sync::Barrier::new(2);
+    let runtime = tokio::runtime::Handle::current();
+    let (client_a, client_b) = std::thread::scope(|scope| {
+        let build = |env: &BundleEnv| {
+            let _entered = runtime.enter();
+            barrier.wait();
+            fresh_client(env, "concurrent").unwrap()
+        };
+        let a = scope.spawn(move || build(&env_a));
+        let b = scope.spawn(move || build(&env_b));
+        (a.join().unwrap(), b.join().unwrap())
+    });
+    assert!(
+        request_with_fresh_connection(&client_a, server_a.clone(), "localhost")
+            .await
+            .is_ok()
+    );
+    assert_certificate_failure(
+        request_with_fresh_connection(&client_a, server_b.clone(), "localhost")
+            .await
+            .expect_err("certificate validation should reject this server"),
+        rustls::CertificateError::UnknownIssuer,
+    );
+    assert!(
+        request_with_fresh_connection(&client_b, server_b, "localhost")
+            .await
+            .is_ok()
+    );
+    assert_certificate_failure(
+        request_with_fresh_connection(&client_b, server_a, "localhost")
+            .await
+            .expect_err("certificate validation should reject this server"),
+        rustls::CertificateError::UnknownIssuer,
+    );
+}
