+#[tokio::test]
+async fn converted_ca_cache_observes_same_path_rotation_and_preserves_builders() {
+    let (pem_a, server_a) = independent_ca("rotation issuer A");
+    let (pem_b, server_b) = independent_ca("rotation issuer B");
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("rotating.pem");
+    // Keep file length and mtime unchanged throughout rotation.
+    let pad = |pem: &str| format!("{pem}{}", " ".repeat(4096 - pem.len()));
+    std::fs::write(&path, pad(&pem_a)).unwrap();
+    let modified = std::fs::metadata(&path).unwrap().modified().unwrap();
+    let replace = |pem: &str| {
+        std::fs::write(&path, pad(pem)).unwrap();
+        std::fs::File::options()
+            .write(true)
+            .open(&path)
+            .unwrap()
+            .set_times(std::fs::FileTimes::new().set_modified(modified))
+            .unwrap();
+    };
+    let env = BundleEnv {
+        preferred: Some(path.clone()),
+        fallback: None,
+    };
+    let first = fresh_client(&env, "first").unwrap();
+    assert!(
+        request_with_fresh_connection(&first, server_a.clone(), "localhost")
+            .await
+            .unwrap()
+            .contains("x-cache-test: first")
+    );
+    let second = fresh_client(&env, "second").unwrap();
+    assert!(
+        request_with_fresh_connection(&second, server_a.clone(), "localhost")
+            .await
+            .unwrap()
+            .contains("x-cache-test: second")
+    );
+
+    replace("invalid PEM");
+    let error = fresh_client(&env, "invalid").unwrap_err();
+    assert!(
+        matches!(error, super::BuildCustomCaTransportError::InvalidCaFile { source_env: CODEX_CA_CERT_ENV, path: ref current, .. } if current == &path)
+    );
+
+    replace(&pem_b);
+    let rotated = fresh_client(&env, "rotated").unwrap();
+    assert!(
+        request_with_fresh_connection(&rotated, server_b.clone(), "localhost")
+            .await
+            .is_ok()
+    );
+    assert_certificate_failure(
+        request_with_fresh_connection(&rotated, server_a.clone(), "localhost")
+            .await
+            .expect_err("certificate validation should reject this server"),
+        rustls::CertificateError::UnknownIssuer,
+    );
+    assert_certificate_failure(
+        request_with_fresh_connection(&rotated, server_b.clone(), "127.0.0.1")
+            .await
+            .expect_err("certificate validation should reject this server"),
+        rustls::CertificateError::NotValidForName,
+    );
+    assert!(
+        request_with_fresh_connection(&first, server_a, "localhost")
+            .await
+            .is_ok()
+    );
+    let ordinary = fresh_client(
+        &BundleEnv {
+            preferred: None,
+            fallback: None,
+        },
+        "ordinary",
+    )
+    .unwrap();
+    assert_certificate_failure(
+        request_with_fresh_connection(&ordinary, server_b, "localhost")
+            .await
+            .expect_err("certificate validation should reject this server"),
+        rustls::CertificateError::UnknownIssuer,
+    );
+}
