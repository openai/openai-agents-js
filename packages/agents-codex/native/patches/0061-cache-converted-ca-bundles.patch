+#[tokio::test]
+async fn converted_ca_cache_reports_current_file_and_conversion_errors() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let path = temp.path().join("current.pem");
+    let pem = include_str!("../tests/fixtures/test-ca.pem");
+    std::fs::write(&path, pem).unwrap();
+    let env = BundleEnv {
+        preferred: None,
+        fallback: Some(path.clone()),
+    };
+    fresh_client(&env, "warm").unwrap();
+    std::fs::remove_file(&path).unwrap();
+    let error = fresh_client(&env, "deleted").unwrap_err();
+    assert!(
+        matches!(error, super::BuildCustomCaTransportError::ReadCaFile { source_env: super::SSL_CERT_FILE_ENV, path: ref current, ref source } if current == &path && source.kind() == std::io::ErrorKind::NotFound)
+    );
+
+    std::fs::write(&path, pem).unwrap();
+    let missing = temp.path().join("preferred-missing.pem");
+    let preferred = BundleEnv {
+        preferred: Some(missing.clone()),
+        fallback: Some(path.clone()),
+    };
+    let error = fresh_client(&preferred, "missing").unwrap_err();
+    assert!(
+        matches!(error, super::BuildCustomCaTransportError::ReadCaFile { source_env: CODEX_CA_CERT_ENV, path: ref current, ref source } if current == &missing && source.kind() == std::io::ErrorKind::NotFound)
+    );
+
+    std::fs::write(
+        &missing,
+        format!("{pem}\n-----BEGIN CERTIFICATE-----\nAQID\n-----END CERTIFICATE-----\n"),
+    )
+    .unwrap();
+    let error = fresh_client(&preferred, "bad-der").unwrap_err();
+    assert!(
+        matches!(error, super::BuildCustomCaTransportError::RegisterCertificate { source_env: CODEX_CA_CERT_ENV, path: ref current, certificate_index: 2, .. } if current == &missing)
+    );
+    std::fs::write(&missing, pem).unwrap();
+    fresh_client(&preferred, "restored").unwrap();
+
+    // Cache a conversion, then keep a caller's invalid builder setting observable.
+    let error = super::build_reqwest_client_with_env(
+        &preferred,
+        reqwest::Client::builder()
+            .no_proxy()
+            .user_agent("invalid\nheader"),
+    )
+    .unwrap_err();
+    assert!(
+        matches!(error, super::BuildCustomCaTransportError::BuildClientWithCustomCa { source_env: CODEX_CA_CERT_ENV, path: ref current, .. } if current == &missing)
+    );
+}
