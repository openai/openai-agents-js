+    /// Builds the source recovery context without charging it as a model request.
+    /// Only this exact step receives the marker; concurrent captures do not inherit it.
+    pub(crate) async fn capture_staged_input_preparation(
+        self: &Arc<Self>,
+        turn_context: Arc<TurnContext>,
+        cancellation_token: &CancellationToken,
+        required_servers: &[String],
+        required_plugins: &HashSet<String>,
+    ) -> CodexResult<Arc<StepContext>> {
+        struct EndPreparation(codex_extension_api::StagedInputPreparation);
+        impl Drop for EndPreparation {
+            fn drop(&mut self) {
+                self.0.finish();
+            }
+        }
+        let preparation =
+            codex_extension_api::StagedInputPreparation::new(turn_context.sub_id.clone());
+        let _end = EndPreparation(preparation.clone());
+        let step = self
+            .capture_step_context_inner(
+                turn_context,
+                cancellation_token,
+                required_servers,
+                required_plugins,
+                None,
+                true,
+                Some(preparation),
+            )
+            .await?;
+        self.set_last_known_step_context(&step).await;
+        Ok(step)
+    }
