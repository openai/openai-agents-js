+    // Exercise process environment reads in a fresh executable, never by mutating
+    // the environment shared by concurrent Rust tests.
+    #[test]
+    fn local_snapshot_matches_fixed_file_in_isolated_cases() {
+        const CASE: &str = "SDK_LOCAL_SNAPSHOT_CORE_CASE";
+        const MARKER: &str = "SDK_LOCAL_SNAPSHOT_CORE_MARKER";
+        const KEYS: [&str; 5] = [
+            "CODEX_EXEC_SERVER_URL",
+            "CODEX_EXEC_SERVER_NOISE_REGISTRY_URL",
+            "CODEX_EXEC_SERVER_NOISE_ENVIRONMENT_ID",
+            "CODEX_EXEC_SERVER_NOISE_AUTH_TOKEN",
+            "CODEX_EXEC_SERVER_NOISE_CHATGPT_ACCOUNT_ID",
+        ];
+        if std::env::var_os(CASE).is_none() {
+            let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+            listener.set_nonblocking(true).unwrap();
+            let url = format!("http://{}", listener.local_addr().unwrap());
+            let cases = vec![
+                "unset",
+                "ambient-remote",
+                "ambient-none",
+                "account-only",
+                "account-only-invalid",
+                "whitespace",
+                "noise",
+                "noise-trimmed",
+                "noise-malformed-url",
+                "invalid-auth",
+                "invalid-account",
+                "partial-1",
+                "partial-2",
+                "partial-3",
+                "partial-4",
+                "partial-5",
+                "partial-6",
+            ];
+            #[cfg(unix)]
+            let cases = cases
+                .into_iter()
+                .chain(["non-unicode", "non-unicode-partial", "non-unicode-account"])
+                .collect::<Vec<_>>();
+            for case in cases {
+                let witness = tempfile::tempdir().unwrap();
+                let marker = witness.path().join("passed");
+                let mut command = std::process::Command::new(std::env::current_exe().unwrap());
+                command
+                    .args([
+                        "--exact",
+                        "environment::tests::local_snapshot_matches_fixed_file_in_isolated_cases",
+                        "--nocapture",
+                    ])
+                    .env(CASE, case)
+                    .env(MARKER, &marker)
+                    .env("RUST_MIN_STACK", "33554432");
+                for key in KEYS {
+                    command.env_remove(key);
+                }
+                if case != "unset" {
+                    command.env(KEYS[0], format!("ws://{}", listener.local_addr().unwrap()));
+                }
+                match case {
+                    "ambient-none" => {
+                        command.env(KEYS[0], "none");
+                    }
+                    "account-only" => {
+                        command.env(KEYS[4], "workspace-only");
+                    }
+                    "account-only-invalid" => {
+                        command.env(KEYS[4], "bad\naccount");
+                    }
+                    "whitespace" => {
+                        for key in &KEYS[1..] {
+                            command.env(key, " \t ");
+                        }
+                    }
+                    "non-unicode" | "non-unicode-partial" | "non-unicode-account" => {
+                        #[cfg(unix)]
+                        {
+                            use std::os::unix::ffi::OsStringExt;
+                            let non_unicode = std::ffi::OsString::from_vec(vec![0xff]);
+                            if case == "non-unicode-account" {
+                                command
+                                    .env(KEYS[1], &url)
+                                    .env(KEYS[2], "environment")
+                                    .env(KEYS[3], "token")
+                                    .env(KEYS[4], non_unicode);
+                            } else {
+                                command.env(KEYS[1], non_unicode);
+                                if case == "non-unicode-partial" {
+                                    command.env(KEYS[2], "environment").env(KEYS[3], "token");
+                                }
+                            }
+                        }
+                    }
+                    _ if case.starts_with("partial-") => {
+                        let mask: u8 = case.trim_start_matches("partial-").parse().unwrap();
+                        for (index, value) in
+                            [url.as_str(), "environment", "token"].iter().enumerate()
+                        {
+                            if mask & (1 << index) != 0 {
+                                command.env(KEYS[index + 1], value);
+                            }
+                        }
+                    }
+                    "noise"
+                    | "noise-trimmed"
+                    | "noise-malformed-url"
+                    | "invalid-auth"
+                    | "invalid-account" => {
+                        command
+                            .env(
+                                KEYS[1],
+                                if case == "noise-malformed-url" {
+                                    "not-a-url"
+                                } else {
+                                    &url
+                                },
+                            )
+                            .env(KEYS[2], "environment")
+                            .env(KEYS[3], "token");
+                        if case == "noise-trimmed" {
+                            command
+                                .env(KEYS[1], format!("  {url}  "))
+                                .env(KEYS[2], " environment ")
+                                .env(KEYS[3], " token ");
+                        }
+                        if case == "invalid-auth" {
+                            command.env(KEYS[3], "bad\ntoken");
+                        }
+                        if case == "invalid-account" {
+                            command.env(KEYS[4], "bad\naccount");
+                        }
+                    }
+                    _ => {}
+                }
+                let mut child = command.spawn().unwrap();
+                let deadline = std::time::Instant::now() + Duration::from_secs(30);
+                loop {
+                    match child.try_wait() {
+                        Ok(Some(status)) => {
+                            assert!(status.success(), "case {case}");
+                            break;
+                        }
+                        Ok(None) if std::time::Instant::now() < deadline => {
+                            std::thread::sleep(Duration::from_millis(10))
+                        }
+                        result => {
+                            let _ = child.kill();
+                            let _ = child.wait();
+                            panic!("isolated case {case} failed or timed out: {result:?}");
+                        }
+                    }
+                }
+                assert_eq!(
+                    std::fs::read_to_string(marker).unwrap(),
+                    "passed",
+                    "child selected no test: {case}"
+                );
+                assert_eq!(
+                    listener.accept().unwrap_err().kind(),
+                    std::io::ErrorKind::WouldBlock,
+                    "constructor connected: {case}"
+                );
+            }
+            return;
+        }
+        tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap()
+            .block_on(async {
+                let case = std::env::var(CASE).unwrap();
+                let home = tempfile::tempdir().unwrap();
+                std::fs::write(
+                    home.path().join("environments.toml"),
+                    "default = \"none\"\ninclude_local = true\n",
+                )
+                .unwrap();
+                let old = EnvironmentManager::prepare_from_codex_home(home.path()).await;
+                let new = EnvironmentManager::prepare_local_without_default();
+                if case.starts_with("partial-")
+                    || case.starts_with("invalid-")
+                    || case == "non-unicode-partial"
+                {
+                    let old = old.unwrap_err();
+                    let new = new.unwrap_err();
+                    assert!(matches!(
+                        &old,
+                        crate::ExecServerError::EnvironmentRegistryConfig(_)
+                    ));
+                    assert_eq!(old.to_string(), new.to_string());
+                } else {
+                    let old = old.unwrap();
+                    let new = new.unwrap();
+                    let remote = matches!(
+                        case.as_str(),
+                        "noise" | "noise-trimmed" | "noise-malformed-url" | "non-unicode-account"
+                    );
+                    assert_eq!(old.default_environment_is_remote(), remote);
+                    assert_eq!(new.default_environment_is_remote(), remote);
+                    if !remote {
+                        for prepared in [&old, &new] {
+                            let crate::environment_bootstrap::PreparedEnvironmentSource::Snapshot(
+                                snapshot,
+                            ) = &prepared.source
+                            else {
+                                panic!("expected fixed local snapshot");
+                            };
+                            assert!(snapshot.environments.is_empty());
+                            assert!(matches!(snapshot.default, EnvironmentDefault::Disabled));
+                            assert!(snapshot.include_local);
+                        }
+                        let paths =
+                            test_runtime_paths().with_join_unreturned_local_exec_on_interrupt();
+                        let factory =
+                            HttpClientFactory::new(OutboundProxyPolicy::RespectSystemProxy)
+                                .with_network_policy(
+                                    codex_http_client::NetworkPolicy::unmanaged()
+                                        .restrict_to_endpoints(
+                                            std::iter::once(
+                                                "http://127.0.0.1:9/allowed".parse().unwrap(),
+                                            )
+                                            .collect(),
+                                        ),
+                                );
+                        let old = old.build(Some(paths.clone()), factory.clone()).unwrap();
+                        let new = new.build(Some(paths.clone()), factory.clone()).unwrap();
+                        let second = EnvironmentManager::prepare_local_without_default()
+                            .unwrap()
+                            .build(Some(paths.clone()), factory.clone())
+                            .unwrap();
+                        for manager in [&old, &new, &second] {
+                            assert_eq!(manager.default_environment_id(), None);
+                            assert!(manager.default_environment().is_none());
+                            assert!(manager.get_environment(REMOTE_ENVIRONMENT_ID).is_none());
+                            assert_eq!(manager.environments.read().unwrap().len(), 1);
+                            assert_eq!(manager.http_client_factory(), &factory);
+                            assert_eq!(manager.local_runtime_paths.as_ref(), Some(&paths));
+                            let local = manager.try_local_environment().unwrap();
+                            assert!(!local.is_remote());
+                            assert_eq!(local.local_runtime_paths(), Some(&paths));
+                            assert!(local.startup_task.lock().unwrap().is_none());
+                            assert!(local.info().await.is_ok());
+                        }
+                        let a = new.try_local_environment().unwrap();
+                        let b = second.try_local_environment().unwrap();
+                        assert!(!Arc::ptr_eq(&a, &b));
+                        assert!(!Arc::ptr_eq(&a.exec_backend, &b.exec_backend));
+                        assert!(!Arc::ptr_eq(&a.filesystem, &b.filesystem));
+                        drop(a);
+                        drop(new);
+                        assert!(
+                            b.info().await.is_ok(),
+                            "one manager's drop disabled another"
+                        );
+                        let old_error = EnvironmentManager::prepare_from_codex_home(home.path())
+                            .await
+                            .unwrap()
+                            .build(None, factory.clone())
+                            .unwrap_err();
+                        let new_error = EnvironmentManager::prepare_local_without_default()
+                            .unwrap()
+                            .build(None, factory)
+                            .unwrap_err();
+                        assert_eq!(old_error.to_string(), new_error.to_string());
+                    }
+                    // Preparation alone must accept malformed nonempty registry text,
+                    // classify it as remote, and leave connection setup to build.
+                }
+                std::fs::write(std::env::var_os(MARKER).unwrap(), "passed").unwrap();
+            });
+    }
 }
