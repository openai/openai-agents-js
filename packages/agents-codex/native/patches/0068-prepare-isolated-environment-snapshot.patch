+    /// Prepares a local environment without granting a default executor.
+    ///
+    /// Noise configuration keeps the same precedence and validation as
+    /// `prepare_from_codex_home`; callers can inspect it before building.
+    /// Otherwise the snapshot contains only a lazy local environment. No home
+    /// configuration or `CODEX_EXEC_SERVER_URL` is read.
+    pub fn prepare_local_without_default() -> Result<PreparedEnvironmentManager, ExecServerError> {
+        let source = if let Some(config) = noise_environment_config_from_env()? {
+            PreparedEnvironmentSource::Noise(config)
+        } else {
+            PreparedEnvironmentSource::Snapshot(EnvironmentProviderSnapshot {
+                environments: Vec::new(),
+                default: EnvironmentDefault::Disabled,
+                include_local: true,
+            })
+        };
+        Ok(PreparedEnvironmentManager { source })
+    }
