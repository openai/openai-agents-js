+    /// Read query-local memory provenance from the same exact canonical occurrences.
+    pub(crate) async fn sdk_memory_history_snapshot(
+        &self,
+    ) -> codex_protocol::error::Result<(
+        String,
+        usize,
+        Vec<String>,
+        Vec<codex_history::sdk_originals::SdkMemorySource>,
+    )> {
+        use super::original_history_read::{MemorySnapshotReader, SnapshotReader};
+        use codex_protocol::error::CodexErr;
+        let unavailable = || {
+            CodexErr::InvalidRequest(
+                "Canonical original history is unavailable for memory export".into(),
+            )
+        };
+        let (revision, total, originals) = self.sdk_replay_history_snapshot().await?;
+        drop(originals);
+        if total > 256 {
+            return Err(CodexErr::InvalidRequest(
+                "Native sandbox memory supports at most 256 original records".into(),
+            ));
+        }
+        let (token, policy) = {
+            let state = self.state.lock().await;
+            (
+                (
+                    state.sdk_originals.revision().map(str::to_owned),
+                    state.sdk_originals.read_token().1,
+                ),
+                state.sdk_originals_replay_policy.unwrap_or(
+                    codex_utils_output_truncation::TruncationPolicy::Bytes(usize::MAX),
+                ),
+            )
+        };
+        let live = self.live_thread().ok_or_else(unavailable)?;
+        live.flush().await.map_err(|_| unavailable())?;
+        let sources = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+        let captured = live
+            .read_original_history(Box::new(MemorySnapshotReader {
+                snapshot: SnapshotReader {
+                    limit: 256,
+                    policy,
+                    max_bytes: Some(8 * 1024 * 1024),
+                },
+                sources: std::sync::Arc::clone(&sources),
+            }))
+            .await
+            .map_err(|_| unavailable())?;
+        let state = self.state.lock().await;
+        if (
+            state.sdk_originals.revision().map(str::to_owned),
+            state.sdk_originals.read_token().1,
+        ) != token
+            || captured.0 != revision
+            || captured.1 != total
+        {
+            return Err(unavailable());
+        }
+        let owned = std::mem::take(&mut *sources.lock().map_err(|_| unavailable())?);
+        if owned.len() != total {
+            return Err(unavailable());
+        }
+        Ok((captured.0, captured.1, captured.2, owned))
+    }
