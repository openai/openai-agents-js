+#[tokio::test]
+async fn stale_task_start_does_not_change_active_plugin_selection() {
+    use crate::session::owned_turn_stop::TaskAdmission;
+
+    let (session, mut turn, _) = make_session_and_context_with_rx().await;
+    Arc::get_mut(&mut turn)
+        .expect("unshared turn settings")
+        .disabled_plugin_ids = vec!["stale@test".into()];
+    let surviving_selection = vec!["survivor@test".to_string()];
+    session.state.lock().await.active_disabled_plugin_ids = surviving_selection.clone();
+
+    let reserved = ActiveTurn::default();
+    let reservation = Arc::clone(&reserved.turn_state);
+    session.active_turn.lock().await.replace(reserved);
+    let admission = session
+        .services
+        .thread_extension_data
+        .get_or_init(TaskAdmission::default);
+    let permit = admission.0.lock().await;
+    let start = session.start_reserved_task(
+        turn,
+        Vec::new(),
+        crate::tasks::RegularTask::new(),
+        &reservation,
+    );
+    tokio::pin!(start);
+    assert!(futures::poll!(start.as_mut()).is_pending());
+
+    let surviving = ActiveTurn::default();
+    let surviving_state = Arc::clone(&surviving.turn_state);
+    session.active_turn.lock().await.replace(surviving);
+    drop(permit);
+
+    assert!(!start.await);
+    assert_eq!(
+        session.state.lock().await.active_disabled_plugin_ids,
+        surviving_selection
+    );
+    let active = session.active_turn.lock().await;
+    assert!(Arc::ptr_eq(
+        &active.as_ref().expect("surviving reservation").turn_state,
+        &surviving_state
+    ));
+}
