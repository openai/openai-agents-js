+    pub(crate) fn wake_span(&self, sub_id: &str) -> Span {
+        if self.initiating_agent_path.is_none() {
+            // Queue-only durable wake has no triggering caller.
+            return Span::current();
+        }
+        let parent = self.trace.as_ref().and_then(|trace| {
+            context_from_w3c_trace_context(&trace.carrier)
+                .map(|context| (trace, context.with_value(Arc::clone(&trace.policy))))
+        });
+        let parent = match parent {
+            Some((trace, _)) if trace.submission_id == sub_id => return Span::current(),
+            Some((_, parent)) => parent,
+            // A mixed or unknown owner has no shared parent, storage, or capture consent.
+            None => sdk_trace::suppressed_context(),
+        };
+        let span = info_span!(parent: None, "mailbox_turn_wake");
+        set_parent_from_context(&span, parent);
+        span
+    }
