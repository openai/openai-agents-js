+#[tokio::test]
+async fn shutdown_invalidates_a_held_mailbox_start_before_conversation_cleanup() {
+    use codex_extension_api::TurnStartPhase;
+    use codex_otel::sdk_trace;
+
+    #[derive(Default)]
+    struct StartGate {
+        entered: Notify,
+        release: Notify,
+    }
+
+    impl codex_extension_api::TurnLifecycleContributor for StartGate {
+        fn turn_start_phase(&self, _: &codex_extension_api::ExtensionData) -> TurnStartPhase {
+            TurnStartPhase::BeforeTaskRegistration
+        }
+
+        fn on_turn_start<'a>(
+            &'a self,
+            _: codex_extension_api::TurnStartInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+            Box::pin(async move {
+                self.entered.notify_one();
+                self.release.notified().await;
+            })
+        }
+    }
+
+    let server = start_mock_server().await;
+    let home = tempfile::tempdir().expect("synthetic Codex home");
+    let (mut session, _, _events) = make_session_and_context_with_auth_config_home_and_rx(
+        CodexAuth::from_api_key("test-key"),
+        Vec::new(),
+        home.path(),
+        |config| {
+            config.model_provider.base_url = Some(format!("{}/v1", server.uri()));
+            config.model_provider.supports_websockets = false;
+        },
+    )
+    .await;
+    let gate = Arc::new(StartGate::default());
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::new();
+    builder.turn_lifecycle_contributor(gate.clone());
+    Arc::get_mut(&mut session)
+        .expect("unshared session before startup")
+        .services
+        .extensions = Arc::new(builder.build());
+    let policy =
+        sdk_trace::policy_for_context(&sdk_trace::suppressed_context()).expect("synthetic policy");
+    let lease = Arc::downgrade(&policy);
+    let trace = super::input_queue::MailboxTrace::from_submission(
+        "held",
+        Some(W3cTraceContext {
+            traceparent: Some("00-11111111111111111111111111111111-0000000000000066-01".into()),
+            tracestate: None,
+        }),
+        Some(policy),
+    );
+    session
+        .input_queue
+        .enqueue_mailbox_submission(
+            InterAgentCommunication::new(
+                AgentPath::try_from("/root/sender").expect("sender path"),
+                AgentPath::root(),
+                Vec::new(),
+                "synthetic held input".into(),
+                /*trigger_turn*/ true,
+            ),
+            Default::default(),
+            trace,
+            false,
+        )
+        .await;
+    let wake = tokio::spawn(session.maybe_start_turn_for_pending_work());
+    timeout(Duration::from_secs(5), gate.entered.notified())
+        .await
+        .expect("wake before registration");
+    assert!(lease.upgrade().is_some());
+    assert!(!session.services.local_agent_runtime.shutdown.is_cancelled());
+
+    let conversation = session.conversation.hold_state_for_shutdown_test().await;
+    let shutdown = handlers::shutdown_session_runtime(&session);
+    tokio::pin!(shutdown);
+    assert!(futures::poll!(shutdown.as_mut()).is_pending());
+    assert!(session.is_shutting_down().await);
+    gate.release.notify_one();
+    timeout(Duration::from_secs(5), wake)
+        .await
+        .expect("the stale wake can exit during shutdown")
+        .expect("mailbox wake joined");
+    assert!(session.active_turn.lock().await.is_none());
+    assert!(lease.upgrade().is_none());
+    assert!(session.input_queue.has_trigger_turn_mailbox_items().await);
+    assert!(
+        server
+            .received_requests()
+            .await
+            .expect("request log")
+            .iter()
+            .all(|request| !request.url.path().ends_with("/responses"))
+    );
+
+    drop(conversation);
+    shutdown.await;
+}
