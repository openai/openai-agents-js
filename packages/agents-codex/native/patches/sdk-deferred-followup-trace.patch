+    let handle = root["handle"].as_str().expect("caller scope handle");
+    let caller_policy =
+        sdk_trace::policy_for_context(&sdk_trace::context(handle).expect("caller context"))
+            .expect("caller policy");
+    sdk_trace::release_trace_span(handle);
+
+    let (mut session, turn) = make_session_and_context().await;
+    let (starts_tx, starts) = async_channel::unbounded();
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::new();
+    builder.turn_lifecycle_contributor(Arc::new(CaptureRegularStart(starts_tx)));
+    session.services.extensions = Arc::new(builder.build());
+    let (tx_event, events) = async_channel::unbounded();
+    session.tx_event = tx_event;
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    let finish = Arc::new(Notify::new());
+    if deferred {
+        session
+            .spawn_task(
+                Arc::clone(&turn),
+                Vec::new(),
+                HeldStepTask {
+                    kind: TaskKind::Regular,
+                    finish: Arc::clone(&finish),
+                },
+            )
+            .await;
+        session
+            .input_queue
+            .defer_mailbox_delivery_to_next_turn(&session.active_turn, &turn.sub_id)
+            .await;
+    }
+
+    let mail = InterAgentCommunication::new(
+        AgentPath::try_from("/root/worker").expect("worker path"),
+        AgentPath::root(),
+        Vec::new(),
+        "trigger a turn".to_string(),
+        /*trigger_turn*/ true,
+    );
+    let submission = Submission {
+        id: "mail-submission".to_string(),
+        op: Op::InterAgentCommunication {
+            communication: mail.clone(),
+            start_options: Default::default(),
+        },
+        trace: Some(W3cTraceContext {
+            traceparent: Some(format!("00-{TRACE_ID}-0000000000000066-01")),
+            tracestate: None,
+        }),
+        trace_policy: Some(Arc::clone(&caller_policy)),
+        turn_extension_init: None,
+        parent_turn_id: None,
+        root_turn_id: None,
+        residency_guard: None,
+    };
+    let span = submission_dispatch_span(&submission);
+    let Op::InterAgentCommunication {
+        communication,
+        start_options,
+    } = submission.op
+    else {
+        unreachable!()
+    };
+    let trace = super::input_queue::MailboxTrace::from_submission(
+        &submission.id,
+        submission.trace,
+        submission.trace_policy,
+    );
+    handlers::inter_agent_communication(
+        &session,
+        submission.id,
+        communication,
+        start_options,
+        trace,
+    )
+    .instrument(span)
+    .await;
+
+    if deferred {
+        assert!(
+            !session
+                .input_queue
+                .has_pending_input(&session.active_turn)
+                .await
+        );
+        assert!(starts.is_empty());
+        finish.notify_one();
+        let complete = recv_terminal_event(&events, TerminalEventKind::TurnComplete).await;
+        assert_eq!(complete.id, turn.sub_id);
+    }
+    let start = timeout(Duration::from_secs(5), starts.recv())
+        .await
+        .expect("mailbox task should start")
+        .expect("regular task startup");
+    let state = session
+        .input_queue
+        .turn_state_for_sub_id(&session.active_turn, &start.id)
+        .await
+        .expect("registered mailbox task");
+    let input = state.lock().await.pending_input.snapshot();
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+
+    assert_ne!(start.id, turn.sub_id);
+    assert_eq!(input, vec![TurnInput::InterAgentCommunication(mail)]);
+    assert!(starts.is_empty());
+    let trace_id = start
+        .trace
+        .as_ref()
+        .and_then(codex_otel::context_from_w3c_trace_context)
+        .map(|ctx| ctx.span().span_context().trace_id());
+    let policy = start
+        .policy
+        .as_ref()
+        .map(|p| (p.disabled, p.include_sensitive_data));
+    assert_eq!(
+        (trace_id, policy),
+        (
+            Some(TraceId::from_hex(TRACE_ID).expect("trace ID")),
+            Some((disabled, false))
+        ),
+        "mailbox task should inherit the sender's trace and sensitive-data policy"
+    );
+    assert!(Arc::ptr_eq(&start.policy.unwrap(), &caller_policy));
+}
