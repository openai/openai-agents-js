+#[tokio::test]
+async fn mailbox_trace_startup_seal_keeps_late_trigger_out_of_first_sampling(
+    interrupt: bool,
+    mixed: bool,
+) {
+    use codex_extension_api::TurnStartPhase;
+    use codex_otel::sdk_trace;
+
+    struct StartGate {
+        phase: TurnStartPhase,
+        started: async_channel::Sender<(String, Option<Arc<sdk_trace::ScopePolicy>>)>,
+        release: Option<Arc<tokio::sync::Semaphore>>,
+    }
+
+    impl codex_extension_api::TurnLifecycleContributor for StartGate {
+        fn turn_start_phase(&self, _: &codex_extension_api::ExtensionData) -> TurnStartPhase {
+            self.phase
+        }
+
+        fn on_turn_start<'a>(
+            &'a self,
+            input: codex_extension_api::TurnStartInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+            Box::pin(async move {
+                if input.turn_id == "old-turn" {
+                    return;
+                }
+                self.started
+                    .try_send((input.turn_id.to_owned(), sdk_trace::current_scope_policy()))
+                    .expect("record turn start");
+                if let Some(release) = &self.release {
+                    release.acquire().await.expect("registration gate").forget();
+                }
+            })
+        }
+    }
+
+    async fn submit(
+        session: &Arc<Session>,
+        id: &str,
+        message: &str,
+        trace_byte: &str,
+        disabled: bool,
+    ) -> Arc<sdk_trace::ScopePolicy> {
+        let trace_id = trace_byte.repeat(16);
+        let options = json!({
+            "name": "mail sender",
+            "kind": "workflow",
+            "trace_id": trace_id,
+            "disabled": disabled,
+            "include_sensitive_data": !disabled,
+        });
+        let readback = sdk_trace::start_trace_span(&options.to_string()).expect("start caller");
+        let root: serde_json::Value = serde_json::from_str(&readback).expect("caller readback");
+        let handle = root["handle"].as_str().expect("caller handle");
+        let policy = sdk_trace::policy_for_context(&sdk_trace::context(handle).expect("context"))
+            .expect("policy");
+        sdk_trace::release_trace_span(handle);
+        let trace = W3cTraceContext {
+            traceparent: Some(format!("00-{trace_id}-0000000000000066-01")),
+            tracestate: None,
+        };
+        let communication = InterAgentCommunication::new(
+            AgentPath::try_from("/root/sender").expect("sender path"),
+            AgentPath::root(),
+            Vec::new(),
+            message.to_owned(),
+            /*trigger_turn*/ true,
+        );
+        let start_options = codex_protocol::turn_input::TurnStartOptions {
+            parent_turn_id: Some("caller-turn".to_string()),
+            ..Default::default()
+        };
+        let submission = Submission {
+            id: id.to_owned(),
+            op: Op::InterAgentCommunication {
+                communication: communication.clone(),
+                start_options: start_options.clone(),
+            },
+            trace: Some(trace.clone()),
+            trace_policy: Some(Arc::clone(&policy)),
+            turn_extension_init: None,
+            parent_turn_id: None,
+            root_turn_id: None,
+            residency_guard: None,
+        };
+        let dispatch = submission_dispatch_span(&submission);
+        let trace = super::input_queue::MailboxTrace::from_submission(
+            id,
+            Some(trace),
+            Some(Arc::clone(&policy)),
+        );
+        handlers::inter_agent_communication(
+            session,
+            submission.id,
+            communication,
+            start_options,
+            trace,
+        )
+        .instrument(dispatch)
+        .await;
+        policy
+    }
+
+    async fn receive<T>(rx: &async_channel::Receiver<T>) -> T {
+        timeout(Duration::from_secs(10), rx.recv())
+            .await
+            .expect("start gate deadline")
+            .expect("start gate event")
+    }
+
+    const FIRST: &str = "synthetic mail accepted before the startup seal";
+    const LATE: &str = "synthetic mail from the disabled late sender";
+    let _tracing = install_test_tracing("codex-core-tests");
+    let server = start_mock_server().await;
+    let first_request = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_response_created("first-response"),
+            ev_assistant_message("first-message", "first result"),
+            ev_completed("first-response"),
+        ]),
+    )
+    .await;
+    let second_request = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_response_created("second-response"),
+            ev_assistant_message("second-message", "second result"),
+            ev_completed("second-response"),
+        ]),
+    )
+    .await;
+    let (before_tx, before_rx) = async_channel::unbounded();
+    let (regular_tx, regular_rx) = async_channel::unbounded();
+    let release_registration = Arc::new(tokio::sync::Semaphore::new(0));
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::new();
+    builder.turn_lifecycle_contributor(Arc::new(StartGate {
+        phase: TurnStartPhase::BeforeTaskRegistration,
+        started: before_tx,
+        release: Some(Arc::clone(&release_registration)),
+    }));
+    builder.turn_lifecycle_contributor(Arc::new(StartGate {
+        phase: TurnStartPhase::RegularTaskStart,
+        started: regular_tx,
+        release: None,
+    }));
+    let home = tempfile::tempdir().expect("synthetic Codex home");
+    let (mut session, _, events) = make_session_and_context_with_auth_config_home_and_rx(
+        CodexAuth::from_api_key("test-key"),
+        Vec::new(),
+        home.path(),
+        |config| {
+            config.model_provider.base_url = Some(format!("{}/v1", server.uri()));
+            config.model_provider.supports_websockets = false;
+        },
+    )
+    .await;
+    Arc::get_mut(&mut session)
+        .expect("unique session before startup")
+        .services
+        .extensions = Arc::new(builder.build());
+    let old = session
+        .new_turn_with_default_settings("old-turn".to_string(), Default::default())
+        .await;
+    let finish_old = Arc::new(Notify::new());
+    session
+        .spawn_task(
+            old.clone(),
+            Vec::new(),
+            HeldStepTask {
+                kind: TaskKind::Regular,
+                finish: Arc::clone(&finish_old),
+            },
+        )
+        .await;
+    session
+        .input_queue
+        .defer_mailbox_delivery_to_next_turn(&session.active_turn, &old.sub_id)
+        .await;
+    let owner_a = submit(&session, "admit-a", FIRST, "11", false).await;
+    let mixed_owner = if mixed {
+        // The same carrier does not establish common ownership of policy or storage.
+        Some(submit(&session, "admit-b", LATE, "11", true).await)
+    } else {
+        None
+    };
+    finish_old.notify_one();
+    let (reserved, _) = receive(&before_rx).await;
+    let owner_b = match mixed_owner {
+        Some(owner) => owner,
+        None => submit(&session, "admit-b", LATE, "22", true).await,
+    };
+    assert!(first_request.requests().is_empty());
+    assert!(regular_rx.is_empty());
+    assert!(session.input_queue.has_trigger_turn_mailbox_items().await);
+
+    let expected_first_turn = if interrupt {
+        let reservation = Arc::clone(
+            &session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .expect("A reserved")
+                .turn_state,
+        );
+        timeout(Duration::from_secs(10), session.interrupt_task())
+            .await
+            .expect("interrupt should return while the original start hook is held");
+        assert!(
+            session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .is_none_or(|active| !Arc::ptr_eq(&active.turn_state, &reservation))
+        );
+        assert!(session.input_queue.has_trigger_turn_mailbox_items().await);
+        release_registration.add_permits(1);
+        let (retried, policy) = receive(&before_rx).await;
+        assert_ne!(retried, reserved);
+        assert!(Arc::ptr_eq(&policy.expect("retried policy"), &owner_a));
+        let direct = timeout(
+            Duration::from_secs(10),
+            super::turn_input::handle(
+                &session,
+                TurnInputRequest::user_input(vec![UserInput::Text {
+                    text: "synthetic later direct input".to_string(),
+                    text_elements: Vec::new(),
+                }]),
+                TurnInputMode::StartIfIdle,
+                "later-direct".to_string(),
+            ),
+        )
+        .await
+        .expect("mailbox priority decision while the retried start hook is held")
+        .expect("direct admission result");
+        assert_eq!(
+            direct,
+            TurnInputSubmission::NotSubmitted {
+                reason: codex_protocol::turn_input::NotSubmittedReason::PendingTriggerTurn,
+            }
+        );
+        retried
+    } else {
+        reserved
+    };
+    release_registration.add_permits(1);
+    let (first_turn, first_policy) = receive(&regular_rx).await;
+    let first_policy = first_policy.expect("first sampling scope");
+    assert_eq!(first_turn, expected_first_turn);
+    if mixed {
+        assert!(first_policy.disabled);
+        assert!(!first_policy.include_sensitive_data);
+        assert!(!Arc::ptr_eq(&first_policy, &owner_a));
+        assert!(!Arc::ptr_eq(&first_policy, &owner_b));
+    } else {
+        assert!(Arc::ptr_eq(&first_policy, &owner_a));
+    }
+    let completion = async |turn_id: &str| {
+        timeout(Duration::from_secs(10), async {
+            loop {
+                let event = events.recv().await.expect("turn event");
+                if event.id == turn_id && matches!(event.msg, EventMsg::TurnComplete(_)) {
+                    break;
+                }
+            }
+        })
+        .await
+        .expect("turn completion deadline");
+    };
+    completion(&first_turn).await;
+    let input = first_request.single_request().input();
+    let first_position = input
+        .iter()
+        .position(|item| item.to_string().contains(FIRST));
+    let late_position = input
+        .iter()
+        .position(|item| item.to_string().contains(LATE));
+    assert!(first_position.is_some());
+    assert_eq!(
+        input
+            .iter()
+            .filter(|item| item.to_string().contains(FIRST))
+            .count(),
+        1
+    );
+    if mixed {
+        assert!(late_position.is_some());
+        assert!(first_position < late_position);
+        assert_eq!(
+            input
+                .iter()
+                .filter(|item| item.to_string().contains(LATE))
+                .count(),
+            1
+        );
+        assert!(second_request.requests().is_empty());
+        assert!(regular_rx.is_empty());
+    } else {
+        assert_eq!(late_position, None);
+        let (late_reservation, _) = receive(&before_rx).await;
+        release_registration.add_permits(1);
+        let (second_turn, second_policy) = receive(&regular_rx).await;
+        assert_ne!(first_turn, second_turn);
+        assert_eq!(late_reservation, second_turn);
+        assert!(Arc::ptr_eq(&second_policy.expect("late policy"), &owner_b));
+        completion(&second_turn).await;
+        let late_matches = second_request
+            .single_request()
+            .input()
+            .iter()
+            .filter(|item| item.to_string().contains(LATE))
+            .count();
+        assert_eq!(late_matches, 1);
+    }
+    assert!(!session.input_queue.has_trigger_turn_mailbox_items().await);
+}
