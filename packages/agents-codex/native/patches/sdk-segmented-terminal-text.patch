new file mode 100644
index 00000000..b30c17de
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/sdk_final_text.rs
@@ -0,0 +1,61 @@
+use codex_protocol::models::{ContentItem, ResponseItem};
+
+/// Finalized assistant text from one SDK model response.
+///
+/// A completed response may separate assistant messages with reasoning or hosted
+/// search. Its final result joins the visible text while the caller retains the
+/// original output items in their original order.
+#[derive(Default)]
+pub struct SdkSegmentedAssistantText {
+    has_separator: bool,
+    final_message_has_text: bool,
+    fragments: Vec<String>,
+}
+
+impl SdkSegmentedAssistantText {
+    /// Returns false if this item rules out composition for the whole response.
+    pub fn observe_item(&mut self, item: &ResponseItem, finalized: bool) -> bool {
+        match item {
+            ResponseItem::Message { role, content, .. } => {
+                if role == "assistant" {
+                    self.final_message_has_text = finalized
+                        && content
+                            .iter()
+                            .any(|part| matches!(part, ContentItem::OutputText { .. }));
+                }
+                true
+            }
+            ResponseItem::Reasoning { .. }
+            | ResponseItem::ToolSearchCall { .. }
+            | ResponseItem::ToolSearchOutput { .. } => {
+                self.has_separator = true;
+                true
+            }
+            _ => false,
+        }
+    }
+
+    pub fn push_text(&mut self, text: String) {
+        if !text.is_empty() {
+            self.fragments.push(text);
+        }
+    }
+
+    pub fn is_segmented(&self) -> bool {
+        self.has_separator && self.final_message_has_text
+    }
+
+    pub fn finish(self, terminal: bool) -> Option<String> {
+        if terminal && self.is_segmented() {
+            return Some(self.fragments.concat());
+        }
+        self.last_nonblank()
+    }
+
+    pub fn last_nonblank(self) -> Option<String> {
+        self.fragments
+            .into_iter()
+            .rev()
+            .find(|fragment| !fragment.trim().is_empty())
+    }
+}
