+    #[test]
+    fn sdk_default_compaction_preserves_explicit_disables_and_durable_shape() {
+        let controls: ModelRequestControls = serde_json::from_value(json!({
+            "sdk_default_provider_compaction": true,
+        }))
+        .unwrap();
+        assert!(!controls.is_empty());
+        assert!(!controls.has_wire_values());
+        assert_eq!(
+            controls.context_management_for_model(None),
+            Some(vec![
+                json!({"type":"compaction", "compact_threshold":240000})
+            ])
+        );
+        for patch in [
+            json!({"provider_compaction":null}),
+            json!({"context_management":null}),
+            json!({"context_management":[]}),
+        ] {
+            let mut selected = controls.clone();
+            selected.apply_patch(&serde_json::from_value(patch).unwrap());
+            let context = selected.context_management_for_model(None);
+            assert!(context.is_none() || context == Some(vec![]));
+        }
+        let mut disabled = controls.clone();
+        disabled.apply_patch(&ModelRequestControls {
+            sdk_default_provider_compaction: Some(false),
+            ..Default::default()
+        });
+        assert_eq!(disabled.context_management_for_model(None), None);
+        let persisted = controls.for_persistence();
+        assert!(persisted.is_empty());
+        assert!(
+            serde_json::to_value(persisted)
+                .unwrap()
+                .get("sdk_default_provider_compaction")
+                .is_none()
+        );
+    }
