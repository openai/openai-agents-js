+            .batches
+            .iter()
+            .find_map(|(owner, batch)| batch.hosted_calls.get(id).map(|call| (owner, call)))
+        {
+            if owner != response_id || call.server_label != label {
+                return Err("Hosted MCP call identity changed".into());
+            }
+            return Ok(());
+        }
+        if id.len() + label.len() > MAX_CALL_BYTES
