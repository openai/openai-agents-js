+            return Err("Hosted MCP call capacity exceeded".into());
+        }
+        let batch = self.batches.entry(response_id.into()).or_default();
+        batch.out_of_band = detached.is_some();
+        batch.hosted_calls.insert(
+            id.into(),
+            HostedCall {
+                server_label: label.into(),
+                terminal: false,
+            },
+        );
+        Ok(())
