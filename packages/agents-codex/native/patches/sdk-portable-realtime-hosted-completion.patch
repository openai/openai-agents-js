+                "arguments":"{}","status":"in_progress"});
+            let done = command(
+                &mut control,
+                json!({"type":"provider","event":{
+                    "type":"response.done","response":{"id":"hosted-response","status":"completed",
+                    "output":[first,second]}
+                }}),
