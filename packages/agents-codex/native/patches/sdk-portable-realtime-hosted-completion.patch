+            first["output"] = json!("one");
+            let complete_first = command(
+                &mut control,
+                json!({"type":"provider","event":{
+                    "type":"conversation.item.done","item":first
+                }}),
+            );
+            assert_eq!(response_creates(&complete_first), 0);
+
+            let mut second = second;
+            second["status"] = json!("failed");
