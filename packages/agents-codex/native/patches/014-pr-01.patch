+    let bytes: usize = encoded.values().map(String::len).sum();
+    assert!(bytes < 1_312_000);
+    assert_eq!(
+        decode_sandbox_command_environment(&encoded).unwrap(),
+        Some(payload)
+    );
+}
+
+#[test]
+fn command_environment_rejects_noncanonical_or_truncated_lengths() {
+    for body in [
+        "01:",
+        "1:1:é0:",
+        "1:2:a",
+        "1:1:a00:",
+        "1:1:a0:extra",
+        "2:1:a0:1:a0:",
+        "1:1:a18446744073709551615:x",
+    ] {
+        let carrier = std::collections::HashMap::from([
+            (CODEX_SANDBOX_COMMAND_ENV_JSON.to_owned(), "1:1".to_owned()),
+            (
+                "CODEX_SANDBOX_COMMAND_ENV_JSON_0".to_owned(),
+                body.to_owned(),
+            ),
+        ]);
+        assert!(decode_sandbox_command_environment(&carrier).is_err());
+    }
+}
