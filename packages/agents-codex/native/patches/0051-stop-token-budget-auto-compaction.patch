+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn token_budget_auto_compaction_respects_stop_during_pre_compact_hook() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![sse(vec![
+            ev_response_created("resp-1"),
+            ev_function_call("remaining-call", "get_context_remaining", "{}"),
+            ev_completed_with_tokens("resp-1", /*total_tokens*/ 9_500),
+        ])],
+    )
+    .await;
+    let test = test_codex()
+        .with_pre_build_hook(|home| {
+            let script = home.join("hold_pre_compact.py");
+            let entered = home.join("pre_compact_entered");
+            let release = home.join("pre_compact_release");
+            std::fs::write(
+                &script,
+                format!(
+                    "import json, sys, time\nfrom pathlib import Path\njson.load(sys.stdin)\nPath({entered:?}).touch()\nwhile not Path({release:?}).exists(): time.sleep(0.01)\n"
+                ),
+            )
+            .expect("write blocking compact hook");
+            let hooks = json!({
+                "hooks": {
+                    "PreCompact": [{
+                        "matcher": "auto",
+                        "hooks": [{
+                            "type": "command",
+                            "command": python_hook_command(&script),
+                        }]
+                    }]
+                }
+            });
+            std::fs::write(home.join("hooks.json"), hooks.to_string()).expect("write hooks.json");
+        })
+        .with_config(|config| {
+            config.model_context_window = Some(10_000);
+            config.features.enable(Feature::TokenBudget).unwrap();
+            trust_discovered_hooks(config);
+        })
+        .build(&server)
+        .await?;
+    let mut extension_data = ExtensionDataInit::new();
+    extension_data.insert(TurnSamplingStop::default());
+    let stop = extension_data
+        .get::<TurnSamplingStop>()
+        .expect("sampling stop should be attached");
+    test.codex
+        .start_or_steer_turn(WithTurnExtensionData::new(
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "trigger automatic compaction".into(),
+                text_elements: Vec::new(),
+            }]),
+            extension_data,
+        ))
+        .await?;
+
+    let entered = test.codex_home_path().join("pre_compact_entered");
+    tokio::time::timeout(Duration::from_secs(10), async {
+        while !entered.exists() {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await?;
+    stop.request();
+    std::fs::write(test.codex_home_path().join("pre_compact_release"), [])?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::HookCompleted(event) if event.run.event_name == HookEventName::PreCompact)
+    })
+    .await;
+
+    let started = tokio::time::timeout(Duration::from_secs(1), async {
+        loop {
+            let event = test.codex.next_event().await.expect("next event");
+            if matches!(
+                event.msg,
+                EventMsg::ItemStarted(ItemStartedEvent {
+                    item: TurnItem::ContextCompaction(_),
+                    ..
+                })
+            ) {
+                break;
+            }
+        }
+    })
+    .await;
+    test.codex.submit(Op::Interrupt).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnAborted(_))
+    })
+    .await;
+    assert!(started.is_err(), "stopped turn started compaction");
+    assert_eq!(responses.requests().len(), 1);
+    Ok(())
+}
+
 #[test_case(false; "token_budget_only")]
 #[test_case(true; "with_client_developer_retention")]
 #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
