+/// Only conversation candidates participate in the optional default predicate.
+fn compaction_candidate_indexes(items: &[ResponseItem]) -> Vec<usize> {
+    items
+        .iter()
+        .enumerate()
+        .filter_map(|(index, item)| {
+            (!is_compaction_control_item(item)
+                && !matches!(item, ResponseItem::Message { role, .. } if role == "user")
+                && !matches!(
+                    item,
+                    ResponseItem::Compaction { .. } | ResponseItem::ContextCompaction { .. }
+                ))
+            .then_some(index)
+        })
+        .collect()
+}
