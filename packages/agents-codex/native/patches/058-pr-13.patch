+fn is_compaction_control_item(item: &ResponseItem) -> bool {
+    matches!(item, ResponseItem::Message { role, .. } if role == "system" || role == "developer")
+        || matches!(
+            item,
+            ResponseItem::ConfigurationUpdate { .. }
+                | ResponseItem::CompactionTrigger { .. }
