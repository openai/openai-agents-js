+#[tokio::test]
+async fn metadata_lookup_rejects_stale_catalog_after_identity_change_and_auth_removal() {
+    let bundled = crate::bundled_models_response_ref()
+        .expect("bundled catalog should load")
+        .models[0]
+        .clone();
+    for explicit_provider in [false, true] {
+        let auth =
+            AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing());
+        let replacement = remote_model(&bundled.slug, "Authenticated replacement", 0);
+        let endpoint =
+            TestAuthAwareModelsEndpoint::new(Some(auth.clone()), vec![vec![replacement]]);
+        let mut manager =
+            OpenAiModelsManager::new_without_cache(endpoint.clone(), Some(auth.clone()));
+        if explicit_provider {
+            manager = manager.with_provider_catalog();
+        }
+        // Keep API-key discovery enabled so the changed-identity phase tests the
+        // identity guard rather than the independent discovery rollback guard.
+        manager.set_api_key_model_discovery_enabled(true);
+        manager
+            .refresh_available_models(RefreshStrategy::Online, &DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .expect("initial authenticated catalog should load");
+        let original_identity = endpoint.identity().expect("initial authenticated identity");
+        let config = ModelsManagerConfig::default();
+        assert_eq!(
+            manager
+                .get_model_info(&bundled.slug, &config)
+                .await
+                .display_name,
+            "Authenticated replacement"
+        );
+        assert_eq!(endpoint.fetch_count(), 1);
+
+        auth.set_external_auth(Arc::new(TestExternalApiKeyAuth))
+            .await
+            .expect("test API-key auth should resolve");
+        assert!(endpoint.identity().is_some());
+        assert_ne!(endpoint.identity().as_ref(), Some(&original_identity));
+        let fallback = if explicit_provider {
+            model_info::model_info_from_slug(&bundled.slug)
+        } else {
+            bundled.clone()
+        };
+        assert_eq!(
+            manager.get_model_info(&bundled.slug, &config).await,
+            fallback,
+            "a changed identity must not reuse the authenticated catalog"
+        );
+        assert_eq!(
+            endpoint.fetch_count(),
+            1,
+            "metadata lookup must not refresh"
+        );
+
+        auth.clear_external_auth();
+        assert_eq!(endpoint.identity(), None);
+        assert_eq!(
+            manager.get_model_info(&bundled.slug, &config).await,
+            fallback,
+            "an unavailable identity must not reuse the authenticated catalog"
+        );
+        assert_eq!(
+            endpoint.fetch_count(),
+            1,
+            "metadata lookup must not refresh"
+        );
+    }
