+#[tokio::test]
+async fn metadata_lookup_keeps_explicit_provider_exact_matching_and_failure_fallback() {
+    let model = remote_model("fixture-provider", "Provider model", 0);
+    let endpoint = TestModelsEndpoint::with_command_auth(vec![
+        Ok(vec![model.clone()]),
+        Err(CodexErr::RequestTimeout),
+    ]);
+    let manager =
+        OpenAiModelsManager::new_without_cache(endpoint.clone(), None).with_provider_catalog();
+    let config = ModelsManagerConfig::default();
+    let bundled_slug = crate::bundled_models_response_ref()
+        .expect("bundled catalog should load")
+        .models[0]
+        .slug
+        .clone();
+    assert!(
+        manager
+            .get_model_info(&bundled_slug, &config)
+            .await
+            .used_fallback_model_metadata
+    );
+    manager
+        .refresh_available_models(RefreshStrategy::Online, &DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("explicit catalog should load");
+    assert_eq!(manager.get_model_info(&model.slug, &config).await, model);
+    for unknown in ["fixture-provider-extra", "custom/fixture-provider"] {
+        assert!(
+            manager
+                .get_model_info(unknown, &config)
+                .await
+                .used_fallback_model_metadata
+        );
+    }
+    manager
+        .refresh_available_models(RefreshStrategy::Online, &DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect_err("failed refresh must clear explicit catalog");
+    assert!(
+        manager
+            .get_model_info(&model.slug, &config)
+            .await
+            .used_fallback_model_metadata
+    );
+    assert_eq!(endpoint.fetch_count(), 2);
+}
