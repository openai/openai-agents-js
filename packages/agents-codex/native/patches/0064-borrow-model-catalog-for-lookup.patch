+#[tokio::test]
+async fn metadata_lookup_selects_from_active_and_static_catalogs_without_sharing_results() {
+    let candidates = vec![
+        remote_model("fixture-model", "Short", 0),
+        remote_model("fixture-model-long", "Long", 1),
+    ];
+    let endpoint = TestModelsEndpoint::with_command_auth(vec![Ok(candidates.clone())]);
+    let remote = OpenAiModelsManager::new_without_cache(endpoint.clone(), None);
+    remote
+        .refresh_available_models(RefreshStrategy::Online, &DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("remote catalog should load");
+    let managers: Vec<SharedModelsManager> = vec![
+        Arc::new(remote),
+        Arc::new(StaticModelsManager::new(
+            None,
+            ModelsResponse { models: candidates },
+        )),
+    ];
+    let config = ModelsManagerConfig {
+        model_context_window: Some(1234),
+        base_instructions: Some("Current application instructions".into()),
+        ..Default::default()
+    };
+    for manager in managers {
+        for slug in ["fixture-model-long-preview", "custom/fixture-model-long"] {
+            let mut selected = manager.get_model_info(slug, &config).await;
+            assert_eq!(selected.slug, slug);
+            assert_eq!(selected.display_name, "Long");
+            assert!(!selected.used_fallback_model_metadata);
+            assert_eq!(selected.context_window, Some(1234));
+            assert_eq!(
+                selected
+                    .model_messages
+                    .as_ref()
+                    .unwrap()
+                    .instructions_template
+                    .as_deref(),
+                Some("Current application instructions")
+            );
+            selected.display_name.clear();
+            selected
+                .model_messages
+                .as_mut()
+                .unwrap()
+                .instructions_template = None;
+            let untouched = manager
+                .get_model_info(slug, &ModelsManagerConfig::default())
+                .await;
+            assert_eq!(untouched.display_name, "Long");
+            assert_eq!(untouched.context_window, Some(272_000));
+            assert_eq!(
+                untouched
+                    .model_messages
+                    .as_ref()
+                    .unwrap()
+                    .instructions_template
+                    .as_deref(),
+                Some("base instructions")
+            );
+        }
+        let missing = manager
+            .get_model_info("fixture-unknown-model", &config)
+            .await;
+        assert!(missing.used_fallback_model_metadata);
+        assert_eq!(missing.slug, "fixture-unknown-model");
+        assert_eq!(missing.context_window, Some(1234));
+    }
+    assert_eq!(
+        endpoint.fetch_count(),
+        1,
+        "metadata lookup must not refresh"
+    );
+}
