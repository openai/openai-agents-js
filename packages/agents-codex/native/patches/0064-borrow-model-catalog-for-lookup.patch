+#[tokio::test]
+async fn metadata_lookup_honors_api_discovery_rollback_and_preserves_bundled_values() {
+    let expected = crate::bundled_models_response_ref()
+        .expect("bundled catalog should load")
+        .models[0]
+        .clone();
+    let replacement = remote_model(&expected.slug, "Remote replacement", 0);
+    let endpoint = TestModelsEndpoint::without_refresh(vec![vec![replacement]]);
+    let auth = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("test-key"));
+    let manager = OpenAiModelsManager::new_without_cache(endpoint.clone(), Some(auth));
+    manager.set_api_key_model_discovery_enabled(true);
+    manager
+        .refresh_available_models(RefreshStrategy::Online, &DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("remote catalog should load");
+    let config = ModelsManagerConfig::default();
+    assert_eq!(
+        manager
+            .get_model_info(&expected.slug, &config)
+            .await
+            .display_name,
+        "Remote replacement"
+    );
+    manager.set_api_key_model_discovery_enabled(false);
+    let mut selected = manager.get_model_info(&expected.slug, &config).await;
+    assert_eq!(selected, expected);
+    selected.display_name.clear();
+    selected.model_messages = None;
+    assert_eq!(
+        manager.get_model_info(&expected.slug, &config).await,
+        expected
+    );
+    assert_eq!(endpoint.fetch_count(), 1);
+}
