diff --git a/codex-rs/core/src/session/owned_turn_stop.rs b/codex-rs/core/src/session/owned_turn_stop.rs
new file mode 100644
index 0000000000000000000000000000000000000000..985f78214e406e331df2a08ff3499ffa60dba30f
--- /dev/null
+++ b/codex-rs/core/src/session/owned_turn_stop.rs
@@ -0,0 +1,247 @@
+//! Host-owned retirement of one captured task, without borrowing a later task.
+use std::future::Future;
+use std::panic::AssertUnwindSafe;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::task::Context;
+use std::task::Poll;
+
+use futures::FutureExt;
+use futures::future::BoxFuture;
+use futures::future::Shared;
+use tokio::sync::Mutex;
+use tokio::task::AbortHandle;
+use tokio::task::JoinError;
+use tokio::task::JoinHandle;
+use tokio_util::sync::CancellationToken;
+
+use crate::codex_thread::CodexThread;
+use crate::session::session::Session;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+
+/// Serializes task registration with owned retirement. Task execution does not
+/// hold this gate; ordinary completion can finish while retirement joins it.
+#[derive(Default)]
+pub(crate) struct TaskAdmission(pub(crate) Arc<Mutex<()>>);
+
+type JoinedTask = Shared<BoxFuture<'static, Result<(), Arc<JoinError>>>>;
+
+/// Opaque identity and completion of a single Core task. Hosts capture this
+/// from the original turn's extension store; IDs alone confer no stop authority.
+#[derive(Default)]
+pub struct OwnedTurnTask {
+    identity: OnceLock<(String, String)>,
+    task: OnceLock<TaskJoin>,
+    pub(crate) recording: Mutex<()>,
+    stopping: CancellationToken,
+}
+
+impl OwnedTurnTask {
+    pub(crate) fn new(thread_id: String, turn_id: String) -> Self {
+        let value = Self::default();
+        let _ = value.identity.set((thread_id, turn_id));
+        value
+    }
+
+    /// Fence this captured task's next model request after an admitted stop.
+    /// The host must then call `stop_owned_turn` outside its callback scope.
+    pub fn request_stop(&self) {
+        self.stopping.cancel();
+    }
+
+    pub(crate) fn stopping(&self) -> bool {
+        self.stopping.is_cancelled()
+    }
+
+    /// Probe the captured owner at logical client request admission, after
+    /// caller preparation. A stop observed by this probe prevents polling.
+    /// A request admitted before a concurrent stop may still be polled/sent;
+    /// retirement joins that original task and its cleanup.
+    pub(crate) async fn admit_model<F>(&self, request: F) -> CodexResult<F::Output>
+    where
+        F: Future + Send,
+        F::Output: Send,
+    {
+        tokio::select! {
+            biased;
+            _ = self.stopping.cancelled() => Err(CodexErr::TurnAborted),
+            result = request => Ok(result),
+        }
+    }
+
+    /// Join this original physical task after confirmed cancellation or normal
+    /// terminal delivery. This does not request interruption and must not be
+    /// awaited by the captured task's own callback.
+    pub async fn join(&self) -> CodexResult<()> {
+        let task = self
+            .task
+            .get()
+            .ok_or_else(|| CodexErr::Fatal("Owned turn task was not registered".to_owned()))?;
+        match task.clone().await {
+            Ok(()) => Ok(()),
+            Err(error) if error.is_cancelled() => Ok(()),
+            Err(_) => Err(CodexErr::Fatal(
+                "Owned turn task failed while joining".to_owned(),
+            )),
+        }
+    }
+}
+
+/// Retirement continues even if its host drops this receipt. Joining it proves
+/// task completion, input recording and abort cleanup, not only cancellation.
+pub struct OwnedTurnStop {
+    retirement: JoinHandle<CodexResult<()>>,
+}
+
+impl OwnedTurnStop {
+    pub async fn join(self) -> CodexResult<()> {
+        self.retirement
+            .await
+            .map_err(|_| CodexErr::Fatal("Owned turn retirement task failed".to_owned()))?
+    }
+}
+
+impl CodexThread {
+    /// Seal and retire the captured task. This must be called outside that
+    /// task's callbacks: awaiting one's own retirement would join oneself.
+    /// Pending steering is recorded under the original context. An input hook
+    /// already running must settle before cancellation can preserve its batch.
+    pub async fn stop_owned_turn(
+        &self,
+        expected: &Arc<OwnedTurnTask>,
+    ) -> CodexResult<OwnedTurnStop> {
+        self.session.stop_owned_turn(expected).await
+    }
+}
+
+impl Session {
+    pub(crate) async fn stop_owned_turn(
+        self: &Arc<Self>,
+        expected: &Arc<OwnedTurnTask>,
+    ) -> CodexResult<OwnedTurnStop> {
+        let Some((thread_id, turn_id)) = expected.identity.get() else {
+            return Err(CodexErr::Fatal("Unregistered owned turn task".to_owned()));
+        };
+        if thread_id != &self.thread_id.to_string() {
+            return Err(CodexErr::Fatal(
+                "Owned turn belongs to another thread".to_owned(),
+            ));
+        }
+        expected.request_stop();
+        let admission = self
+            .services
+            .thread_extension_data
+            .get_or_init(TaskAdmission::default);
+        let admission = admission.0.clone().lock_owned().await;
+        let captured = {
+            let mut active = self.active_turn.lock().await;
+            active.as_mut().and_then(|turn| {
+                let task = turn.task.as_ref()?;
+                if task.turn_context.sub_id != *turn_id
+                    || !Arc::ptr_eq(task.handle.owner(), expected)
+                {
+                    return None;
+                }
+                expected.request_stop();
+                // Leave the original frame in place. New starts cannot enter
+                // while this task's history and cleanup are still being joined.
+                Some((
+                    turn.task.take().expect("matched task"),
+                    turn.turn_state.clone(),
+                ))
+            })
+        };
+        let session = self.clone();
+        let owner = expected.clone();
+        let retirement = if let Some((task, state)) = captured {
+            tokio::spawn(async move {
+                let result = AssertUnwindSafe(session.finish_owned_turn(task, state, &owner))
+                    .catch_unwind()
+                    .await;
+                // Even a recording/cleanup panic must not release successor
+                // admission until abort-on-drop has physically joined the task.
+                let joined = owner.join().await;
+                drop(admission);
+                match result {
+                    Ok(result) => result.and(joined),
+                    Err(_) => Err(CodexErr::Fatal("Owned turn retirement failed".to_owned())),
+                }
+            })
+        } else {
+            // Normal completion queues follow-up admission outside its task,
+            // after physical completion. Keep successors fenced while joining
+            // even when on_task_finished already detached the original handle.
+            tokio::spawn(async move {
+                let result = owner.join().await;
+                drop(admission);
+                result
+            })
+        };
+        Ok(OwnedTurnStop { retirement })
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct TaskJoin {
+    abort: AbortHandle,
+    joined: JoinedTask,
+}
+
+impl TaskJoin {
+    pub(crate) fn abort(&self) {
+        self.abort.abort();
+    }
+}
+
+impl Future for TaskJoin {
+    type Output = Result<(), Arc<JoinError>>;
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        Pin::new(&mut self.joined).poll(cx)
+    }
+}
+
+/// Preserve the existing abort-on-drop contract while retaining a shareable
+/// *actual JoinHandle* future, including after normal completion detaches it.
+pub(crate) struct TaskHandle {
+    owner: Arc<OwnedTurnTask>,
+    abort_on_drop: bool,
+}
+
+impl TaskHandle {
+    pub(crate) fn new(handle: JoinHandle<()>, owner: Arc<OwnedTurnTask>) -> Self {
+        let abort = handle.abort_handle();
+        let joined = handle
+            .map(|result| result.map_err(Arc::new))
+            .boxed()
+            .shared();
+        assert!(owner.task.set(TaskJoin { abort, joined }).is_ok());
+        Self {
+            owner,
+            abort_on_drop: true,
+        }
+    }
+
+    pub(crate) fn owner(&self) -> &Arc<OwnedTurnTask> {
+        &self.owner
+    }
+
+    pub(crate) fn abort(&self) {
+        self.owner.task.get().expect("registered task").abort();
+    }
+
+    pub(crate) fn detach(mut self) -> TaskJoin {
+        self.abort_on_drop = false;
+        self.owner.task.get().expect("registered task").clone()
+    }
+}
+
+impl Drop for TaskHandle {
+    fn drop(&mut self) {
+        if self.abort_on_drop {
+            self.abort();
+        }
+    }
+}
