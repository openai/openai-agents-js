+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use tokio::sync::Notify;
+use tokio_util::sync::CancellationToken;
+
+use crate::session::owned_turn_stop::OwnedTurnTask;
+use crate::session::session::Session;
+use crate::session::tests::make_session_and_context_with_rx;
+use crate::session::turn_context::TurnContext;
+use crate::state::TaskKind;
+use crate::tasks::SessionTask;
+use crate::tasks::SessionTaskResult;
+
+struct Dropped(Arc<AtomicBool>);
+impl Drop for Dropped {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+
+struct FinishingTask {
+    entered: Arc<Notify>,
+    release: Arc<Notify>,
+    dropped: Arc<AtomicBool>,
+}
+impl SessionTask for FinishingTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.owned_retirement_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _context: Arc<TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        _cancelled: CancellationToken,
+    ) -> SessionTaskResult {
+        let _dropped = Dropped(self.dropped.clone());
+        self.entered.notify_one();
+        self.release.notified().await;
+        Ok(None)
+    }
+}
+
+#[tokio::test]
+async fn detached_finishing_task_keeps_successor_out_until_physical_join() {
+    let (session, context, _events) = make_session_and_context_with_rx().await;
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let dropped = Arc::new(AtomicBool::new(false));
+    session
+        .spawn_task(
+            context.clone(),
+            Vec::new(),
+            FinishingTask {
+                entered: entered.clone(),
+                release: release.clone(),
+                dropped: dropped.clone(),
+            },
+        )
+        .await;
+    entered.notified().await;
+    let original = context.extension_data.get::<OwnedTurnTask>().unwrap();
+    // Reproduce normal completion's taken/detached-handle window while the
+    // original task is still physically running, rather than merely idle.
+    {
+        let mut active = session.active_turn.lock().await;
+        let task = active.as_mut().unwrap().task.take().unwrap();
+        drop(task.handle.detach());
+    }
+    let retirement = session.stop_owned_turn(&original).await.unwrap();
+    let successor_entered = Arc::new(Notify::new());
+    let successor_release = Arc::new(Notify::new());
+    let successor_context = session
+        .new_turn_with_default_settings("successor".to_owned(), Default::default())
+        .await;
+    let successor_receipt_context = successor_context.clone();
+    let attempted = Arc::new(Notify::new());
+    let successor = tokio::spawn({
+        let session = session.clone();
+        let entered = successor_entered.clone();
+        let release = successor_release.clone();
+        let attempted = attempted.clone();
+        async move {
+            attempted.notify_one();
+            session
+                .spawn_task(
+                    successor_context,
+                    Vec::new(),
+                    FinishingTask {
+                        entered,
+                        release,
+                        dropped: Arc::new(AtomicBool::new(false)),
+                    },
+                )
+                .await;
+        }
+    });
+    attempted.notified().await;
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), successor_entered.notified())
+            .await
+            .is_err()
+    );
+    assert!(!dropped.load(Ordering::Acquire));
+    release.notify_one();
+    tokio::time::timeout(Duration::from_secs(2), retirement.join())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(dropped.load(Ordering::Acquire));
+    tokio::time::timeout(Duration::from_secs(2), successor_entered.notified())
+        .await
+        .unwrap();
+    successor_release.notify_one();
+    successor.await.unwrap();
+    successor_receipt_context
+        .extension_data
+        .get::<OwnedTurnTask>()
+        .unwrap()
+        .join()
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn stopped_owner_does_not_poll_an_already_ready_model_request() {
+    let owner = OwnedTurnTask::default();
+    let effects = AtomicUsize::new(0);
+    owner.request_stop();
+    let result = owner
+        .admit_model(async { effects.fetch_add(1, Ordering::Relaxed) })
+        .await;
+    assert!(
+        matches!(result, Err(error) if matches!(error.details(), codex_protocol::error::CodexErrorDetails::TurnAborted))
+    );
+    assert_eq!(effects.load(Ordering::Relaxed), 0);
+}
+
+#[tokio::test]
+async fn model_admission_stays_cancelled_across_pending_request_preparation() {
+    let owner = Arc::new(OwnedTurnTask::default());
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let effects = Arc::new(AtomicUsize::new(0));
+    let request = tokio::spawn({
+        let owner = owner.clone();
+        let entered = entered.clone();
+        let release = release.clone();
+        let effects = effects.clone();
+        async move {
+            owner
+                .admit_model(async {
+                    entered.notify_one();
+                    release.notified().await;
+                    effects.fetch_add(1, Ordering::Relaxed)
+                })
+                .await
+        }
+    });
+    entered.notified().await;
+    owner.request_stop();
+    release.notify_one();
+    let error = request.await.unwrap().unwrap_err();
+    assert!(matches!(
+        error.details(),
+        codex_protocol::error::CodexErrorDetails::TurnAborted
+    ));
+    assert_eq!(effects.load(Ordering::Relaxed), 0);
+}
