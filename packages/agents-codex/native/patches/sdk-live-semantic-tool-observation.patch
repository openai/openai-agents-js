+/// Publish the live view of an accepted response item after canonical history owns it.
+pub(crate) async fn publish_semantic_tool_item(
+    sess: &Session,
+    turn_context: &TurnContext,
+    item: &ResponseItem,
+) -> Result<()> {
+    if !matches!(
+            item,
+            ResponseItem::ToolSearchCall { .. }
+                | ResponseItem::ToolSearchOutput { .. }
+        )
+    {
+        return Ok(());
+    }
+    sess.ensure_rollout_durable().await?;
+    let turn_id = turn_context.sub_id.clone();
+    sess.deliver_event_raw(Event {
+        id: turn_id.clone(),
+        msg: EventMsg::SdkSemanticToolItem(ItemCompletedEvent {
+            thread_id: sess.thread_id,
+            turn_id,
+            item: TurnItem::HostedToolCall(HostedToolCallItem {
+                id: uuid::Uuid::new_v4().to_string(),
+                item: item.clone(),
+            }),
+            started_at_ms: None,
+            completed_at_ms: now_unix_timestamp_ms(),
+        }),
+    })
+    .await;
+    Ok(())
+}
