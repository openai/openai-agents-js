diff --git a/codex-rs/ext/extension-api/src/tool_not_found.rs b/codex-rs/ext/extension-api/src/tool_not_found.rs
index ccfa57ced4c1ab2477939d1959e0de1c35e2ce47..d9c15eabd548d2ce645324644c9d736202b0508b 100644
--- a/codex-rs/ext/extension-api/src/tool_not_found.rs
+++ b/codex-rs/ext/extension-api/src/tool_not_found.rs
@@ -1,3 +1,5 @@
+use codex_history::RolloutItem;
+
 /// Unknown direct function-call handling for one admitted operation.
 /// Supply through that operation's turn ExtensionDataInit. Absence preserves
 /// model-visible recovery; this policy does not change known-tool admission.
@@ -7,3 +9,29 @@ pub enum ToolNotFoundBehavior {
     ReturnErrorToModel,
     RaiseError,
 }
+
+impl ToolNotFoundBehavior {
+    pub const RECEIPT_KEY: &'static str = "tool_not_found_behavior";
+    pub const STRICT_RECEIPT_VALUE: &'static str = "raise_error";
+
+    /// Recover the operation choice from the same turn's native sampling history.
+    /// Older receipts omit this setting and keep the default behavior.
+    pub fn from_turn_history(
+        history: &[RolloutItem],
+        turn_id: &str,
+    ) -> Result<Option<Self>, &'static str> {
+        let marker = history.iter().rev().find_map(|item| match item {
+            RolloutItem::TurnContext(context) if context.turn_id.as_deref() == Some(turn_id) => {
+                context.sdk_receipt.as_ref()?.get(Self::RECEIPT_KEY)
+            }
+            _ => None,
+        });
+        match marker {
+            None => Ok(None),
+            Some(marker) if marker.as_str() == Some(Self::STRICT_RECEIPT_VALUE) => {
+                Ok(Some(Self::RaiseError))
+            }
+            Some(_) => Err("Invalid native tool-not-found behavior receipt"),
+        }
+    }
+}
