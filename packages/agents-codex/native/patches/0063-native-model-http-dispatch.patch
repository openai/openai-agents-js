+/// Trusted in-process HTTP stream dispatch. The endpoint session still prepares,
+/// authenticates, observes and retries the request through HttpTransport.
+/// A selected dispatcher owns the route: failures must never fall back to I/O.
+pub type ModelHttpStream = Arc<
+    dyn Fn(
+            codex_client::Request,
+        )
+            -> BoxFuture<'static, Result<codex_client::StreamResponse, codex_client::TransportError>>
+        + Send
+        + Sync,
+>;
+
 /// Contributes request-scoped preparation and response interception.
 /// Return None for requests this host does not manage.
 pub trait ModelRequestContributor: Send + Sync + std::fmt::Debug {
+    /// Select solely from the provider endpoint before physical-client creation.
+    /// Declining must not mutate request admission or execute application code.
+    /// The returned dispatcher must revalidate the exact authenticated request.
+    fn http_stream(&self, _url: &str) -> Option<ModelHttpStream> {
+        None
+    }
