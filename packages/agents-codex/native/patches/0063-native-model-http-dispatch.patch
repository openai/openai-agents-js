+
+// Keep EndpointSession's existing HttpTransport boundary. Only a trusted
+// contributor can claim streaming; execute always uses physical transport.
+struct ModelResponsesTransport<F> {
+    direct: Option<codex_extension_api::ModelHttpStream>,
+    fallback: F,
+    defaults: ApiHeaderMap,
+}
+
+impl<F> codex_client::HttpTransport for ModelResponsesTransport<F>
+where
+    F: Fn() -> std::result::Result<ReqwestTransport, codex_client::TransportError> + Send + Sync,
+{
+    async fn execute(
+        &self,
+        req: codex_client::Request,
+    ) -> std::result::Result<codex_client::Response, codex_client::TransportError> {
+        codex_client::HttpTransport::execute(&(self.fallback)()?, req).await
+    }
+
+    async fn stream(
+        &self,
+        mut req: codex_client::Request,
+    ) -> std::result::Result<codex_client::StreamResponse, codex_client::TransportError> {
+        if let Some(direct) = &self.direct {
+            // Match the physical client's merge: explicit/auth/trace headers win,
+            // including all values of a repeated header. Preserve the same snapshot.
+            for name in self.defaults.keys() {
+                if !req.headers.contains_key(name) {
+                    for value in self.defaults.get_all(name) {
+                        req.headers.append(name, value.clone());
+                    }
+                }
+            }
+            direct(req).await
+        } else {
+            codex_client::HttpTransport::stream(&(self.fallback)()?, req).await
+        }
+    }
 }

