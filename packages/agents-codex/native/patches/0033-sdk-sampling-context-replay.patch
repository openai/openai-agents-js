+// A sampling record copies the frozen context for a turn whose canonical context
+// was already written. Live sampling may change summary, realtime, or the
+// effective settings inside the receipt. Those observations are not baselines.
+fn sdk_sampling_context_indexes(replay_items: &[RolloutItem]) -> HashSet<usize> {
+    let mut observations = HashSet::new();
+    let mut baseline: Option<&TurnContextItem> = None;
+    for (index, item) in replay_items.iter().enumerate() {
+        match item {
+            RolloutItem::TurnContext(context) => {
+                if baseline.is_some_and(|baseline| is_sdk_sampling_context(context, baseline)) {
+                    observations.insert(index);
+                } else {
+                    baseline = Some(context);
+                }
+            }
+            RolloutItem::Compacted(_)
+            | RolloutItem::EventMsg(
+                EventMsg::TurnStarted(_) | EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_),
+            ) => baseline = None,
+            _ => {}
+        }
+    }
+    observations
+}
+
+fn is_sdk_sampling_context(context: &TurnContextItem, baseline: &TurnContextItem) -> bool {
+    let Some(receipt) = context.sdk_receipt.as_ref() else {
+        return false;
+    };
+    if context.turn_id.is_none()
+        || context.turn_id != baseline.turn_id
+        || receipt.get("version").and_then(serde_json::Value::as_u64) != Some(1)
+        || !receipt
+            .get("thread_id")
+            .and_then(serde_json::Value::as_str)
+            .is_some_and(|id| ThreadId::from_string(id).is_ok())
+        || !receipt
+            .get("model")
+            .and_then(serde_json::Value::as_str)
+            .is_some_and(|model| !model.is_empty())
+        || !receipt
+            .get("approval_policy")
+            .is_some_and(|policy| AskForApproval::deserialize(policy).is_ok())
+    {
+        return false;
+    }
+    let mut baseline = baseline.clone();
+    baseline.sdk_receipt.clone_from(&context.sdk_receipt);
+    baseline.realtime_active = context.realtime_active;
+    baseline.summary = context.summary;
+    &baseline == context
+}
