+#[tokio::test]
+async fn sdk_sampling_metadata_cannot_discard_the_durable_turn_context() {
+    let (session, turn_context) = make_session_and_context().await;
+    let canonical = turn_context.to_turn_context_item();
+    let turn_id = canonical.turn_id.clone().expect("native turn id");
+    let receipt = json!({
+        "version": 1,
+        "thread_id": ThreadId::new(),
+        "model": "step-model",
+        "reasoning_effort": null,
+        "instruction_revision": null,
+        "developer_instructions_sha256": null,
+        "instruction_files": [],
+        "user_config_applied": false,
+        "codex_revision": "a".repeat(40),
+        "codex_source_tree": "b".repeat(40),
+        "approval_policy": "never",
+        "executors": null,
+    });
+
+    for (attached, include_sample) in [
+        (Some(json!({"invalid": true})), false),
+        (Some(receipt.clone()), false),
+        (None, true),
+    ] {
+        let mut restored_context = canonical.clone();
+        restored_context.sdk_receipt = attached;
+        let mut rollout = vec![
+            RolloutItem::EventMsg(EventMsg::TurnStarted(
+                codex_protocol::protocol::TurnStartedEvent {
+                    turn_id: turn_id.clone(),
+                    root_turn_id: None,
+                    trace_id: None,
+                    started_at: None,
+                    model_context_window: Some(128_000),
+                    collaboration_mode_kind: ModeKind::Default,
+                },
+            )),
+            RolloutItem::EventMsg(EventMsg::UserMessage(
+                codex_protocol::protocol::UserMessageEvent {
+                    message: "seed".to_string(),
+                    ..Default::default()
+                },
+            )),
+            RolloutItem::TurnContext(restored_context),
+        ];
+        if include_sample {
+            let mut sampled = canonical.clone();
+            sampled.sdk_receipt = Some(receipt.clone());
+            sampled.realtime_active = Some(!turn_context.realtime_active);
+            rollout.push(RolloutItem::TurnContext(sampled));
+        }
+        let restored = session
+            .reconstruct_history_from_rollout(&turn_context, &rollout)
+            .await;
+        assert_eq!(restored.reference_context_item.as_ref(), Some(&canonical));
+        assert_eq!(
+            restored
+                .previous_turn_settings
+                .as_ref()
+                .map(|settings| settings.model.as_str()),
+            Some(canonical.model.as_str())
+        );
+    }
+}
