+
+#[test]
+fn bundled_catalog_matches_source_and_returns_independent_values() {
+    let expected: ModelsResponse = serde_json::from_str(include_str!("../models.json"))
+        .expect("bundled models.json should parse");
+    let mut response = crate::bundled_models_response().expect("bundled catalog should load");
+    assert_eq!(response, expected);
+
+    response.models.clear();
+    assert_eq!(
+        crate::bundled_models_response().expect("bundled catalog should remain available"),
+        expected
+    );
+}
+
+#[test]
+fn bundled_catalog_returns_independent_values_to_concurrent_callers() {
+    let expected: ModelsResponse = serde_json::from_str(include_str!("../models.json"))
+        .expect("bundled models.json should parse");
+    let barrier = std::sync::Barrier::new(8);
+    std::thread::scope(|scope| {
+        let workers = (0..8)
+            .map(|_| {
+                scope.spawn(|| {
+                    barrier.wait();
+                    let mut response =
+                        crate::bundled_models_response().expect("bundled catalog should load");
+                    assert_eq!(response, expected);
+                    response.models.clear();
+                })
+            })
+            .collect::<Vec<_>>();
+        for worker in workers {
+            worker.join().expect("catalog reader should finish");
+        }
+    });
+    assert_eq!(
+        crate::bundled_models_response().expect("bundled catalog should remain available"),
+        expected
+    );
+}
