+    pub(crate) fn model_client_for_profile(
+        &self,
+        profile: Option<&codex_extension_api::CapturedAgentProfile>,
+    ) -> crate::client::ModelClient {
+        struct ProfileClients(std::sync::Mutex<HashMap<Arc<str>, crate::client::ModelClient>>);
+
+        let root = &self.services.model_client;
+        let provider = profile.and_then(|profile| {
+            profile.profile.data.get::<crate::client::SdkAgentProfileProvider>()
+        });
+        let Some(provider) = provider else { return root.clone(); };
+        let clients = self.services.thread_extension_data.get_or_init(|| {
+            ProfileClients(std::sync::Mutex::new(HashMap::new()))
+        });
+        clients.0.lock().expect("profile model clients poisoned")
+            .entry(Arc::clone(&provider.id))
+            .or_insert_with(|| root.for_sdk_profile(&provider))
+            .clone()
+    }
