+/// SDK originals omit the instruction receipts validated by the SDK admission paths.
+/// Unknown, mixed, or caller-authored developer content remains visible in originals.
+pub(crate) fn is_sdk_original_item(
+    item: &ResponseItem,
+    metadata: Option<&CodexHarnessMetadata>,
+) -> bool {
+    if let ResponseItem::Message {
+        role,
+        content,
+        internal_chat_message_metadata_passthrough: Some(message_metadata),
+        ..
+    } = item
+        && role == "developer"
+        && !metadata.is_some_and(|metadata| metadata.client_authored)
+        && message_metadata
+            .content_item_kinds
+            .as_ref()
+            .is_some_and(|kinds| {
+                !kinds.is_empty()
+                    && kinds.len() == content.len()
+                    && kinds.iter().all(|kind| {
+                        matches!(
+                            kind.0.as_str(),
+                            "sdk_application.accepted" | "sdk_application.instructions"
+                        )
+                    })
+            })
+    {
+        return false;
+    }
+    is_api_message(item, metadata)
+}
