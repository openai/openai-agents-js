@@ -600,3 +600,80 @@ async fn concurrent_turns_keep_distinct_worktree_and_repository_metadata() -> Re
     server.shutdown().await;
     Ok(())
 }
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn thread_started_metric_uses_thread_local_client_for_repository_tags() -> Result<()> {
+    use codex_otel::MetricsClient;
+    use codex_otel::MetricsConfig;
+    use codex_otel::THREAD_STARTED_METRIC;
+    use opentelemetry_sdk::metrics::InMemoryMetricExporter;
+    use opentelemetry_sdk::metrics::data::AggregatedMetrics;
+    use opentelemetry_sdk::metrics::data::MetricData;
+    use std::collections::BTreeMap;
+
+    skip_if_no_network!(Ok(()));
+
+    let (repo, _head) = create_git_repo()?;
+    let metrics = MetricsClient::new(
+        MetricsConfig::in_memory(
+            "test",
+            "codex-core",
+            env!("CARGO_PKG_VERSION"),
+            InMemoryMetricExporter::default(),
+        )
+        .with_runtime_reader(),
+    )?;
+    let server = core_test_support::responses::start_mock_server().await;
+    let cwd = repo.path().to_path_buf();
+    let fixture = test_codex()
+        .with_config(move |config| config.cwd = cwd.abs())
+        .build(&server)
+        .await?;
+    let mut options = StartThreadOptions::new(fixture.config.clone());
+    options.thread_extension_init.insert(metrics.clone());
+    let started = fixture.thread_manager.start_thread(options).await;
+    let snapshot = started
+        .as_ref()
+        .ok()
+        .map(|started| started.thread.session_telemetry().snapshot_metrics());
+
+    // Attempt every close before propagating a startup or snapshot failure.
+    let started_shutdown = match &started {
+        Ok(started) => Some(started.thread.shutdown_and_wait().await),
+        Err(_) => None,
+    };
+    let fixture_shutdown = fixture.codex.shutdown_and_wait().await;
+    let metrics_shutdown = metrics.shutdown();
+    drop(started?);
+    if let Some(shutdown) = started_shutdown {
+        shutdown?;
+    }
+    fixture_shutdown?;
+    metrics_shutdown?;
+
+    let snapshot = snapshot.context("started thread must provide a metrics snapshot")??;
+    let metric = snapshot
+        .scope_metrics()
+        .flat_map(opentelemetry_sdk::metrics::data::ScopeMetrics::metrics)
+        .find(|metric| metric.name() == THREAD_STARTED_METRIC)
+        .context("thread-start counter must reach the attached client")?;
+    let AggregatedMetrics::U64(MetricData::Sum(sum)) = metric.data() else {
+        panic!("expected u64 thread-start counter");
+    };
+    let points = sum.data_points().collect::<Vec<_>>();
+    assert_eq!(points.len(), 1);
+    assert_eq!(points[0].value(), 1);
+    let tags = points[0]
+        .attributes()
+        .filter(|attribute| matches!(attribute.key.as_str(), "is_git" | "is_worktree"))
+        .map(|attribute| (attribute.key.to_string(), attribute.value.to_string()))
+        .collect::<BTreeMap<_, _>>();
+    assert_eq!(
+        tags,
+        BTreeMap::from([
+            ("is_git".to_owned(), "true".to_owned()),
+            ("is_worktree".to_owned(), "false".to_owned()),
+        ]),
+    );
+    Ok(())
+}
