+// Only provider polling borrows the model-response ancestry. Function and
+// approval callbacks retain the existing operation context.
+async fn poll_provider_response<F: std::future::Future>(
+    future: F,
+    span: Option<&codex_otel::sdk_trace::ProviderResponseSpan>,
+) -> F::Output {
+    use codex_otel::sdk_trace::FutureExt as _;
+    match span {
+        Some(span) => future.with_context(span.context()).await,
+        None => future.await,
+    }
+}
+
+// One SDK scope owns all attempts in this logical model round. Generic Core
+// turns and disabled/unowned contexts never ask a host for an identifier.
+async fn admit_sdk_provider_response_span(
+    sess: &Session,
+    step: &Arc<StepContext>,
+    cancellation: CancellationToken,
+) -> CodexResult<Option<codex_otel::sdk_trace::ProviderResponseSpan>> {
+    if step
+        .extension_data
+        .get::<codex_extension_api::SdkTurnReceiptSeed>()
+        .is_none()
+        || codex_otel::sdk_trace::current_scope_policy().is_none_or(|policy| policy.disabled)
+    {
+        return Ok(None);
+    }
+    let Some(parent) = codex_otel::sdk_trace::ContextLease::capture() else {
+        return Ok(None);
+    };
+    let admission = crate::model_request::tool_admission_for_step(
+        sess.thread_id.to_string(),
+        step.clone(),
+        Vec::new(),
+    );
+    let mut selected = None;
+    for contributor in sess.services.extensions.model_request_contributors() {
+        if cancellation.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        let reply = contributor
+            .admit_provider_response_span(codex_extension_api::SdkProviderResponseSpanInput {
+                admission: admission.clone(),
+                parent_context: parent.token().to_owned(),
+                cancellation: cancellation.clone(),
+            })
+            .await
+            .map_err(CodexErr::Fatal)?;
+        if let Some(reply) = reply {
+            if selected.replace(reply).is_some() {
+                return Err(CodexErr::Fatal(
+                    "Multiple SDK response span admissions".into(),
+                ));
+            }
+        }
+    }
+    if cancellation.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+    selected
+        .map(|reply| {
+            codex_otel::sdk_trace::start_provider_response_span(&parent, reply.span_id)
+                .map_err(CodexErr::Fatal)
+        })
+        .transpose()
+}
