+        let historical = original.snapshot();
+        let restored = Arc::new(AttemptLedger::default());
+        let current = begin(&restored, &parent);
+        current
+            .report_usage(TokenUsage {
+                total_tokens: 3,
+                ..Default::default()
+            })
+            .unwrap();
+        let fresh_projection = restored.snapshot();
+        assert!(restored.settle(&old).is_err());
+        original.settle(&old).unwrap();
+        assert_eq!(original.snapshot(), historical);
+        assert_eq!(restored.snapshot(), fresh_projection);
+        restored.settle(&current).unwrap();
+        assert_eq!(
+            historical.usage.requests + restored.snapshot().usage.requests,
+            2
+        );
+        assert_eq!(
+            historical.usage.token_usage.total_tokens
