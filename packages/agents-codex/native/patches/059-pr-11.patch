+                    || kind.starts_with("response.image_generation_call.")
+                    || kind.starts_with("response.mcp_call.")
+                    || kind.starts_with("response.shell_call.")
+                    || kind.starts_with("response.shell_call_command.")
+                    || kind.starts_with("response.shell_call_output_content.")
