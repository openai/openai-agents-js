+        let first = begin(&ledger, &parent);
+        ledger.settle(&first).unwrap();
+        ledger.terminal(&first).unwrap();
+        let snapshot = ledger.snapshot();
+        assert_eq!(snapshot.usage.requests_without_token_usage, 1);
+        // The detached snapshot belongs only to the host historical offset.
+        // Fresh runtime attachment data cannot contain the old held attempt.
+        let restored = Arc::new(AttemptLedger::default());
+        let retry = begin(&restored, &parent);
+        assert_eq!(retry.attempt(), 1);
+        assert_eq!(restored.snapshot().usage.requests, 1);
+        assert_ne!(first.id(), retry.id());
+        assert_ne!(
+            snapshot.owner_attempt_id,
+            restored.snapshot().owner_attempt_id
+        );
+        assert!(restored.snapshot().terminal_attempt_id.is_none());
+    }
+
+    #[test]
+    fn held_measured_attempt_settles_only_into_its_original_owner() {
