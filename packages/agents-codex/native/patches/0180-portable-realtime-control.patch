+//! Target-neutral Realtime control. Hosts execute effects; they never admit calls.
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, BTreeSet};
+
+const MAX_FRAME_BYTES: usize = 8 * 1024 * 1024;
+const MAX_CALL_BYTES: usize = 256 * 1024;
+const MAX_CALLS: usize = 256;
+
+/// A single-use execution claim shared with the server Core tool lifecycle.
+#[derive(Debug, Default)]
+pub struct CallClaim(bool);
+impl From<bool> for CallClaim {
+    fn from(value: bool) -> Self {
+        Self(value)
+    }
+}
+impl CallClaim {
+    pub fn is_claimed(&self) -> bool {
+        self.0
+    }
+    pub fn claim(&mut self) -> bool {
+        if self.0 {
+            return false;
+        }
+        self.0 = true;
+        true
+    }
+    pub fn release(&mut self) {
+        self.0 = false;
+    }
+}
+
+/// Shared response admission state. Physical sends stay in each host driver.
+#[derive(Debug)]
+pub enum CreateIntent<T> {
+    Default,
+    Native(T),
+    Guardrail(String),
+}
+pub struct ResponseCreateState<T> {
+    pub sdk_response_id: Option<String>,
+    pub sdk_cancelled_response: Option<String>,
+    pub active_default_response: bool,
+    pub pending_create: bool,
+    pub pending_user_create: bool,
+    pub pending_native_create: Option<T>,
+    pub pending_guardrail_response: Option<String>,
+}
+impl<T> Default for ResponseCreateState<T> {
+    fn default() -> Self {
+        Self {
+            sdk_response_id: None,
+            sdk_cancelled_response: None,
+            active_default_response: false,
+            pending_create: false,
+            pending_user_create: false,
+            pending_native_create: None,
+            pending_guardrail_response: None,
+        }
+    }
+}
+impl<T> ResponseCreateState<T> {
+    /// True authorizes one immediate physical send; false coalesces the intent.
+    pub fn request_create(&mut self) -> bool {
+        self.pending_guardrail_response = None;
+        if self.active_default_response {
+            self.pending_create = true;
+            return false;
+        }
+        self.pending_create = false;
+        self.pending_user_create = false;
+        self.pending_native_create = None;
+        true
+    }
+    pub fn mark_started(&mut self) {
+        self.active_default_response = true;
+    }
+    /// Consume exactly one deferred continuation after the active response ends.
+    pub fn mark_finished(&mut self) -> Option<CreateIntent<T>> {
+        self.active_default_response = false;
+        if !self.pending_create {
+            return None;
+        }
+        self.pending_create = false;
+        let explicit = std::mem::take(&mut self.pending_user_create);
+        let native = self.pending_native_create.take();
+        if !explicit && let Some(native) = native {
+            return Some(CreateIntent::Native(native));
+        }
+        if let Some(id) = self.pending_guardrail_response.take() {
+            return Some(CreateIntent::Guardrail(id));
+        }
+        Some(CreateIntent::Default)
+    }
+    /// A provider active-response error is a deferral, never a replay.
+    pub fn raced_active_response(&mut self) {
+        self.active_default_response = true;
+        self.pending_create = true;
+    }
+}
+
+/// Provider identity excludes response_id: that identity can arrive after arguments.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct FunctionCall {
+    pub namespace: Option<String>,
+    pub call_id: String,
+    pub item_id: String,
+    pub name: String,
+    pub arguments: String,
+    pub response_id: Option<String>,
+}
+impl FunctionCall {
+    pub fn fingerprint(&self) -> Result<[u8; 32], String> {
+        if self.namespace.is_some() {
+            return Err("Namespaced Realtime functions are not supported".into());
+        }
+        if serde_json::to_vec(self)
+            .map_err(|_| "Invalid function request")?
+            .len()
+            > MAX_CALL_BYTES
+        {
+            return Err("SDK Realtime function request exceeds capacity".into());
+        }
+        Ok(Sha256::digest(
+            serde_json::to_vec(&(
+                &self.namespace,
+                &self.call_id,
+                &self.item_id,
+                &self.name,
+                &self.arguments,
+            ))
+            .map_err(|_| "Invalid function request")?,
+        )
+        .into())
+    }
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Tool {
+    pub name: String,
+    pub description: String,
+    pub parameters: Value,
+    #[serde(default)]
+    pub needs_approval: bool,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Config {
+    pub model: String,
+    pub instructions: String,
+    #[serde(default)]
+    pub tools: Vec<Tool>,
+}
+#[derive(Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Command {
+    Start { config: Config },
+    Provider { event: Value },
+    Approve { call_id: String, approved: bool },
+    ToolResult { call_id: String, output: String },
+    Sent { id: u64 },
+    Text { text: String },
+    Close,
+}
+#[derive(Debug, Serialize, PartialEq)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum Effect {
+    Send {
+        id: u64,
+        event: Value,
+    },
+    Approve {
+        call_id: String,
+        name: String,
+        arguments: Value,
+    },
+    Execute {
+        call_id: String,
+        name: String,
+        arguments: Value,
+    },
+    Event {
+        event: Value,
+    },
+    Ready,
+    Closed,
+}
+#[derive(Clone, Copy, PartialEq)]
+enum Phase {
+    New,
+    Configuring,
+    Ready,
+    Closed,
+}
+#[derive(Clone, Copy, PartialEq)]
+enum CallPhase {
+    Discovered,
+    Approval,
+    Executing,
+    Publishing(u64),
+    Published,
+}
+struct Call {
+    request: FunctionCall,
+    fingerprint: [u8; 32],
+    phase: CallPhase,
+    claim: CallClaim,
+}
+struct Batch {
+    calls: Vec<String>,
+    continued: bool,
+}
+/// All mutation is synchronous and serialized by the host's Wasm instance.
+/// No OS, executor, socket, callback, filesystem, or ambient credential access.
+pub struct Control {
+    phase: Phase,
+    tools: BTreeMap<String, Tool>,
+    calls: BTreeMap<String, Call>,
+    batches: BTreeMap<String, Batch>,
+    responses: ResponseCreateState<()>,
+    next_send: u64,
+    pending_send: BTreeSet<u64>,
+    startup_send: Option<u64>,
+    startup_sent: bool,
+    startup_accepted: bool,
+}
+impl Default for Control {
+    fn default() -> Self {
+        Self {
+            phase: Phase::New,
+            tools: BTreeMap::new(),
+            calls: BTreeMap::new(),
+            batches: BTreeMap::new(),
+            responses: ResponseCreateState::default(),
+            next_send: 0,
+            pending_send: BTreeSet::new(),
+            startup_send: None,
+            startup_sent: false,
+            startup_accepted: false,
+        }
+    }
+}
+impl Control {
+    fn send(&mut self, event: Value, effects: &mut Vec<Effect>) -> u64 {
+        self.next_send += 1;
+        self.pending_send.insert(self.next_send);
+        effects.push(Effect::Send {
+            id: self.next_send,
+            event,
+        });
+        self.next_send
+    }
+    pub fn apply(&mut self, command: Command) -> Result<Vec<Effect>, String> {
+        if self.phase == Phase::Closed {
+            return if matches!(command, Command::Close) {
+                Ok(vec![])
+            } else {
+                Err("Realtime control is closed".into())
+            };
+        }
+        let mut effects = vec![];
+        match command {
+            Command::Start { config } => {
+                if self.phase != Phase::New {
+                    return Err("Realtime control already started".into());
+                }
+                if config.model.is_empty() || config.tools.len() > MAX_CALLS {
+                    return Err("Invalid Realtime configuration".into());
+                }
+                let mut tools = BTreeMap::new();
+                let mut wire_tools = vec![];
+                for tool in config.tools {
+                    if tool.name.is_empty()
+                        || !tool.parameters.is_object()
+                        || tools.contains_key(&tool.name)
+                    {
+                        return Err("Invalid or duplicate Realtime tool".into());
+                    }
+                    wire_tools.push(json!({"type":"function","name":tool.name,"description":tool.description,"parameters":tool.parameters}));
+                    tools.insert(tool.name.clone(), tool);
+                }
+                self.tools = tools;
+                self.phase = Phase::Configuring;
+                self.startup_send = Some(self.send(json!({"type":"session.update","session":{"type":"realtime","model":config.model,"instructions":config.instructions,"tools":wire_tools,"tool_choice":"auto"}}), &mut effects));
+            }
+            Command::Sent { id } => {
+                if !self.pending_send.remove(&id) {
+                    return Err("Unknown or already settled send receipt".into());
+                }
+                if self.startup_send == Some(id) {
+                    self.startup_sent = true;
+                }
+                for call in self.calls.values_mut() {
+                    if call.phase == CallPhase::Publishing(id) {
+                        call.phase = CallPhase::Published;
+                    }
+                }
+                self.continue_batches(&mut effects);
+            }
+            Command::Provider { event } => self.provider(event, &mut effects)?,
+            Command::Approve { call_id, approved } => {
+                self.require_ready()?;
+                let call = self.calls.get_mut(&call_id).ok_or("Unknown approval")?;
+                if call.phase != CallPhase::Approval {
+                    return Err("Approval is stale or already settled".into());
+                }
+                if approved {
+                    call.phase = CallPhase::Executing;
+                    effects.push(execute(&call.request)?);
+                } else {
+                    self.publish(
+                        &call_id,
+                        "Tool execution was not approved.".into(),
+                        &mut effects,
+                    )?;
+                }
+            }
+            Command::ToolResult { call_id, output } => {
+                self.require_ready()?;
+                if self
+                    .calls
+                    .get(&call_id)
+                    .is_none_or(|call| call.phase != CallPhase::Executing)
+                {
+                    return Err("Tool result has no live execution claim".into());
+                }
+                self.publish(&call_id, output, &mut effects)?;
+            }
+            Command::Text { text } => {
+                self.require_ready()?;
+                self.send(json!({"type":"conversation.item.create","item":{"type":"message","role":"user","content":[{"type":"input_text","text":text}]}}), &mut effects);
+                if self.responses.request_create() {
+                    self.responses.mark_started();
+                    self.send(json!({"type":"response.create"}), &mut effects);
+                }
+            }
+            Command::Close => {
+                self.phase = Phase::Closed;
+                self.calls.clear();
+                self.batches.clear();
+                self.pending_send.clear();
+                effects.push(Effect::Closed);
+            }
+        }
+        if self.phase == Phase::Configuring && self.startup_sent && self.startup_accepted {
+            self.phase = Phase::Ready;
+            effects.push(Effect::Ready);
+        }
+        Ok(effects)
+    }
+    fn require_ready(&self) -> Result<(), String> {
+        if self.phase != Phase::Ready {
+            Err("Realtime configuration is not accepted".into())
+        } else {
+            Ok(())
+        }
+    }
+    fn provider(&mut self, event: Value, effects: &mut Vec<Effect>) -> Result<(), String> {
+        if serde_json::to_vec(&event)
+            .map_err(|_| "Invalid provider event")?
+            .len()
+            > MAX_FRAME_BYTES
+        {
+            return Err("Provider event exceeds capacity".into());
+        }
+        let kind = event
+            .get("type")
+            .and_then(Value::as_str)
+            .ok_or("Provider event has no type")?;
+        match kind {
+            "session.updated" => {
+                if self.phase == Phase::Configuring || self.phase == Phase::Ready {
+                    let session = event
+                        .get("session")
+                        .ok_or("Invalid accepted configuration")?;
+                    let advertised = session
+                        .get("tools")
+                        .and_then(Value::as_array)
+                        .ok_or("Accepted configuration omitted tools")?;
+                    if advertised.len() != self.tools.len()
+                        || advertised.iter().any(|tool| {
+                            tool.get("type").and_then(Value::as_str) != Some("function")
+                                || tool.get("name").and_then(Value::as_str).is_none_or(|name| {
+                                    self.tools.get(name).is_none_or(|declared| {
+                                        tool.get("parameters") != Some(&declared.parameters)
+                                    })
+                                })
+                        })
+                    {
+                        return Err("Provider accepted another tool configuration".into());
+                    }
+                    self.startup_accepted = true;
+                }
+            }
+            "response.created" => {
+                self.require_ready()?;
+                let id = string(&event["response"], "id")?;
+                if self
+                    .responses
+                    .sdk_response_id
+                    .as_ref()
+                    .is_some_and(|active| active != &id)
+                {
+                    return Err("Concurrent default responses are not supported".into());
+                }
+                self.responses.sdk_response_id = Some(id);
+                self.responses.mark_started();
+            }
+            "response.output_item.done" => {
+                self.require_ready()?;
+                let item = event.get("item").ok_or("Provider item is missing")?;
+                if item.get("type").and_then(Value::as_str) == Some("function_call") {
+                    self.discover(FunctionCall {
+                        namespace: item
+                            .get("namespace")
+                            .and_then(Value::as_str)
+                            .map(str::to_owned),
+                        call_id: string(item, "call_id")?,
+                        item_id: string(item, "id")?,
+                        name: string(item, "name")?,
+                        arguments: string(item, "arguments")?,
+                        response_id: Some(string(&event, "response_id")?),
+                    })?;
+                }
+            }
+            "response.done" => {
+                self.require_ready()?;
+                let response = event.get("response").ok_or("Missing response")?;
+                let id = string(response, "id")?;
+                if self.responses.sdk_response_id.as_ref() != Some(&id) {
+                    return Err("Completed response does not own the active response".into());
+                }
+                let output = response
+                    .get("output")
+                    .and_then(Value::as_array)
+                    .ok_or("Missing response output")?;
+                let mut ids = vec![];
+                for item in output {
+                    if item.get("type").and_then(Value::as_str) == Some("function_call") {
+                        let request = FunctionCall {
+                            namespace: item
+                                .get("namespace")
+                                .and_then(Value::as_str)
+                                .map(str::to_owned),
+                            call_id: string(item, "call_id")?,
+                            item_id: string(item, "id")?,
+                            name: string(item, "name")?,
+                            arguments: string(item, "arguments")?,
+                            response_id: Some(id.clone()),
+                        };
+                        if ids.contains(&request.call_id) {
+                            return Err("Duplicate function in completed response".into());
+                        }
+                        ids.push(request.call_id.clone());
+                        self.discover(request)?;
+                    }
+                }
+                if self.calls.values().any(|call| {
+                    call.request.response_id.as_ref() == Some(&id)
+                        && !ids.contains(&call.request.call_id)
+                }) {
+                    return Err("Completed response omitted a discovered function".into());
+                }
+                self.responses.sdk_response_id = None;
+                if self.responses.mark_finished().is_some() {
+                    self.responses.mark_started();
+                    self.send(json!({"type":"response.create"}), effects);
+                }
+                if !ids.is_empty() {
+                    if self.batches.contains_key(&id) {
+                        return Err("Response batch already admitted".into());
+                    }
+                    self.batches.insert(
+                        id,
+                        Batch {
+                            calls: ids.clone(),
+                            continued: false,
+                        },
+                    );
+                    for call_id in ids {
+                        let call = self.calls.get_mut(&call_id).ok_or("Missing function")?;
+                        if !call.claim.claim() {
+                            return Err("Function already admitted".into());
+                        }
+                        let tool = self
+                            .tools
+                            .get(&call.request.name)
+                            .ok_or("Function is outside accepted configuration")?;
+                        if tool.needs_approval {
+                            call.phase = CallPhase::Approval;
+                            effects.push(Effect::Approve {
+                                call_id,
+                                name: call.request.name.clone(),
+                                arguments: arguments(&call.request)?,
+                            });
+                        } else {
+                            call.phase = CallPhase::Executing;
+                            effects.push(execute(&call.request)?);
+                        }
+                    }
+                }
+            }
+            "error" => return Err("Realtime provider rejected the operation".into()),
+            _ => {}
+        }
+        effects.push(Effect::Event { event });
+        Ok(())
+    }
+    fn discover(&mut self, request: FunctionCall) -> Result<(), String> {
+        let fingerprint = request.fingerprint()?;
+        if !self.tools.contains_key(&request.name) {
+            return Err("Function is outside accepted configuration".into());
+        }
+        arguments(&request)?;
+        if let Some(old) = self.calls.get(&request.call_id) {
+            if old.fingerprint != fingerprint || old.request.response_id != request.response_id {
+                return Err("Realtime function identity changed".into());
+            }
+            return Ok(());
+        }
+        if self.calls.len() == MAX_CALLS {
+            return Err("SDK Realtime function capacity exceeded".into());
+        }
+        self.calls.insert(
+            request.call_id.clone(),
+            Call {
+                request,
+                fingerprint,
+                phase: CallPhase::Discovered,
+                claim: CallClaim::default(),
+            },
+        );
+        Ok(())
+    }
+    fn publish(
+        &mut self,
+        call_id: &str,
+        output: String,
+        effects: &mut Vec<Effect>,
+    ) -> Result<(), String> {
+        if output.len() > MAX_CALL_BYTES {
+            return Err("Tool output exceeds capacity".into());
+        }
+        let id = self.send(json!({"type":"conversation.item.create","item":{"type":"function_call_output","call_id":call_id,"output":output}}), effects);
+        self.calls.get_mut(call_id).ok_or("Unknown function")?.phase = CallPhase::Publishing(id);
+        Ok(())
+    }
+    fn continue_batches(&mut self, effects: &mut Vec<Effect>) {
+        if self.responses.active_default_response {
+            return;
+        }
+        let ready: Vec<_> = self
+            .batches
+            .iter()
+            .filter(|(_, batch)| {
+                !batch.continued
+                    && batch.calls.iter().all(|id| {
+                        self.calls
+                            .get(id)
+                            .is_some_and(|call| call.phase == CallPhase::Published)
+                    })
+            })
+            .map(|(id, _)| id.clone())
+            .collect();
+        if let Some(id) = ready.into_iter().next() {
+            self.responses.mark_started();
+            self.batches.get_mut(&id).unwrap().continued = true;
+            self.send(json!({"type":"response.create"}), effects);
+        }
+    }
+    pub fn apply_json(&mut self, input: &str) -> String {
+        let result = if input.len() > MAX_FRAME_BYTES {
+            Err("Command exceeds capacity".into())
+        } else {
+            serde_json::from_str::<Command>(input)
+                .map_err(|_| "Invalid control command".into())
+                .and_then(|command| self.apply(command))
+        };
+        match result {
+            Ok(effects) => json!({"effects":effects}).to_string(),
+            Err(error) => {
+                self.phase = Phase::Closed;
+                self.calls.clear();
+                self.batches.clear();
+                self.pending_send.clear();
+                json!({"error":error}).to_string()
+            }
+        }
+    }
+}
+fn string(value: &Value, key: &str) -> Result<String, String> {
+    value
+        .get(key)
+        .and_then(Value::as_str)
+        .filter(|s| !s.is_empty())
+        .map(str::to_owned)
+        .ok_or_else(|| format!("Provider event omitted {key}"))
+}
+fn arguments(request: &FunctionCall) -> Result<Value, String> {
+    let args: Value =
+        serde_json::from_str(&request.arguments).map_err(|_| "Invalid function arguments")?;
+    if !args.is_object() {
+        return Err("Function arguments must be an object".into());
+    }
+    Ok(args)
+}
+fn execute(request: &FunctionCall) -> Result<Effect, String> {
+    Ok(Effect::Execute {
+        call_id: request.call_id.clone(),
+        name: request.name.clone(),
+        arguments: arguments(request)?,
+    })
+}
