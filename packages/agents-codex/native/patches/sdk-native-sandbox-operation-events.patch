+#[tokio::test]
+async fn sandbox_lifecycle_marks_only_builtin_runtimes() -> anyhow::Result<()> {
+    use codex_extension_api::BuiltinSandboxOperation;
+
+    let (mut session, turn) = crate::session::tests::make_session_and_context().await;
+    let records = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.tool_lifecycle_contributor(Arc::new(ToolLifecycleRecorder {
+        records: Arc::clone(&records),
+    }));
+    session.services.extensions = Arc::new(builder.build());
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    let handlers: [(Arc<dyn CoreToolRuntime>, BuiltinSandboxOperation); 3] = [
+        (
+            Arc::new(crate::tools::handlers::ExecCommandHandler::default()),
+            BuiltinSandboxOperation::Exec,
+        ),
+        (
+            Arc::new(crate::tools::handlers::WriteStdinHandler),
+            BuiltinSandboxOperation::WriteStdin,
+        ),
+        (
+            Arc::new(crate::tools::handlers::ViewImageHandler::default()),
+            BuiltinSandboxOperation::ViewImage,
+        ),
+    ];
+
+    for (index, (handler, operation)) in handlers.into_iter().enumerate() {
+        let tool_name = handler.tool_name().with_default_namespace();
+        let native_call = format!("native-{index}");
+        let registry = ToolRegistry::from_tools([handler]);
+        let mut invocation = test_invocation(
+            Arc::clone(&session),
+            Arc::clone(&turn),
+            &native_call,
+            tool_name.clone(),
+        );
+        // Actual native handlers fail before any executor or file side effect.
+        // The lifecycle must still pair the start and its exact failed owner.
+        invocation.payload = ToolPayload::Function {
+            arguments: "{".into(),
+        };
+        let state = Arc::new(ToolCallState::default());
+        let _ = state.dispatch_started_at.set(std::time::Instant::now());
+        assert!(
+            registry
+                .dispatch_any_with_state(invocation, Some(state))
+                .await
+                .is_err()
+        );
+
+        let application_call = format!("application-{index}");
+        let registry = ToolRegistry::from_tools([Arc::new(LifecycleTestHandler {
+            tool_name: tool_name.clone(),
+            result: LifecycleTestResult::Ok { success: true },
+        }) as Arc<dyn CoreToolRuntime>]);
+        registry
+            .dispatch_any_with_state(
+                test_invocation(
+                    Arc::clone(&session),
+                    Arc::clone(&turn),
+                    &application_call,
+                    tool_name.clone(),
+                ),
+                None,
+            )
+            .await?;
+
+        let actual = records
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .drain(..)
+            .collect::<Vec<_>>();
+        assert_eq!(
+            actual,
+            vec![
+                RecordedToolLifecycle::Start {
+                    call_id: native_call.clone(),
+                    tool_name: tool_name.clone().with_default_namespace(),
+                    root_turn_id: None,
+                    builtin_sandbox_operation: Some(operation),
+                },
+                RecordedToolLifecycle::Finish {
+                    call_id: native_call,
+                    tool_name: tool_name.clone().with_default_namespace(),
+                    outcome: codex_extension_api::ToolCallOutcome::Failed {
+                        handler_executed: true
+                    },
+                    builtin_sandbox_operation: Some(operation),
+                    timed: true,
+                },
+                RecordedToolLifecycle::Start {
+                    call_id: application_call.clone(),
+                    tool_name: tool_name.clone().with_default_namespace(),
+                    root_turn_id: None,
+                    builtin_sandbox_operation: None,
+                },
+                RecordedToolLifecycle::Finish {
+                    call_id: application_call,
+                    tool_name: tool_name.with_default_namespace(),
+                    outcome: codex_extension_api::ToolCallOutcome::Completed { success: true },
+                    builtin_sandbox_operation: None,
+                    timed: false,
+                },
+            ]
+        );
+    }
+    Ok(())
+}
