diff --git a/codex-rs/core/src/compact/request_usage.rs b/codex-rs/core/src/compact/request_usage.rs
new file mode 100644
index 00000000000..e3b13261795
--- /dev/null
+++ b/codex-rs/core/src/compact/request_usage.rs
@@ -0,0 +1,136 @@
+use super::{CodexResult, Session, TurnContext};
+use codex_extension_api::CompactionRequestAccounting;
+use codex_protocol::protocol::ReceivedResponseUsage;
+use std::sync::Mutex;
+
+#[derive(Debug)]
+struct Request {
+    id: String,
+    settled: bool,
+    received: bool,
+    usage: Option<ReceivedResponseUsage>,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    closed: bool,
+    request: Option<Request>,
+}
+
+/// Each compaction callback can dispatch at most one borrowed SDK endpoint call.
+#[derive(Debug, Default)]
+pub(super) struct BorrowedCompactionUsage(Mutex<State>);
+
+impl CompactionRequestAccounting for BorrowedCompactionUsage {
+    fn dispatched(&self) -> Result<String, String> {
+        let mut state = self.0.lock().expect("Compaction accounting poisoned");
+        if state.closed || state.request.is_some() {
+            return Err("Compaction request already admitted or retired".into());
+        }
+        let id = uuid::Uuid::now_v7().to_string();
+        state.request = Some(Request {
+            id: id.clone(),
+            settled: false,
+            received: false,
+            usage: None,
+        });
+        Ok(id)
+    }
+
+    fn settled(
+        &self,
+        id: &str,
+        usage: Option<ReceivedResponseUsage>,
+        received: bool,
+    ) -> Result<(), String> {
+        let mut state = self.0.lock().expect("Compaction accounting poisoned");
+        if state.closed {
+            return Err("Compaction request retired".into());
+        }
+        let request = state
+            .request
+            .as_mut()
+            .filter(|request| request.id == id && !request.settled)
+            .ok_or_else(|| "Compaction request receipt expired".to_string())?;
+        if let Some(value) = &usage {
+            if !received
+                || [
+                    value.input_tokens,
+                    value.cached_input_tokens,
+                    value.cache_write_input_tokens,
+                    value.output_tokens,
+                    value.reasoning_output_tokens,
+                    value.total_tokens,
+                ]
+                .into_iter()
+                .flatten()
+                .any(|count| count < 0)
+            {
+                return Err("Invalid compaction usage".into());
+            }
+        }
+        request.settled = true;
+        request.received = received;
+        request.usage = usage;
+        Ok(())
+    }
+}
+
+impl BorrowedCompactionUsage {
+    fn take(&self) -> Option<Request> {
+        let mut state = self.0.lock().expect("Compaction accounting poisoned");
+        state.closed = true;
+        state.request.take()
+    }
+
+    pub(super) async fn flush(&self, sess: &Session, turn: &TurnContext) -> CodexResult<()> {
+        if let Some(request) = self.take() {
+            sess.record_borrowed_compaction_usage(
+                turn,
+                request.id,
+                request.usage,
+                request.received,
+            )
+            .await?;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn one_identity_and_one_settlement() {
+        let owner = BorrowedCompactionUsage::default();
+        let id = owner.dispatched().unwrap();
+        assert!(owner.dispatched().is_err());
+        assert!(owner.settled("foreign", None, false).is_err());
+        owner.settled(&id, None, false).unwrap();
+        assert!(owner.settled(&id, None, false).is_err());
+        assert_eq!(owner.take().unwrap().id, id);
+        assert!(owner.take().is_none());
+        assert!(owner.dispatched().is_err());
+    }
+    #[test]
+    fn joined_unsettled_dispatch_retains_unknown_usage() {
+        let owner = BorrowedCompactionUsage::default();
+        owner.dispatched().unwrap();
+        let record = owner.take().unwrap();
+        assert!(record.usage.is_none());
+        assert!(!record.received);
+    }
+    #[test]
+    fn received_usage_survives_later_callback_failure() {
+        let owner = BorrowedCompactionUsage::default();
+        let id = owner.dispatched().unwrap();
+        let usage = ReceivedResponseUsage {
+            input_tokens: Some(4),
+            output_tokens: Some(2),
+            total_tokens: Some(6),
+            ..Default::default()
+        };
+        owner.settled(&id, Some(usage.clone()), true).unwrap();
+        assert_eq!(owner.take().unwrap().usage, Some(usage));
+    }
+}
