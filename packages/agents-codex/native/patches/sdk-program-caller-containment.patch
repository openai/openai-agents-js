+    #[test]
+    fn function_call_caller_cannot_widen_direct_dispatch() {
+        let plain = serde_json::json!({
+            "type": "function_call",
+            "id": "fc_native_call",
+            "name": "lookup",
+            "namespace": "functions",
+            "arguments": "{}",
+            "encrypted_function_args": ["opaque"],
+            "async": true,
+            "status": "completed",
+            "call_id": "call_lookup"
+        });
+        let absent: super::ResponseItem = serde_json::from_value(plain.clone()).unwrap();
+        let mut direct = plain.clone();
+        direct["caller"] = serde_json::json!({"type": "direct"});
+        let direct: super::ResponseItem = serde_json::from_value(direct).unwrap();
+        assert_eq!(absent, direct);
+        let mut null = plain.clone();
+        null["caller"] = serde_json::Value::Null;
+        assert_eq!(absent, serde_json::from_value::<super::ResponseItem>(null).unwrap());
+        assert_eq!(serde_json::to_value(absent).unwrap(), plain);
+
+        for caller in [
+            serde_json::json!({"type": "program", "caller_id": "pc_provider"}),
+            serde_json::json!({"type": "programmatic", "program_call_id": "pc_provider"}),
+            serde_json::json!({"type": "unknown"}),
+            serde_json::json!(false),
+        ] {
+            let mut owned = plain.clone();
+            owned["caller"] = caller;
+            let error = serde_json::from_value::<super::ResponseItem>(owned).unwrap_err();
+            assert!(error.to_string().contains("Only direct function callers"));
+        }
+    }
 
