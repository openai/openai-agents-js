+            "root_turn_id": "root", "response_id": "response", "usage": TokenUsage::default(),
+            "turn_token_usage": TokenUsage::default(), "thread_token_usage": TokenUsage::default()
+        });
+        let record: TokenUsageRecord = serde_json::from_value(value).unwrap();
+        assert!(record.response_observation_id.is_none());
+        assert!(
+            serde_json::to_value(record)
+                .unwrap()
+                .get("response_observation_id")
+                .is_none()
+        );
+    }
+}
