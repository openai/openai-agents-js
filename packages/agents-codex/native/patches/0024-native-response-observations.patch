+mod response_observation_tests {
+    use super::*;
+
+    #[test]
+    fn received_observation_roundtrip_preserves_origin_and_exact_optional_counters() {
+        let record = ResponseObservationRecord {
+            id: "occurrence".to_string(),
+            thread_id: ThreadId::new(),
+            turn_id: "origin-turn".to_string(),
+            observation: ResponseObservation {
+                response_id: None,
+                status: ResponseObservationStatus::Incomplete,
+                incomplete_reason: Some(ResponseIncompleteReason::Unknown),
+                usage: Some(ReceivedResponseUsage {
+                    input_tokens: Some(9007199254740993),
+                    cache_write_input_tokens: Some(0),
+                    ..ReceivedResponseUsage::default()
+                }),
+            },
+        };
+        let value = serde_json::to_value(&record).unwrap();
+        assert_eq!(value["id"], "occurrence");
+        assert_eq!(value["turn_id"], "origin-turn");
+        assert_eq!(value["usage"]["input_tokens"], 9007199254740993_i64);
+        assert_eq!(value["usage"]["cache_write_input_tokens"], 0);
+        assert!(value["usage"].get("cached_input_tokens").is_none());
+        assert_eq!(
+            serde_json::from_value::<ResponseObservationRecord>(value).unwrap(),
+            record
+        );
+    }
+
+    #[test]
+    fn old_accounting_record_has_no_invented_occurrence_link() {
+        let value = serde_json::json!({
