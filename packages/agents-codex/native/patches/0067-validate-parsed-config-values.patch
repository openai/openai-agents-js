+#[test]
+fn parsed_value_strict_validation_preserves_all_toml_value_types() {
+    let contents = r#"
+text = "quoted \"value\""
+flag = true
+minimum = -9223372036854775808
+maximum = 9223372036854775807
+fraction = 1.25
+negative_zero = -0.0
+positive_infinity = inf
+negative_infinity = -inf
+not_a_number = nan
+offset_datetime = 1979-05-27T07:32:00Z
+local_datetime = 1979-05-27T07:32:00
+local_date = 1979-05-27
+local_time = 07:32:00
+mixed_array = [1, "two", false]
+empty_array = []
+[nested]
+"quoted.key" = { value = "nested" }
+"#;
+    let value = toml::from_str::<toml::Value>(contents).unwrap();
+    assert!(
+        config_error_from_ignored_toml_fields::<toml::Value>("JavaScript configuration", contents)
+            .is_none()
+    );
+    assert!(
+        config_error_from_ignored_toml_value_fields::<toml::Value>(
+            "JavaScript configuration",
+            "",
+            value.clone()
+        )
+        .is_none()
+    );
+    let serialized = toml::to_string(&value).unwrap();
+    assert!(
+        config_error_from_ignored_toml_fields::<toml::Value>(
+            "JavaScript configuration",
+            &serialized
+        )
+        .is_none()
+    );
+}
