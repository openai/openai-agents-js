+#[tokio::test]
+async fn explicit_fetch_failure_clears_owned_models_and_keeps_invalidation_metadata() {
+    let endpoint = TestModelsEndpoint::with_command_auth(vec![Err(CodexErr::RequestTimeout)]);
+    let manager =
+        OpenAiModelsManager::new_without_cache(endpoint.clone(), None).with_provider_catalog();
+    assert!(
+        manager
+            .apply_remote_models(ModelsCacheEntry {
+                fetched_at: Utc::now(),
+                etag: Some("previous".to_string()),
+                client_version: Some(crate::client_version_to_whole()),
+                identity: endpoint.identity(),
+                models: vec![remote_model("previous", "Previous", 0)],
+            })
+            .await
+    );
+    assert!(!manager.get_remote_models().await.is_empty());
+    let result = manager
+        .raw_model_catalog(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+        .await;
+    assert!(
+        result.models.is_empty(),
+        "refresh errors retain the existing best-effort API"
+    );
+    let entry = manager.remote_models.read().await;
+    assert!(matches!(&entry.models, Cow::Owned(models) if models.is_empty()));
+    assert_eq!(entry.fetched_at, DateTime::<Utc>::MIN_UTC);
+    assert_eq!(entry.etag, None);
+    assert_eq!(entry.identity, endpoint.identity());
+    assert_eq!(endpoint.fetch_count(), 1);
