+#[tokio::test]
+async fn constructor_borrows_bundle_with_fresh_metadata_and_independent_lock() {
+    let bundled = crate::bundled_models_response_ref().unwrap();
+    assert!(!bundled.models.is_empty());
+    let endpoint = TestModelsEndpoint::without_refresh(Vec::new());
+    let before = Utc::now();
+    let first = OpenAiModelsManager::new_without_cache(endpoint.clone(), None);
+    let second = OpenAiModelsManager::new_without_cache(endpoint.clone(), None);
+    let after = Utc::now();
+    let first_entry = first.remote_models.write().await;
+    assert!(matches!(&first_entry.models, Cow::Borrowed(_)));
+    assert!(std::ptr::eq(
+        first_entry.models.as_ptr(),
+        bundled.models.as_ptr()
+    ));
+    assert!(before <= first_entry.fetched_at && first_entry.fetched_at <= after);
+    assert_eq!(first_entry.identity, endpoint.identity());
+    assert_eq!(first_entry.etag, None);
+    assert_eq!(
+        first_entry._client_version.as_deref(),
+        Some(crate::client_version_to_whole().as_str())
+    );
+    // Another manager must remain readable while this manager's lock is held.
+    assert!(!second.try_list_models().unwrap().is_empty());
+    let second_entry = second.remote_models.read().await;
+    assert!(matches!(&second_entry.models, Cow::Borrowed(_)));
+    assert!(std::ptr::eq(
+        first_entry.models.as_ptr(),
+        second_entry.models.as_ptr()
+    ));
+    assert_eq!(endpoint.fetch_count(), 0);
+}
