+#[tokio::test]
+async fn explicit_empty_catalog_does_not_retain_or_resurrect_the_seed() {
+    let endpoint = TestModelsEndpoint::without_refresh(Vec::new());
+    let manager =
+        OpenAiModelsManager::new_without_cache(endpoint.clone(), None).with_provider_catalog();
+    {
+        let entry = manager.remote_models.read().await;
+        assert!(matches!(&entry.models, Cow::Owned(models) if models.is_empty()));
+        assert_eq!(entry.identity, endpoint.identity());
+    }
+    assert!(manager.get_remote_models().await.is_empty());
+    assert!(manager.try_list_models().unwrap().is_empty());
+    manager
+        .refresh_after_auth_change(DEFAULT_HTTP_CLIENT_FACTORY)
+        .await;
+    assert_eq!(endpoint.fetch_count(), 0);
+}
