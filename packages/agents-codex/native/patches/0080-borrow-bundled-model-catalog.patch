+#[tokio::test]
+async fn borrowed_seed_still_returns_independent_owned_catalogs() {
+    let bundled = crate::bundled_models_response_ref().unwrap();
+    let endpoint = TestModelsEndpoint::without_refresh(Vec::new());
+    let manager = OpenAiModelsManager::new_without_cache(endpoint.clone(), None);
+    let original = bundled.models[0].display_name.clone();
+    let mut result = manager.get_remote_models().await;
+    assert_eq!(result, bundled.models);
+    result[0].display_name.push_str(" changed by caller");
+    assert_eq!(
+        manager.try_get_remote_models().unwrap()[0].display_name,
+        original
+    );
+    assert_eq!(bundled.models[0].display_name, original);
+    assert!(matches!(
+        &manager.remote_models.read().await.models,
+        Cow::Borrowed(_)
+    ));
+    assert_eq!(endpoint.fetch_count(), 0);
+}
+
+#[tokio::test]
+async fn publication_owns_models_and_preserves_other_managers_borrowed_seed() {
+    let bundled = crate::bundled_models_response_ref().unwrap();
+    let endpoint = TestModelsEndpoint::without_refresh(Vec::new());
+    let first = OpenAiModelsManager::new_without_cache(endpoint.clone(), None);
+    let second = OpenAiModelsManager::new_without_cache(endpoint.clone(), None);
+    let slug = &bundled.models[0].slug;
+    let fetched_at = Utc::now();
+    let version = crate::client_version_to_whole();
+    assert!(
+        first
+            .apply_remote_models(ModelsCacheEntry {
+                fetched_at,
+                etag: Some("new-catalog".to_string()),
+                client_version: Some(version.clone()),
+                identity: endpoint.identity(),
+                models: vec![remote_model(slug, "Replacement", 0)],
+            })
+            .await
+    );
+    {
+        let entry = first.remote_models.read().await;
+        assert!(matches!(&entry.models, Cow::Owned(_)));
+        assert_eq!(entry.fetched_at, fetched_at);
+        assert_eq!(entry.etag.as_deref(), Some("new-catalog"));
+        assert_eq!(entry._client_version.as_deref(), Some(version.as_str()));
+        assert_eq!(entry.identity, endpoint.identity());
+        assert_eq!(entry.models.len(), bundled.models.len());
+        assert_eq!(
+            entry
+                .models
+                .iter()
+                .find(|m| &m.slug == slug)
+                .unwrap()
+                .display_name,
+            "Replacement"
+        );
+    }
+    let entry = second.remote_models.read().await;
+    assert!(matches!(&entry.models, Cow::Borrowed(_)));
+    assert_eq!(entry.models.as_ref(), bundled.models.as_slice());
+    assert_eq!(bundled.models[0].display_name, entry.models[0].display_name);
+}
