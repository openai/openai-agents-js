+/// Private live state; the public cache DTO always keeps an owned model vector.
+#[derive(Debug)]
+struct LiveModelsCacheEntry {
+    fetched_at: DateTime<Utc>,
+    etag: Option<String>,
+    _client_version: Option<String>,
+    identity: Option<String>,
+    models: Cow<'static, [ModelInfo]>,
+}
+
+impl From<ModelsCacheEntry> for LiveModelsCacheEntry {
+    fn from(entry: ModelsCacheEntry) -> Self {
+        Self {
+            fetched_at: entry.fetched_at,
+            etag: entry.etag,
+            _client_version: entry.client_version,
+            identity: entry.identity,
+            models: Cow::Owned(entry.models),
+        }
+    }
+}
