+    pub(crate) async fn sdk_history_snapshot(
+        &self,
+        limit: Option<usize>,
+    ) -> codex_protocol::error::Result<(String, usize, Vec<String>)> {
+        if let Some(snapshot) = self.state.lock().await.sdk_originals.snapshot(limit) {
+            return Ok(snapshot);
+        }
+        if let Some(limit) = limit {
+            use codex_protocol::error::CodexErr;
+            let unavailable =
