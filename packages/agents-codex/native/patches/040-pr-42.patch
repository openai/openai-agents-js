+#[tokio::test]
+async fn sdk_original_prefix_edits_preserve_native_output_truncation() {
+    use codex_utils_output_truncation::TruncationPolicy;
+    use serde_json::json;
+    let (mut session, _turn, _) = make_session_and_context_with_rx().await;
+    crate::session::tests::attach_thread_persistence(
+        std::sync::Arc::get_mut(&mut session).expect("unique session"),
+    )
+    .await;
+    let full_output = "original native output ".repeat(2000);
+    let values = vec![
+        json!({"type":"message","id":"user-one","role":"user","content":[{"type":"input_text","text":"first"}]}),
+        json!({"type":"function_call","id":"call-one","call_id":"native-call","name":"lookup","arguments":"{}"}),
+        json!({"type":"function_call_output","id":"result-one","call_id":"native-call","output":full_output}),
+        json!({"type":"message","id":"user-two","role":"user","content":[{"type":"input_text","text":"second"}]}),
+    ];
+    let mut rows: Vec<ResponseItemEnvelope> = values
+        .iter()
+        .map(|value| {
+            serde_json::from_value::<ResponseItem>(value.clone())
+                .unwrap()
+                .into()
+        })
+        .collect();
+    for row in &mut rows {
+        // The native admission path prepares positional Message classifications before recording.
+        if let Some(content) = codex_context_fragments::to_annotated_content(&mut row.item) {
+            let _ = codex_context_fragments::set_annotated_content(&mut row.item, content);
+        }
+        if matches!(
+            row.item,
+            ResponseItem::FunctionCallOutput { .. } | ResponseItem::CustomToolCallOutput { .. }
+        ) {
+            row.metadata
+                .get_or_insert_with(Default::default)
+                .history_truncation_token_limit = Some(64);
+        }
+    }
+    let values: Vec<_> = rows
+        .iter()
+        .map(|row| serde_json::to_value(&row.item).unwrap())
+        .collect();
+    {
+        let mut state = session.state.lock().await;
+        state.record_annotated_items(&mut rows, TruncationPolicy::Tokens(64));
+    }
+    session
+        .persist_rollout_items(
+            &rows
+                .iter()
+                .cloned()
+                .map(RolloutItem::ResponseItem)
+                .collect::<Vec<_>>(),
+        )
+        .await;
+    let (revision, total, originals) = session.sdk_history_snapshot(None).await.unwrap();
+    assert_eq!(total, 4);
+    assert_eq!(
+        originals
+            .iter()
+            .map(|raw| serde_json::from_str::<serde_json::Value>(raw).unwrap())
+            .collect::<Vec<_>>(),
+        values
+    );
+    let before = session.clone_history().await.into_annotated_items();
+    let model_output = serde_json::to_value(&before[2].item).unwrap();
+    assert!(model_output["output"].as_str().unwrap().len() < full_output.len());
+    session
+        .sdk_replace_history(
+            &revision,
+            3,
+            vec![json!({"type":"audit","retained":true}).to_string()],
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        session.clone_history().await.into_annotated_items(),
+        before[..3]
+    );
+    let (_, total, retained) = session.sdk_history_snapshot(None).await.unwrap();
+    assert_eq!(total, 4);
+    assert_eq!(retained[..3], originals[..3]);
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(&retained[2]).unwrap()["output"],
+        full_output
+    );
+}
