+                .sdk_originals
+                .revision()
+                .is_some_and(|revision| revision != expected_revision)
+            {
+                return Err(invalid("canonical history revision conflict"));
+            }
+            if let SdkHistoryEdit::Replace { keep, .. } = &edit
+                && state.sdk_originals.len().is_some_and(|total| *keep > total)
+            {
+                return Err(invalid("history keep exceeds snapshot length"));
+            }
+        }
+        let current = self.sdk_load_original_history().await?;
+        let mut state = self.state.lock().await;
+        if state.sdk_originals.revision() != Some(expected_revision) {
+            return Err(invalid("canonical history revision conflict"));
+        }
+        let (originals, envelopes, popped, rebuilt_context) = match edit {
+            SdkHistoryEdit::Replace { keep, appended } => {
+                if keep > current.items.len() {
+                    return Err(invalid("history keep exceeds snapshot length"));
+                }
+                let mut originals = current.prefix(keep);
+                for original in appended {
+                    let projection = input_projection(&original)
+                        .map_err(|_| invalid("Invalid canonical history item"))?
+                        .map(|mut item| {
+                            Self::assign_missing_response_item_id(&mut item);
+                            self.annotate_client_response_item(item)
+                        });
+                    originals.append(SdkOriginalItem {
+                        original,
+                        projection,
+                    });
+                }
+                let mut envelopes = current
+                    .retained_projection(state.history.annotated_items(), keep)
+                    .map_err(invalid)?;
+                envelopes.extend(
+                    originals.items[keep..]
+                        .iter()
+                        .filter_map(|item| item.projection.clone()),
+                );
+                (originals, envelopes, None, false)
+            }
+            SdkHistoryEdit::Pop { allow_rebuild } => {
+                let Some(pop) = current
+                    .prepare_pop(state.history.annotated_items(), allow_rebuild)
+                    .map_err(|error| {
+                        invalid(&format!(
+                            "{error}; raw pop can explicitly rebuild model context"
+                        ))
+                    })?
+                else {
+                    return Ok((current.revision().to_owned(), None, false));
+                };
+                (
+                    pop.originals,
+                    pop.projection,
+                    Some(pop.item),
+                    pop.rebuilt_context,
+                )
+            }
+        };
+        let mut projection_ids = std::collections::HashSet::new();
+        if envelopes
+            .iter()
+            .filter_map(|row| row.item.id())
+            .any(|id| !projection_ids.insert(id.to_string()))
+        {
+            return Err(invalid("canonical history item IDs must be unique"));
+        }
+        let revision = originals.revision().to_owned();
+        let checkpoint = codex_history::CompactedItem {
+            sdk_originals: Some(originals.clone().into()),
+            message: String::new(),
+            replacement_history: Some(envelopes.clone()),
+            guardian_history: None,
+            retained_context: Some(Default::default()),
+            mcp_resource_origins: self.services.mcp_runtime.resource_origin_checkpoint(),
+            window_number: Some(state.auto_compact_window_number()),
+            first_window_id: Some(state.auto_compact_window_ids().first_window_id.to_string()),
+            previous_window_id: state
+                .auto_compact_window_ids()
+                .previous_window_id
+                .map(|id| id.to_string()),
+            window_id: Some(state.auto_compact_window_ids().window_id.to_string()),
+            compaction_response_id: None,
+            latest_token_usage_record: state.latest_token_usage_record.clone(),
+            resume_metadata: Some(codex_history::CompactionResumeMetadata {
+                multi_agent_version: self.multi_agent_version(),
+                last_started_turn_id: state.last_started_turn_id.clone(),
+                previous_turn_settings: state.previous_turn_settings(),
+            }),
+        };
+        // Keep live state unchanged until both representations are durable.
+        if !self
+            .persist_rollout_items(&[codex_history::RolloutItem::Compacted(checkpoint)])
+            .await
+        {
+            return Err(CodexErr::Fatal(
+                "Canonical history commit outcome is uncertain".into(),
+            ));
+        }
+        self.flush_rollout()
+            .await
+            .map_err(|_| CodexErr::Fatal("Canonical history commit outcome is uncertain".into()))?;
+        state.replace_annotated_history(envelopes, None, HistoryReplacement::Reset);
+        state.sdk_originals =
+            codex_history::sdk_originals::SdkOriginalHistoryCache::from(&originals);
+        Ok((revision, popped, rebuilt_context))
+    }
+}
