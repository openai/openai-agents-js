         params: LoadThreadHistoryParams,
     ) -> ThreadStoreFuture<'_, StoredThreadHistory>;
 
+    /// Loads the complete canonical-original journal, including frozen reference prefixes.
+    /// Explicit complete reads may allocate their complete requested result.
+    fn load_original_history(
+        &self,
+        params: LoadThreadHistoryParams,
+    ) -> ThreadStoreFuture<'_, StoredThreadHistory> {
+        self.load_history(params)
+    }
+
+    /// Runs a bounded reader against borrowed records or immutable rollout prefixes.
+    /// There is deliberately no full-history fallback for stores without this capability.
+    fn read_original_history(
+        &self,
+        _params: LoadThreadHistoryParams,
+        _reader: Box<dyn crate::OriginalHistoryReader>,
+    ) -> ThreadStoreFuture<'_, crate::OriginalHistorySnapshot> {
+        Box::pin(async {
+            Err(ThreadStoreError::Unsupported {
+                operation: "read_original_history",
+            })
+        })
+    }
+
     /// Loads the persisted rollout items needed to reconstruct the latest model-visible context.
     ///
     /// Implementations that cannot perform a targeted read may return the full persisted history.
