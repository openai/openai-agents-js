+#[cfg(target_os = "linux")]
+#[test]
+fn shared_reused_connection_observes_policy_and_account_revocation() {
+    codex_utils_rustls_provider::ensure_rustls_crypto_provider();
+    let temp = TempDir::new().expect("tempdir");
+    let material = generate_tls13_material();
+    let cert = write_cert_file(&temp, "current.pem", &material.ca_cert_pem);
+    let listener = TcpListener::bind(("127.0.0.1", 0)).expect("bind TLS origin");
+    listener
+        .set_nonblocking(true)
+        .expect("nonblocking listener");
+    let url = format!(
+        "https://{}/oauth/token",
+        listener.local_addr().expect("address")
+    );
+    let config = Arc::new(
+        rustls::ServerConfig::builder_with_protocol_versions(&[&rustls::version::TLS13])
+            .with_no_client_auth()
+            .with_single_cert(vec![material.server_cert], material.server_key)
+            .expect("TLS config"),
+    );
+    let (tx, rx) = mpsc::channel();
+    let server = thread::spawn(move || {
+        let result = (|| -> io::Result<Vec<(usize, String)>> {
+            let mut requests = Vec::new();
+            // Two fresh pools must use the first connection; only the new
+            // account may open a second connection. Denials must send nothing.
+            for (connection_id, count) in [(0, 2), (1, 1)] {
+                let stream = accept_with_timeout(listener.try_clone()?, Duration::from_secs(5))?;
+                stream.set_nonblocking(false)?;
+                stream.set_read_timeout(Some(Duration::from_secs(5)))?;
+                stream.set_write_timeout(Some(Duration::from_secs(5)))?;
+                let connection =
+                    rustls::ServerConnection::new(Arc::clone(&config)).map_err(io::Error::other)?;
+                let mut tls = rustls::StreamOwned::new(connection, stream);
+                for _ in 0..count {
+                    requests.push((connection_id, read_http_message(&mut tls)?));
+                    tls.write_all(
+                        b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nok",
+                    )?;
+                    tls.flush()?;
+                }
+                // Account replacement retires the first client before its new
+                // request. Explicit owner close/process teardown ends the last.
+                let mut extra = [0];
+                match tls.read(&mut extra) {
+                    Ok(0) => {}
+                    Err(error) if error.kind() == io::ErrorKind::UnexpectedEof => {}
+                    other => {
+                        return Err(io::Error::other(format!(
+                            "unexpected post-revocation bytes: {other:?}"
+                        )));
+                    }
+                }
+            }
+            Ok(requests)
+        })();
+        let _ = tx.send(result.map_err(|error| error.to_string()));
+    });
+    let mut cmd = probe_command();
+    cmd.env(SSL_CERT_FILE_ENV, cert)
+        .env(PROBE_URL_ENV, url)
+        .env("CODEX_CUSTOM_CA_PROBE_SHARED_POLICY", "1");
+    let output = cmd.output().expect("policy probe runs");
+    let result = rx.recv_timeout(Duration::from_secs(12));
+    server.join().expect("TLS origin joins");
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(
+        String::from_utf8_lossy(&output.stdout)
+            .contains("shared-policy: destination=denied old-account=revoked current-account=ok")
+    );
+    let requests = result
+        .expect("origin result")
+        .expect("origin requests and peer close");
+    assert_eq!(
+        requests.iter().map(|(id, _)| *id).collect::<Vec<_>>(),
+        vec![0, 0, 1]
+    );
+    for (_, request) in requests {
+        assert_token_exchange_request(&request);
+    }
+}
