+async fn run_shared_policy_probe(url: String) -> Result<(), String> {
+    use codex_http_client::DestinationPolicy;
+    use codex_http_client::NetworkPolicyDenied;
+
+    let owner = std::sync::Arc::new(codex_http_client::SharedApiClients::default());
+    let controller = codex_http_client::NetworkPolicyController::default();
+    let policy = controller.policy();
+    assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+    let factory = codex_http_client::HttpClientFactory::new(
+        codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+    )
+    .with_network_policy(policy.clone().for_current_account());
+    for _ in 0..2 {
+        shared_post_with_factory(&owner, &url, factory.clone(), None).await?;
+    }
+
+    // The same physical slot remains populated, but a fresh logical pool must
+    // acquire a current permit even when its factory/key would otherwise match.
+    assert!(controller.publish(
+        policy.revision(),
+        DestinationPolicy::Restricted {
+            allowed_hosts: Default::default(),
+        },
+    ));
+    shared_post_with_factory(
+        &owner,
+        &url,
+        factory.clone(),
+        Some(NetworkPolicyDenied::Destination),
+    )
+    .await?;
+
+    // Restore an unrestricted policy in a new account. The old factory must
+    // still fail, and the fresh account must not inherit its physical client.
+    policy.invalidate();
+    assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+    shared_post_with_factory(&owner, &url, factory, Some(NetworkPolicyDenied::Revoked)).await?;
+    let current = codex_http_client::HttpClientFactory::new(
+        codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+    )
+    .with_network_policy(policy.for_current_account());
+    shared_post_with_factory(&owner, &url, current, None).await?;
+    owner.close();
+    println!("shared-policy: destination=denied old-account=revoked current-account=ok");
+    Ok(())
+}
