 use std::collections::HashMap;
 use std::sync::Arc;

+pub(crate) async fn wait_if_sampling_stopped(admission: Option<&dyn ModelToolAdmission>) {
+    if admission
+        .and_then(|admission| admission.turn_store().get::<TurnSamplingStop>())
+        .is_some_and(|stop| stop.requested())
+    {
+        // Keep the native interrupt responsible for aborting the task and joining cleanup.
+        std::future::pending::<()>().await;
+    }
+}
