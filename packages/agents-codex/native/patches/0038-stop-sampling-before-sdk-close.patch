 use futures::stream::BoxStream;
 use std::collections::HashMap;
 use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+/// Stops admission to model requests while the host interrupts the turn.
+/// Hosts can install the same stop in every turn they close together.
+#[derive(Clone, Debug, Default)]
+pub struct TurnSamplingStop(Arc<AtomicBool>);
+
+impl TurnSamplingStop {
+    pub fn request(&self) {
+        self.0.store(true, Ordering::Release);
+    }
+
+    pub fn requested(&self) -> bool {
+        self.0.load(Ordering::Acquire)
+    }
+}

