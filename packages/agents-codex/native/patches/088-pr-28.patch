+/// Untrusted provider provenance; native runtime admission supplies execution authority.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ProviderFunctionCaller {
+    Direct,
+    Program { caller_id: String },
+}
+
+// Parsing retains provenance; native per-call admission grants execution authority.
+type FunctionCallFields = (
+    Option<ResponseItemId>,
+    String,
+    Option<String>,
+    String,
+    Option<Vec<String>>,
+    Option<bool>,
+    Option<String>,
+    String,
+    Option<InternalChatMessageMetadataPassthrough>,
+    Option<ProviderFunctionCaller>,
+);
+
+fn deserialize_function_call<'de, D>(deserializer: D) -> Result<FunctionCallFields, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    #[derive(Deserialize)]
+    struct WireCall {
+        id: Option<ResponseItemId>,
+        name: String,
+        namespace: Option<String>,
+        arguments: String,
+        encrypted_function_args: Option<Vec<String>>,
+        #[serde(rename = "async")]
+        asynchronous: Option<bool>,
+        status: Option<String>,
+        call_id: String,
+        internal_chat_message_metadata_passthrough: Option<InternalChatMessageMetadataPassthrough>,
+        caller: Option<serde_json::Value>,
+    }
+
+    let call = WireCall::deserialize(deserializer)?;
+    let caller = match call.caller {
+        None | Some(serde_json::Value::Null) => None,
+        Some(serde_json::Value::Object(value)) => match value
+            .get("type")
+            .and_then(serde_json::Value::as_str)
+        {
+            Some("direct") => None,
+            Some("program") if value.len() == 2 => {
+                let caller_id = value
+                    .get("caller_id")
+                    .and_then(serde_json::Value::as_str)
+                    .filter(|id| !id.is_empty())
+                    .ok_or_else(|| serde::de::Error::custom("Invalid provider function caller"))?;
+                Some(ProviderFunctionCaller::Program {
+                    caller_id: caller_id.to_owned(),
+                })
+            }
+            _ => return Err(serde::de::Error::custom("Invalid provider function caller")),
+        },
+        _ => return Err(serde::de::Error::custom("Invalid provider function caller")),
+    };
+    Ok((
+        call.id,
+        call.name,
+        call.namespace,
+        call.arguments,
+        call.encrypted_function_args,
+        call.asynchronous,
+        call.status,
+        call.call_id,
+        call.internal_chat_message_metadata_passthrough,
+        caller,
+    ))
+}
