+// The existing analytics capture bounds distinct per-response tool IDs at 256.
+// Bound provider program admission independently at the same capacity.
+const MAX_HOSTED_PROGRAM_CALL_IDS_PER_RESPONSE: usize = 256;
+
+fn retained_hosted_program_calls(prompt: &Prompt) -> HashMap<String, bool> {
+    let mut retained = HashMap::new();
+    for item in prompt.input.iter() {
+        match item {
+            ResponseItem::Program { call_id, .. } => {
+                retained.insert(call_id.clone(), false);
+            }
+            ResponseItem::ProgramOutput {
+                call_id, status, ..
+            } => {
+                retained.insert(
+                    call_id.clone(),
+                    matches!(
+                        status,
+                        codex_protocol::models::ProgramOutputStatus::Completed
+                    ),
+                );
+            }
+            _ => {}
+        }
+    }
+    retained
+}
+
+fn admit_hosted_program_item(
+    prompt: &Prompt,
+    calls: &mut HashMap<String, bool>,
+    retained_calls: &mut Option<HashMap<String, bool>>,
+    item: &ResponseItem,
+) -> CodexResult<()> {
+    let opaque_prompt_catalog = prompt.tools.is_empty()
+        && prompt
+            .request_controls
+            .hosted_prompt
+            .as_ref()
+            .and_then(Option::as_ref)
+            .is_some_and(|hosted| hosted.omit_tools);
+    if !opaque_prompt_catalog
+        && !prompt.tools.iter().any(|tool| {
+            matches!(tool, codex_tools::ToolSpec::ProviderOnly(tool)
+            if tool.tool_type() == "programmatic_tool_calling")
+        })
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Provider returned a program without an offered programmatic tool".into(),
+        ));
+    }
+    match item {
+        ResponseItem::Program { call_id, .. } => {
+            if call_id.is_empty() || calls.contains_key(call_id) {
+                return Err(CodexErr::InvalidRequest(
+                    "Invalid provider program call ID".into(),
+                ));
+            }
+            if calls.len() >= MAX_HOSTED_PROGRAM_CALL_IDS_PER_RESPONSE {
+                return Err(CodexErr::InvalidRequest(
+                    "Too many provider program calls in one response".into(),
+                ));
+            }
+            calls.insert(call_id.clone(), false);
+        }
+        ResponseItem::ProgramOutput {
+            call_id, status, ..
+        } => {
+            if !calls.contains_key(call_id)
+                && calls.len() >= MAX_HOSTED_PROGRAM_CALL_IDS_PER_RESPONSE
+            {
+                return Err(CodexErr::InvalidRequest(
+                    "Too many provider program calls in one response".into(),
+                ));
+            }
+            let prior = calls.entry(call_id.clone()).or_insert_with(|| {
+                // The retained prompt is immutable for this response. Index its latest state once.
+                retained_calls
+                    .get_or_insert_with(|| retained_hosted_program_calls(prompt))
+                    .get(call_id)
+                    .copied()
+                    .unwrap_or(true)
+            });
+            if *prior {
+                return Err(CodexErr::InvalidRequest(
+                    "Provider program output has no unfinished program with this call ID".into(),
+                ));
+            }
+            *prior = matches!(
+                status,
+                codex_protocol::models::ProgramOutputStatus::Completed
+            );
+        }
+        _ => unreachable!("program admission only handles program items"),
+    }
+    Ok(())
+}
