@@ -18,3 +18,83 @@ pub struct AgentProfileHandoff {
     pub target_profile_id: String,
     pub call_id: String,
 }
+
+impl AgentProfileHandoff {
+    /// The accepted transfer consumes exactly the next epoch of its destination.
+    pub fn matches_destination(&self, committed: &AgentProfileReceipt) -> bool {
+        self.target_profile_id == committed.profile_id
+            && self.source.epoch.checked_add(1) == Some(committed.epoch)
+    }
+}
+
+/// An accepted destination presentation, separate from canonical effect history.
+/// This source prototype has not been connected to public input or persistence.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct AgentProfileHandoffPresentation {
+    pub handoff: AgentProfileHandoff,
+    pub destination: AgentProfileReceipt,
+    pub input: Vec<serde_json::Value>,
+    pub previous: Vec<serde_json::Value>,
+    pub generated: Vec<serde_json::Value>,
+}
+
+impl AgentProfileHandoffPresentation {
+    /// The destination publication has to consume this exact source epoch.
+    pub fn belongs_to(&self, committed: &AgentProfileReceipt) -> bool {
+        self.destination == *committed && self.handoff.matches_destination(committed)
+    }
+}
+
+#[cfg(test)]
+mod presentation_tests {
+    use super::*;
+
+    #[test]
+    fn accepted_presentation_remains_bound_to_exact_destination_epoch() {
+        let handoff = AgentProfileHandoff {
+            source: AgentProfileReceipt {
+                profile_id: "a".into(),
+                epoch: 2,
+            },
+            target_profile_id: "b".into(),
+            call_id: "accepted-call".into(),
+        };
+        let destination = AgentProfileReceipt {
+            profile_id: "b".into(),
+            epoch: 3,
+        };
+        let accepted = AgentProfileHandoffPresentation {
+            handoff,
+            destination: destination.clone(),
+            input: vec![serde_json::json!({"occurrence":"input-1"})],
+            previous: vec![],
+            generated: vec![serde_json::json!({"occurrence":"generated-0"})],
+        };
+        let restored: AgentProfileHandoffPresentation =
+            serde_json::from_str(&serde_json::to_string(&accepted).unwrap()).unwrap();
+        assert_eq!(restored, accepted);
+        assert!(restored.belongs_to(&destination));
+        assert!(!restored.belongs_to(&AgentProfileReceipt {
+            profile_id: "a".into(),
+            epoch: 3
+        }));
+        assert!(!restored.belongs_to(&AgentProfileReceipt {
+            profile_id: "b".into(),
+            epoch: 4
+        }));
+    }
+}
