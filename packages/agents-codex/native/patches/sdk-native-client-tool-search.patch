+#[cfg(test)]
+mod client_search_tests {
+    use super::*;
+    use serde_json::json;
+
+    fn entry(name: &str, namespace: Option<&str>, deferred: bool) -> ClientToolSearchEntry {
+        let function = crate::ResponsesApiTool {
+            name: name.into(),
+            description: "captured-schema-sentinel".into(),
+            strict: false,
+            defer_loading: None,
+            output_schema: None,
+            parameters: crate::JsonSchema::object(std::collections::BTreeMap::new(), None, None),
+        };
+        let spec = match namespace {
+            Some(namespace) => crate::ToolSpec::Namespace(crate::ResponsesApiNamespace {
+                name: namespace.into(),
+                description: String::new(),
+                tools: vec![crate::ResponsesApiNamespaceTool::Function(function)],
+            }),
+            None => crate::ToolSpec::Function(function),
+        };
+        ClientToolSearchEntry {
+            name: ToolName::new(namespace.map(str::to_owned), name),
+            deferred,
+            info: ToolSearchInfo::from_tool_spec(spec, None).unwrap(),
+        }
+    }
+
+    #[test]
+    fn default_paths_preserve_namespace_precedence_and_ignore_unknown_or_direct_tools() {
+        let call = ClientToolSearchCall {
+            arguments: json!({}),
+            catalog: vec![
+                entry("lookup", None, true),
+                entry("first", Some("reports"), true),
+                entry("second", Some("reports"), true),
+                entry("direct", None, false),
+            ],
+        };
+        let selected = call
+            .load_default(&[
+                "reports.first".into(),
+                "missing".into(),
+                "lookup".into(),
+                "reports".into(),
+                "lookup".into(),
+                "direct".into(),
+            ])
+            .unwrap();
+        assert_eq!(
+            selected,
+            vec![
+                ToolName::plain("lookup"),
+                ToolName::new(Some("reports".into()), "first"),
+                ToolName::new(Some("reports".into()), "second")
+            ]
+        );
+    }
+
+    #[test]
+    fn selected_refs_resolve_only_captured_or_admitted_new_tools() {
+        let captured = vec![entry("lookup", None, true)];
+        let added = vec![entry("new_lookup", Some("reports"), true)];
+        let response = codex_protocol::dynamic_tools::DynamicToolResponse {
+            success: true, content_items: vec![codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem::InputText { text: json!({"tool_refs":[{"name":"lookup"},{"name":"new_lookup","namespace":"reports"}],"catalog_generation":"42"}).to_string() }],
+        };
+        let selection = ClientToolSearchSelection::from_response(&response).unwrap();
+        assert_eq!(selection.catalog_generation.as_deref(), Some("42"));
+        assert_eq!(selection.resolve(&captured, &added).unwrap().tools.len(), 2);
+        assert!(selection.resolve(&captured, &[]).is_err());
+        assert!(
+            selection
+                .resolve(&captured, &[entry("lookup", None, true)])
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn raw_client_payload_debug_has_been_redacting_arguments_and_schemas() {
+        let payload = ToolPayload::ClientToolSearch(ClientToolSearchCall {
+            arguments: json!({"department":"private-argument-sentinel","tags":["account"]}),
+            catalog: vec![entry("lookup", None, true)],
+        });
+        let debug = format!("{payload:?}");
+        assert!(!debug.contains("private-argument-sentinel"));
+        assert!(!debug.contains("captured-schema-sentinel"));
+        assert_eq!(payload.log_payload(), "[native client tool search]");
+    }
+
+    #[test]
+    fn typed_slot_has_been_preserving_provider_configuration_without_a_function_schema() {
+        let declaration = json!({"type":"tool_search","execution":"client","description":"Find support tools","parameters":{"type":"object","properties":{"department":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}}}}});
+        let slot = codex_protocol::dynamic_tools::DynamicToolSearchSpec {
+            declaration: declaration.clone(),
+        };
+        let spec = crate::client_tool_search_spec(&slot).unwrap();
+        assert_eq!(serde_json::to_value(spec).unwrap(), declaration);
+        let wire = serde_json::to_value(
+            codex_protocol::dynamic_tools::DynamicToolSpec::ToolSearch(slot),
+        )
+        .unwrap();
+        assert_eq!(wire["type"], "toolSearch");
+        assert_eq!(wire["declaration"], declaration);
+    }
+}
