+                let strict_unknown_function = matches!(&invocation.payload, ToolPayload::Function { .. })
+                    && matches!(
+                        &invocation.source,
+                        crate::tools::context::ToolCallSource::Direct
+                            | crate::tools::context::ToolCallSource::DirectPlaintextMessage
+                    )
+                    && invocation.turn.extension_data
+                        .get::<codex_extension_api::ToolNotFoundBehavior>()
+                        .as_deref()
+                        == Some(&codex_extension_api::ToolNotFoundBehavior::RaiseError);
+                let err = if strict_unknown_function {
+                    FunctionCallError::Fatal(message)
+                } else {
+                    FunctionCallError::RespondToModel(message)
+                };
                 dispatch_trace.record_failed(&err);
                 return Err(err);
             }
