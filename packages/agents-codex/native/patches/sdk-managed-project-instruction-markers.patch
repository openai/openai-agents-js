+
+/// Checks a project marker and, for a directory with a supplied Git HEAD path,
+/// requires that the same filesystem and sandbox can see its HEAD metadata.
+pub async fn project_marker_exists(
+    file_system: &dyn ExecutorFileSystem,
+    path: &PathUri,
+    git_head: Option<&PathUri>,
+    sandbox: Option<&FileSystemSandboxContext>,
+) -> FileSystemResult<bool> {
+    let metadata = file_system
+        .get_metadata(path, crate::GetMetadataOptions::default(), sandbox)
+        .await?;
+    if metadata.is_directory
+        && let Some(git_head) = git_head
+    {
+        return Ok(file_system
+            .get_metadata(git_head, crate::GetMetadataOptions::default(), sandbox)
+            .await
+            .is_ok());
+    }
+    Ok(true)
 }
 
