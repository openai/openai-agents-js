+// Keep native wire selection with the same immutable profile as model and tools.
+pub(super) fn selected_profile_output_schema(
+    profile: Option<&codex_extension_api::CapturedAgentProfile>,
+    control: Option<&codex_extension_api::AgentProfileOutputControl>,
+    turn_schema: Option<&serde_json::Value>,
+    thread_id: &str,
+) -> Result<Option<serde_json::Value>, String> {
+    let Some(schema) = profile.and_then(|profile| {
+        profile
+            .profile
+            .data
+            .get::<codex_extension_api::AgentProfileOutputSchema>()
+    }) else {
+        return Ok(turn_schema.cloned());
+    };
+    let control = control
+        .filter(|control| control.thread_id == thread_id)
+        .ok_or("Per-profile output schemas require their managed SDK thread scope")?;
+    Ok(if control.preserve_turn_output {
+        turn_schema.cloned()
+    } else {
+        schema.0.clone()
+    })
+}
