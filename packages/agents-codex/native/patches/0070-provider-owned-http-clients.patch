+// Only retain the inputs used by this construction; no unrelated environment
+// values become part of a long-lived provider resource.
+struct CapturedFileEnvironment(std::collections::BTreeMap<std::ffi::OsString, std::ffi::OsString>);
+
+const SHARED_PROXY_ENV: [&str; 8] = [
+    "ALL_PROXY",
+    "all_proxy",
+    "HTTP_PROXY",
+    "http_proxy",
+    "HTTPS_PROXY",
+    "https_proxy",
+    "NO_PROXY",
+    "no_proxy",
+];
+
+impl CapturedFileEnvironment {
+    fn capture() -> Self {
+        Self(
+            env::vars_os()
+                .filter(|(key, _)| {
+                    key.to_str().is_some_and(|key| {
+                        SHARED_PROXY_ENV.contains(&key)
+                            || [CODEX_CA_CERT_ENV, SSL_CERT_FILE_ENV, "SSL_CERT_DIR"].contains(&key)
+                    })
+                })
+                .collect(),
+        )
+    }
+
+    fn is_file_only_without_proxy(&self) -> bool {
+        cfg!(target_os = "linux")
+            && SHARED_PROXY_ENV
+                .iter()
+                .all(|key| !self.0.contains_key(std::ffi::OsStr::new(key)))
+            && !self.0.contains_key(std::ffi::OsStr::new("SSL_CERT_DIR"))
+            && self
+                .configured_ca_bundle()
+                .is_some_and(|bundle| bundle.source_env == SSL_CERT_FILE_ENV)
+    }
+}
+
+impl EnvSource for CapturedFileEnvironment {
+    fn var(&self, key: &str) -> Option<String> {
+        self.0
+            .get(std::ffi::OsStr::new(key))?
+            .to_str()
+            .map(str::to_owned)
+    }
+}
