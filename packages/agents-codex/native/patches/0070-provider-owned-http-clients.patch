+#[tokio::test]
+async fn retired_fallback_work_does_not_hold_the_shared_build_permit() {
+    let owner = Arc::new(SharedApiClients::default());
+    let initial_factory = factory();
+    let route = OutboundProxyRoute::TransportDefault;
+    context(&owner, &initial_factory, &route).publish(trust(), client());
+    let permit = Arc::clone(&owner.build).lock_owned().await;
+    let worker_owner = Arc::clone(&owner);
+    let (started, entered) = tokio::sync::oneshot::channel();
+    let release = Arc::new(std::sync::Barrier::new(2));
+    let worker_release = Arc::clone(&release);
+    let worker = tokio::task::spawn_blocking(move || {
+        let factory = factory();
+        let route = OutboundProxyRoute::TransportDefault;
+        SharedApiClientContext {
+            owner: &worker_owner,
+            factory: &factory,
+            route: &route,
+            follows_redirects: false,
+            _build_permit: Some(permit),
+        }
+        .retire_and_release();
+        started.send(()).expect("caller awaits fresh work");
+        // Model a slow fresh constructor after the common fallback boundary.
+        worker_release.wait();
+        client()
+    });
+    entered.await.expect("fresh fallback started");
+    let next = tokio::time::timeout(
+        std::time::Duration::from_secs(1),
+        Arc::clone(&owner.build).lock_owned(),
+    )
+    .await;
+    // Always release and join the worker before asserting, including regression.
+    release.wait();
+    drop(worker.await.expect("fresh construction joined"));
+    assert!(
+        next.is_ok(),
+        "fresh fallback construction must not serialize later callers"
+    );
+    assert!(
+        context(&owner, &initial_factory, &route)
+            .lookup(&trust())
+            .is_none()
+    );
+}
