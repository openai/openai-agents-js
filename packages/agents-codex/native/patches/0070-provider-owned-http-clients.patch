+#[tokio::test]
+async fn close_rejects_publication_from_a_blocking_build_after_caller_cancellation() {
+    let owner = Arc::new(SharedApiClients::default());
+    let (started, entered) = tokio::sync::oneshot::channel();
+    let release = Arc::new(std::sync::Barrier::new(2));
+    let worker_owner = Arc::clone(&owner);
+    let worker_release = Arc::clone(&release);
+    let worker = tokio::task::spawn_blocking(move || {
+        started.send(()).expect("caller awaits build start");
+        worker_release.wait();
+        let built = client();
+        let factory = factory();
+        SharedApiClientContext {
+            owner: &worker_owner,
+            factory: &factory,
+            route: &OutboundProxyRoute::TransportDefault,
+            follows_redirects: false,
+            _build_permit: None,
+        }
+        .publish(trust(), built);
+    });
+    entered.await.expect("blocking build started");
+    // Running spawn_blocking work cannot be cancelled by aborting its caller.
+    worker.abort();
+    owner.close();
+    release.wait();
+    worker.await.expect("late blocking build joined");
+    let state = owner.state.lock().expect("owner state");
+    assert!(state.closed);
+    assert!(state.clients.iter().all(Option::is_none));
+}
