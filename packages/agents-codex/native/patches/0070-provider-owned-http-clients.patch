+#[test]
+fn ssl_invalid_inputs_keep_custom_error_categories() {
+    let temp = TempDir::new().expect("tempdir");
+    for (name, content, message) in [
+        ("empty.pem", "", "no certificates found in PEM file"),
+        (
+            "broken.pem",
+            "-----BEGIN CERTIFICATE-----\nMIIBroken",
+            "failed to parse PEM file",
+        ),
+    ] {
+        let path = write_cert_file(&temp, name, content);
+        let output = run_probe(&[(SSL_CERT_FILE_ENV, &path)]);
+        assert!(!output.status.success());
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        assert!(stderr.contains(message));
+        assert!(stderr.contains("selected by SSL_CERT_FILE"));
+    }
+    let missing = temp.path().join("missing.pem");
+    let output = run_probe(&[(SSL_CERT_FILE_ENV, &missing)]);
+    assert!(!output.status.success());
+    assert!(String::from_utf8_lossy(&output.stderr).contains("Failed to read CA certificate file"));
+    let mut cmd = probe_command();
+    cmd.env("REQUESTS_CA_BUNDLE", &missing);
+    assert!(cmd.output().expect("REQUESTS-only probe").status.success());
+}
