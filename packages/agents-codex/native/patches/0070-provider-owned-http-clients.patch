+
+/// Bounded physical HTTP clients owned by one SDK provider, without session state.
+///
+/// Each operation must retain its own route-aware pool and policy authority. Clients
+/// are admitted here only after fresh captured trust/proxy inputs have been validated.
+#[derive(Default)]
+pub struct SharedApiClients {
+    state: Mutex<State>,
+    pub(crate) build: Arc<tokio::sync::Mutex<()>>,
+}
+
+#[derive(Default)]
+struct State {
+    closed: bool,
+    clients: [Option<Entry>; 2],
+}
+
+struct Entry {
+    factory: HttpClientFactory,
+    route: OutboundProxyRoute,
+    trust: FileTrustIdentity,
+    client: reqwest::Client,
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub(crate) struct FileTrustIdentity {
+    pub(crate) path: PathBuf,
+    pub(crate) sha256: [u8; 32],
+    pub(crate) len: usize,
+}
+
+pub(crate) struct SharedApiClientContext<'a> {
+    pub(crate) owner: &'a SharedApiClients,
+    pub(crate) factory: &'a HttpClientFactory,
+    pub(crate) route: &'a OutboundProxyRoute,
+    pub(crate) follows_redirects: bool,
+    // Eligible construction owns the existing permit through publication.
+    pub(crate) _build_permit: Option<tokio::sync::OwnedMutexGuard<()>>,
+}
+
+impl SharedApiClients {
+    /// Prevents late publication and releases idle client references. Active leases
+    /// retain their own clients; callers must close those leases before closing this owner.
+    pub fn close(&self) {
+        let retired = {
+            let mut state = self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            state.closed = true;
+            std::mem::take(&mut state.clients)
+        };
+        drop(retired);
+    }
+}
+
+impl SharedApiClientContext<'_> {
+    pub(crate) fn retire_and_release(self) {
+        self.retire();
+        // Drop the owned permit before an ineligible caller constructs fresh.
+    }
+
+    pub(crate) fn retire(&self) {
+        let retired = {
+            let mut state = self
+                .owner
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            state.clients[usize::from(self.follows_redirects)].take()
+        };
+        drop(retired);
+    }
+
+    pub(crate) fn lookup(&self, trust: &FileTrustIdentity) -> Option<reqwest::Client> {
+        let state = self
+            .owner
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.closed {
+            return None;
+        }
+        let entry = state.clients[usize::from(self.follows_redirects)].as_ref()?;
+        (entry.factory == *self.factory && entry.route == *self.route && entry.trust == *trust)
+            .then(|| entry.client.clone())
+    }
+
+    pub(crate) fn publish(&self, trust: FileTrustIdentity, client: reqwest::Client) {
+        let retired = {
+            let mut state = self
+                .owner
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            // spawn_blocking may finish after its caller was cancelled and the
+            // provider closed. Closing and publication use the same fence.
+            if state.closed {
+                return;
+            }
+            state.clients[usize::from(self.follows_redirects)].replace(Entry {
+                factory: self.factory.clone(),
+                route: self.route.clone(),
+                trust,
+                client,
+            })
+        };
+        drop(retired);
+    }
+}
