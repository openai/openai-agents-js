+pub(crate) fn build_reqwest_client_with_shared_api_clients(
+    builder: reqwest::ClientBuilder,
+    shared: crate::shared_api_clients::SharedApiClientContext<'_>,
+) -> Result<reqwest::Client, BuildCustomCaTransportError> {
+    let captured = CapturedFileEnvironment::capture();
+    if captured.is_file_only_without_proxy()
+        && matches!(
+            shared.route,
+            crate::OutboundProxyRoute::TransportDefault | crate::OutboundProxyRoute::Direct
+        )
+    {
+        build_reqwest_client_with_env_and_shared(&captured, builder, Some(shared))
+    } else {
+        // Any present proxy/directory, another CA source, or another platform
+        // retains the original fresh construction path and its error behavior.
+        shared.retire_and_release();
+        build_reqwest_client_with_custom_ca(builder)
+    }
+}
