+async fn shared_post(
+    owner: &std::sync::Arc<codex_http_client::SharedApiClients>,
+    url: &str,
+) -> Result<(), String> {
+    // A fresh logical pool for each operation, as in a fresh SDK Engine.
+    let pool = codex_http_client::RouteAwareClientPool::with_builder(
+        codex_http_client::HttpClientFactory::new(
+            codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+        ),
+        codex_http_client::ClientRouteClass::Api,
+        codex_http_client::HttpClientBuilder::new().without_request_logging(),
+    )
+    .with_shared_api_clients(std::sync::Arc::clone(owner));
+    let response = pool
+        .post(url)
+        .header("Content-Type", "application/x-www-form-urlencoded")
+        .body("grant_type=authorization_code&code=test")
+        .send()
+        .await
+        .map_err(|error| format!("shared probe request failed: {error:?}"))?;
+    let status = response.status();
+    let body = response.text().await.map_err(|error| error.to_string())?;
+    if !status.is_success() || body != "ok" {
+        return Err(format!("shared probe response mismatch: {status}"));
+    }
+    Ok(())
+}
+
+async fn run_shared_probe(target: Option<String>) -> Result<(), String> {
+    let owner = std::sync::Arc::new(codex_http_client::SharedApiClients::default());
+    if let Some(url) = target {
+        shared_post(&owner, &url).await?;
+    }
+    if let Some(replacement) = env::var_os("CODEX_CUSTOM_CA_PROBE_REPLACEMENT") {
+        let selected = env::var_os("SSL_CERT_FILE").ok_or("rotation needs SSL_CERT_FILE")?;
+        std::fs::copy(replacement, selected).map_err(|error| error.to_string())?;
+        let second =
+            env::var("CODEX_CUSTOM_CA_PROBE_SECOND_URL").map_err(|error| error.to_string())?;
+        shared_post(&owner, &second).await?;
+        let old =
+            env::var("CODEX_CUSTOM_CA_PROBE_OLD_ROOT_URL").map_err(|error| error.to_string())?;
+        let error = shared_post(&owner, &old)
+            .await
+            .expect_err("removed root must not authorize TLS");
+        if !error.contains("UnknownIssuer") {
+            return Err(format!("unexpected old-root failure: {error}"));
+        }
+    }
+    owner.close();
+    Ok(())
+}
