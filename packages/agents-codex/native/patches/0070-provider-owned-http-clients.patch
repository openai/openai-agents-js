+fn build_reqwest_client_from_loaded_ca(
+    bundle: &ConfiguredCaBundle,
+    loaded: LoadedReqwestCertificates,
+    mut builder: reqwest::ClientBuilder,
+    shared: Option<crate::shared_api_clients::SharedApiClientContext<'_>>,
+) -> Result<reqwest::Client, BuildCustomCaTransportError> {
+    for certificate in loaded.certificates {
+        builder = builder.add_root_certificate(certificate);
+    }
+    // The shared path already captured file-only native trust and absence
+    // of every proxy variable. Consume that capture; do not consult process
+    // environment or reload the file while constructing this client.
+    let shared = if loaded.standard_pem {
+        shared
+    } else {
+        if let Some(context) = shared {
+            context.retire_and_release();
+        }
+        None
+    };
+    if let Some(context) = &shared {
+        builder = builder.no_proxy().tls_built_in_native_certs(false);
+        if let Some(client) = context.lookup(&loaded.identity) {
+            return Ok(client);
+        }
+        context.retire();
+    }
+    match builder.build() {
+        Ok(client) => {
+            if let Some(context) = shared {
+                context.publish(loaded.identity, client.clone());
+            }
+            Ok(client)
+        }
+        Err(source) => {
+            warn!(
+                source_env = bundle.source_env,
+                ca_path = %bundle.path.display(),
+                error = %source,
+                "failed to build client after loading custom CA bundle"
+            );
+            Err(BuildCustomCaTransportError::BuildClientWithCustomCa {
+                source_env: bundle.source_env,
+                path: bundle.path.clone(),
+                source,
+            })
+        }
+    };
