+#[tokio::test]
+async fn eligible_publication_retains_the_permit_and_close_uses_its_independent_fence() {
+    let owner = SharedApiClients::default();
+    let factory = factory();
+    let route = OutboundProxyRoute::TransportDefault;
+    let context = SharedApiClientContext {
+        owner: &owner,
+        factory: &factory,
+        route: &route,
+        follows_redirects: false,
+        _build_permit: Some(Arc::clone(&owner.build).lock_owned().await),
+    };
+    assert!(owner.build.try_lock().is_err());
+    context.publish(trust(), client());
+    assert!(owner.build.try_lock().is_err());
+    owner.close();
+    context.publish(trust(), client());
+    assert!(context.lookup(&trust()).is_none());
+    drop(context);
+    assert!(owner.build.try_lock().is_ok());
+}
