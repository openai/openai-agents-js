+#[tokio::test]
+async fn reused_client_preserves_request_headers_and_close_releases_the_idle_socket() {
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    use tokio::time::Duration;
+    use tokio::time::timeout;
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0))
+        .await
+        .expect("bind");
+    let url = format!("http://{}/", listener.local_addr().expect("address"));
+    let server = tokio::spawn(async move {
+        let (mut stream, _) = listener.accept().await.expect("one physical connection");
+        let mut requests = Vec::new();
+        for _ in 0..2 {
+            let mut request = Vec::new();
+            while !request.ends_with(b"\r\n\r\n") {
+                let byte = stream
+                    .read_u8()
+                    .await
+                    .expect("request remains on same connection");
+                request.push(byte);
+            }
+            requests.push(String::from_utf8(request).expect("ASCII request"));
+            stream
+                .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
+                .await
+                .expect("response");
+        }
+        let mut byte = [0];
+        assert_eq!(stream.read(&mut byte).await.expect("peer close"), 0);
+        requests
+    });
+    let temp = tempfile::TempDir::new().expect("tempdir");
+    let path = temp.path().join("trust.pem");
+    fs::write(&path, CERT).expect("trust fixture");
+    let env = environment(&path);
+    let owner = SharedApiClients::default();
+    let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    let route = OutboundProxyRoute::TransportDefault;
+    for value in ["first", "second"] {
+        let client = build_reqwest_client_with_env_and_shared(
+            &env,
+            reqwest::Client::builder(),
+            Some(SharedApiClientContext {
+                owner: &owner,
+                factory: &factory,
+                route: &route,
+                follows_redirects: true,
+                _build_permit: None,
+            }),
+        )
+        .expect("fresh validation with shared physical client");
+        let output = timeout(Duration::from_secs(3), async {
+            client
+                .get(&url)
+                .header("Authorization", format!("Bearer {value}"))
+                .header("x-request-id", value)
+                .send()
+                .await
+                .expect("request")
+                .text()
+                .await
+                .expect("body")
+        })
+        .await
+        .expect("bounded request");
+        assert_eq!(output, "ok");
+    }
+    owner.close();
+    let requests = timeout(Duration::from_secs(3), server)
+        .await
+        .expect("idle socket closes")
+        .expect("joined server");
+    assert!(requests[0].contains("authorization: Bearer first\r\n"));
+    assert!(requests[1].contains("authorization: Bearer second\r\n"));
+    assert!(requests[0].contains("x-request-id: first\r\n"));
+    assert!(requests[1].contains("x-request-id: second\r\n"));
+}
