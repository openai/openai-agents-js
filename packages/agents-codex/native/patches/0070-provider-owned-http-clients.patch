+#[tokio::test]
+async fn ordinary_factories_match_but_managed_controllers_and_accounts_do_not() {
+    let owner = SharedApiClients::default();
+    let first = factory();
+    let second = factory();
+    let route = OutboundProxyRoute::TransportDefault;
+    context(&owner, &first, &route).publish(trust(), client());
+    assert!(context(&owner, &second, &route).lookup(&trust()).is_some());
+    let controller = NetworkPolicyController::default();
+    let managed = factory().with_network_policy(controller.policy());
+    assert!(context(&owner, &managed, &route).lookup(&trust()).is_none());
+    context(&owner, &managed, &route).publish(trust(), client());
+    assert!(context(&owner, &managed, &route).lookup(&trust()).is_some());
+    let other = factory().with_network_policy(NetworkPolicyController::default().policy());
+    assert!(context(&owner, &other, &route).lookup(&trust()).is_none());
+    let old_account = controller.policy().for_current_account();
+    let account_factory = factory().with_network_policy(old_account.clone());
+    context(&owner, &account_factory, &route).publish(trust(), client());
+    old_account.invalidate();
+    let new_account_factory =
+        factory().with_network_policy(controller.policy().for_current_account());
+    assert!(
+        context(&owner, &new_account_factory, &route)
+            .lookup(&trust())
+            .is_none()
