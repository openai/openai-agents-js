+#[test]
+fn ssl_file_rotation_uses_fresh_roots_in_the_same_process() {
+    let temp = TempDir::new().expect("tempdir");
+    codex_utils_rustls_provider::ensure_rustls_crypto_provider();
+    let old = generate_tls13_material();
+    let first = spawn_tls13_test_server_with_material(Tls13Material {
+        ca_cert_pem: old.ca_cert_pem.clone(),
+        server_cert: old.server_cert.clone(),
+        server_key: old.server_key.clone_key(),
+    });
+    let removed = spawn_tls13_test_server_with_material(old);
+    let second = spawn_tls13_test_server();
+    let selected = write_cert_file(&temp, "selected.pem", &first.ca_cert_pem);
+    let replacement = write_cert_file(&temp, "replacement.pem", &second.ca_cert_pem);
+    let mut cmd = probe_command();
+    cmd.env(SSL_CERT_FILE_ENV, &selected)
+        .env(PROBE_TLS13_ENV, "1")
+        .env(PROBE_URL_ENV, &first.url)
+        .env("CODEX_CUSTOM_CA_PROBE_REPLACEMENT", &replacement)
+        .env("CODEX_CUSTOM_CA_PROBE_SECOND_URL", &second.url)
+        .env("CODEX_CUSTOM_CA_PROBE_OLD_ROOT_URL", &removed.url);
+    let output = cmd.output().expect("rotation probe");
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    for server in [&first, &second] {
+        assert_token_exchange_request(
+            &server
+                .request_rx
+                .recv_timeout(Duration::from_secs(5))
+                .expect("server result")
+                .expect("current-root HTTPS request"),
+        );
+    }
+    assert!(
+        removed
+            .request_rx
+            .recv_timeout(Duration::from_secs(5))
+            .expect("old-root TLS result")
+            .is_err()
+    );
+}
