+    #[derive(Debug)]
+    struct Claim {
+        claims: bool,
+        requests: Arc<AtomicUsize>,
+        streams: Arc<AtomicUsize>,
+    }
+    impl ModelRequestContributor for Claim {
+        fn http_stream(&self, _: &str) -> Option<ModelHttpStream> {
+            if !self.claims {
+                return None;
+            }
+            let streams = self.streams.clone();
+            Some(Arc::new(move |_| {
+                let streams = streams.clone();
+                Box::pin(async move {
+                    streams.fetch_add(1, Ordering::SeqCst);
+                    Err(TransportError::Build("direct dispatch observed".into()))
+                })
+            }))
+        }
+        fn request(&self, _: ModelRequestInput<'_>) -> Option<Box<dyn ModelResponseInterceptor>> {
+            self.requests.fetch_add(1, Ordering::SeqCst);
+            None
+        }
+    }
