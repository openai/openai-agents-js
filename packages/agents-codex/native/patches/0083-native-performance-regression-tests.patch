+        fallback: None,
+    };
+    let env_b = BundleEnv {
+        preferred: None,
+        fallback: Some(path_b),
+    };
+    let barrier = std::sync::Barrier::new(2);
+    let runtime = tokio::runtime::Handle::current();
+    let (client_a, client_b) = std::thread::scope(|scope| {
+        let build = |env: &BundleEnv| {
+            let _entered = runtime.enter();
+            barrier.wait();
+            fresh_client(env, "concurrent").unwrap()
+        };
+        let a = scope.spawn(move || build(&env_a));
+        let b = scope.spawn(move || build(&env_b));
