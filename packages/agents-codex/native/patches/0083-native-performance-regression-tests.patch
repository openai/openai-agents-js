+    #[derive(Debug)]
+    struct RefuseAdmission;
+    impl PreparedRequestAdmission for RefuseAdmission {
+        fn admit_request(&self) -> std::result::Result<(), String> {
+            Err("prepared admission refused".into())
+        }
