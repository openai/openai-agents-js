 #[cfg(test)]
 #[path = "parallel_observation_tests.rs"]
 mod observation_tests;
+
+#[cfg(test)]
+mod decision_handoff_tests {
+    use super::admits_handoff;
+    use codex_extension_api::{
+        AgentProfileDecisionHandoffTools, AgentProfileHandoffTools, ExtensionDataInit,
+    };
+    use codex_tools::ToolName;
+
+    #[test]
+    fn static_and_decision_grants_preserve_exact_tool_and_target_membership() {
+        let mut init = ExtensionDataInit::new();
+        init.insert(AgentProfileHandoffTools {
+            targets: [(
+                ToolName::new(None, "fixed").with_default_namespace(),
+                "b".into(),
+            )]
+            .into(),
+        });
+        init.insert(AgentProfileDecisionHandoffTools {
+            targets: [(
+                ToolName::new(None, "choose").with_default_namespace(),
+                vec!["b".into(), "c".into()],
+            )]
+            .into(),
+        });
+        let data = init;
+        for (name, target, admitted) in [
+            ("fixed", "b", true),
+            ("fixed", "c", false),
+            ("choose", "b", true),
+            ("choose", "c", true),
+            ("choose", "missing", false),
+            ("other", "b", false),
+        ] {
+            assert_eq!(
+                admits_handoff(&data, &ToolName::new(None, name), Some(target)),
+                admitted
+            );
+        }
+        assert!(admits_handoff(&data, &ToolName::new(None, "choose"), None));
+        assert!(!admits_handoff(
+            &data,
+            &ToolName::namespaced("other", "choose"),
+            Some("b")
+        ));
+    }
+}
