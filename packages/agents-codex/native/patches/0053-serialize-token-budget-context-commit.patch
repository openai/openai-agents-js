+struct HeldContextWindow {
+    entered: Arc<tokio::sync::Notify>,
+    release: Arc<tokio::sync::Notify>,
+}
+
+impl codex_extension_api::ContextContributor for HeldContextWindow {
+    fn contribute_turn_context<'a>(
+        &'a self,
+        _input: codex_extension_api::TurnContextContributionInput<'a>,
+    ) -> std::pin::Pin<
+        Box<dyn std::future::Future<Output = Vec<codex_extension_api::PromptFragment>> + Send + 'a>,
+    > {
+        Box::pin(async move {
+            self.entered.notify_one();
+            self.release.notified().await;
+            Vec::new()
+        })
+    }
+}
+
+#[tokio::test]
+async fn token_budget_context_commit_respects_late_stop() {
+    for stopped in [false, true] {
+        let (mut session, turn_context, events) =
+            make_session_and_context_with_auth_and_config_and_rx(
+                CodexAuth::from_api_key("Test API Key"),
+                Vec::new(),
+                |config| {
+                    config.features.enable(Feature::TokenBudget).unwrap();
+                    config.model_context_window = Some(10_000);
+                },
+            )
+            .await;
+        let rollout_path =
+            attach_thread_persistence(Arc::get_mut(&mut session).expect("unique session")).await;
+        let entered = Arc::new(tokio::sync::Notify::new());
+        let release = Arc::new(tokio::sync::Notify::new());
+        let mut registry = codex_extension_api::ExtensionRegistryBuilder::new();
+        registry.prompt_contributor(Arc::new(HeldContextWindow {
+            entered: entered.clone(),
+            release: release.clone(),
+        }));
+        Arc::get_mut(&mut session)
+            .expect("unique session")
+            .services
+            .extensions = Arc::new(registry.build());
+        turn_context
+            .extension_data
+            .insert(codex_extension_api::TurnSamplingStop::default());
+        let stop = turn_context
+            .extension_data
+            .get::<codex_extension_api::TurnSamplingStop>()
+            .unwrap();
+        let step = session
+            .capture_step_context(turn_context.clone(), &CancellationToken::new())
+            .await
+            .unwrap();
+        let world = Arc::new(session.build_world_state_for_step(&step).await.unwrap());
+        let before = {
+            let mut state = session.state.lock().await;
+            state.set_auto_compact_window_estimated_prefill(123);
+            (
+                state.auto_compact_window_ids(),
+                state.auto_compact_window_number(),
+                state.auto_compact_window_snapshot(),
+                raw_history_items(&state.clone_history()),
+            )
+        };
+        let task = tokio::spawn(crate::compact_token_budget::run_inline_auto_compact_task(
+            session.clone(),
+            step,
+            world,
+        ));
+        tokio::time::timeout(std::time::Duration::from_secs(5), entered.notified())
+            .await
+            .unwrap();
+        let mut started = false;
+        while let Ok(event) = events.try_recv() {
+            started |= matches!(
+                event.msg,
+                EventMsg::ItemStarted(codex_protocol::protocol::ItemStartedEvent {
+                    item: TurnItem::ContextCompaction(_),
+                    ..
+                })
+            );
+        }
+        assert!(started, "context build must follow compaction start");
+        if stopped {
+            stop.request();
+        }
+        release.notify_one();
+        if stopped {
+            assert!(
+                tokio::time::timeout(std::time::Duration::from_millis(100), async {
+                    while !task.is_finished() {
+                        tokio::task::yield_now().await;
+                    }
+                })
+                .await
+                .is_err(),
+                "stopped reset completed before interrupt"
+            );
+            let state = session.state.lock().await;
+            assert_eq!(state.auto_compact_window_ids(), before.0);
+            assert_eq!(state.auto_compact_window_number(), before.1);
+            assert_eq!(state.auto_compact_window_snapshot(), before.2);
+            assert_eq!(raw_history_items(&state.clone_history()), before.3);
+            drop(state);
+            while let Ok(event) = events.try_recv() {
+                assert!(!matches!(
+                    event.msg,
+                    EventMsg::ItemCompleted(codex_protocol::protocol::ItemCompletedEvent {
+                        item: TurnItem::ContextCompaction(_),
+                        ..
+                    })
+                ));
+            }
+            task.abort();
+            assert!(task.await.unwrap_err().is_cancelled());
+        } else {
+            tokio::time::timeout(std::time::Duration::from_secs(5), task)
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            let state = session.state.lock().await;
+            assert_eq!(state.auto_compact_window_number(), before.1 + 1);
+            let ids = state.auto_compact_window_ids();
+            assert_ne!(ids.window_id, before.0.window_id);
+            assert_eq!(ids.previous_window_id, Some(before.0.window_id));
+            let text = developer_input_texts(&raw_history_items(&state.clone_history())).join("\n");
+            assert!(
+                text.contains(&ids.window_id.to_string()),
+                "rendered context must use committed window ID"
+            );
+        }
+        session.flush_rollout().await.unwrap();
+        let InitialHistory::Resumed(persisted) =
+            RolloutRecorder::get_rollout_history(&rollout_path)
+                .await
+                .unwrap()
+        else {
+            panic!("expected persisted session");
+        };
+        assert_eq!(
+            persisted
+                .history
+                .iter()
+                .filter(|item| matches!(item, RolloutItem::Compacted(_)))
+                .count(),
+            usize::from(!stopped)
+        );
+    }
+}
