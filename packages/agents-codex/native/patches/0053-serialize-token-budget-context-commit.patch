+    /// Serialize a synchronous context commit with stop reservation.
+    /// The callback must not block, await, or call back into the host.
+    pub fn try_commit<T>(&self, commit: impl FnOnce() -> T) -> Option<T> {
+        let _commit = self
+            .commit
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
