+#[cfg(test)]
+mod sampling_stop_tests {
+    use super::TurnSamplingStop;
+
+    #[test]
+    fn context_commit_respects_turn_and_parent_stops() {
+        let parent = TurnSamplingStop::default();
+        let turn = parent.for_turn();
+        let sibling = parent.for_turn();
+        assert_eq!(turn.try_commit(|| 1), Some(1));
+        turn.clone().request();
+        assert_eq!(
+            turn.try_commit(|| panic!("stopped turn committed")),
+            None::<()>
+        );
+        assert_eq!(sibling.try_commit(|| 2), Some(2));
+        parent.request();
+        assert_eq!(
+            sibling.try_commit(|| panic!("stopped parent committed")),
+            None::<()>
+        );
+        assert_eq!(TurnSamplingStop::default().try_commit(|| 3), Some(3));
+    }
+}
