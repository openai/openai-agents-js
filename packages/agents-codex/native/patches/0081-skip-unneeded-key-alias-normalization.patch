 pub(crate) fn normalize_key_aliases(value: &TomlValue) -> TomlValue {
+    if !CONFIG_KEY_ALIASES
+        .iter()
+        .any(|alias| may_contain_legacy_path(value, alias.legacy))
+    {
+        return value.clone();
+    }
     normalize_key_aliases_at_path(value, &[])
 }
 
+// Prove absence only. Arrays retain the existing recursive normalization path.
+fn may_contain_legacy_path(mut value: &TomlValue, path: &[&str]) -> bool {
+    for segment in path {
+        let Some(table) = value.as_table() else {
+            return value.is_array();
+        };
+        let Some(child) = table.get(*segment) else {
+            return false;
+        };
+        value = child;
+    }
+    // Any present legacy leaf (or an empty future path) requires the old behavior.
+    true
+}
