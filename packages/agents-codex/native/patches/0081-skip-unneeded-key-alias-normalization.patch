+#[test]
+fn nan_payload_and_signed_zero_bits_survive_fast_and_fallback_paths() {
+    let bits = [
+        0x7ff8_0000_0000_0042_u64,
+        (-0.0_f64).to_bits(),
+        0.0_f64.to_bits(),
+    ];
+    for use_alias in [false, true] {
+        let mut table = TomlMap::new();
+        for (index, bits) in bits.into_iter().enumerate() {
+            table.insert(
+                format!("number{index}"),
+                TomlValue::Float(f64::from_bits(bits)),
+            );
+        }
+        if use_alias {
+            table.insert("tui".to_string(), toml::from_str("whimsy = true").unwrap());
+        }
+        let value = TomlValue::Table(table);
+        assert_eq!(
+            CONFIG_KEY_ALIASES
+                .iter()
+                .any(|alias| may_contain_legacy_path(&value, alias.legacy)),
+            use_alias
+        );
+        let actual = normalize_key_aliases(&value);
+        let expected = normalize_key_aliases_at_path(&value, &[]);
+        for (index, bits) in bits.into_iter().enumerate() {
+            let key = format!("number{index}");
+            assert_eq!(actual[key.as_str()].as_float().unwrap().to_bits(), bits);
+            assert_eq!(expected[key.as_str()].as_float().unwrap().to_bits(), bits);
+        }
+    }
+}
