+use super::*;
+
+#[test]
+fn present_aliases_keep_canonical_precedence_and_blocked_destinations() {
+    for source in [
+        "tui.whimsy = true",
+        "memories.no_memories_if_mcp_or_web_search = false",
+        "agents.max_threads = 3",
+        "tui.whimsy = true\ntui.effects.starfield = false",
+        "memories.no_memories_if_mcp_or_web_search = true\nmemories.disable_on_external_context = false",
+        "agents.max_threads = 3\nagents.max_concurrent_threads_per_session = 7",
+        "tui.whimsy = true\ntui.effects = 'blocked'",
+    ] {
+        let value: TomlValue = toml::from_str(source).unwrap();
+        assert!(
+            CONFIG_KEY_ALIASES
+                .iter()
+                .any(|alias| may_contain_legacy_path(&value, alias.legacy))
+        );
+        assert_eq!(
+            normalize_key_aliases(&value),
+            normalize_key_aliases_at_path(&value, &[]),
+            "{source}"
+        );
+    }
+    let value: TomlValue = toml::from_str("tui.whimsy = true\ntui.effects = 'blocked'").unwrap();
+    let normalized = normalize_key_aliases(&value);
+    assert!(normalized["tui"].get("whimsy").is_none());
+    assert_eq!(normalized["tui"]["effects"].as_str(), Some("blocked"));
+}
+
+#[test]
+fn every_present_legacy_value_requires_fallback() {
+    for literal in [
+        "true",
+        "3",
+        "1.25",
+        "'value'",
+        "1979-05-27T07:32:00Z",
+        "[]",
+        "[1, 2]",
+        "{}",
+        "{ nested = true }",
+    ] {
+        let value: TomlValue = toml::from_str(&format!("tui.whimsy = {literal}")).unwrap();
+        assert!(may_contain_legacy_path(&value, &["tui", "whimsy"]));
+        assert_eq!(
+            normalize_key_aliases(&value),
+            normalize_key_aliases_at_path(&value, &[]),
+            "{literal}"
+        );
+    }
+}
+
+#[test]
+fn relevant_arrays_conservatively_keep_recursive_behavior() {
+    let aliased: TomlValue = toml::from_str("tui.whimsy = true").unwrap();
+    let nested: TomlValue =
+        toml::from_str("tui = [[{ whimsy = false }], { effects = 'blocked', whimsy = true }]")
+            .unwrap();
+    for value in [
+        TomlValue::Array(Vec::new()),
+        TomlValue::Array(vec![TomlValue::Integer(1)]),
+        TomlValue::Array(vec![aliased.clone()]),
+        TomlValue::Array(vec![TomlValue::Array(vec![aliased])]),
+        toml::from_str("tui = []").unwrap(),
+        nested,
+    ] {
+        assert!(may_contain_legacy_path(&value, &["tui", "whimsy"]));
+        assert_eq!(
+            normalize_key_aliases(&value),
+            normalize_key_aliases_at_path(&value, &[])
+        );
+    }
+}
+
+#[test]
+fn no_alias_proof_uses_literal_paths_and_ignores_unrelated_subtrees() {
+    for source in [
+        "",
+        "tui = 'scalar parent'",
+        "tui.effects.starfield = true",
+        "memories.disable_on_external_context = false",
+        "agents.max_concurrent_threads_per_session = 7",
+        "'tui.whimsy' = true\n'agents.max_threads' = 4",
+        "other.tui.whimsy = true",
+        "profiles.example.tui.whimsy = true",
+        "payload = [{ tui = { whimsy = true } }]",
+    ] {
+        let value: TomlValue = toml::from_str(source).unwrap();
+        assert!(
+            !CONFIG_KEY_ALIASES
+                .iter()
+                .any(|alias| may_contain_legacy_path(&value, alias.legacy)),
+            "{source}"
+        );
+        assert_eq!(
+            normalize_key_aliases(&value),
+            normalize_key_aliases_at_path(&value, &[]),
+            "{source}"
+        );
+    }
+    // An empty future registry path must never certify absence.
+    assert!(may_contain_legacy_path(&TomlValue::Boolean(false), &[]));
+}
+
+#[test]
+fn no_alias_values_keep_types_order_and_independent_ownership() {
+    for value in [
+        TomlValue::Boolean(true),
+        TomlValue::Integer(7),
+        TomlValue::Float(1.25),
+        TomlValue::String("text".to_string()),
+    ] {
+        assert!(
+            !CONFIG_KEY_ALIASES
+                .iter()
+                .any(|alias| may_contain_legacy_path(&value, alias.legacy))
+        );
+        assert_eq!(
+            normalize_key_aliases(&value),
+            normalize_key_aliases_at_path(&value, &[])
+        );
+    }
+    let value: TomlValue = toml::from_str(
+        "name = 'original'\nwhen = 1979-05-27T07:32:00Z\npayload = [{ name = 'nested' }]",
+    )
+    .unwrap();
+    let mut normalized = normalize_key_aliases(&value);
+    assert_eq!(normalized, normalize_key_aliases_at_path(&value, &[]));
+    assert_eq!(
+        normalized.as_table().unwrap().keys().collect::<Vec<_>>(),
+        value.as_table().unwrap().keys().collect::<Vec<_>>()
+    );
+    normalized["name"] = TomlValue::String("changed".to_string());
+    normalized["payload"][0]["name"] = TomlValue::String("changed nested".to_string());
+    assert_eq!(value["name"].as_str(), Some("original"));
+    assert_eq!(value["payload"][0]["name"].as_str(), Some("nested"));
+    assert_eq!(normalized["when"], value["when"]);
+}
