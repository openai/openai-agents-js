+    fn webrtc_ready() -> Control {
+        let mut control = Control::default();
+        let started = command(
+            &mut control,
+            json!({"type":"start","clear_output_audio_on_interrupt":true,"config":{"model":"test-realtime","instructions":"Help.","tools":[tool()]}}),
+        );
