+// Reserve workspace mutations before dispatch tasks can be scheduled out of order.
+// Automatic callbacks remain concurrent, but later mutations await their settlement.
+// Manual callbacks stay independent so they can unblock an automatic callback.
+struct OrderedWorkspaceCalls {
+    state: std::sync::Mutex<WorkspaceDispatchState>,
+    progress: tokio::sync::watch::Sender<CallbackProgress>,
+}
+
+impl Default for OrderedWorkspaceCalls {
+    fn default() -> Self {
+        let (progress, _) = tokio::sync::watch::channel(CallbackProgress::default());
+        Self {
+            state: std::sync::Mutex::new(WorkspaceDispatchState::default()),
+            progress,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+struct CallbackProgress {
+    settled: usize,
+    failed_at: Option<usize>,
+}
+
+#[derive(Default)]
+struct WorkspaceDispatchState {
+    waiting: VecDeque<WorkspaceWaiter>,
+    callbacks: VecDeque<bool>,
+    progress: CallbackProgress,
+}
+
+struct CallbackBarrier {
+    progress: tokio::sync::watch::Receiver<CallbackProgress>,
+    through: usize,
+    failed: bool,
+}
+
+impl CallbackBarrier {
+    async fn wait(mut self) -> Result<(), FunctionCallError> {
+        if self.failed {
+            return Err(FunctionCallError::Fatal(
+                "Earlier automatic callback failed".into(),
+            ));
+        }
+        let progress = self
+            .progress
+            .wait_for(|progress| {
+                let boundary = progress
+                    .failed_at
+                    .filter(|failed| *failed <= self.through)
+                    .unwrap_or(self.through);
+                progress.settled >= boundary
+            })
+            .await
+            .map_err(|_| FunctionCallError::Fatal("Automatic callback settlement closed".into()))?;
+        if progress
+            .failed_at
+            .is_some_and(|failed| failed <= self.through)
+        {
+            return Err(FunctionCallError::Fatal(
+                "Earlier automatic callback failed".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+struct AutomaticCallbackLease {
+    calls: Arc<OrderedWorkspaceCalls>,
+    sequence: usize,
+    success: bool,
+}
+
+impl Drop for AutomaticCallbackLease {
+    fn drop(&mut self) {
+        let mut state = self
+            .calls
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        if !self.success {
+            state.progress.failed_at = Some(
+                state
+                    .progress
+                    .failed_at
+                    .map_or(self.sequence, |previous| previous.min(self.sequence)),
+            );
+        }
+        let index = self.sequence - state.progress.settled - 1;
+        state.callbacks[index] = true;
+        while state.callbacks.front() == Some(&true) {
+            state.callbacks.pop_front();
+            state.progress.settled += 1;
+        }
+        self.calls.progress.send_replace(state.progress);
+    }
+}
+
+struct WorkspaceWaiter {
+    identity: Arc<()>,
+    ready: Option<tokio::sync::oneshot::Sender<()>>,
+}
+
+struct WorkspaceTicket {
+    lease: WorkspaceLease,
+    ready: tokio::sync::oneshot::Receiver<()>,
+    callbacks: CallbackBarrier,
+}
+
+struct WorkspaceLease {
+    calls: Arc<OrderedWorkspaceCalls>,
+    identity: Arc<()>,
+}
+
+impl OrderedWorkspaceCalls {
+    fn callbacks_at_drain(&self) -> (usize, bool) {
+        let state = self
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        (
+            state.progress.settled + state.callbacks.len(),
+            state.progress.failed_at.is_some(),
+        )
+    }
+
+    fn reserve_callback(self: &Arc<Self>) -> AutomaticCallbackLease {
+        let mut state = self
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        state.callbacks.push_back(false);
+        AutomaticCallbackLease {
+            calls: Arc::clone(self),
+            sequence: state.progress.settled + state.callbacks.len(),
+            success: false,
+        }
+    }
+
+    fn reserve(self: &Arc<Self>) -> WorkspaceTicket {
+        let (sender, ready) = tokio::sync::oneshot::channel();
+        let identity = Arc::new(());
+        let mut state = self
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        let callbacks = CallbackBarrier {
+            progress: self.progress.subscribe(),
+            through: state.progress.settled + state.callbacks.len(),
+            failed: state.progress.failed_at.is_some(),
+        };
+        let waiting = &mut state.waiting;
+        let sender = if waiting.is_empty() {
+            let _ = sender.send(());
+            None
+        } else {
+            Some(sender)
+        };
+        waiting.push_back(WorkspaceWaiter {
+            identity: Arc::clone(&identity),
+            ready: sender,
+        });
+        WorkspaceTicket {
+            lease: WorkspaceLease {
+                calls: Arc::clone(self),
+                identity,
+            },
+            ready,
+            callbacks,
+        }
+    }
+}
+
+impl Drop for WorkspaceLease {
+    fn drop(&mut self) {
+        let mut state = self
+            .calls
+            .state
+            .lock()
+            .expect("workspace dispatch queue poisoned");
+        let waiting = &mut state.waiting;
+        let Some(position) = waiting
+            .iter()
+            .position(|entry| Arc::ptr_eq(&entry.identity, &self.identity))
+        else {
+            return;
+        };
+        waiting.remove(position);
+        // Removing a cancelled middle waiter cannot release the next mutation
+        // while the original head is still running.
+        if position == 0
+            && let Some(next) = waiting.front_mut()
+            && let Some(ready) = next.ready.take()
+        {
+            let _ = ready.send(());
+        }
+    }
+}
