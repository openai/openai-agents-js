+        let legacy = serde_json::json!({"response_id":"compact-or-legacy","token_usage":null,"usage_metadata":null});
+        let event: RawResponseCompletedEvent = serde_json::from_value(legacy.clone()).unwrap();
+        assert!(event.model_attempt_id.is_none());
+        assert_eq!(serde_json::to_value(event).unwrap(), legacy);
+        let event = RawResponseCompletedEvent {
+            model_attempt_id: Some("native-generation-attempt".into()),
+            response_id: "provider-response".into(),
+            token_usage: None,
+            usage_metadata: None,
+        };
+        let encoded = serde_json::to_value(&event).unwrap();
+        assert_eq!(encoded["model_attempt_id"], "native-generation-attempt");
+        let decoded: RawResponseCompletedEvent = serde_json::from_value(encoded).unwrap();
+        assert_eq!(decoded.model_attempt_id, event.model_attempt_id);
+        assert_eq!(decoded.response_id, "provider-response");
+    }
+}
