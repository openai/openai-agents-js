+//! Captured retry configuration and logical-attempt facts. Core owns execution.
+use crate::protocol::TokenUsage;
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetrySettings {
+    /// Distinguishes explicit empty settings from an inherited policy-disable marker.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub configured: Option<bool>,
+    /// Captured runtime declaration marker; never executable callback data.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub has_policy: Option<bool>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub max_retries: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub backoff: Option<ModelRetryBackoff>,
+}
+
+#[derive(Debug, Clone, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(default, deny_unknown_fields)]
+pub struct ModelRetryBackoff {
+    pub initial_delay_ms: f64,
+    pub max_delay_ms: f64,
+    pub multiplier: f64,
+    pub jitter: bool,
+}
+
+impl Default for ModelRetryBackoff {
+    fn default() -> Self {
+        Self {
+            initial_delay_ms: 250.0,
+            max_delay_ms: 2_000.0,
+            multiplier: 2.0,
+            jitter: true,
+        }
+    }
+}
+
+impl ModelRetrySettings {
+    pub fn apply_patch(&mut self, patch: &Self) {
+        if patch.configured.is_some() {
+            self.configured = patch.configured;
+        }
+        if patch.has_policy.is_some() {
+            self.has_policy = patch.has_policy;
+        }
+        if patch.max_retries.is_some() {
+            self.max_retries = patch.max_retries;
+        }
+        if patch.backoff.is_some() {
+            self.backoff = patch.backoff.clone();
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), String> {
+        if let Some(backoff) = &self.backoff {
+            for (name, value) in [
+                ("initial_delay_ms", backoff.initial_delay_ms),
+                ("max_delay_ms", backoff.max_delay_ms),
+                ("multiplier", backoff.multiplier),
+            ] {
+                if !value.is_finite() || value < 0.0 {
+                    return Err(format!(
+                        "retry.backoff.{name} must be finite and nonnegative"
+                    ));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryError {
+    pub message: String,
+    #[serde(default)]
+    pub status_code: Option<u16>,
+    #[serde(default)]
+    pub error_code: Option<String>,
+    #[serde(default)]
+    pub request_id: Option<String>,
+    #[serde(default)]
+    pub retry_after_ms: Option<f64>,
+    #[serde(default)]
+    pub is_abort: bool,
+    #[serde(default)]
+    pub is_network_error: bool,
+    #[serde(default)]
+    pub is_timeout: bool,
+}
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(rename_all = "snake_case")]
+pub enum ModelReplaySafety {
+    Safe,
+    Unsafe,
+    #[default]
+    Unknown,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryAdvice {
+    #[serde(default)]
+    pub suggested: Option<bool>,
+    #[serde(default)]
+    pub retry_after_ms: Option<f64>,
+    #[serde(default)]
+    pub replay_safety: ModelReplaySafety,
+    #[serde(default)]
+    pub reason: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryDecision {
+    pub retry: bool,
+    #[serde(default)]
+    pub delay_ms: Option<f64>,
+    #[serde(default)]
+    pub reason: Option<String>,
+    #[serde(default)]
+    pub approve_unsafe_replay: bool,
+}
+
+impl ModelRetryDecision {
+    pub fn validate(&self) -> Result<(), String> {
+        if self
+            .delay_ms
+            .is_some_and(|delay| !delay.is_finite() || delay < 0.0)
+        {
+            return Err("Retry decision delay_ms must be finite and nonnegative".into());
+        }
+        Ok(())
+    }
+}
+
+/// One Core-owned logical generation attempt, not an opaque client HTTP retry.
+#[derive(Debug, Clone, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryContext {
+    pub attempt_id: String,
+    /// Exact retained provider exception selected by Core; absent for native failures.
+    pub original_error_attempt_id: Option<String>,
+    #[ts(type = "number")]
+    pub attempt: u64,
+    #[ts(type = "number")]
+    pub request_attempt: u64,
+    pub max_retries: u32,
+    pub policy_enabled: bool,
+    pub thread_id: String,
+    pub turn_id: String,
+    pub model: String,
+    pub transport: String,
+    pub normalized: ModelRetryError,
+    pub provider_advice: ModelRetryAdvice,
+    pub response_started: bool,
+    pub retry_unsafe_output: bool,
+    pub local_effects: bool,
+    pub stateful: bool,
+    pub previous_response_id: Option<String>,
+    pub conversation_id: Option<String>,
+    pub usage: Option<TokenUsage>,
+}
+
+/// Cumulative native facts for one exact turn. Explicit host reports stay separate.
+/// Live events, final results and checkpoints carry the same authoritative totals.
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelAttemptUsage {
+    #[ts(type = "number")]
+    pub requests: u64,
+    pub token_usage: TokenUsage,
+    #[ts(type = "number")]
+    pub requests_without_token_usage: u64,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelAttemptSnapshot {
+    /// First existing attempt UUID; stable within this ledger, fresh after restore.
+    pub owner_attempt_id: Option<String>,
+    pub usage: ModelAttemptUsage,
+    pub terminal_attempt_id: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelProducerFailure {
+    pub attempt_id: String,
+    pub normalized: ModelRetryError,
+    #[serde(default)]
+    pub usage: Option<TokenUsage>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRetryResolution {
+    /// None retains Core's decision while allowing captured backend advice.
+    pub decision: Option<ModelRetryDecision>,
+    #[serde(default)]
+    pub provider_advice: Option<ModelRetryAdvice>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Deserialize, Serialize, JsonSchema, TS)]
+#[serde(rename_all = "snake_case")]
+pub enum ModelAttemptPhase {
+    Started,
+    Measured,
+    Finished,
+    Retry,
+    Terminal,
+    Cancelled,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn captures_configuration_without_executable_policy() {
+        let retry: ModelRetrySettings =
+            serde_json::from_str(r#"{"max_retries":0,"backoff":{"multiplier":1.5}}"#).unwrap();
+        assert_eq!(retry.max_retries, Some(0));
+        let backoff = retry.backoff.unwrap();
+        assert_eq!(backoff.initial_delay_ms, 250.0);
+        assert_eq!(backoff.multiplier, 1.5);
+        assert!(serde_json::from_str::<ModelRetrySettings>(r#"{"policy":true}"#).is_err());
+    }
+
+    #[test]
+    fn rejects_invalid_policy_delay_and_backoff() {
+        for delay in [-1.0, f64::NAN, f64::INFINITY] {
+            assert!(
+                ModelRetryDecision {
+                    retry: true,
+                    delay_ms: Some(delay),
+                    ..Default::default()
+                }
+                .validate()
+                .is_err()
+            );
+            assert!(
+                ModelRetrySettings {
+                    backoff: Some(ModelRetryBackoff {
+                        multiplier: delay,
+                        ..Default::default()
+                    }),
+                    ..Default::default()
+                }
+                .validate()
+                .is_err()
+            );
+        }
+    }
+}
