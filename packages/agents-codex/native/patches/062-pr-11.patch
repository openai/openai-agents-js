+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn begin(ledger: &Arc<AttemptLedger>, parent: &Arc<TurnSamplingStop>) -> Arc<Attempt> {
+        ledger
+            .begin(1, parent, &CancellationToken::new(), true, false)
+            .unwrap()
+    }
+
+    #[test]
+    fn retained_attempt_keeps_exact_usage_after_turn_store_release_without_a_cycle() {
+        let ledger = Arc::new(AttemptLedger::default());
+        let ledger_weak = Arc::downgrade(&ledger);
+        let parent = Arc::new(TurnSamplingStop::default());
+        let attempt = begin(&ledger, &parent);
+        attempt
+            .report_usage(TokenUsage {
+                input_tokens: 7,
+                total_tokens: 7,
+                ..Default::default()
+            })
+            .unwrap();
+        drop(ledger);
+        assert_eq!(
+            attempt.snapshot().unwrap().usage.token_usage.input_tokens,
+            7
+        );
+        assert_eq!(
+            attempt
+                .snapshot()
+                .unwrap()
+                .usage
+                .requests_without_token_usage,
+            0
+        );
+        drop(attempt);
+        assert!(ledger_weak.upgrade().is_none());
+    }
+
+    #[test]
+    fn joined_old_usage_is_attributed_once_before_next_attempt() {
+        let ledger = Arc::new(AttemptLedger::default());
+        let parent = Arc::new(TurnSamplingStop::default());
+        let first = begin(&ledger, &parent);
+        first.stop.request();
+        first
+            .report_usage(TokenUsage {
+                input_tokens: 2,
+                total_tokens: 2,
+                ..Default::default()
+            })
+            .unwrap();
+        assert!(
+            ledger
+                .begin(2, &parent, &CancellationToken::new(), true, true)
+                .is_err()
+        );
+        let before_join = ledger.snapshot();
+        assert_eq!(before_join.owner_attempt_id.as_deref(), Some(first.id()));
+        assert_eq!(before_join.usage.token_usage.total_tokens, 2);
+        assert_eq!(before_join.usage.requests_without_token_usage, 0);
+        ledger.settle(&first).unwrap();
+        assert_eq!(ledger.snapshot(), before_join);
+        assert!(first.report_usage(TokenUsage::default()).is_err());
+        assert!(!parent.requested());
+        let retry = begin(&ledger, &parent);
+        retry
+            .report_usage(TokenUsage {
+                output_tokens: 3,
+                total_tokens: 3,
+                ..Default::default()
+            })
+            .unwrap();
+        ledger.settle(&retry).unwrap();
+        assert!(ledger.settle(&retry).is_err());
+        assert_eq!(
+            ledger.snapshot().owner_attempt_id,
+            before_join.owner_attempt_id
+        );
+        let usage = ledger.snapshot().usage;
+        assert_eq!(usage.requests, 2);
+        assert_eq!(usage.token_usage.total_tokens, 5);
+        assert_eq!(usage.requests_without_token_usage, 0);
+    }
+
+    #[test]
+    fn fresh_restored_owner_does_not_recount_the_historical_attempt() {
+        let ledger = Arc::new(AttemptLedger::default());
+        let parent = Arc::new(TurnSamplingStop::default());
+        let first = begin(&ledger, &parent);
+        ledger.settle(&first).unwrap();
+        ledger.terminal(&first).unwrap();
+        let snapshot = ledger.snapshot();
+        assert_eq!(snapshot.usage.requests_without_token_usage, 1);
+        // The detached snapshot belongs only to the host historical offset.
+        // Fresh runtime attachment data cannot contain the old held attempt.
+        let restored = Arc::new(AttemptLedger::default());
+        let retry = begin(&restored, &parent);
+        assert_eq!(retry.attempt(), 1);
+        assert_eq!(restored.snapshot().usage.requests, 1);
+        assert_ne!(first.id(), retry.id());
+        assert_ne!(
+            snapshot.owner_attempt_id,
+            restored.snapshot().owner_attempt_id
+        );
+        assert!(restored.snapshot().terminal_attempt_id.is_none());
+    }
+
+    #[test]
+    fn held_measured_attempt_settles_only_into_its_original_owner() {
+        let original = Arc::new(AttemptLedger::default());
+        let parent = Arc::new(TurnSamplingStop::default());
+        let old = begin(&original, &parent);
+        old.report_usage(TokenUsage {
+            total_tokens: 2,
+            ..Default::default()
+        })
+        .unwrap();
+        let historical = original.snapshot();
+        let restored = Arc::new(AttemptLedger::default());
+        let current = begin(&restored, &parent);
+        current
+            .report_usage(TokenUsage {
+                total_tokens: 3,
+                ..Default::default()
+            })
+            .unwrap();
+        let fresh_projection = restored.snapshot();
+        assert!(restored.settle(&old).is_err());
+        original.settle(&old).unwrap();
+        assert_eq!(original.snapshot(), historical);
+        assert_eq!(restored.snapshot(), fresh_projection);
+        restored.settle(&current).unwrap();
+        assert_eq!(
+            historical.usage.requests + restored.snapshot().usage.requests,
+            2
+        );
+        assert_eq!(
+            historical.usage.token_usage.total_tokens
+                + restored.snapshot().usage.token_usage.total_tokens,
+            5
+        );
+        assert_ne!(
+            historical.owner_attempt_id,
+            restored.snapshot().owner_attempt_id
+        );
+    }
