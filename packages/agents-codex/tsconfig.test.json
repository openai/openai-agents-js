{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@hyperjump/json-schema/experimental": [
        "../../node_modules/@hyperjump/json-schema/lib/experimental"
      ],
      "@hyperjump/json-schema/instance/experimental": [
        "../../node_modules/@hyperjump/json-schema/lib/instance"
      ],
      "@openai/agents": ["../agents/src/index.ts"],
      "@openai/agents/*": ["../agents/src/*"],
      "@openai/agents-codex": ["./src/index.ts"],
      "@openai/agents-codex/*": ["./src/*"]
    },
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist/**", "native/**"]
}
