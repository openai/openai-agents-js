  "scripts": {
    "prebuild": "node ../../scripts/embedMeta.mts",
    "build": "tsc",
    "build-check": "tsc --noEmit -p ./tsconfig.test.json",
    "dist:check": "tsc --noEmit -p ./tsconfig.dist-check.json",
    "native:prepare": "node scripts/native.mjs prepare",
    "native:build": "node scripts/native.mjs build",
    "native:audit": "node scripts/native.mjs audit",
    "native:portable": "node ../../scripts/build-portable-realtime.mjs"
  },
  "dependencies": {
    "@openai/agents-core": "workspace:*",
    "openai": "^7.2.0",
    "ws": "^8.22.0",
    "zod": "^4.3.5",
    "email-addresses": "5.0.0",
    "@hyperjump/json-schema": "1.18.0",
    "@hyperjump/browser": "1.6.0",
    "@hyperjump/uri": "1.3.9",
    "zod-deferred": "npm:zod@4.6.7"
  },
  "keywords": [
    "openai",
    "agents",
    "ai",
    "agentic"
  ],
  "license": "MIT",
  "devDependencies": {
    "@openai/agents-openai": "workspace:*",
    "@openai/agents-realtime": "workspace:*",
    "@types/ws": "^8.18.2",
    "ai": "6.0.277"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "files": [
    "dist",
    "native/index.js",
    "native/index.d.ts",
    "native/codex.node",
    "native/CODEX_REVISION",
    "native/build-receipt.json",
    "bin",
    "NATIVE.md",
    "licenses",
    "TESTING.md",
    "EXTERNAL_JOBS.md",
    "MCP_TASKS.md",
    "experimental",
    "a2a",
    "A2A.md",
    "native/codex-realtime-control.wasm",
    "native/portable-build-receipt.json",
    "PORTABLE_CONTROL.md"
  ],
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "experimental/deferred": [
        "dist/experimental/deferred.d.ts"
      ],
      "experimental/mcp-tasks": [
        "dist/experimental/mcp-tasks/index.d.ts"
      ],
      "a2a": [
        "dist/a2a/index.d.ts"
      ],
