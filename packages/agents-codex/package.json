      ],
      "voice/workerd": [
        "dist/voice/workerd.d.ts"
      ],
      "voice/twilio": [
        "dist/voice/twilio.d.ts"
      ],
      "voice/portable": [
        "dist/voice/portable.d.ts"
      ],
      "memory": [
        "dist/memory/index.d.ts"
      ],
      "artifacts": [
        "dist/artifacts/index.d.ts"
      ],
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "mcp-apps": [
        "dist/mcp-apps/index.d.ts"
      ]
    }
  },
  "optionalDependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0"
  }
