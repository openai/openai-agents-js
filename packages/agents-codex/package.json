{
  "name": "@openai/agents-codex",
  "repository": "https://github.com/openai/openai-agents-js",
  "homepage": "https://openai.github.io/openai-agents-js/",
  "version": "0.21.0",
  "description": "The embedded Codex runtime for the OpenAI Agents SDK.",
  "author": "OpenAI <support@openai.com>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.mts",
        "default": "./dist/testing/index.mjs"
      },
      "require": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "./experimental/deferred": {
      "import": {
        "types": "./dist/experimental/deferred.d.mts",
        "default": "./dist/experimental/deferred.mjs"
      },
      "require": {
        "types": "./dist/experimental/deferred.d.ts",
        "default": "./dist/experimental/deferred.js"
      }
    },
    "./experimental/mcp-tasks": {
