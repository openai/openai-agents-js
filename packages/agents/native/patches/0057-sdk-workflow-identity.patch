+    fn workflow_identity_uses_selected_parent_and_survives_closed_nonrecording_scopes() {
+        const CHILD: &str = "CODEX_SDK_WORKFLOW_IDENTITY_CHILD";
+        if std::env::var_os(CHILD).is_none() {
+            let status = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "sdk_trace::tests::workflow_identity_uses_selected_parent_and_survives_closed_nonrecording_scopes"])
+                .env(CHILD, "1").status().unwrap();
+            assert!(status.success());
+            return;
+        }
+        configure_pipeline(false);
+        let start = |value: Value| -> Value {
+            serde_json::from_str(&start_trace_span(&value.to_string()).unwrap()).unwrap()
+        };
+        let a = start(
+            json!({"name":"A","kind":"workflow","disabled":true,"trace_id":"123456789012345678901234567890ab"}),
+        );
+        let b = start(json!({"name":"B","kind":"workflow","parent":a["handle"]}));
+        assert_eq!(a["trace_id"], b["trace_id"]);
+        assert_eq!(a["workflow_span_id"], a["span_id"]);
+        assert_eq!(b["workflow_span_id"], b["span_id"]);
+        assert_ne!(a["workflow_span_id"], b["workflow_span_id"]);
+        let child = start(
+            json!({"name":"child","kind":"custom","parent":a["handle"],"restrictions_parents":[b["handle"]]}),
+        );
+        assert_eq!(child["workflow_span_id"], a["span_id"]);
+        let detached = start(
+            json!({"name":"detached","kind":"custom","parent":a["handle"],"detached":true,"restrictions_parents":[b["handle"]]}),
+        );
+        assert!(detached["workflow_span_id"].is_null());
+        let lease = retain_trace_context(child["handle"].as_str().unwrap()).unwrap();
+        for scope in [&a, &b, &child, &detached] {
+            let key = scope["handle"].as_str().unwrap();
+            end_trace_span(key, r#"{"status":"ok"}"#).unwrap();
+            release_trace_span(key);
+        }
+        let carrier = trace_carrier(&lease).unwrap();
+        let parent = crate::context_from_w3c_trace_context(&carrier).unwrap();
+        assert_eq!(
+            policy_for_context(&parent)
+                .unwrap()
+                .workflow_span_id
+                .unwrap()
+                .to_string(),
+            a["span_id"]
+        );
+        let guard = parent.attach();
+        let token = current_context_token().unwrap();
+        let callback: Value = serde_json::from_str(&trace_span_context(&token).unwrap()).unwrap();
+        assert_eq!(callback["workflow_span_id"], a["span_id"]);
+        release_trace_context(&token);
+        drop(guard);
+        release_trace_context(&lease);
+    }
