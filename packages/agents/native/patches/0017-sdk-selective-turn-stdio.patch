+fn root_input(
+    home: &Path,
+    log: &Path,
+    include_turn: bool,
+    tx: Sender<Event>,
+    runtime_context: McpRuntimeContext,
+) -> McpRuntimeInput {
+    let mut input = input(home, log, "turn", tx, runtime_context);
+    let mut turn = input.mcp_servers["docs"].config().clone();
+    turn.sdk_turn_scoped_stdio = true;
+    let mut session = turn.clone();
+    session.sdk_turn_scoped_stdio = false;
+    let codex_config::McpServerTransportConfig::Stdio { args, .. } = &mut session.transport else {
+        unreachable!();
+    };
+    *args.last_mut().unwrap() = "session".to_owned();
+    input.mcp_servers.clear();
+    let mut catalog = crate::ResolvedMcpCatalog::builder();
+    if include_turn {
+        catalog.register(crate::McpServerRegistration::from_config(
+            "docs".to_owned(),
+            turn.clone(),
+        ));
+        input.mcp_servers.insert(
+            "docs".to_owned(),
+            EffectiveMcpServer::from_host_config(turn),
+        );
+    }
+    catalog.register(crate::McpServerRegistration::from_config(
+        "session".to_owned(),
+        session.clone(),
+    ));
+    input.mcp_servers.insert(
+        "session".to_owned(),
+        EffectiveMcpServer::from_host_config(session),
+    );
+    let config = Arc::make_mut(&mut input.config);
+    config.mcp_server_catalog = catalog.build();
+    config.set_server_permission_profiles(&input.mcp_servers, std::iter::empty());
+    input.client_mcp_extensions =
+        ClientMcpExtensions::new([("openai/sdk-root-prompts".to_owned(), serde_json::json!({}))]);
+    input
+}
+
+fn process_pids(log: &Path, label: &str) -> anyhow::Result<Vec<u64>> {
+    let mut pids = Vec::new();
+    for file in std::fs::read_dir(log)? {
+        let rows = std::fs::read_to_string(file?.path())?;
+        for line in rows.lines() {
+            let row: serde_json::Value = serde_json::from_str(line)?;
+            if row["event"] == "start" && row["label"] == label {
+                pids.push(row["pid"].as_u64().unwrap());
+            }
+        }
+    }
+    Ok(pids)
+}
+
+fn process_is_alive(pid: u64) -> anyhow::Result<bool> {
+    Ok(std::process::Command::new("kill")
+        .args(["-0", &pid.to_string()])
+        .output()?
+        .status
+        .success())
+}
+
+#[tokio::test]
+async fn sdk_root_turn_retirement_preserves_session_peer_through_roster_replacement()
+-> anyhow::Result<()> {
+    tokio::time::timeout(Duration::from_secs(45), async {
+        let home = tempfile::tempdir()?;
+        let log = home.path().join("processes");
+        std::fs::create_dir(&log)?;
+        let (tx, _rx) = async_channel::unbounded();
+        let runtime_context = McpRuntimeContext::new(
+            Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+            home.path().to_path_buf(),
+        );
+        let runtime = McpRuntime::empty(true);
+        // No admitted turn: start the session peer, leave the selected server dormant.
+        runtime
+            .replace(root_input(
+                home.path(),
+                &log,
+                true,
+                tx.clone(),
+                runtime_context.clone(),
+            ))
+            .await;
+        runtime.validate_required_servers().await?;
+        let session = process_pids(&log, "session")?;
+        assert_eq!(session.len(), 1);
+        assert!(process_pids(&log, "turn")?.is_empty());
+        let first =
+            codex_rmcp_client::ElicitationOwner::for_admission("first".to_owned(), Arc::new(()));
+        runtime.set_stdio_admission(first.clone());
+        runtime
+            .replace(root_input(
+                home.path(),
+                &log,
+                true,
+                tx.clone(),
+                runtime_context.clone(),
+            ))
+            .await;
+        runtime.validate_required_servers().await?;
+        let retained_binding = runtime.current_binding().await.expect("first binding");
+        let first_pids = process_pids(&log, "turn")?;
+        assert_eq!(first_pids.len(), 1);
+        assert_eq!(process_pids(&log, "session")?, session);
+        assert_eq!(runtime.stdio_retirement.lock().unwrap().len(), 1);
+        // Removing the selected server must not lose its retirement handle.
+        runtime
+            .replace(root_input(
+                home.path(),
+                &log,
+                false,
+                tx.clone(),
+                runtime_context.clone(),
+            ))
+            .await;
+        runtime.retire_owned_stdio().await?;
+        assert!(!first.is_live());
+        assert!(!process_is_alive(first_pids[0])?);
+        assert!(process_is_alive(session[0])?);
+        assert!(
+            retained_binding
+                .prepare_call("docs", "search")
+                .unwrap()
+                .call(None, None, None)
+                .await
+                .is_err()
+        );
+        let second =
+            codex_rmcp_client::ElicitationOwner::for_admission("second".to_owned(), Arc::new(()));
+        runtime.set_stdio_admission(second.clone());
+        runtime
+            .replace(root_input(home.path(), &log, true, tx, runtime_context))
+            .await;
+        runtime.validate_required_servers().await?;
+        assert_eq!(process_pids(&log, "session")?, session);
+        let turns = process_pids(&log, "turn")?;
+        assert_eq!(turns.len(), 2);
+        let successor = *turns.iter().find(|pid| **pid != first_pids[0]).unwrap();
+        assert!(process_is_alive(successor)?);
+        runtime.retire_owned_stdio().await?;
+        assert!(!second.is_live());
+        assert!(!process_is_alive(successor)?);
+        assert!(process_is_alive(session[0])?);
+        runtime.shutdown().await;
+        anyhow::Ok(())
+    })
+    .await?
+}
