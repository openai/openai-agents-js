+#[tokio::test]
+async fn sdk_root_prompts_require_the_original_live_owner_before_policy() {
+    let (manager, events, _) =
+        elicitation_fixture(AskForApproval::Never, PermissionProfile::Disabled, None);
+    let (tx, root_events) = async_channel::bounded(1);
+    let sender = manager.make_sender(
+        "independent-mcp".to_owned(),
+        Some(tx),
+        &ClientMcpExtensions::new([("openai/sdk-root-prompts".to_owned(), json!({}))]),
+    );
+    let absent = codex_rmcp_client::scope_owner(None, send_elicitation(&sender, None)).await;
+    assert_eq!(absent.action, ElicitationAction::Cancel);
+    let owner = codex_rmcp_client::ElicitationOwner::for_admission(
+        "original-root".to_owned(),
+        Arc::new(()),
+    );
+    let live =
+        codex_rmcp_client::scope_owner(Some(owner.clone()), send_elicitation(&sender, None)).await;
+    // Preserve full-access approval behavior once a real original admission exists.
+    assert_eq!(live.action, ElicitationAction::Accept);
+    owner.revoke();
+    let expired =
+        codex_rmcp_client::scope_owner(Some(owner), send_elicitation(&sender, None)).await;
+    assert_eq!(expired.action, ElicitationAction::Cancel);
+    assert!(root_events.try_recv().is_err());
+    assert!(events.try_recv().is_err());
+    assert!(manager.router.requests.lock().unwrap().is_empty());
+}
