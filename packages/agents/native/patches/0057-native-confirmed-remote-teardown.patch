+#[tokio::test]
+async fn confirmed_remote_termination_reuses_success_or_failure_through_drop() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    for rejected in [false, true] {
+        let calls = Arc::new(AtomicUsize::new(0));
+        let (session, _) = crate::session::tests::make_session_and_context().await;
+        let failed = session
+            .services
+            .local_agent_runtime
+            .remote_process_termination_policy();
+        let process = remote_process_with_termination_controls(
+            WriteStatus::Accepted,
+            rejected.then(|| "rejected".to_owned()),
+            codex_sandboxing::SandboxType::None,
+            calls.clone(),
+            None,
+            None,
+        )
+        .await;
+        process.confirm_remote_termination(failed.clone());
+        assert_eq!(process.terminate_confirmed().await.is_err(), rejected);
+        assert_eq!(process.terminate_confirmed().await.is_err(), rejected);
+        process.request_terminate();
+        process.terminate();
+        drop(process);
+        tokio::task::yield_now().await;
+        assert_eq!(
+            calls.load(Ordering::SeqCst),
+            1,
+            "cleanup never retries the remote operation"
+        );
+        assert_eq!(failed.failed(), rejected);
+    }
+}
