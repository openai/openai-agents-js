+#[tokio::test]
+async fn checked_remote_shutdown_retains_canceled_confirmation_after_empty_drain() {
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let session = Arc::new(session);
+    session
+        .services
+        .thread_extension_data
+        .insert(crate::ConfirmRemoteProcessTermination);
+    let entered = Arc::new(tokio::sync::Notify::new());
+    let release = Arc::new(tokio::sync::Notify::new());
+    let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let process = Arc::new(
+        crate::unified_exec::process_tests::remote_process_with_termination_controls(
+            codex_exec_server::WriteStatus::Accepted,
+            None,
+            codex_sandboxing::SandboxType::None,
+            calls.clone(),
+            Some(entered.clone()),
+            Some(release.clone()),
+        )
+        .await,
+    );
+    insert_remote_shutdown_process_instance(&session, &turn, process.clone()).await;
+    let closing = tokio::spawn({
+        let session = session.clone();
+        async move {
+            session.close_unified_exec_processes().await;
+        }
+    });
+    entered.notified().await;
+    closing.abort();
+    closing.await.expect_err("abort waiting drain");
+    assert!(
+        session
+            .services
+            .unified_exec_manager
+            .remote_process_termination_failed()
+    );
+    let final_drain = tokio::spawn({
+        let session = session.clone();
+        async move {
+            session.close_unified_exec_processes().await;
+        }
+    });
+    tokio::task::yield_now().await;
+    assert!(
+        !final_drain.is_finished(),
+        "empty drain joins original pending request"
+    );
+    release.notify_one();
+    final_drain.await.expect("final drain joins original RPC");
+    process
+        .terminate_confirmed()
+        .await
+        .expect("original request eventually acknowledges");
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    drop(process);
+    session
+        .services
+        .local_agent_runtime
+        .request_shutdown()
+        .wait_for_process_shutdown()
+        .await
+        .expect_err("empty later drain cannot repair uncertain acknowledgment");
+    assert!(
+        session
+            .services
+            .unified_exec_manager
+            .remote_process_termination_failed(),
+        "first uncertain close remains failed"
+    );
+}
