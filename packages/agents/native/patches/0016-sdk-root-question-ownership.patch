+/// Trusted SDK opt-ins capture authority without changing root approval policy.
+pub(crate) fn sdk_owns_prompts(session: &Session, turn: &TurnContext) -> bool {
+    let extension = if turn.session_source.is_non_root_agent() {
+        "openai/sdk-child-prompts"
+    } else {
+        "openai/sdk-root-prompts"
+    };
+    session.services.client_mcp_extensions.contains(extension)
