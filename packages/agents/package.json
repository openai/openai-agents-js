        "dist/testing/index.d.ts"
      ],
      "sandbox": [
        "dist/sandbox/index.d.ts"
      ],
      "sandbox/local": [
        "dist/sandbox/local.d.ts"
      ],
      "realtime": [
        "dist/realtime/index.d.ts"
