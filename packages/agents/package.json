      ],
      "classic/testing": [
        "dist/classic/testing/index.d.ts"
      ],
      "classic/sandbox": [
        "dist/classic/sandbox/index.d.ts"
      ],
      "classic/sandbox/local": [
        "dist/classic/sandbox/local.d.ts"
      ],
      "classic/realtime": [
        "dist/classic/realtime/index.d.ts"
      ],
      "classic/realtime/testing": [
        "dist/classic/realtime/testing/index.d.ts"
      ],
      "classic/utils": [
        "dist/classic/utils/index.d.ts"
